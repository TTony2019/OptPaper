import Mathlib
import TheoremLib.Bot_Csetnek_An_Inertial_Tseng_s_Type_Proximal_Algorithm_for_Nonsmooth_and_Nonconvex_Optimization_Problems_2015.items.def_1

namespace BotCsetnek2015

/-- The Bregman distance generated by a differentiable function `u`. -/
noncomputable def bregmanDistance {m : Nat} (u : EuclideanSpace m -> Real)
    (x y : EuclideanSpace m) : Real :=
  u x - u y - inner Real (gradient u y) (x - y)

end BotCsetnek2015
