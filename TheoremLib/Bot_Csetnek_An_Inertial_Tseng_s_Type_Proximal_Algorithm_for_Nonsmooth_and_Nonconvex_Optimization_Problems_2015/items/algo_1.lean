import Mathlib
import TheoremLib.Bot_Csetnek_An_Inertial_Tseng_s_Type_Proximal_Algorithm_for_Nonsmooth_and_Nonconvex_Optimization_Problems_2015.items.def_3
import TheoremLib.Bot_Csetnek_An_Inertial_Tseng_s_Type_Proximal_Algorithm_for_Nonsmooth_and_Nonconvex_Optimization_Problems_2015.items.ext_def_2
import TheoremLib.Bot_Csetnek_An_Inertial_Tseng_s_Type_Proximal_Algorithm_for_Nonsmooth_and_Nonconvex_Optimization_Problems_2015.items.ext_def_4
import TheoremLib.Bot_Csetnek_An_Inertial_Tseng_s_Type_Proximal_Algorithm_for_Nonsmooth_and_Nonconvex_Optimization_Problems_2015.items.ext_def_7
import TheoremLib.Bot_Csetnek_An_Inertial_Tseng_s_Type_Proximal_Algorithm_for_Nonsmooth_and_Nonconvex_Optimization_Problems_2015.items.ext_thm_1

namespace BotCsetnek2015

/-- The objective minimized in the first line of Algorithm 3.1 at index `n`. -/
noncomputable def algorithmStepObjective {m : ℕ} (P : ProblemData m)
    (u : EuclideanSpace m → ℝ) (lambda alphaSeq : ℕ → ℝ)
    (x : ℕ → EuclideanSpace m) (n : ℕ) : EuclideanSpace m → EReal :=
  fun y ↦
    erealAddReal (P.f y)
      ((1 / lambda n) * bregmanDistance u y (x n) +
        inner ℝ y (gradient P.h (x n)) +
        (alphaSeq n / lambda n) * inner ℝ y (x (n - 1) - x n))

/-- Data generated by Algorithm 3.1. -/
structure AlgorithmData {m : ℕ} (P : ProblemData m) where
  x : ℕ → EuclideanSpace m
  p : ℕ → EuclideanSpace m
  lambda : ℕ → ℝ
  alphaSeq : ℕ → ℝ
  lambdaLower : ℝ
  lambdaUpper : ℝ
  alpha : ℝ
  u : EuclideanSpace m → ℝ
  sigma : ℝ
  Lgrad_u : ℝ
  lambdaLower_pos : 0 < lambdaLower
  lambdaUpper_pos : 0 < lambdaUpper
  alpha_nonneg : 0 ≤ alpha
  alpha_bounds : ∀ n, 1 ≤ n → 0 ≤ alphaSeq n ∧ alphaSeq n ≤ alpha
  lambda_bounds : ∀ n, 1 ≤ n → lambdaLower ≤ lambda n ∧ lambda n ≤ lambdaUpper
  u_strongly_convex : StronglyConvexWith sigma u
  u_lipschitz_gradient : HasLipschitzContinuousGradient u Lgrad_u
  u_Lgrad_pos : 0 < Lgrad_u
  p_argmin : ∀ n, 1 ≤ n →
    p n ∈ argminSet (algorithmStepObjective P u lambda alphaSeq x n)
  x_update : ∀ n, 1 ≤ n →
    x (n + 1) = p n + lambda n • (gradient P.h (x n) - gradient P.h (p n))

/-- Inequality (5), available for the Bregman distance used by Algorithm 3.1. -/
theorem algorithm_bregman_bounds {m : ℕ} {P : ProblemData m} (A : AlgorithmData P) :
    ∀ x y : EuclideanSpace m,
      (A.sigma / 2) * ‖x - y‖ ^ 2 ≤ bregmanDistance A.u x y ∧
        bregmanDistance A.u x y ≤ (A.Lgrad_u / 2) * ‖x - y‖ ^ 2 :=
  bregmanDistance_quadratic_bounds A.u A.sigma A.Lgrad_u A.u_strongly_convex
    A.u_lipschitz_gradient

end BotCsetnek2015
