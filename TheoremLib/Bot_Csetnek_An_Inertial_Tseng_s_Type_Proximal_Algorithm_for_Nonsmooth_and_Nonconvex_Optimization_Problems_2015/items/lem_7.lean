open ERealFunction

noncomputable def pairSequence {m : ℕ} {P : ProblemData m} (A : AlgorithmData P) :
    ℕ → EuclideanSpace m × EuclideanSpace m :=
  fun n ↦ (A.p n, A.x n)

noncomputable def HFunction {m : ℕ} (P : ProblemData m) (M2 : ℝ) :
    EuclideanSpace m × EuclideanSpace m → EReal :=
  fun z ↦ objectiveWithQuadratic P M2 z.1 z.2

/-- The Hilbert `ℓ²` product used for the KL property of the Lyapunov function. -/
abbrev HilbertProduct (m : ℕ) :=
  WithLp 2 (EuclideanSpace m × EuclideanSpace m)

/-- The algorithm pair sequence viewed in the Hilbert `ℓ²` product. -/
noncomputable def pairSequenceL2 {m : ℕ} {P : ProblemData m} (A : AlgorithmData P) :
    ℕ → HilbertProduct m :=
  fun n ↦ WithLp.toLp 2 (A.p n, A.x n)

/-- The product Lyapunov function on its canonical Hilbert `ℓ²` product space. -/
noncomputable def HFunctionL2 {m : ℕ} (P : ProblemData m) (M2 : ℝ) :
    HilbertProduct m → EReal :=
  fun z ↦ objectiveWithQuadratic P M2 z.fst z.snd

private noncomputable def quadraticProductGradient {m : ℕ} (M : ℝ) :
    HilbertProduct m → HilbertProduct m :=
  fun z ↦ WithLp.toLp 2
    ((2 * M) • (z.fst - z.snd), (2 * M) • (z.snd - z.fst))

private theorem quadraticProduct_hasGradientAt {m : ℕ} (M : ℝ) (z : HilbertProduct m) :
    HasGradientAt (fun w : HilbertProduct m ↦ M * ‖w.fst - w.snd‖ ^ 2)
      (quadraticProductGradient M z) z := by
  rw [hasGradientAt_iff_hasFDerivAt]
  let L : HilbertProduct m →L[ℝ] EuclideanSpace m :=
    WithLp.fstL 2 ℝ _ _ - WithLp.sndL 2 ℝ _ _
  have hd : HasFDerivAt (fun w : HilbertProduct m ↦ w.fst - w.snd) L z := by
    exact (WithLp.fstL 2 ℝ _ _).hasFDerivAt.sub (WithLp.sndL 2 ℝ _ _).hasFDerivAt
  have hq := hd.norm_sq.const_mul M
  convert hq using 1
  ext w
  simp only [InnerProductSpace.toDual_apply_apply, ContinuousLinearMap.coe_smul',
    ContinuousLinearMap.coe_comp', Pi.smul_apply, Function.comp_apply, innerSL_apply_apply]
  rw [WithLp.prod_inner_apply]
  simp only [quadraticProductGradient, WithLp.ofLp_fst, WithLp.ofLp_snd]
  dsimp [L]
  simp_rw [inner_smul_left, inner_sub_left, inner_sub_right]
  simp only [starRingEnd_apply, star_trivial]
  ring

private theorem quadraticProductGradient_continuous {m : ℕ} (M : ℝ) :
    Continuous (quadraticProductGradient (m := m) M) := by
  unfold quadraticProductGradient
  fun_prop

/-- The explicit product vector generated by an objective subgradient is a limiting
subgradient of the Lyapunov function. -/
theorem HFunctionL2_limitingSubgradient {m : ℕ} (P : ProblemData m) (M : ℝ)
    {x y v : EuclideanSpace m}
    (hv : v ∈ limitingSubdifferential P.objective x) :
    WithLp.toLp 2
        (v + (2 * M) • (x - y), (2 * M) • (y - x)) ∈
      ERealFunction.limitingSubdifferential (HFunctionL2 P M) (WithLp.toLp 2 (x, y)) := by
  have hlift := ERealFunction.limitingSubdifferential_comp_fst
    (F := EuclideanSpace m) (y := y) hv
  have hadd := ERealFunction.limitingSubdifferential_addReal_of_mem
    (f := fun z : HilbertProduct m ↦ P.objective z.fst)
    (h := fun z : HilbertProduct m ↦ M * ‖z.fst - z.snd‖ ^ 2)
    (g := quadraticProductGradient M)
    (fun z ↦ quadraticProduct_hasGradientAt M z)
    (quadraticProductGradient_continuous M) hlift
  have hvec :
      WithLp.toLp 2 (v, 0) + quadraticProductGradient M (WithLp.toLp 2 (x, y)) =
        WithLp.toLp 2
          (v + (2 * M) • (x - y), (2 * M) • (y - x)) := by
    apply WithLp.ofLp_injective
    simp [quadraticProductGradient]
  rw [← hvec]
  simpa [HFunctionL2, objectiveWithQuadratic, erealAddReal] using hadd

noncomputable def diagonalCriticalSet {m : ℕ} (P : ProblemData m) :
    Set (EuclideanSpace m × EuclideanSpace m) :=
  {z | z.1 = z.2 ∧ z.1 ∈ limitingCriticalPoints P.objective}

/-
The paper identifies the limiting-critical set of the product Lyapunov
function with this diagonal set.  The reverse subdifferential sum rule needed
for the exact characterization is not yet present, so this set remains the
named interface used by Lemma 3.7.
-/
noncomputable def HCriticalSet {m : ℕ} (P : ProblemData m) (_M2 : ℝ) :
    Set (EuclideanSpace m × EuclideanSpace m) :=
  diagonalCriticalSet P

private theorem erealAddReal_eq_add_local (a : EReal) (r : ℝ) :
    erealAddReal a r = a + (r : EReal) := by
  cases a with
  | bot =>
      rw [EReal.bot_add]
      change (⊥ : EReal) = ⊥
      rfl
  | coe s =>
      rw [← EReal.coe_add]
      change ((s + r : ℝ) : EReal) = ((s + r : ℝ) : EReal)
      rfl
  | top =>
      rw [EReal.top_add_coe]
      change (⊤ : EReal) = ⊤
      rfl

private theorem erealAddReal_zero (a : EReal) : erealAddReal a 0 = a := by
  rw [erealAddReal_eq_add_local]
  cases a <;> simp

private theorem lowerSemicontinuous_add_ereal_pair_local {X : Type*} [TopologicalSpace X]
    {g h : X → EReal} (hg : LowerSemicontinuous g) (hh : LowerSemicontinuous h) :
    LowerSemicontinuous (fun x ↦ g x + h x) := by
  rw [lowerSemicontinuous_iff_le_liminf]
  intro x
  calc
    g x + h x ≤ Filter.liminf g (nhds x) + Filter.liminf h (nhds x) :=
      add_le_add (hg.le_liminf x) (hh.le_liminf x)
    _ ≤ Filter.liminf (fun y ↦ g y + h y) (nhds x) := by
      simpa using
        (EReal.le_liminf_add :
          Filter.liminf g (nhds x) + Filter.liminf h (nhds x) ≤
            Filter.liminf (g + h) (nhds x))

private theorem objective_isProper_local {m : ℕ} (P : ProblemData m) :
    ERealFunction.IsProper P.objective := by
  rcases P.f_proper with ⟨hf_ne_bot, x0, hx0_lt_top⟩
  constructor
  · intro x
    unfold ProblemData.objective objectiveSum erealAddReal
    cases hfx : P.f x with
    | bot =>
        exact (hf_ne_bot x hfx).elim
    | coe r =>
        change ((r : EReal) + (P.h x : EReal)) ≠ ⊥
        rw [← EReal.coe_add]
        exact EReal.coe_ne_bot _
    | top =>
        change ((⊤ : EReal) + (P.h x : EReal)) ≠ ⊥
        rw [EReal.top_add_coe]
        exact top_ne_bot
  · have hx0_ne_top : P.f x0 ≠ ⊤ := ne_of_lt hx0_lt_top
    have hx0_eff : x0 ∈ ERealFunction.effectiveDom P.f := by
      rw [ERealFunction.mem_effectiveDom_iff]
      exact ⟨hx0_ne_top, hf_ne_bot x0⟩
    rcases (ERealFunction.mem_effectiveDom_iff_exists_real P.f x0).mp hx0_eff with
      ⟨r, hr⟩
    refine ⟨x0, ?_⟩
    rw [ERealFunction.mem_dom_iff]
    unfold ProblemData.objective objectiveSum erealAddReal
    rw [hr]
    change ((r : EReal) + (P.h x0 : EReal)) < ⊤
    rw [← EReal.coe_add]
    exact EReal.coe_lt_top _

private theorem objective_lowerSemicontinuous_local {m : ℕ} (P : ProblemData m) :
    LowerSemicontinuous P.objective := by
  have hh_cont : Continuous (fun x : EuclideanSpace m ↦ (P.h x : EReal)) :=
    continuous_coe_real_ereal.comp P.h_frechet_differentiable.continuous
  have hh_lsc : LowerSemicontinuous (fun x : EuclideanSpace m ↦ (P.h x : EReal)) :=
    hh_cont.lowerSemicontinuous
  have hsum :
      LowerSemicontinuous
        (fun x : EuclideanSpace m ↦ P.f x + (P.h x : EReal)) :=
    lowerSemicontinuous_add_ereal_pair_local P.f_lsc hh_lsc
  change LowerSemicontinuous (objectiveSum P.f P.h)
  convert hsum using 1
  funext x
  simp [objectiveSum, erealAddReal_eq_add_local]

theorem objective_bddBelow_of_coercive {m : ℕ} {P : ProblemData m}
    (hcoercive : CoerciveEReal P.objective) :
    ∃ C : ℝ, ∀ x : EuclideanSpace m, (C : EReal) ≤ P.objective x := by
  have hmin :=
    exists_minimizer_of_proper_lsc_coercive P.objective (objective_isProper_local P)
      (objective_lowerSemicontinuous_local P) hcoercive
  rcases hmin.1 with ⟨C, hCinf⟩
  rcases hmin.2 with ⟨xmin, hxmin_min, _hxmin_eq_inf⟩
  have hmin_all : ∀ x : EuclideanSpace m, P.objective xmin ≤ P.objective x := by
    simpa [IsMinOn, IsMinFilter] using hxmin_min
  refine ⟨C, ?_⟩
  intro x
  rw [← hCinf, ← _hxmin_eq_inf]
  exact hmin_all x

private theorem tendsto_norm_of_summable_norm_sq_local {m : ℕ}
    {z : ℕ → EuclideanSpace m}
    (hs : Summable (fun n : ℕ ↦ ‖z n‖ ^ 2)) :
    Tendsto (fun n : ℕ ↦ ‖z n‖) atTop (nhds 0) := by
  have hs0 : Tendsto (fun n : ℕ ↦ ‖z n‖ ^ 2) atTop (nhds 0) :=
    hs.tendsto_atTop_zero
  have hsqrt :
      Tendsto (fun n : ℕ ↦ Real.sqrt (‖z n‖ ^ 2)) atTop
        (nhds (Real.sqrt 0)) :=
    (Real.continuous_sqrt.tendsto 0).comp hs0
  simpa [Real.sqrt_sq_eq_abs, abs_of_nonneg (norm_nonneg _)] using hsqrt

theorem tendsto_of_summable_norm_sq_local {m : ℕ}
    {z : ℕ → EuclideanSpace m}
    (hs : Summable (fun n : ℕ ↦ ‖z n‖ ^ 2)) :
    Tendsto z atTop (nhds 0) := by
  exact tendsto_zero_iff_norm_tendsto_zero.mpr
    (tendsto_norm_of_summable_norm_sq_local hs)

private theorem p_increments_tendsto_zero_local {m : ℕ} {P : ProblemData m}
    (A : AlgorithmData P)
    (hxp : Summable (fun n : ℕ ↦ ‖A.x n - A.p n‖ ^ 2))
    (hxx : Summable (fun n : ℕ ↦ ‖A.x (n + 1) - A.x n‖ ^ 2)) :
    Tendsto (fun n : ℕ ↦ A.p (n + 1) - A.p n) atTop
      (nhds (0 : EuclideanSpace m)) := by
  have hxp_vec :
      Tendsto (fun n : ℕ ↦ A.x n - A.p n) atTop
        (nhds (0 : EuclideanSpace m)) :=
    tendsto_of_summable_norm_sq_local hxp
  have hxx_vec :
      Tendsto (fun n : ℕ ↦ A.x (n + 1) - A.x n) atTop
        (nhds (0 : EuclideanSpace m)) :=
    tendsto_of_summable_norm_sq_local hxx
  have hxp_shift_neg :
      Tendsto (fun n : ℕ ↦ A.p (n + 1) - A.x (n + 1)) atTop
        (nhds (0 : EuclideanSpace m)) := by
    have hshift :
        Tendsto (fun n : ℕ ↦ A.x (n + 1) - A.p (n + 1)) atTop
          (nhds (0 : EuclideanSpace m)) :=
      hxp_vec.comp (tendsto_add_atTop_nat 1)
    simpa [sub_eq_add_neg] using hshift.neg
  have hsum :
      Tendsto
        (fun n : ℕ ↦
          (A.p (n + 1) - A.x (n + 1)) +
            (A.x (n + 1) - A.x n) + (A.x n - A.p n))
        atTop (nhds (0 : EuclideanSpace m)) := by
    simpa using (hxp_shift_neg.add hxx_vec).add hxp_vec
  have hid :
      (fun n : ℕ ↦ A.p (n + 1) - A.p n) =
        fun n : ℕ ↦
          (A.p (n + 1) - A.x (n + 1)) +
            (A.x (n + 1) - A.x n) + (A.x n - A.p n) := by
    funext n
    abel
  simpa [hid] using hsum

theorem omega_pair_fst_mem {m : ℕ} {P : ProblemData m} {A : AlgorithmData P}
    {z : EuclideanSpace m × EuclideanSpace m}
    (hz : z ∈ omega (pairSequence A)) :
    z.1 ∈ omega A.p := by
  rcases IsSequentialClusterPt.exists_subseq_tendsto (by simpa [omega] using hz) with
    ⟨phi, hphi, hlim⟩
  refine ⟨phi, hphi, ?_⟩
  have hfst := (continuous_fst.tendsto z).comp hlim
  simpa [Function.comp, pairSequence] using hfst

theorem omega_pair_diagonal {m : ℕ} {P : ProblemData m} {A : AlgorithmData P}
    (hxp_vec : Tendsto (fun n : ℕ ↦ A.x n - A.p n) atTop
      (nhds (0 : EuclideanSpace m)))
    {z : EuclideanSpace m × EuclideanSpace m}
    (hz : z ∈ omega (pairSequence A)) :
    z.1 = z.2 := by
  rcases IsSequentialClusterPt.exists_subseq_tendsto (by simpa [omega] using hz) with
    ⟨phi, _hphi, hlim⟩
  have hp_lim : Tendsto (fun k : ℕ ↦ A.p (phi k)) atTop (nhds z.1) := by
    have hfst := (continuous_fst.tendsto z).comp hlim
    simpa [Function.comp, pairSequence] using hfst
  have hx_lim : Tendsto (fun k : ℕ ↦ A.x (phi k)) atTop (nhds z.2) := by
    have hsnd := (continuous_snd.tendsto z).comp hlim
    simpa [Function.comp, pairSequence] using hsnd
  have hdiff_lim :
      Tendsto (fun k : ℕ ↦ A.x (phi k) - A.p (phi k)) atTop
        (nhds (z.2 - z.1)) :=
    hx_lim.sub hp_lim
  have hphi_atTop : Tendsto phi atTop atTop := StrictMono.tendsto_atTop _hphi
  have hdiff_zero :
      Tendsto (fun k : ℕ ↦ A.x (phi k) - A.p (phi k)) atTop
        (nhds (0 : EuclideanSpace m)) :=
    hxp_vec.comp hphi_atTop
  have hzero : z.2 - z.1 = 0 := tendsto_nhds_unique hdiff_lim hdiff_zero
  exact Eq.symm (sub_eq_zero.mp hzero)

theorem omega_pair_diag_mem {m : ℕ} {P : ProblemData m} {A : AlgorithmData P}
    (hxp_vec : Tendsto (fun n : ℕ ↦ A.x n - A.p n) atTop
      (nhds (0 : EuclideanSpace m)))
    {p : EuclideanSpace m} (hp : p ∈ omega A.p) :
    (p, p) ∈ omega (pairSequence A) := by
  rcases IsSequentialClusterPt.exists_subseq_tendsto (by simpa [omega] using hp) with
    ⟨phi, hphi, hp_lim⟩
  refine ⟨phi, hphi, ?_⟩
  have hphi_atTop : Tendsto phi atTop atTop := StrictMono.tendsto_atTop hphi
  have hxp_sub :
      Tendsto (fun k : ℕ ↦ A.x (phi k) - A.p (phi k)) atTop
        (nhds (0 : EuclideanSpace m)) :=
    hxp_vec.comp hphi_atTop
  have hx_lim : Tendsto (fun k : ℕ ↦ A.x (phi k)) atTop (nhds p) := by
    have hsum := hp_lim.add hxp_sub
    simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hsum
  rw [Prod.tendsto_iff]
  exact ⟨by simpa [Function.comp, pairSequence] using hp_lim,
    by simpa [Function.comp, pairSequence] using hx_lim⟩

theorem omega_pair_eq_diag_image {m : ℕ} {P : ProblemData m} {A : AlgorithmData P}
    (hxp_vec : Tendsto (fun n : ℕ ↦ A.x n - A.p n) atTop
      (nhds (0 : EuclideanSpace m))) :
    omega (pairSequence A) =
      (fun p : EuclideanSpace m ↦ (p, p)) '' omega A.p := by
  ext z
  constructor
  · intro hz
    refine ⟨z.1, omega_pair_fst_mem hz, ?_⟩
    have hzdiag := omega_pair_diagonal hxp_vec hz
    ext <;> simp [hzdiag]
  · rintro ⟨p, hp, rfl⟩
    exact omega_pair_diag_mem hxp_vec hp

/-- Lemma 3.7: cluster points of `(p_n, x_n)` and the Lyapunov function `H`. -/
theorem lemma_3_7_pair_cluster_points {m : ℕ} {P : ProblemData m} (A : AlgorithmData P)
    (nu mu : ℝ) (hchosen : chosenAsInLemma33 A nu mu)
    (hcoercive : CoerciveEReal P.objective) :
    (omega (pairSequence A)).Nonempty ∧
      omega (pairSequence A) ⊆ HCriticalSet P (A.M2 nu mu) ∧
      HCriticalSet P (A.M2 nu mu) = diagonalCriticalSet P ∧
      Tendsto (fun n : ℕ ↦ Metric.infDist (pairSequence A n) (omega (pairSequence A)))
        atTop (nhds 0) ∧
      IsCompact (omega (pairSequence A)) ∧
      IsConnected (omega (pairSequence A)) ∧
      (∃ c : EReal, ∀ z ∈ omega (pairSequence A), HFunction P (A.M2 nu mu) z = c) := by
  have hchosen_copy := hchosen
  rcases hchosen_copy with ⟨_hnu, _hmu, _hstrict, _hM2ltM1⟩
  have h36 := lemma_3_6_cluster_points A nu mu hchosen hcoercive
  rcases h36 with
    ⟨hp_omega_nonempty, hp_crit, hp_dist, hp_compact, hp_connected, hp_const⟩
  have hboundedBelowReal :
      ∃ C : ℝ, ∀ x : EuclideanSpace m, (C : EReal) ≤ P.objective x :=
    objective_bddBelow_of_coercive hcoercive
  have hboundedBelow : BddBelow (Set.range P.objective) := by
    rcases hboundedBelowReal with ⟨C, hC⟩
    refine ⟨(C : EReal), ?_⟩
    rintro y ⟨x, rfl⟩
    exact hC x
  rcases lemma_3_4_decrease A nu mu hchosen hboundedBelowReal with
    ⟨hxp_sum, _hxx_sum, _hobj_conv⟩
  have hxp_vec :
      Tendsto (fun n : ℕ ↦ A.x n - A.p n) atTop
        (nhds (0 : EuclideanSpace m)) :=
    tendsto_of_summable_norm_sq_local hxp_sum
  let diagMap : EuclideanSpace m → EuclideanSpace m × EuclideanSpace m :=
    fun p ↦ (p, p)
  have hdiag_cont : Continuous diagMap := by
    rw [continuous_iff_continuousAt]
    intro p
    rw [ContinuousAt, Prod.tendsto_iff]
    exact ⟨tendsto_id, tendsto_id⟩
  have homega_eq :
      omega (pairSequence A) = diagMap '' omega A.p := by
    simpa [diagMap] using omega_pair_eq_diag_image (A := A) hxp_vec
  have homega_nonempty : (omega (pairSequence A)).Nonempty := by
    rcases hp_omega_nonempty with ⟨p, hp⟩
    refine ⟨diagMap p, ?_⟩
    rw [homega_eq]
    exact ⟨p, hp, rfl⟩
  have homega_compact : IsCompact (omega (pairSequence A)) := by
    rw [homega_eq]
    exact hp_compact.image hdiag_cont
  have homega_connected : IsConnected (omega (pairSequence A)) := by
    rw [homega_eq]
    exact hp_connected.image diagMap hdiag_cont.continuousOn
  have hsubset_diag : omega (pairSequence A) ⊆ diagonalCriticalSet P := by
    intro z hz
    exact ⟨omega_pair_diagonal hxp_vec hz, hp_crit (omega_pair_fst_mem hz)⟩
  have hdist_pair :
      Tendsto (fun n : ℕ ↦ Metric.infDist (pairSequence A n) (omega (pairSequence A)))
        atTop (nhds 0) := by
    have hxp_dist :
        Tendsto (fun n : ℕ ↦ dist (A.x n) (A.p n)) atTop (nhds 0) := by
      have hnorm :
          Tendsto (fun n : ℕ ↦ ‖A.x n - A.p n‖) atTop (nhds 0) :=
        tendsto_norm_of_summable_norm_sq_local hxp_sum
      simpa [dist_eq_norm] using hnorm
    rw [Metric.tendsto_atTop]
    intro eps heps
    have heps3 : 0 < eps / 3 := by positivity
    rcases (Metric.tendsto_atTop.1 hp_dist (eps / 3) heps3) with ⟨Np, hNp⟩
    rcases (Metric.tendsto_atTop.1 hxp_dist (eps / 3) heps3) with ⟨Nx, hNx⟩
    refine ⟨max Np Nx, ?_⟩
    intro n hn
    have hnNp : n ≥ Np := le_trans (le_max_left Np Nx) hn
    have hnNx : n ≥ Nx := le_trans (le_max_right Np Nx) hn
    have hp_inf_lt :
        Metric.infDist (A.p n) (omega A.p) < eps / 3 := by
      have h := hNp n hnNp
      simpa [Real.dist_eq, abs_of_nonneg Metric.infDist_nonneg] using h
    have hx_dist_lt : dist (A.x n) (A.p n) < eps / 3 := by
      have h := hNx n hnNx
      simpa [Real.dist_eq, abs_of_nonneg dist_nonneg] using h
    rcases (Metric.infDist_lt_iff hp_omega_nonempty).1 hp_inf_lt with
      ⟨q, hq, hpq_lt⟩
    have hq_pair : (q, q) ∈ omega (pairSequence A) := by
      rw [homega_eq]
      exact ⟨q, hq, rfl⟩
    have hpq_eps : dist (A.p n) q < eps := by
      nlinarith [hpq_lt, heps]
    have hxq_lt : dist (A.x n) q < eps := by
      have hxq_le : dist (A.x n) q ≤ dist (A.x n) (A.p n) + dist (A.p n) q :=
        dist_triangle (A.x n) (A.p n) q
      have hsum : dist (A.x n) (A.p n) + dist (A.p n) q < eps / 3 + eps / 3 :=
        add_lt_add hx_dist_lt hpq_lt
      have htwo : eps / 3 + eps / 3 < eps := by nlinarith [heps]
      exact lt_of_le_of_lt hxq_le (lt_trans hsum htwo)
    have hpair_dist_lt : dist (pairSequence A n) (q, q) < eps := by
      rw [pairSequence, Prod.dist_eq]
      exact max_lt hpq_eps hxq_lt
    have hinf_lt :
        Metric.infDist (pairSequence A n) (omega (pairSequence A)) < eps :=
      lt_of_le_of_lt (Metric.infDist_le_dist_of_mem hq_pair) hpair_dist_lt
    simpa [Real.dist_eq, abs_of_nonneg Metric.infDist_nonneg] using hinf_lt
  have hH_const :
      ∃ c : EReal, ∀ z ∈ omega (pairSequence A), HFunction P (A.M2 nu mu) z = c := by
    rcases hp_const with ⟨cR, hcR⟩
    refine ⟨(cR : EReal), ?_⟩
    intro z hz
    have hzp : z.1 ∈ omega A.p := omega_pair_fst_mem hz
    have hzdiag : z.1 = z.2 := omega_pair_diagonal hxp_vec hz
    calc
      HFunction P (A.M2 nu mu) z
          = erealAddReal (P.objective z.1) ((A.M2 nu mu) * ‖z.1 - z.2‖ ^ 2) := by
              rfl
      _ = erealAddReal (P.objective z.1) 0 := by
              rw [hzdiag, sub_self]
              norm_num
      _ = P.objective z.1 := erealAddReal_zero _
      _ = (cR : EReal) := hcR z.1 hzp
  exact ⟨homega_nonempty, by simpa [HCriticalSet] using hsubset_diag, rfl,
    hdist_pair, homega_compact, homega_connected, hH_const⟩

end BotCsetnek2015
