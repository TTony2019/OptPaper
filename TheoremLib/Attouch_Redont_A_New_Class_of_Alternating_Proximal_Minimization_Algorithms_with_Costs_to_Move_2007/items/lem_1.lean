import Mathlib

/-!
# Lemma 2.3: Fundamental Dissipative Inequality

Under assumptions H21-H24, for any sequence generated by (CA²):
μ_n f(x_{n+1}) + β_n g(y_{n+1}) + β_n μ_n c(x_{n+1}, y_{n+1})
+ μ_n α_n h(x_n, x_{n+1}) + β_n ν_n k(y_n, y_{n+1})
≤ μ_n f(x_n) + β_n g(y_n) + β_n μ_n c(x_n, y_n).

Depends on: algo_1 (CA2 structure).

From: H. Attouch, P. Redont, A. Soubeyran (2007).
-/

/-- CA2 algorithm (duplicated for self-containment; see algo_1). -/
structure CA2 (X Y : Type*) (f : X → ℝ) (g : Y → ℝ)
    (h : X → X → ℝ) (k : Y → Y → ℝ) (c : X → Y → ℝ)
    (α β μ ν : ℕ → ℝ) where
  x : ℕ → X
  y : ℕ → Y
  step_x (n : ℕ) (ξ : X) :
    f (x (n+1)) + α n * h (x n) (x (n+1)) + β n * c (x (n+1)) (y n) ≤
    f ξ + α n * h (x n) ξ + β n * c ξ (y n)
  step_y (n : ℕ) (η : Y) :
    g (y (n+1)) + μ n * c (x (n+1)) (y (n+1)) + ν n * k (y n) (y (n+1)) ≤
    g η + μ n * c (x (n+1)) η + ν n * k (y n) η

/-- Assumptions H21-H24:
H21: X, Y are abstract spaces.
H22: f, g are bounded below.
H23: h, k, c ≥ 0, and h(x,x) = k(y,y) = 0.
H24: β_n > 0, μ_n > 0, α_n ≥ 0, ν_n ≥ 0. -/
structure H21toH24 (X Y : Type*) (f : X → ℝ) (g : Y → ℝ)
    (h : X → X → ℝ) (k : Y → Y → ℝ) (c : X → Y → ℝ)
    (α β μ ν : ℕ → ℝ) : Prop where
  f_bdd_below : ∃ Mf : ℝ, ∀ x : X, f x ≥ Mf
  g_bdd_below : ∃ Mg : ℝ, ∀ y : Y, g y ≥ Mg
  h_nonneg : ∀ x ξ : X, h x ξ ≥ 0
  k_nonneg : ∀ y η : Y, k y η ≥ 0
  c_nonneg : ∀ x : X, ∀ y : Y, c x y ≥ 0
  h_diag_zero : ∀ x : X, h x x = 0
  k_diag_zero : ∀ y : Y, k y y = 0
  beta_pos : ∀ n : ℕ, β n > 0
  mu_pos : ∀ n : ℕ, μ n > 0
  alpha_nonneg : ∀ n : ℕ, α n ≥ 0
  nu_nonneg : ∀ n : ℕ, ν n ≥ 0

/-- Lemma 2.3: For any sequence (x_n, y_n) generated by (CA²), the dissipative inequality holds. -/
theorem lemma_2_3 {X Y : Type*} {f : X → ℝ} {g : Y → ℝ}
    {h : X → X → ℝ} {k : Y → Y → ℝ} {c : X → Y → ℝ}
    {α β μ ν : ℕ → ℝ} (alg : CA2 X Y f g h k c α β μ ν)
    (hyp : H21toH24 X Y f g h k c α β μ ν) (n : ℕ) :
    μ n * f (alg.x (n+1)) + β n * g (alg.y (n+1)) + β n * μ n * c (alg.x (n+1)) (alg.y (n+1)) +
    μ n * α n * h (alg.x n) (alg.x (n+1)) + β n * ν n * k (alg.y n) (alg.y (n+1)) ≤
    μ n * f (alg.x n) + β n * g (alg.y n) + β n * μ n * c (alg.x n) (alg.y n) := by
  -- Instantiate CA² inequalities with ξ = x_n and η = y_n
  have hx := alg.step_x n (alg.x n)
  have hy := alg.step_y n (alg.y n)
  -- Simplify using h(x_n, x_n) = 0 and k(y_n, y_n) = 0
  have hx' : f (alg.x (n+1)) + α n * h (alg.x n) (alg.x (n+1)) + β n * c (alg.x (n+1)) (alg.y n) ≤
      f (alg.x n) + β n * c (alg.x n) (alg.y n) := by
    simpa [hyp.h_diag_zero (alg.x n)] using hx
  have hy' : g (alg.y (n+1)) + μ n * c (alg.x (n+1)) (alg.y (n+1)) + ν n * k (alg.y n) (alg.y (n+1)) ≤
      g (alg.y n) + μ n * c (alg.x (n+1)) (alg.y n) := by
    simpa [hyp.k_diag_zero (alg.y n)] using hy
  -- Multiply by nonnegative coefficients μ_n > 0, β_n > 0
  have hpos_mu : 0 ≤ μ n := by linarith [hyp.mu_pos n]
  have hpos_beta : 0 ≤ β n := by linarith [hyp.beta_pos n]
  have hx_mul := mul_le_mul_of_nonneg_left hx' hpos_mu
  have hy_mul := mul_le_mul_of_nonneg_left hy' hpos_beta
  -- Add the two inequalities and cancel the common cross-term μ_n β_n c(x_{n+1}, y_n)
  have h_add := add_le_add hx_mul hy_mul
  nlinarith
