/-!
# Convergence of the splitting inertial proximal method

Theorem 1 from Moudafi–Oliny (2002):
Let `{x_k} ⊂ H` be a sequence generated by
`λ_k A_{ε_k}(x_{k+1}) + x_{k+1} - y_k + λ_k B(x_k) ∋ 0`,
where `y_k := x_k + θ_k(x_k - x_{k-1})`, `A, B` are two maximal monotone operators with
`B` β-cocoercive w.r.t. the solution set `S := (A + B)⁻¹(0)`.

Under the parameter conditions:
1. `∃ δ, ∃ λ̲ > 0` such that `∀ k ≥ 1`, `λ̲ ≤ λ_k ≤ 2β - δ`.
2. `∃ θ ∈ [0,1[` such that `∀ k ≥ 1`, `0 ≤ θ_k ≤ θ`.
3. `∑_{k=1}^{∞} ε_k < +∞`.
4. `∑_{k=1}^{∞} θ_k|x_k - x_{k-1}|² < +∞`.

Then there exists `x* ∈ S` such that `{x_k}` weakly converges to `x*`.

NOTE: The paper's proof implicitly assumes `S ≠ ∅` (it fixes `x ∈ S` at the start).
We make this explicit.
-/

open SetValuedOperator
open scoped InnerProductSpace Topology Pointwise
open Filter

variable {H : Type _} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

omit [CompleteSpace H] in
/-- For a maximal monotone operator, the zero-enlargement is contained in the operator. -/
theorem enlargement_zero_subset_of_maximal {T : SetValuedOperator H H}
    (hT : IsMaximalMonotone T) {x v : H} (hv : v ∈ enlargement T 0 x) : v ∈ T x := by
  rcases hT with ⟨hT_mono, hT_max⟩
  let T' : SetValuedOperator H H := fun y => T y ∪ {w | y = x ∧ w = v}
  have hT_subset : T.graph ⊆ T'.graph := by
    intro p hp
    exact Or.inl hp
  have hT'_mono : IsMonotone T' := by
    intro y z uy huy uz huz
    rcases huy with huy | huy
    · rcases huz with huz | huz
      · exact hT_mono uy huy uz huz
      · rcases huz with ⟨rfl, rfl⟩
        rw [enlargement, Set.mem_setOf_eq] at hv
        have h := hv y uy huy
        simpa [inner_neg_right] using h
    · rcases huy with ⟨rfl, rfl⟩
      rcases huz with huz | huz
      · rw [enlargement, Set.mem_setOf_eq] at hv
        have h := hv z uz huz
        have hEq : ⟪uy - uz, y - z⟫_ℝ = ⟪uz - uy, z - y⟫_ℝ := by
          rw [show uy - uz = -(uz - uy) by abel_nf, show y - z = -(z - y) by abel_nf]
          rw [inner_neg_left, inner_neg_right, neg_neg]
        rw [hEq]
        simpa using h
      · rcases huz with ⟨rfl, rfl⟩
        simp
  have hgraph : T'.graph ⊆ T.graph := hT_max T' hT'_mono hT_subset
  have hp : (x, v) ∈ T'.graph := by
    change v ∈ T' x
    exact Or.inr ⟨rfl, rfl⟩
  exact hgraph hp

omit [CompleteSpace H] in
/-- A single-valued monotone Lipschitz operator with full domain is maximal monotone. -/
theorem maximalMonotone_svEmbed_of_lipschitz
    {B : H → H} {β : ℝ}
    (hβ_pos : 0 < β)
    (hB_mono : IsMonotone (svEmbed B))
    (hB_lipschitz : ∀ x y : H, ‖B x - B y‖ ≤ (1 / β) * ‖x - y‖) :
    IsMaximalMonotone (svEmbed B) := by
  refine ⟨hB_mono, ?_⟩
  intro T hT_mono hsubset p hp
  rcases p with ⟨x, u⟩
  rw [SetValuedOperator.mem_graph_iff]
  rw [SetValuedOperator.mem_graph_iff] at hp
  dsimp [svEmbed]
  rw [Set.mem_singleton_iff]
  let d : H := u - B x
  have hmono_at : 0 ≤ ⟪B (x + (β / 2) • d) - u, (x + (β / 2) • d) - x⟫_ℝ := by
    have hB_mem : B (x + (β / 2) • d) ∈ T (x + (β / 2) • d) := by
      have hgraph : (x + (β / 2) • d, B (x + (β / 2) • d)) ∈ T.graph := by
        apply hsubset
        rw [SetValuedOperator.mem_graph_iff]
        dsimp [svEmbed]
        simp
      exact (SetValuedOperator.mem_graph_iff T _ _).mp hgraph
    exact hT_mono (B (x + (β / 2) • d)) hB_mem u hp
  have hinner_nonneg : 0 ≤ ⟪B (x + (β / 2) • d) - u, d⟫_ℝ := by
    have hβ2_pos : 0 < β / 2 := by positivity
    have hscaled :
        0 ≤ (β / 2) * ⟪B (x + (β / 2) • d) - u, d⟫_ℝ := by
      simpa [sub_eq_add_neg, inner_smul_right] using hmono_at
    exact nonneg_of_mul_nonneg_left (by simpa [mul_comm] using hscaled) hβ2_pos
  have hcs :
      ⟪B (x + (β / 2) • d) - B x, d⟫_ℝ ≤
        ‖B (x + (β / 2) • d) - B x‖ * ‖d‖ := by
    exact le_trans (le_abs_self _) (abs_real_inner_le_norm _ _)
  have hlip :
      ‖B (x + (β / 2) • d) - B x‖ ≤ (1 / 2) * ‖d‖ := by
    have h := hB_lipschitz (x + (β / 2) • d) x
    calc
      ‖B (x + (β / 2) • d) - B x‖
          ≤ (1 / β) * ‖(x + (β / 2) • d) - x‖ := h
      _ = (1 / 2) * ‖d‖ := by
        rw [show (x + (β / 2) • d) - x = (β / 2) • d by abel_nf, norm_smul]
        rw [Real.norm_eq_abs, abs_of_pos (by positivity : 0 < β / 2)]
        field_simp [hβ_pos.ne']
  have hnorm_sq_le : ‖d‖ ^ 2 ≤ (1 / 2) * ‖d‖ ^ 2 := by
    have hrewrite :
        ⟪B (x + (β / 2) • d) - u, d⟫_ℝ =
          ⟪B (x + (β / 2) • d) - B x, d⟫_ℝ - ‖d‖ ^ 2 := by
      rw [show B (x + (β / 2) • d) - u = B (x + (β / 2) • d) - B x - d by
        dsimp [d]
        abel_nf]
      rw [inner_sub_left, real_inner_self_eq_norm_sq]
    have hle_inner :
        ‖d‖ ^ 2 ≤ ⟪B (x + (β / 2) • d) - B x, d⟫_ℝ := by
      nlinarith
    have hmul : ‖B (x + (β / 2) • d) - B x‖ * ‖d‖ ≤
        ((1 / 2) * ‖d‖) * ‖d‖ := by
      gcongr
    nlinarith [hcs, hmul]
  have hd_zero : ‖d‖ = 0 := by
    have hnonneg : 0 ≤ ‖d‖ ^ 2 := sq_nonneg ‖d‖
    nlinarith
  have hd : d = 0 := norm_eq_zero.mp hd_zero
  calc
    u = d + B x := by dsimp [d]; abel_nf
    _ = B x := by rw [hd]; simp

/-- A maximal monotone operator plus a single-valued monotone Lipschitz operator is maximal
monotone. The range step is the standard Minty-resolvent contraction argument. -/
theorem maximalMonotone_add_svEmbed_of_lipschitz
    {A : SetValuedOperator H H} {B : H → H} {β : ℝ}
    (hA_max : IsMaximalMonotone A)
    (hβ_pos : 0 < β)
    (hB_mono : IsMonotone (svEmbed B))
    (hB_lipschitz : ∀ x y : H, ‖B x - B y‖ ≤ (1 / β) * ‖x - y‖) :
    IsMaximalMonotone (A + svEmbed B) := by
  have hB_max : IsMaximalMonotone (svEmbed B) :=
    maximalMonotone_svEmbed_of_lipschitz hβ_pos hB_mono hB_lipschitz
  have hA_dom_nonempty : A.dom.Nonempty := by
    rcases ((minty_surjective_iff_maximal_monotone hA_max.1).1 hA_max 0) with
      ⟨x, u, hu, _⟩
    exact ⟨x, u, hu⟩
  rcases hA_dom_nonempty with ⟨x₀, hx₀⟩
  have hdomB_univ : (svEmbed B).dom = Set.univ := by
    ext x
    rw [SetValuedOperator.mem_dom_iff]
    simp [svEmbed]
  have hdom : (interior (svEmbed B).dom ∩ A.dom).Nonempty := by
    refine ⟨x₀, ?_⟩
    constructor
    · rw [hdomB_univ]
      simp
    · exact hx₀
  have hsum_BA : IsMaximalMonotone (svEmbed B + A) :=
    (isMaximalMonotone_iff_maximal_isMonotone (svEmbed B + A)).2
      (Maximal.add_of_interior_dom_inter_dom_nonempty
        ((isMaximalMonotone_iff_maximal_isMonotone (svEmbed B)).1 hB_max)
        ((isMaximalMonotone_iff_maximal_isMonotone A).1 hA_max) hdom)
  have hcomm : svEmbed B + A = A + svEmbed B := by
    ext x w
    constructor
    · intro hw
      rcases (SetValuedOperator.mem_add_smul_iff (A := svEmbed B) (B := A) (r := 1) x w).mp
          (by simpa [one_smul] using hw) with ⟨uB, huB, uA, huA, hEq⟩
      have : w ∈ (A + (1 : ℝ) • svEmbed B) x := by
        rw [SetValuedOperator.mem_add_smul_iff]
        refine ⟨uA, huA, uB, huB, ?_⟩
        simpa [one_smul, add_comm] using hEq
      simpa [one_smul] using this
    · intro hw
      rcases (SetValuedOperator.mem_add_smul_iff (A := A) (B := svEmbed B) (r := 1) x w).mp
          (by simpa [one_smul] using hw) with ⟨uA, huA, uB, huB, hEq⟩
      have : w ∈ (svEmbed B + (1 : ℝ) • A) x := by
        rw [SetValuedOperator.mem_add_smul_iff]
        refine ⟨uB, huB, uA, huA, ?_⟩
        simpa [one_smul, add_comm] using hEq
      simpa [one_smul] using this
  simpa [hcomm] using hsum_BA

omit [CompleteSpace H] in
private theorem monotone_add_svEmbed
    {A : SetValuedOperator H H} {B : H → H}
    (hA_mono : IsMonotone A)
    (hB_mono : IsMonotone (svEmbed B)) :
    IsMonotone (A + svEmbed B) := by
  intro x y u hu v hv
  rcases (SetValuedOperator.mem_add_smul_iff (A := A) (B := svEmbed B) (r := 1) x u).mp
      (by simpa [one_smul] using hu) with ⟨uA, huA, uB, huB, hu_eq⟩
  rcases (SetValuedOperator.mem_add_smul_iff (A := A) (B := svEmbed B) (r := 1) y v).mp
      (by simpa [one_smul] using hv) with ⟨vA, hvA, vB, hvB, hv_eq⟩
  have h_eq : ⟪(uA + uB) - (vA + vB), x - y⟫_ℝ =
      ⟪uA - vA, x - y⟫_ℝ + ⟪uB - vB, x - y⟫_ℝ := by
    calc
      ⟪(uA + uB) - (vA + vB), x - y⟫_ℝ
          = ⟪(uA - vA) + (uB - vB), x - y⟫_ℝ := by abel_nf
      _ = ⟪uA - vA, x - y⟫_ℝ + ⟪uB - vB, x - y⟫_ℝ := by
        simp [inner_add_left]
  simpa [hu_eq, hv_eq, one_smul, h_eq] using
    add_nonneg (hA_mono uA huA vA hvA) (hB_mono uB huB vB hvB)

omit [CompleteSpace H] in
private theorem splitting_algorithm_unpack
    {A : SetValuedOperator H H} {B : H → H}
    (x y : ℕ → H) (lam ε : ℕ → ℝ)
    (h_alg : ∀ k, 1 ≤ k → (0 : H) ∈
      (lam k • enlargement A (ε k) (x (k + 1))) + {x (k + 1) - y k} +
        (lam k • svEmbed B (x k))) :
    ∀ k, 1 ≤ k → ∃ a_k ∈ enlargement A (ε k) (x (k + 1)),
      x (k + 1) - y k + lam k • B (x k) = -lam k • a_k := by
  intro k hk
  have h_alg_k := h_alg k hk
  rcases Set.mem_add.mp h_alg_k with ⟨w, hw, v, hv, hsum⟩
  rcases Set.mem_add.mp hw with ⟨u1, hu1, u2, hu2, hw_eq⟩
  have hu2_eq : u2 = x (k + 1) - y k := by simpa using hu2
  rcases Set.mem_smul_set.mp hu1 with ⟨a, ha, ha_eq⟩
  rcases Set.mem_smul_set.mp hv with ⟨b, hb, hb_eq⟩
  have hb_val : b = B (x k) := by
    dsimp [svEmbed] at hb
    simpa using hb
  have hsum_total : lam k • a + (x (k + 1) - y k) + lam k • B (x k) = 0 := by
    calc
      lam k • a + (x (k + 1) - y k) + lam k • B (x k)
          = u1 + (x (k + 1) - y k) + lam k • B (x k) := by rw [ha_eq]
      _ = u1 + u2 + lam k • B (x k) := by rw [← hu2_eq]
      _ = u1 + u2 + lam k • b := by rw [hb_val]
      _ = u1 + u2 + v := by rw [hb_eq]
      _ = w + v := by rw [hw_eq]
      _ = 0 := hsum
  have hgoal : x (k + 1) - y k + lam k • B (x k) = -lam k • a := by
    calc
      x (k + 1) - y k + lam k • B (x k)
          = ((lam k • a) + (x (k + 1) - y k) + lam k • B (x k)) - lam k • a := by
            abel_nf
      _ = (0 : H) - lam k • a := by rw [hsum_total]
      _ = -lam k • a := by simp
  exact ⟨a, ha, hgoal⟩

omit [CompleteSpace H] in
private theorem zeros_sum_svEmbed_repr
    {A : SetValuedOperator H H} {B : H → H} {S : Set H}
    (hS_def : S = (A + svEmbed B).zeros) :
    ∀ z ∈ S, ∃ az ∈ A z, az = -B z := by
  intro z hz
  rw [hS_def, SetValuedOperator.mem_zeros_iff] at hz
  have hz' : (0 : H) ∈ (A + (1 : ℝ) • svEmbed B) z := by
    simpa [one_smul] using hz
  rcases (SetValuedOperator.mem_add_smul_iff A (svEmbed B) 1 z 0).mp hz' with
    ⟨az, haz, bz, hbz, hzero_z⟩
  have hbz_eq : bz = B z := by
    dsimp [svEmbed] at hbz
    simpa using hbz
  have haz_eq : az = -B z := by
    rw [hbz_eq] at hzero_z
    simpa [add_comm] using eq_neg_of_add_eq_zero_left (by simpa using hzero_z.symm)
  exact ⟨az, haz, haz_eq⟩

omit [CompleteSpace H] in
private theorem norm_sq_diff_identity (z a b : H) :
    ‖z - a‖ ^ 2 - ‖z - b‖ ^ 2 =
      ‖b - a‖ ^ 2 + 2 * ⟪b - a, z - b⟫_ℝ := by
  rw [norm_sub_sq_real z a, norm_sub_sq_real z b, norm_sub_sq_real b a,
    inner_sub_right (b - a) z b, inner_sub_left b a z, inner_sub_left b a b]
  simp [real_inner_comm a b, real_inner_comm a z, real_inner_comm z b]
  ring

omit [CompleteSpace H] in
private theorem phi_inner_xkz_identity (x : ℕ → H) (z : H) (k : ℕ) :
    ⟪x k - x (k - 1), x k - z⟫_ℝ =
      (1 / 2 : ℝ) * ‖z - x k‖ ^ 2 - (1 / 2 : ℝ) * ‖z - x (k - 1)‖ ^ 2 +
        (1 / 2 : ℝ) * ‖x k - x (k - 1)‖ ^ 2 := by
  have h_vec : x k - z = (x k - x (k - 1)) + (x (k - 1) - z) := by
    abel_nf
  rw [h_vec, inner_add_right, real_inner_self_eq_norm_sq]
  have h_neg_inner : x (k - 1) - z = -(z - x (k - 1)) := by abel_nf
  rw [h_neg_inner, inner_neg_right]
  have h := norm_sq_diff_identity z (x k) (x (k - 1))
  have hrw : (1 / 2 : ℝ) * ‖z - x k‖ ^ 2 -
        (1 / 2 : ℝ) * ‖z - x (k - 1)‖ ^ 2 +
        (1 / 2 : ℝ) * ‖x k - x (k - 1)‖ ^ 2 =
      (1 / 2 : ℝ) * (‖z - x k‖ ^ 2 - ‖z - x (k - 1)‖ ^ 2) +
        (1 / 2 : ℝ) * ‖x k - x (k - 1)‖ ^ 2 := by
    ring
  rw [hrw, h]
  have h_neg_vec : x (k - 1) - x k = -(x k - x (k - 1)) := by abel_nf
  rw [h_neg_vec, norm_neg, inner_neg_left]
  ring

omit [CompleteSpace H] [InnerProductSpace ℝ H] in
private theorem sigma_sum_summable
    {β δ : ℝ} (hβ_pos : 0 < β) (hδ_pos : 0 < δ)
    (x : ℕ → H) (θ lam ε η : ℕ → ℝ)
    (hη_lower : ∀ k, 1 ≤ k → δ / (2 * β) ≤ η k)
    (hη_pos : ∀ k, 1 ≤ k → 0 < η k)
    (hlam_nonneg : ∀ k, 1 ≤ k → 0 ≤ lam k)
    (hlam_le_two_beta : ∀ k, 1 ≤ k → lam k ≤ 2 * β)
    (hθ_nonneg : ∀ k, 1 ≤ k → 0 ≤ θ k)
    (h_eps_sum : Summable ε)
    (h_eps_pos : ∀ k, ε k ≥ 0)
    (h_summable : Summable fun k : ℕ ↦ θ (k + 1) * ‖x (k + 1) - x k‖ ^ 2) :
    Summable fun k : ℕ =>
      (θ k / η k) * ‖x k - x (k - 1)‖ ^ 2 + lam k * ε k := by
  set σ_sum : ℕ → ℝ :=
    fun k => (θ k / η k) * ‖x k - x (k - 1)‖ ^ 2 + lam k * ε k
    with hσ_sum_def
  have h_nonneg : ∀ k, 0 ≤ σ_sum (k + 1) := by
    intro k
    have hk : 1 ≤ k + 1 := by omega
    dsimp [σ_sum]
    have h1 : 0 ≤ (θ (k + 1) / η (k + 1)) * ‖x (k + 1) - x k‖ ^ 2 := by
      have hθ : 0 ≤ θ (k + 1) := hθ_nonneg (k + 1) hk
      have hη : 0 ≤ η (k + 1) := le_of_lt (hη_pos (k + 1) hk)
      positivity
    have h2 : 0 ≤ lam (k + 1) * ε (k + 1) := by
      have hlam : 0 ≤ lam (k + 1) := hlam_nonneg (k + 1) hk
      have heps : 0 ≤ ε (k + 1) := h_eps_pos (k + 1)
      positivity
    positivity
  have h_bound : ∀ k, σ_sum (k + 1) ≤
      ((2 * β) / δ) * (θ (k + 1) * ‖x (k + 1) - x k‖ ^ 2) +
        (2 * β) * ε (k + 1) := by
    intro k
    have hk : 1 ≤ k + 1 := by omega
    dsimp [σ_sum]
    have hη_ge : δ / (2 * β) ≤ η (k + 1) := hη_lower (k + 1) hk
    have hη_pos' : 0 < η (k + 1) := hη_pos (k + 1) hk
    have hθ_nonneg' : 0 ≤ θ (k + 1) := hθ_nonneg (k + 1) hk
    have h_lam_le : lam (k + 1) ≤ 2 * β := hlam_le_two_beta (k + 1) hk
    have h_eps_nonneg : 0 ≤ ε (k + 1) := h_eps_pos (k + 1)
    have h_first : (θ (k + 1) / η (k + 1)) * ‖x (k + 1) - x k‖ ^ 2 ≤
        ((2 * β) / δ) * (θ (k + 1) * ‖x (k + 1) - x k‖ ^ 2) := by
      have h_div_pos : 0 < δ / (2 * β) := div_pos hδ_pos (by linarith)
      have h_one_div : 1 / η (k + 1) ≤ (2 * β) / δ := by
        calc
          1 / η (k + 1) ≤ 1 / (δ / (2 * β)) :=
            (one_div_le_one_div hη_pos' h_div_pos).mpr hη_ge
          _ = (2 * β) / δ := by field_simp [hδ_pos.ne']
      calc
        (θ (k + 1) / η (k + 1)) * ‖x (k + 1) - x k‖ ^ 2 =
            (1 / η (k + 1)) * (θ (k + 1) * ‖x (k + 1) - x k‖ ^ 2) := by
          ring
        _ ≤ ((2 * β) / δ) * (θ (k + 1) * ‖x (k + 1) - x k‖ ^ 2) := by
          have h_nonneg : 0 ≤ θ (k + 1) * ‖x (k + 1) - x k‖ ^ 2 := by
            positivity
          gcongr
    have h_second : lam (k + 1) * ε (k + 1) ≤ (2 * β) * ε (k + 1) :=
      mul_le_mul_of_nonneg_right h_lam_le h_eps_nonneg
    nlinarith
  have h_eps_shift_summable : Summable (fun k : ℕ => ε (k + 1)) :=
    (summable_nat_add_iff 1).mpr h_eps_sum
  have h_majorant_summable : Summable (fun k : ℕ =>
      ((2 * β) / δ) * (θ (k + 1) * ‖x (k + 1) - x k‖ ^ 2) +
        (2 * β) * ε (k + 1)) :=
    (h_summable.const_smul ((2 * β) / δ)).add
      (h_eps_shift_summable.const_smul (2 * β))
  have h_shifted_summable : Summable (fun k : ℕ => σ_sum (k + 1)) :=
    Summable.of_nonneg_of_le h_nonneg h_bound h_majorant_summable
  have hσ : Summable σ_sum := (summable_nat_add_iff 1).mp h_shifted_summable
  simpa [σ_sum] using hσ

omit [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem sum_range_le_tsum_of_nonneg {f : ℕ → ℝ}
    (hf_nonneg : ∀ k, 0 ≤ f k) (hf_summable : Summable f) (N : ℕ) :
    (Finset.range N).sum f ≤ ∑' k, f k := by
  set S : ℕ → ℝ := fun n => ∑ i ∈ Finset.range n, f i with hS_def
  have hS_mono : ∀ a b, a ≤ b → S a ≤ S b := by
    intro a b h
    dsimp [S]
    have h_sub : Finset.range a ⊆ Finset.range b := Finset.range_mono h
    have h_extra : 0 ≤ ((Finset.range b) \ (Finset.range a)).sum f :=
      Finset.sum_nonneg (fun i _ => hf_nonneg i)
    calc
      (Finset.range a).sum f ≤
