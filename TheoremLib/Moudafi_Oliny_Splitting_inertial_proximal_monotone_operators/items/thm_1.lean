    ∀ N, (Finset.range N).sum a ≤ D / (1 - θmax) := by
  intro N
  have h_denom_pos : 0 < 1 - θmax := by linarith
  induction N with
  | zero =>
    rw [Finset.sum_range_zero]
    exact div_nonneg hD_nonneg (by linarith)
  | succ m ih =>
    have h_rec' := h_rec m
    calc
      (Finset.range (m + 1)).sum a ≤ θmax * (Finset.range m).sum a + D := h_rec'
      _ ≤ θmax * (D / (1 - θmax)) + D := by
        have hmul := mul_le_mul_of_nonneg_left ih hθmax_nonneg
        nlinarith
      _ = D / (1 - θmax) := by
        field_simp [h_denom_pos.ne']
        ring

omit [CompleteSpace H] in
private theorem splitting_key_ineq
    {A : SetValuedOperator H H} {B : H → H} {β : ℝ}
    (x y : ℕ → H) (θ lam ε η : ℕ → ℝ) (phi : H → ℕ → ℝ) (S : Set H)
    (hy : ∀ k, 1 ≤ k → y k = x k + θ k • (x k - x (k - 1)))
    (h_alg_unpack : ∀ k, 1 ≤ k → ∃ a_k ∈ enlargement A (ε k) (x (k + 1)),
      x (k + 1) - y k + lam k • B (x k) = -lam k • a_k)
    (hB_coco' : ∀ x y : H, y ∈ S → β * ‖B x - B y‖ ^ 2 ≤
      ⟪B x - B y, x - y⟫_ℝ)
    (hS_repr : ∀ z ∈ S, ∃ az ∈ A z, az = -B z)
    (hβ_pos : 0 < β)
    (hlam_nonneg : ∀ k, 1 ≤ k → 0 ≤ lam k)
    (hη_pos : ∀ k, 1 ≤ k → 0 < η k)
    (h_theta_eta_sum_le_two : ∀ k, 1 ≤ k → θ k + η k ≤ 2)
    (hθ_nonneg : ∀ k, 1 ≤ k → 0 ≤ θ k)
    (hη_def : η = fun k => 1 - lam k / (2 * β))
    (hphi_eval : ∀ z k, phi z k = (1 / 2 : ℝ) * ‖z - x k‖ ^ 2) :
    ∀ z ∈ S, ∀ k, 1 ≤ k →
      phi z (k + 1) - phi z k - θ k * (phi z k - phi z (k - 1)) ≤
        -(1 / 2) * η k *
          ‖x (k + 1) - x k - (θ k / η k) • (x k - x (k - 1))‖ ^ 2 +
        (θ k / η k) * ‖x k - x (k - 1)‖ ^ 2 + lam k * ε k := by
  intro z hz k hk
  rcases hS_repr z hz with ⟨az, haz, haz_eq⟩
  set a := x (k + 1) - x k with ha_def
  set b := x k - x (k - 1) with hb_def
  have h_phi_expand : phi z k - phi z (k + 1) = (1 / 2 : ℝ) * ‖a‖ ^ 2
      + ⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ
      + θ k * ⟪b, z - x (k + 1)⟫_ℝ := by
    rw [hphi_eval z k, hphi_eval z (k + 1)]
    dsimp [a, b]
    have hy_eq := hy k hk
    calc
      (1 / 2 : ℝ) * ‖z - x k‖ ^ 2 - (1 / 2 : ℝ) * ‖z - x (k + 1)‖ ^ 2
          = (1 / 2 : ℝ) * (‖z - x k‖ ^ 2 - ‖z - x (k + 1)‖ ^ 2) := by
            ring
      _ = (1 / 2 : ℝ) * (‖x (k + 1) - x k‖ ^ 2
          + 2 * ⟪x (k + 1) - x k, z - x (k + 1)⟫_ℝ) := by
        rw [norm_sq_diff_identity z (x k) (x (k + 1))]
      _ = (1 / 2 : ℝ) * ‖x (k + 1) - x k‖ ^ 2
          + ⟪x (k + 1) - x k, z - x (k + 1)⟫_ℝ := by
        ring
      _ = (1 / 2 : ℝ) * ‖x (k + 1) - x k‖ ^ 2
          + (⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ
          + θ k * ⟪x k - x (k - 1), z - x (k + 1)⟫_ℝ) := by
        rw [show x (k + 1) - x k =
            (x (k + 1) - y k) + θ k • (x k - x (k - 1)) by
          rw [hy_eq]
          abel_nf]
        simp [inner_add_left, inner_smul_left]
      _ = (1 / 2 : ℝ) * ‖x (k + 1) - x k‖ ^ 2
          + ⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ
          + θ k * ⟪x k - x (k - 1), z - x (k + 1)⟫_ℝ := by
        ring
  have h_eps_bound : -lam k * ε k ≤
      ⟪x (k + 1) - y k + lam k • (B (x k) - B z), z - x (k + 1)⟫_ℝ := by
    rcases h_alg_unpack k hk with ⟨a_k, ha_k_enl, ha_k_eq⟩
    have h_enl := ha_k_enl z (-B z) (by rw [← haz_eq]; exact haz)
    rw [show -lam k * ε k = lam k * (-ε k) by ring]
    have htemp := mul_le_mul_of_nonneg_left h_enl (hlam_nonneg k hk)
    have h_rewrite : lam k * ⟪(-B z) - a_k, z - x (k + 1)⟫_ℝ
        = ⟪x (k + 1) - y k + lam k • (B (x k) - B z), z - x (k + 1)⟫_ℝ := by
      calc
        lam k * ⟪(-B z) - a_k, z - x (k + 1)⟫_ℝ
            = ⟪lam k • ((-B z) - a_k), z - x (k + 1)⟫_ℝ := by
              simp [inner_smul_left]
        _ = ⟪lam k • (-B z) - lam k • a_k, z - x (k + 1)⟫_ℝ := by
          rw [smul_sub]
        _ = ⟪-lam k • a_k - lam k • B z, z - x (k + 1)⟫_ℝ := by
          simp [smul_neg, add_comm, sub_eq_add_neg]
        _ = ⟪(x (k + 1) - y k + lam k • B (x k)) - lam k • B z,
          z - x (k + 1)⟫_ℝ := by
          rw [ha_k_eq]
        _ = ⟪x (k + 1) - y k + lam k • (B (x k) - B z),
          z - x (k + 1)⟫_ℝ := by
          rw [add_sub_assoc, smul_sub]
    rw [h_rewrite] at htemp
    exact htemp
  have h_coco_bound : -lam k * ⟪B (x k) - B z, x (k + 1) - z⟫_ℝ
      ≤ (lam k / (4 * β)) * ‖a‖ ^ 2 := by
    set u := B (x k) - B z with hu_def
    set v := a with hv_def
    have h_coco : β * ‖u‖ ^ 2 ≤ ⟪u, x k - z⟫_ℝ := hB_coco' (x k) z hz
    have h_expand : ⟪u, x (k + 1) - z⟫_ℝ = ⟪u, x k - z⟫_ℝ + ⟪u, v⟫_ℝ := by
      rw [← sub_add_sub_cancel (x (k + 1)) (x k) z, inner_add_right, hv_def,
        add_comm]
    have h_sq_expand : ‖(2 * β) • u + v‖ ^ 2 =
        4 * β ^ 2 * ‖u‖ ^ 2 + 4 * β * ⟪u, v⟫_ℝ + ‖v‖ ^ 2 := by
      calc
        ‖(2 * β) • u + v‖ ^ 2
            = ⟪(2 * β) • u + v, (2 * β) • u + v⟫_ℝ := by
              rw [real_inner_self_eq_norm_sq]
        _ = ‖(2 * β) • u‖ ^ 2 + 2 * ⟪(2 * β) • u, v⟫_ℝ + ‖v‖ ^ 2 := by
          calc
            ⟪(2 * β) • u + v, (2 * β) • u + v⟫_ℝ
                = ⟪(2 * β) • u, (2 * β) • u + v⟫_ℝ +
                    ⟪v, (2 * β) • u + v⟫_ℝ := by
                  rw [inner_add_left]
            _ = (⟪(2 * β) • u, (2 * β) • u⟫_ℝ + ⟪(2 * β) • u, v⟫_ℝ)
                + (⟪v, (2 * β) • u⟫_ℝ + ⟪v, v⟫_ℝ) := by
                  rw [inner_add_right, inner_add_right]
            _ = ‖(2 * β) • u‖ ^ 2 + ⟪(2 * β) • u, v⟫_ℝ
                + ⟪v, (2 * β) • u⟫_ℝ + ‖v‖ ^ 2 := by
              simp [add_assoc]
            _ = ‖(2 * β) • u‖ ^ 2 + 2 * ⟪(2 * β) • u, v⟫_ℝ + ‖v‖ ^ 2 := by
              rw [real_inner_comm v ((2 * β) • u)]
              ring
        _ = ((2 * β) * ‖u‖) ^ 2 + 2 * ((2 * β) * ⟪u, v⟫_ℝ) + ‖v‖ ^ 2 := by
          simp [norm_smul, inner_smul_left, abs_of_pos hβ_pos]
        _ = 4 * β ^ 2 * ‖u‖ ^ 2 + 4 * β * ⟪u, v⟫_ℝ + ‖v‖ ^ 2 := by
          ring
    have h_sq_nonneg' : 0 ≤ 4 * β ^ 2 * ‖u‖ ^ 2 + 4 * β * ⟪u, v⟫_ℝ + ‖v‖ ^ 2 := by
      rw [← h_sq_expand]
      positivity
    have h_key : -‖v‖ ^ 2 / (4 * β) ≤ β * ‖u‖ ^ 2 + ⟪u, v⟫_ℝ := by
      field_simp
      nlinarith
    have h_comb : -⟪u, x (k + 1) - z⟫_ℝ ≤ ‖v‖ ^ 2 / (4 * β) := by
      have : -‖v‖ ^ 2 / (4 * β) ≤ ⟪u, x (k + 1) - z⟫_ℝ := by
        rw [h_expand]
        linarith
      have htemp := neg_le_neg this
      simpa [neg_div] using htemp
    calc
      -lam k * ⟪u, x (k + 1) - z⟫_ℝ =
          lam k * (-⟪u, x (k + 1) - z⟫_ℝ) := by
        ring
      _ ≤ lam k * (‖v‖ ^ 2 / (4 * β)) :=
        mul_le_mul_of_nonneg_left h_comb (hlam_nonneg k hk)
      _ = (lam k / (4 * β)) * ‖v‖ ^ 2 := by
        ring
  have h_eps_inner : -⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ
      ≤ lam k * ε k + lam k * ⟪B (x k) - B z, z - x (k + 1)⟫_ℝ := by
    have htemp := h_eps_bound
    rw [show ⟪x (k + 1) - y k + lam k • (B (x k) - B z), z - x (k + 1)⟫_ℝ
        = ⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ
          + lam k * ⟪B (x k) - B z, z - x (k + 1)⟫_ℝ by
      simp [inner_add_left, inner_smul_left]] at htemp
    linarith
  have h_coco_inner : lam k * ⟪B (x k) - B z, z - x (k + 1)⟫_ℝ
      ≤ (lam k / (4 * β)) * ‖a‖ ^ 2 := by
    have : lam k * ⟪B (x k) - B z, z - x (k + 1)⟫_ℝ
        = -lam k * ⟪B (x k) - B z, x (k + 1) - z⟫_ℝ := by
      calc
        lam k * ⟪B (x k) - B z, z - x (k + 1)⟫_ℝ
            = lam k * ⟪B (x k) - B z, -(x (k + 1) - z)⟫_ℝ := by
              abel_nf
        _ = lam k * (-⟪B (x k) - B z, x (k + 1) - z⟫_ℝ) := by
          rw [inner_neg_right]
        _ = -lam k * ⟪B (x k) - B z, x (k + 1) - z⟫_ℝ := by
          ring
    rw [this]
    exact h_coco_bound
  have h_inner_xkz (k' : ℕ) : ⟪x k' - x (k' - 1), x k' - z⟫_ℝ
      = phi z k' - phi z (k' - 1) +
        (1 / 2 : ℝ) * ‖x k' - x (k' - 1)‖ ^ 2 := by
    rw [hphi_eval z k', hphi_eval z (k' - 1)]
    simpa using phi_inner_xkz_identity x z k'
  have h_b_simp : -θ k * ⟪b, z - x (k + 1)⟫_ℝ -
      θ k * (phi z k - phi z (k - 1))
      = (θ k / 2) * ‖b‖ ^ 2 + θ k * ⟪b, a⟫_ℝ := by
    have h_id : ⟪b, z - x (k + 1)⟫_ℝ = -⟪b, x k - z⟫_ℝ - ⟪b, a⟫_ℝ := by
      calc
        ⟪b, z - x (k + 1)⟫_ℝ =
            ⟪b, (z - x k) + (x k - x (k + 1))⟫_ℝ := by
          abel_nf
        _ = ⟪b, z - x k⟫_ℝ + ⟪b, x k - x (k + 1)⟫_ℝ := by
          rw [inner_add_right]
        _ = -⟪b, x k - z⟫_ℝ - ⟪b, x (k + 1) - x k⟫_ℝ := by
          simp [inner_sub_right]
    rw [h_id, ha_def, h_inner_xkz k]
    ring
  have h_combined : phi z (k + 1) - phi z k - θ k * (phi z k - phi z (k - 1))
      ≤ -(1 / 2 : ℝ) * η k * ‖a‖ ^ 2 + (θ k / 2) * ‖b‖ ^ 2
        + θ k * ⟪b, a⟫_ℝ + lam k * ε k := by
    have h_phi_neg : phi z (k + 1) - phi z k = -(1 / 2 : ℝ) * ‖a‖ ^ 2
        - ⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ
        - θ k * ⟪b, z - x (k + 1)⟫_ℝ := by
      linarith [h_phi_expand]
    rw [h_phi_neg]
    have hLHS : (-(1 / 2 : ℝ) * ‖a‖ ^ 2 -
        ⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ
        - θ k * ⟪b, z - x (k + 1)⟫_ℝ) - θ k * (phi z k - phi z (k - 1))
        = -(1 / 2 : ℝ) * ‖a‖ ^ 2 +
          (-⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ)
          + (-θ k * ⟪b, z - x (k + 1)⟫_ℝ -
            θ k * (phi z k - phi z (k - 1))) := by
      ring
    rw [hLHS]
    have h_mid : -(1 / 2 : ℝ) * ‖a‖ ^ 2 +
        (-⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ)
        + (-θ k * ⟪b, z - x (k + 1)⟫_ℝ - θ k * (phi z k - phi z (k - 1)))
        ≤ -(1 / 2 : ℝ) * ‖a‖ ^ 2 +
          (lam k * ε k + (lam k / (4 * β)) * ‖a‖ ^ 2)
          + ((θ k / 2) * ‖b‖ ^ 2 + θ k * ⟪b, a⟫_ℝ) := by
      have h1 : -⟪x (k + 1) - y k, z - x (k + 1)⟫_ℝ
          ≤ lam k * ε k + (lam k / (4 * β)) * ‖a‖ ^ 2 := by
        linarith
      have h2 : -θ k * ⟪b, z - x (k + 1)⟫_ℝ -
          θ k * (phi z k - phi z (k - 1))
          = (θ k / 2) * ‖b‖ ^ 2 + θ k * ⟪b, a⟫_ℝ := h_b_simp
      nlinarith
    have hRHS : -(1 / 2 : ℝ) * ‖a‖ ^ 2 +
        (lam k * ε k + (lam k / (4 * β)) * ‖a‖ ^ 2)
        + ((θ k / 2) * ‖b‖ ^ 2 + θ k * ⟪b, a⟫_ℝ)
        = -(1 / 2 : ℝ) * η k * ‖a‖ ^ 2 + (θ k / 2) * ‖b‖ ^ 2
          + θ k * ⟪b, a⟫_ℝ + lam k * ε k := by
      rw [hη_def]
      ring
    rw [hRHS] at h_mid
    exact h_mid
  have h_sq_ineq : -(1 / 2 : ℝ) * η k * ‖a‖ ^ 2 + (θ k / 2) * ‖b‖ ^ 2 +
      θ k * ⟪b, a⟫_ℝ
      ≤ -(1 / 2 : ℝ) * η k * ‖a - ((θ k / η k) • b)‖ ^ 2 +
        (θ k / η k) * ‖b‖ ^ 2 := by
    set c := θ k / η k with hc_def
    have h_sq_expand : ‖a - c • b‖ ^ 2 =
        ‖a‖ ^ 2 - 2 * c * ⟪a, b⟫_ℝ + c ^ 2 * ‖b‖ ^ 2 := by
      calc
        ‖a - c • b‖ ^ 2 = ‖a‖ ^ 2 - 2 * ⟪a, c • b⟫_ℝ + ‖c • b‖ ^ 2 := by
          rw [norm_sub_sq_real]
        _ = ‖a‖ ^ 2 - 2 * (c * ⟪a, b⟫_ℝ) + ‖c • b‖ ^ 2 := by
          simp [inner_smul_right]
        _ = ‖a‖ ^ 2 - 2 * c * ⟪a, b⟫_ℝ + ‖c • b‖ ^ 2 := by
          ring
        _ = ‖a‖ ^ 2 - 2 * c * ⟪a, b⟫_ℝ + (c ^ 2 * ‖b‖ ^ 2) := by
          simp [norm_smul, Real.norm_eq_abs, mul_pow]
        _ = ‖a‖ ^ 2 - 2 * c * ⟪a, b⟫_ℝ + c ^ 2 * ‖b‖ ^ 2 := by
          ring
    have hη_ne_zero : η k ≠ 0 := by linarith [hη_pos k hk]
    have h_target : -(1 / 2 : ℝ) * η k * ‖a - c • b‖ ^ 2 + c * ‖b‖ ^ 2
        = -(1 / 2 : ℝ) * η k * ‖a‖ ^ 2 + θ k * ⟪a, b⟫_ℝ
          + (c - (θ k) ^ 2 / (2 * η k)) * ‖b‖ ^ 2 := by
      rw [h_sq_expand]
      dsimp [c]
      field_simp [hη_ne_zero]
      ring
    rw [h_target, real_inner_comm b a, hc_def]
    have h_coeff : (θ k / 2 : ℝ) ≤
        (θ k / η k : ℝ) - (θ k) ^ 2 / (2 * η k : ℝ) := by
      have hη_pos' : 0 < η k := hη_pos k hk
      have hθ_nonneg' : 0 ≤ θ k := hθ_nonneg k hk
      have h_sum : θ k + η k ≤ 2 := h_theta_eta_sum_le_two k hk
      field_simp [hη_pos'.ne']
      nlinarith
    have h_nonneg_sq : 0 ≤ ‖b‖ ^ 2 := by positivity
    nlinarith
  apply le_trans h_combined
  nlinarith

omit [CompleteSpace H] in
private theorem distance_to_solution_tendsto
    {β δ θmax : ℝ}
    (x : ℕ → H) (θ lam ε η : ℕ → ℝ) (phi : H → ℕ → ℝ) (S : Set H)
    (hβ_pos : 0 < β) (hδ_pos : 0 < δ)
    (hθmax_nonneg : 0 ≤ θmax) (hθmax_lt_one : θmax < 1)
    (hlam_nonneg : ∀ k, 1 ≤ k → 0 ≤ lam k)
    (hlam_le_two_beta : ∀ k, 1 ≤ k → lam k ≤ 2 * β)
    (hθ_nonneg : ∀ k, 1 ≤ k → 0 ≤ θ k)
    (hθ_bound : ∀ k, 1 ≤ k → θ k ≤ θmax)
    (hη_lower : ∀ k, 1 ≤ k → δ / (2 * β) ≤ η k)
    (hη_pos : ∀ k, 1 ≤ k → 0 < η k)
    (h_eps_sum : Summable ε)
    (h_eps_pos : ∀ k, ε k ≥ 0)
    (h_summable : Summable fun k : ℕ ↦ θ (k + 1) * ‖x (k + 1) - x k‖ ^ 2)
    (hphi_eval : ∀ z k, phi z k = (1 / 2 : ℝ) * ‖z - x k‖ ^ 2)
    (h_key_ineq : ∀ z ∈ S, ∀ k, 1 ≤ k →
      phi z (k + 1) - phi z k - θ k * (phi z k - phi z (k - 1)) ≤
        -(1 / 2) * η k *
          ‖x (k + 1) - x k - (θ k / η k) • (x k - x (k - 1))‖ ^ 2 +
        (θ k / η k) * ‖x k - x (k - 1)‖ ^ 2 + lam k * ε k) :
    ∀ z ∈ S, ∃ l : ℝ, Tendsto (fun n ↦ ‖x n - z‖) atTop (𝓝 l) := by
  intro z hz
  set φ : ℕ → ℝ := phi z with hφ_def
  have hφ_nonneg : ∀ k, 0 ≤ φ k := by
    intro k
    rw [hφ_def, hphi_eval]
    positivity
  set Δ : ℕ → ℝ := fun k => φ k - φ (k - 1) with hΔ_def
  set σ : ℕ → ℝ := fun k => (θ k / η k) * ‖x k - x (k - 1)‖ ^ 2 + lam k * ε k
    with hσ_def
  have hσ_nonneg_ge1 : ∀ k, 1 ≤ k → 0 ≤ σ k := by
    simpa [σ] using sigma_nonneg_ge_one x θ lam ε η hθ_nonneg hη_pos hlam_nonneg
      h_eps_pos
  set a : ℕ → ℝ := fun k => max (Δ k) 0 with ha_def
  have ha_nonneg : ∀ k, 0 ≤ a k := by
    intro k
    dsimp [a]
    exact le_max_right _ _
  have h_diff_bound : ∀ k, 1 ≤ k → Δ (k + 1) ≤ θ k * Δ k + σ k := by
    intro k hk
    have h_key := h_key_ineq z hz k hk
    dsimp [Δ, σ] at h_key ⊢
    have h_nonpos : -(1 / 2 : ℝ) * η k *
        ‖x (k + 1) - x k - (θ k / η k) • (x k - x (k - 1))‖ ^ 2 ≤ 0 := by
      have hηk : 0 ≤ η k := le_of_lt (hη_pos k hk)
      have h_norm_sq : 0 ≤
          ‖x (k + 1) - x k - (θ k / η k) • (x k - x (k - 1))‖ ^ 2 := by
        positivity
      nlinarith
    linarith
  have ha_rec : ∀ k, 1 ≤ k → a (k + 1) ≤ θmax * a k + σ k := by
    simpa [a] using
      positive_part_recurrence Δ σ θ θmax hθmax_nonneg h_diff_bound hθ_nonneg
        hθ_bound hσ_nonneg_ge1
  have h_theta_sq_summable : Summable (fun k : ℕ => θ k * ‖x k - x (k - 1)‖ ^ 2) :=
    theta_sq_summable_of_shift x θ hθ_nonneg h_summable
  have hσ_bound_ge1 : ∀ k, 1 ≤ k → σ k ≤
      (2 * β / δ) * (θ k * ‖x k - x (k - 1)‖ ^ 2) + (2 * β) * ε k := by
    intro k hk
    simpa [σ] using
      sigma_bound_ge_one hβ_pos hδ_pos x θ lam ε η hlam_le_two_beta hη_lower
        hη_pos hθ_nonneg h_eps_pos k hk
  set u : ℕ → ℝ := fun k =>
    (2 * β / δ) * (θ k * ‖x k - x (k - 1)‖ ^ 2) + (2 * β) * ε k
    with hu_def
  have hu_nonneg : ∀ k, 0 ≤ u k := by
    simpa [u] using sigma_majorant_nonneg hβ_pos hδ_pos x θ ε hθ_nonneg h_eps_pos
  have hu_summable : Summable u := by
    simpa [u] using sigma_majorant_summable (β := β) (δ := δ) x θ ε
      h_theta_sq_summable h_eps_sum
  set U : ℝ := ∑' k, u k with hU_def
  have h_partial_sigma_le_U : ∀ N, (Finset.range N).sum (fun k => σ (k + 1)) ≤ U := by
    intro N
    simpa [U] using
      shifted_sum_le_tsum_of_nonneg_majorant hu_nonneg hu_summable hσ_bound_ge1 N
  set D : ℝ := a 0 + a 1 + U with hD_def
  have hD_nonneg : 0 ≤ D := by
    have hU_nonneg : 0 ≤ U := by
      rw [hU_def]
      exact tsum_nonneg hu_nonneg
    have h0 : 0 ≤ a 0 := ha_nonneg 0
    have h1 : 0 ≤ a 1 := ha_nonneg 1
    nlinarith
  have hU_nonneg : 0 ≤ U := by
    rw [hU_def]
    exact tsum_nonneg hu_nonneg
  have h_rec : ∀ N, (Finset.range (N + 1)).sum a ≤
      θmax * (Finset.range N).sum a + D :=
    positive_part_partial_sum_recurrence a σ θmax U D hD_def hθmax_nonneg ha_nonneg
      ha_rec h_partial_sigma_le_U hU_nonneg
  have h_bound : ∀ N, (Finset.range N).sum a ≤ D / (1 - θmax) :=
    partial_sum_bound_of_linear_recurrence a θmax D hD_nonneg hθmax_nonneg
      hθmax_lt_one h_rec
  have ha_summable : Summable a :=
    summable_of_sum_range_le ha_nonneg h_bound
  set b : ℕ → ℝ := fun k => max (-Δ k) 0 with hb_def
  have hb_nonneg : ∀ k, 0 ≤ b k := by
    intro k
    dsimp [b]
    exact le_max_right _ _
  have h_decomp : ∀ k, Δ k = a k - b k := by
    simp [a, b]
  have ha_shift_summable : Summable (fun k => a (k + 1)) :=
    ha_summable.comp_injective (fun _ _ h => Nat.succ_injective h)
  have h_phi_sum : ∀ n, φ n = φ 0 + (∑ k ∈ Finset.range n, Δ (k + 1)) :=
    real_seq_telescoping φ Δ hΔ_def
  have hb_sum_bound : ∀ n, (∑ k ∈ Finset.range n, b (k + 1)) ≤
      (∑ k ∈ Finset.range n, a (k + 1)) + φ 0 := by
    intro n
    have h_nonneg_phi_n : 0 ≤ φ n := hφ_nonneg n
    rw [h_phi_sum n] at h_nonneg_phi_n
    have h_split : (∑ k ∈ Finset.range n, Δ (k + 1)) =
        (∑ k ∈ Finset.range n, a (k + 1)) -
          (∑ k ∈ Finset.range n, b (k + 1)) :=
      calc
        (∑ k ∈ Finset.range n, Δ (k + 1)) =
            (∑ k ∈ Finset.range n, (a (k + 1) - b (k + 1))) := by
          refine Finset.sum_congr rfl (fun k _ => by rw [h_decomp (k + 1)])
        _ = (∑ k ∈ Finset.range n, a (k + 1)) -
            (∑ k ∈ Finset.range n, b (k + 1)) := by
          rw [Finset.sum_sub_distrib]
    rw [h_split] at h_nonneg_phi_n
    linarith
  have hb_summable : Summable (fun k => b (k + 1)) := by
    apply summable_of_sum_range_le (fun k => hb_nonneg (k + 1))
    · intro n
      have ha_bound : (∑ k ∈ Finset.range n, a (k + 1)) ≤ ∑' k, a (k + 1) :=
        sum_range_le_tsum_of_nonneg (fun k => ha_nonneg (k + 1)) ha_shift_summable n
      calc
        (∑ k ∈ Finset.range n, b (k + 1)) ≤
            (∑ k ∈ Finset.range n, a (k + 1)) + φ 0 := hb_sum_bound n
        _ ≤ (∑' k, a (k + 1)) + φ 0 := by nlinarith
  have hΔ_summable : Summable (fun k => Δ (k + 1)) := by
    have h_diff : (fun k => Δ (k + 1)) =
        (fun k => a (k + 1)) - (fun k => b (k + 1)) := by
      ext k
      exact h_decomp (k + 1)
    rw [h_diff]
    exact Summable.sub ha_shift_summable hb_summable
  have h_hasSum : HasSum (fun k => Δ (k + 1)) (∑' k, Δ (k + 1)) :=
    hΔ_summable.hasSum
  set lφ : ℝ := φ 0 + ∑' k, Δ (k + 1) with hlφ_def
  have h_phi_tendsto : Tendsto φ atTop (𝓝 lφ) := by
    have h_eq : φ = fun n => φ 0 + (∑ k ∈ Finset.range n, Δ (k + 1)) :=
      funext h_phi_sum
    rw [h_eq, hlφ_def]
    simpa [add_comm] using h_hasSum.tendsto_sum_nat.add_const (φ 0)
  have hlφ_nonneg : 0 ≤ lφ := by
    by_contra! hlt
    rcases Metric.tendsto_atTop.mp h_phi_tendsto (-lφ / 2) (by linarith) with ⟨N, hN⟩
    have h_abs : |φ N - lφ| < -lφ / 2 := hN N (le_refl N)
    have h_lt : φ N < lφ / 2 := by
      have := abs_lt.mp h_abs
      linarith
    have h_nonneg : 0 ≤ φ N := hφ_nonneg N
    nlinarith
  have h_sq_eq : ∀ n, ‖x n - z‖ ^ 2 = 2 * φ n := by
    intro n
    rw [hφ_def, hphi_eval]
    rw [norm_sub_rev]
    ring
  have h_sq_tendsto : Tendsto (fun n => ‖x n - z‖ ^ 2) atTop (𝓝 (2 * lφ)) := by
    simpa [h_sq_eq] using h_phi_tendsto.const_mul 2
  have h_norm_tendsto : Tendsto (fun n => ‖x n - z‖) atTop (𝓝 (Real.sqrt (2 * lφ))) := by
    have h_nonneg_sq : 0 ≤ 2 * lφ := by nlinarith
    have h_cont : ContinuousAt Real.sqrt (2 * lφ) :=
      Real.continuous_sqrt.continuousAt
    have h_comp := h_cont.tendsto.comp h_sq_tendsto
    have h_sqrt_eq : (Real.sqrt ∘ (fun n : ℕ => ‖x n - z‖ ^ 2)) =
        (fun n => ‖x n - z‖) := by
      ext n
      simp [Real.sqrt_sq (norm_nonneg (x n - z))]
    simpa [h_sqrt_eq] using h_comp
  exact ⟨Real.sqrt (2 * lφ), h_norm_tendsto⟩

private theorem cluster_points_in_solution_set
    {A : SetValuedOperator H H} {B : H → H} {β lamUnder θmax : ℝ}
    (x y : ℕ → H) (θ lam ε : ℕ → ℝ) (S : Set H)
    (hS_def : S = (A + svEmbed B).zeros)
    (h_sum_max : IsMaximalMonotone (A + svEmbed B))
    (hA_mono : IsMonotone A)
    (hB_mono : IsMonotone (svEmbed B))
    (hy : ∀ k, 1 ≤ k → y k = x k + θ k • (x k - x (k - 1)))
    (h_alg_unpack : ∀ k, 1 ≤ k → ∃ a_k ∈ enlargement A (ε k) (x (k + 1)),
      x (k + 1) - y k + lam k • B (x k) = -lam k • a_k)
    (hlamUnder_pos : 0 < lamUnder)
    (hlam_pos : ∀ k, 1 ≤ k → 0 < lam k)
    (hlam_lower : ∀ k, 1 ≤ k → lamUnder ≤ lam k)
    (hθmax_nonneg : 0 ≤ θmax)
    (hθ_nonneg : ∀ k, 1 ≤ k → 0 ≤ θ k)
    (hθ_bound : ∀ k, 1 ≤ k → θ k ≤ θmax)
    (h_eps_sum : Summable ε)
    (hB_lipschitz : ∀ x y : H, ‖B x - B y‖ ≤ (1 / β) * ‖x - y‖)
    (h_norm_diff_tendsto : Tendsto (fun n : ℕ => ‖x (n + 1) - x n‖) atTop (𝓝 0)) :
    ∀ (z : H),
      IsSequentialClusterPt (fun k ↦ toWeakSpace ℝ H (x k)) (toWeakSpace ℝ H z) →
        z ∈ S := by
  intro z hz_cluster
  rcases hz_cluster with ⟨φ_sub, hφ_mono, hφ_tendsto⟩
  rw [hS_def, SetValuedOperator.mem_zeros_iff]
  have h_eps_tendsto : Tendsto ε atTop (𝓝 0) := h_eps_sum.tendsto_atTop_zero
  have h_mono_sum : IsMonotone (A + svEmbed B) :=
    monotone_add_svEmbed hA_mono hB_mono
  have hφ_ge1 : ∀ j, 1 ≤ φ_sub (j + 1) := by
    intro j
    have hpos : 0 ≤ φ_sub 0 := Nat.zero_le _
    have hlt' : φ_sub 0 < φ_sub (j + 1) := hφ_mono (Nat.zero_lt_succ j)
    have hlt : 0 < φ_sub (j + 1) := lt_of_le_of_lt hpos hlt'
    omega
  set u_seq : ℕ → H := fun j =>
    (h_alg_unpack (φ_sub (j + 1)) (hφ_ge1 j)).choose +
      B (x (φ_sub (j + 1) + 1))
    with hu_seq_def
  have hu_seq_mem : ∀ j, u_seq j ∈ enlargement (A + svEmbed B)
      (ε (φ_sub (j + 1))) (x (φ_sub (j + 1) + 1)) := by
    intro j
    rw [hu_seq_def]
    set k := φ_sub (j + 1) with hk_def
    have hk1 : 1 ≤ k := hφ_ge1 j
    set a_k := (h_alg_unpack k hk1).choose with ha_k_def
    have ha_enlA : a_k ∈ enlargement A (ε k) (x (k + 1)) :=
      (h_alg_unpack k hk1).choose_spec.1
    have hB_mem : B (x (k + 1)) ∈ svEmbed B (x (k + 1)) := by
      dsimp [svEmbed]
      simp
    rw [enlargement, Set.mem_setOf_eq]
    intro y u hu
    rcases (SetValuedOperator.mem_add_smul_iff (A := A) (B := svEmbed B) (r := 1) y u).mp
        (by simpa [one_smul] using hu) with ⟨uA, huA, uB, huB, hu_eq⟩
    rw [hu_eq]
    have hA : -ε k ≤ ⟪uA - a_k, y - x (k + 1)⟫_ℝ := by
      rw [enlargement, Set.mem_setOf_eq] at ha_enlA
      exact ha_enlA y uA huA
    have hB : 0 ≤ ⟪uB - B (x (k + 1)), y - x (k + 1)⟫_ℝ :=
      hB_mono uB huB (B (x (k + 1))) hB_mem
    have h_eq : ⟪(uA + uB) - (a_k + B (x (k + 1))), y - x (k + 1)⟫_ℝ =
        ⟪uA - a_k, y - x (k + 1)⟫_ℝ +
          ⟪uB - B (x (k + 1)), y - x (k + 1)⟫_ℝ := by
      calc
        ⟪(uA + uB) - (a_k + B (x (k + 1))), y - x (k + 1)⟫_ℝ
            = ⟪(uA - a_k) + (uB - B (x (k + 1))), y - x (k + 1)⟫_ℝ := by
              abel_nf
        _ = ⟪uA - a_k, y - x (k + 1)⟫_ℝ +
            ⟪uB - B (x (k + 1)), y - x (k + 1)⟫_ℝ := by
          simp [inner_add_left]
    have h_ineq : -ε k ≤
        ⟪(uA + uB) - (a_k + B (x (k + 1))), y - x (k + 1)⟫_ℝ := by
      rw [h_eq]
      nlinarith
    simpa [one_smul, hk_def, ha_k_def] using h_ineq
  have hu_seq_expr (j : ℕ) : u_seq j = (lam (φ_sub (j + 1)))⁻¹ •
      (y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1)) +
      (B (x (φ_sub (j + 1) + 1)) - B (x (φ_sub (j + 1)))) := by
    rw [hu_seq_def]
    set k := φ_sub (j + 1) with hk_def
    have hk1 : 1 ≤ k := hφ_ge1 j
    set a_k := (h_alg_unpack k hk1).choose with ha_k_def
    have ha_eq : x (k + 1) - y k + lam k • B (x k) = -lam k • a_k :=
      (h_alg_unpack k hk1).choose_spec.2
    have hpos : 0 < lam k := hlam_pos k hk1
    have ha_formula : a_k = (lam k)⁻¹ • (y k - x (k + 1)) - B (x k) := by
      have hmul : lam k • a_k = y k - x (k + 1) - lam k • B (x k) := by
        have hneg : -(lam k • a_k) = x (k + 1) - y k + lam k • B (x k) := by
          simpa [neg_smul] using ha_eq.symm
        calc
          lam k • a_k = -((x (k + 1) - y k) + lam k • B (x k)) := by
            rw [← hneg]
            simp
          _ = y k - x (k + 1) - lam k • B (x k) := by abel_nf
      calc
        a_k = (lam k)⁻¹ • (lam k • a_k) := by
          simp [hpos.ne']
        _ = (lam k)⁻¹ • (y k - x (k + 1) - lam k • B (x k)) := by rw [hmul]
        _ = (lam k)⁻¹ • (y k - x (k + 1)) - B (x k) := by
          rw [smul_sub, inv_smul_smul₀ hpos.ne']
    calc
      a_k + B (x (k + 1)) =
          ((lam k)⁻¹ • (y k - x (k + 1)) - B (x k)) + B (x (k + 1)) := by
        rw [ha_formula]
      _ = (lam k)⁻¹ • (y k - x (k + 1)) + (B (x (k + 1)) - B (x k)) := by
        abel_nf
      _ = (lam (φ_sub (j + 1)))⁻¹ •
          (y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1)) +
          (B (x (φ_sub (j + 1) + 1)) - B (x (φ_sub (j + 1)))) := by
        simp [hk_def]
  have hx_weak : Tendsto (fun j : ℕ => toWeakSpace ℝ H (x (φ_sub (j + 1) + 1)))
      atTop (𝓝 (toWeakSpace ℝ H z)) := by
    have h_diff_tendsto : Tendsto (fun n : ℕ => x (n + 1) - x n) atTop (𝓝 (0 : H)) := by
      rw [Metric.tendsto_atTop] at h_norm_diff_tendsto ⊢
      intro ε hε
      rcases h_norm_diff_tendsto ε hε with ⟨N, hN⟩
      refine ⟨N, fun n hn => ?_⟩
      have h := hN n hn
      simpa [dist_eq_norm, sub_zero, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] using h
    rw [weakConvergence_iff_forall_tendsto_inner_right]
    intro w
    have h_succ_mono : StrictMono (fun n : ℕ => n + 1) :=
      fun _ _ h => Nat.add_lt_add_right h 1
    have hbase_weak : Tendsto (fun j : ℕ => toWeakSpace ℝ H (x (φ_sub (j + 1))))
        atTop (𝓝 (toWeakSpace ℝ H z)) := by
      simpa [Function.comp] using hφ_tendsto.comp h_succ_mono.tendsto_atTop
    have hbase_inner : Tendsto (fun j : ℕ => ⟪x (φ_sub (j + 1)), w⟫_ℝ)
        atTop (𝓝 ⟪z, w⟫_ℝ) :=
      (weakConvergence_iff_forall_tendsto_inner_right
        (fun j : ℕ => x (φ_sub (j + 1))) z).1 hbase_weak w
    have h_comp_mono : StrictMono (fun j : ℕ => φ_sub (j + 1)) :=
      hφ_mono.comp h_succ_mono
    have hdiff_strong : Tendsto (fun j : ℕ => x (φ_sub (j + 1) + 1) -
        x (φ_sub (j + 1))) atTop (𝓝 (0 : H)) :=
      h_diff_tendsto.comp h_comp_mono.tendsto_atTop
    have hdiff_inner : Tendsto (fun j : ℕ =>
        ⟪x (φ_sub (j + 1) + 1) - x (φ_sub (j + 1)), w⟫_ℝ) atTop (𝓝 0) := by
      simpa using Filter.Tendsto.inner hdiff_strong
        (tendsto_const_nhds : Tendsto (fun _ : ℕ => w) atTop (𝓝 w))
    have hsum := hbase_inner.add hdiff_inner
    convert hsum using 1
    · ext j
      rw [← inner_add_left]
      congr 1
      abel_nf
    · simp
  have h_eps_sub_tendsto : Tendsto (ε ∘ fun j => φ_sub (j + 1)) atTop (𝓝 0) := by
    have h_succ_mono : StrictMono (fun n : ℕ => n + 1) :=
      fun _ _ h => Nat.add_lt_add_right h 1
    have h_comp_mono : StrictMono (fun j : ℕ => φ_sub (j + 1)) :=
      hφ_mono.comp h_succ_mono
    exact h_eps_tendsto.comp h_comp_mono.tendsto_atTop
  have hu_seq_tendsto : Tendsto u_seq atTop (𝓝 0) := by
    have h_term1 : Tendsto (fun j : ℕ =>
        (lam (φ_sub (j + 1)))⁻¹ •
          (y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1))) atTop (𝓝 (0 : H)) := by
      have h_ylim : Tendsto (fun k : ℕ => y k - x (k + 1)) atTop (𝓝 (0 : H)) := by
        rw [Metric.tendsto_atTop]
        intro ε' hε'
        rcases Metric.tendsto_atTop.mp h_norm_diff_tendsto (ε' / (θmax + 1))
          (div_pos hε' (by linarith [hθmax_nonneg])) with ⟨N, hN⟩
        refine ⟨max (N + 1) 1, fun n hn => ?_⟩
        have hnN : n ≥ N := by omega
        have hn1 : 1 ≤ n := le_trans (le_max_right (N + 1) 1) hn
        have hy_eq := hy n hn1
        rw [hy_eq, dist_eq_norm, sub_zero]
        calc
          ‖x n + θ n • (x n - x (n - 1)) - x (n + 1)‖
              = ‖-(x (n + 1) - x n) + θ n • (x n - x (n - 1))‖ := by
            abel_nf
          _ ≤ ‖x (n + 1) - x n‖ + |θ n| * ‖x n - x (n - 1)‖ := by
            calc
              ‖-(x (n + 1) - x n) + θ n • (x n - x (n - 1))‖ =
                  ‖(x (n + 1) - x n) - θ n • (x n - x (n - 1))‖ := by
                    rw [← norm_neg]
                    congr 1
                    abel_nf
              _ ≤ ‖x (n + 1) - x n‖ + ‖θ n • (x n - x (n - 1))‖ :=
                norm_sub_le _ _
              _ = ‖x (n + 1) - x n‖ + |θ n| * ‖x n - x (n - 1)‖ := by
                rw [norm_smul, Real.norm_eq_abs]
          _ ≤ ‖x (n + 1) - x n‖ + θmax * ‖x n - x (n - 1)‖ := by
            have hθ_le : |θ n| ≤ θmax := by
              rw [abs_of_nonneg (hθ_nonneg n hn1)]
              exact hθ_bound n hn1
            gcongr
          _ < ε' / (θmax + 1) + θmax * (ε' / (θmax + 1)) := by
            have h1 := hN n hnN
            have h1norm : ‖x (n + 1) - x n‖ < ε' / (θmax + 1) := by
              simpa [Real.dist_eq, abs_of_nonneg (norm_nonneg _)] using h1
            have h2 : ‖x n - x (n - 1)‖ < ε' / (θmax + 1) := by
              have hN' := hN (n - 1) (by omega)
              rw [show (n - 1) + 1 = n by omega] at hN'
              simpa using hN'
            nlinarith [h1norm, h2, hθmax_nonneg]
          _ = ε' := by
            field_simp [show θmax + 1 ≠ 0 by linarith]
            ring
      have h_norm_ylim : Tendsto (fun k : ℕ => ‖y k - x (k + 1)‖) atTop (𝓝 0) :=
        by simpa using h_ylim.norm
      have h_succ_mono : StrictMono (fun n : ℕ => n + 1) :=
        fun _ _ h => Nat.add_lt_add_right h 1
      have h_comp_mono : StrictMono (fun j : ℕ => φ_sub (j + 1)) :=
        hφ_mono.comp h_succ_mono
      have h_norm_bound (j : ℕ) : ‖(lam (φ_sub (j + 1)))⁻¹ •
          (y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1))‖ ≤
          ‖y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1)‖ / lamUnder := by
        have hk1 : 1 ≤ φ_sub (j + 1) := hφ_ge1 j
        have hpos : 0 < lam (φ_sub (j + 1)) := hlam_pos (φ_sub (j + 1)) hk1
        have h_le : lamUnder ≤ lam (φ_sub (j + 1)) := hlam_lower (φ_sub (j + 1)) hk1
        calc
          ‖(lam (φ_sub (j + 1)))⁻¹ •
              (y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1))‖ =
              ‖y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1)‖ /
                |lam (φ_sub (j + 1))| := by
            rw [norm_smul, norm_inv, Real.norm_eq_abs, mul_comm, div_eq_mul_inv]
          _ = ‖y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1)‖ /
              lam (φ_sub (j + 1)) := by
            rw [abs_of_pos hpos]
          _ ≤ ‖y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1)‖ / lamUnder := by
            gcongr
      have h_norm_tendsto : Tendsto (fun j : ℕ =>
          ‖(lam (φ_sub (j + 1)))⁻¹ •
            (y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1))‖) atTop (𝓝 0) := by
        apply squeeze_zero (fun j => norm_nonneg _)
        · exact h_norm_bound
        · have : Tendsto (fun j : ℕ =>
              ‖y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1)‖ / lamUnder)
            atTop (𝓝 (0 / lamUnder)) :=
            (h_norm_ylim.comp h_comp_mono.tendsto_atTop).div_const lamUnder
          simpa [zero_div] using this
      rw [Metric.tendsto_atTop] at h_norm_tendsto ⊢
      intro ε' hε'
      rcases h_norm_tendsto ε' hε' with ⟨N, hN⟩
      refine ⟨N, fun j hj => ?_⟩
      have h := hN j hj
      simpa [dist_eq_norm, sub_zero] using h
    have h_term2 : Tendsto (fun j : ℕ =>
        B (x (φ_sub (j + 1) + 1)) - B (x (φ_sub (j + 1)))) atTop (𝓝 (0 : H)) := by
      have h_norm_diff : Tendsto (fun j : ℕ =>
          ‖B (x (φ_sub (j + 1) + 1)) - B (x (φ_sub (j + 1)))‖) atTop (𝓝 0) := by
        have h_bound : ∀ j, ‖B (x (φ_sub (j + 1) + 1)) -
            B (x (φ_sub (j + 1)))‖ ≤
            (1 / β) * ‖x (φ_sub (j + 1) + 1) - x (φ_sub (j + 1))‖ := by
          intro j
          exact hB_lipschitz (x (φ_sub (j + 1) + 1)) (x (φ_sub (j + 1)))
        have h_succ_mono : StrictMono (fun n : ℕ => n + 1) :=
          fun _ _ h => Nat.add_lt_add_right h 1
        have h_comp_mono : StrictMono (fun j : ℕ => φ_sub (j + 1)) :=
          hφ_mono.comp h_succ_mono
        have h_sub_diff : Tendsto (fun j : ℕ => ‖x (φ_sub (j + 1) + 1) -
            x (φ_sub (j + 1))‖) atTop (𝓝 0) :=
          h_norm_diff_tendsto.comp h_comp_mono.tendsto_atTop
        apply squeeze_zero (fun n => norm_nonneg _)
        · exact h_bound
        · have : Tendsto (fun j : ℕ => (1 / β) *
              ‖x (φ_sub (j + 1) + 1) - x (φ_sub (j + 1))‖)
            atTop (𝓝 ((1 / β) * 0)) :=
            h_sub_diff.const_mul (1 / β)
          simpa [mul_zero] using this
      rw [Metric.tendsto_atTop]
      intro ε' hε'
      rcases Metric.tendsto_atTop.mp h_norm_diff ε' hε' with ⟨N, hN⟩
      refine ⟨N, fun j hj => ?_⟩
      have h := hN j hj
      simpa [dist_eq_norm, sub_zero] using h
    have h_add : Tendsto (fun j : ℕ => (lam (φ_sub (j + 1)))⁻¹ •
        (y (φ_sub (j + 1)) - x (φ_sub (j + 1) + 1)) +
        (B (x (φ_sub (j + 1) + 1)) - B (x (φ_sub (j + 1))))) atTop (𝓝 (0 : H)) := by
      simpa using h_term1.add h_term2
    convert h_add using 1
    ext j
    exact hu_seq_expr j
  have h_zero_in_enl : (0 : H) ∈ enlargement (A + svEmbed B) (0 : ℝ) z :=
    demiclosed_weak_x_strong_u h_mono_sum hx_weak hu_seq_tendsto h_eps_sub_tendsto
      hu_seq_mem
  exact enlargement_zero_subset_of_maximal h_sum_max h_zero_in_enl


-- The convergence proof contains long summability and real-inequality estimates.
theorem convergence_of_splitting_inertial_proximal
    {A : SetValuedOperator H H} {B : H → H}
    (hA_max : IsMaximalMonotone A)
    (hB_max : IsMaximalMonotone (svEmbed B))
    {β : ℝ} (hB_coco : IsCocoerciveWRT A B β)
    (hB_lipschitz : ∀ x y : H, ‖B x - B y‖ ≤ (1 / β) * ‖x - y‖)
    (x : ℕ → H) (θ lam ε : ℕ → ℝ)
    (y : ℕ → H)
    (hy : ∀ k, 1 ≤ k → y k = x k + θ k • (x k - x (k - 1)))
    (h_alg : ∀ k, 1 ≤ k → (0 : H) ∈ (lam k • enlargement A (ε k) (x (k + 1))) +
      {x (k + 1) - y k} + (lam k • svEmbed B (x k)))
    (h_delta : ∃ (δ : ℝ) (lamUnder : ℝ), 0 < lamUnder ∧ 0 < δ ∧
      ∀ k, 1 ≤ k → lamUnder ≤ lam k ∧ lam k ≤ 2 * β - δ)
    (h_theta : ∃ (θmax : ℝ), 0 ≤ θmax ∧ θmax < 1 ∧
      ∀ k, 1 ≤ k → 0 ≤ θ k ∧ θ k ≤ θmax)
    (h_eps_sum : Summable ε)
    (h_eps_pos : ∀ k, ε k ≥ 0)
    (h_summable : Summable fun k : ℕ ↦ θ (k + 1) * ‖x (k + 1) - x k‖ ^ 2)
    (hS_nonempty : ((A + svEmbed B).zeros).Nonempty)
    (h_norm_diff_tendsto : Tendsto (fun n : ℕ => ‖x (n+1) - x n‖) atTop (𝓝 0)) :
    ∃ (xstar : H), xstar ∈ (A + svEmbed B).zeros ∧
      Tendsto (fun k ↦ toWeakSpace ℝ H (x k)) atTop (𝓝 (toWeakSpace ℝ H xstar)) := by
  -- ===== Extract parameters =====
  rcases h_delta with ⟨δ, lamUnder, hlamUnder_pos, hδ_pos, h_delta'⟩
  rcases h_theta with ⟨θmax, hθmax_nonneg, hθmax_lt_one, h_theta'⟩
  rcases hB_coco with ⟨hβ_pos, hB_coco'⟩
  have h_sum_max : IsMaximalMonotone (A + svEmbed B) :=
    maximalMonotone_add_svEmbed_of_lipschitz hA_max hβ_pos hB_max.1 hB_lipschitz
  have hβ_2pos : 0 < 2 * β := by linarith
  have hlam_pos : ∀ k, 1 ≤ k → 0 < lam k := by
    intro k hk; rcases h_delta' k hk with ⟨hl, _⟩; linarith
  have hlam_nonneg : ∀ k, 1 ≤ k → 0 ≤ lam k := by
    intro k hk; exact le_of_lt (hlam_pos k hk)
  have hθ_nonneg : ∀ k, 1 ≤ k → 0 ≤ θ k := by
    intro k hk; rcases h_theta' k hk with ⟨hl, _⟩; exact hl
  have hθ_bound : ∀ k, 1 ≤ k → θ k ≤ θmax := by
    intro k hk; rcases h_theta' k hk with ⟨_, hu⟩; exact hu
  -- η_k = 1 - λ_k/(2β) > 0
  set η : ℕ → ℝ := fun k => 1 - lam k / (2 * β) with hη_def
  have hη_lower : ∀ k, 1 ≤ k → δ / (2 * β) ≤ η k :=
    eta_lower_bound hβ_pos (fun k hk => (h_delta' k hk).2) hη_def
  have hη_pos : ∀ k, 1 ≤ k → 0 < η k :=
    eta_positive_of_lower hβ_pos hδ_pos hη_lower
  have hη_nonneg : ∀ k, 1 ≤ k → 0 ≤ η k := by
    intro k hk; exact le_of_lt (hη_pos k hk)
  have hη_le_one : ∀ k, 1 ≤ k → η k ≤ 1 :=
    eta_le_one hβ_pos hlam_nonneg hη_def
  have h_theta_eta_sum_le_two : ∀ k, 1 ≤ k → θ k + η k ≤ 2 := by
    intro k hk
    have hθ := hθ_bound k hk
    have hη := hη_le_one k hk
    linarith
  -- ===== φ function (for use across proof blocks) =====
  set phi : H → ℕ → ℝ := fun z k => (1/2 : ℝ) * ‖z - x k‖ ^ 2 with hphi_def
  -- ===== Unpack algorithm membership =====
  have h_alg_unpack : ∀ k, 1 ≤ k → ∃ a_k ∈ enlargement A (ε k) (x (k + 1)),
      x (k + 1) - y k + lam k • B (x k) = -lam k • a_k :=
    splitting_algorithm_unpack x y lam ε h_alg
  -- ===== S = (A + svEmbed B)⁻¹(0) =====
  set S : Set H := (A + svEmbed B).zeros with hS_def
  have hS_nonempty' : S.Nonempty := by
    rcases hS_nonempty with ⟨z, hz⟩; exact ⟨z, hz⟩
  -- Representation: z ∈ S iff ∃ a ∈ A z, a = -B z
  have hS_repr : ∀ z ∈ S, ∃ az ∈ A z, az = -B z := by
    exact zeros_sum_svEmbed_repr hS_def
  -- ===== KEY INEQUALITY (2.13) for any z ∈ S =====
  have h_key_ineq : ∀ z ∈ S, ∀ k, 1 ≤ k →
      phi z (k + 1) - phi z k - θ k * (phi z k - phi z (k - 1)) ≤
      -(1 / 2) * η k *
        ‖x (k + 1) - x k - (θ k / η k) • (x k - x (k - 1))‖ ^ 2 +
      (θ k / η k) * ‖x k - x (k - 1)‖ ^ 2 + lam k * ε k :=
    splitting_key_ineq x y θ lam ε η phi S hy h_alg_unpack hB_coco' hS_repr
      hβ_pos hlam_nonneg hη_pos h_theta_eta_sum_le_two hθ_nonneg hη_def
      (by
        intro z k
        rw [hphi_def])
  -- ===== Sigma summability (extracted for reuse) =====
  set σ_sum : ℕ → ℝ := fun k => (θ k / η k) * ‖x k - x (k - 1)‖ ^ 2 + lam k * ε k
  have h_sigma_summable : Summable σ_sum := by
    simpa [σ_sum] using
      sigma_sum_summable hβ_pos hδ_pos x θ lam ε η hη_lower hη_pos hlam_nonneg
        (fun k hk => by
          rcases h_delta' k hk with ⟨_, hu⟩
          linarith)
        hθ_nonneg h_eps_sum h_eps_pos h_summable
  have h_sigma_tendsto_zero : Tendsto σ_sum atTop (𝓝 0) :=
    h_sigma_summable.tendsto_atTop_zero
  -- ===== Opial's Lemma application =====
  have h_dist_exists : ∀ z ∈ S, ∃ l : ℝ, Tendsto (fun n ↦ ‖x n - z‖) atTop (𝓝 l) :=
    distance_to_solution_tendsto x θ lam ε η phi S hβ_pos hδ_pos hθmax_nonneg
      hθmax_lt_one hlam_nonneg
      (fun k hk => by
        rcases h_delta' k hk with ⟨_, hu⟩
        linarith)
      hθ_nonneg hθ_bound hη_lower hη_pos h_eps_sum h_eps_pos h_summable
      (by
        intro z k
        rw [hphi_def])
      h_key_ineq
  have h_cluster_in_S : ∀ (z : H),
      IsSequentialClusterPt (fun k ↦ toWeakSpace ℝ H (x k)) (toWeakSpace ℝ H z) → z ∈ S :=
    cluster_points_in_solution_set x y θ lam ε S hS_def h_sum_max hA_max.1 hB_max.1 hy
      h_alg_unpack hlamUnder_pos hlam_pos (fun k hk => (h_delta' k hk).1)
      hθmax_nonneg hθ_nonneg hθ_bound h_eps_sum hB_lipschitz h_norm_diff_tendsto
  -- Opial's Lemma: hS_nonempty' gives nonempty S, h_dist_exists gives norm convergence,
  -- h_cluster_in_S gives that weak cluster points belong to S
  -- Therefore: {x_k} converges weakly to some point in S
  exact opial_lemma hS_nonempty' x h_dist_exists h_cluster_in_S
