/-!
# Proposition 4.1
Let $H$ be a finite dimensional space and let $A: H \Rightarrow H$ be a maximal monotone
operator such that $\operatorname{dom} A = H$ and $0 \in \operatorname{int}(A(0))$.
The operator $B$ is supposed to be equal to $\nabla f$ for a convex function
$f: H \to \mathbb{R}$ of class $\mathcal{C}^1$ satisfying $\inf f > -\infty$.
The positive sequence $(\lambda_n)$ is assumed to be nondecreasing.
Let $(x_n)$ be the sequence generated by the algorithm $(\mathcal{A})$ and let us set
$x_\infty = \lim_{n \to +\infty} x_n$. Assume that the set $A(0)$ is smooth at the point
$-\nabla f(x_\infty)$ and consider the unique vector $u \in H$ defined by $|u| = 1$
and $N_{A(0)}(-\nabla f(x_\infty)) = \mathbb{R}_+ u$. Then, either the sequence $(x_n)$
is finitely convergent or we have:
$$\lim_{n \rightarrow +\infty, n \in \mathbb{N} \setminus \mathcal{D}} \frac{x_{n+1} - x_n}{|x_{n+1} - x_n|} = u,$$
$$x_n = x_\infty - \left(\sum_{k=n}^{+\infty} |x_{k+1} - x_k|\right) u + \mathrm{o}\left(\sum_{k=n}^{+\infty} |x_{k+1} - x_k|\right).$$
As a consequence, we have the equivalence $|x_n - x_\infty| \sim \sum_{k=n}^{+\infty} |x_{k+1} - x_k|$
when $n \to +\infty$ and we deduce that, either $x_n = x_\infty$ for $n$ large enough
or $|x_n - x_\infty| > 0$ for $n$ large enough.
-/
open SetValuedOperator
open scoped Topology
open scoped Asymptotics
open scoped Pointwise
open Set
open Filter
variable {H : Type _} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

omit [CompleteSpace H] in
private theorem prop41_ereal_finite_convexOn_toReal (f : H → EReal)
    (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_conv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y) :
    ConvexOn ℝ Set.univ (fun x => (f x).toReal) := by
  constructor
  · exact convex_univ
  · intro x hx y hy a b ha hb hab
    have h := hf_conv x y a b ha hb hab
    have hbot_l : f (a • x + b • y) ≠ ⊥ := (hfinite _).2
    have hxcoe : f x = ((f x).toReal : EReal) := by
      exact (EReal.coe_toReal (hfinite x).1 (hfinite x).2).symm
    have hycoe : f y = ((f y).toReal : EReal) := by
      exact (EReal.coe_toReal (hfinite y).1 (hfinite y).2).symm
    have hRhsCoe : (a : EReal) * f x + (b : EReal) * f y =
        ((a * (f x).toReal + b * (f y).toReal : ℝ) : EReal) := by
      rw [hxcoe, hycoe]
      simp
    have h' : f (a • x + b • y) ≤
        ((a * (f x).toReal + b * (f y).toReal : ℝ) : EReal) := by
      simpa [hRhsCoe] using h
    have hreal := EReal.toReal_le_toReal h' hbot_l (EReal.coe_ne_top _)
    simpa using hreal

private theorem prop41_lowerSemicontinuous_of_continuous_toReal (f : H → EReal)
    (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hcont : Continuous (fun x => (f x).toReal)) :
    LowerSemicontinuous f := by
  have hcontE : Continuous (fun x => ((f x).toReal : EReal)) :=
    continuous_coe_real_ereal.comp hcont
  have heq : (fun x => ((f x).toReal : EReal)) = f := by
    funext x
    exact EReal.coe_toReal (hfinite x).1 (hfinite x).2
  simpa [heq] using hcontE.lowerSemicontinuous

private theorem prop41_convex_first_order_gradient (g : H → ℝ)
    (hg_conv : ConvexOn ℝ Set.univ g) (hg_C1 : ContDiff ℝ 1 g) :
    ∀ x y : H, g x + inner ℝ (gradient g x) (y - x) ≤ g y := by
  intro x y
  let z : H := y - x
  let φ : ℝ → ℝ := fun t => g (x + t • z)
  have hφ_conv : ConvexOn ℝ Set.univ φ := by
    constructor
    · exact convex_univ
    · intro s hs t ht a b ha hb hab
      have hmain := hg_conv.2 (by simp : x + s • z ∈ (Set.univ : Set H))
        (by simp : x + t • z ∈ (Set.univ : Set H)) ha hb hab
      have harg : a • (x + s • z) + b • (x + t • z) =
          x + (a * s + b * t) • z := by
        calc
          a • (x + s • z) + b • (x + t • z)
              = (a + b) • x + (a * s + b * t) • z := by
                  simp [smul_add, add_smul, mul_smul, add_left_comm, add_assoc]
          _ = x + (a * s + b * t) • z := by simp [hab]
      rw [harg] at hmain
      simpa [φ] using hmain
  have hg_diff : DifferentiableAt ℝ g x := (hg_C1.differentiable (by norm_num)) x
  have hline : HasDerivAt (fun t : ℝ => x + t • z) z 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const z).const_add x
  have hφ_deriv : HasDerivAt φ (inner ℝ (gradient g x) z) 0 := by
    have hg_diff0 : DifferentiableAt ℝ g (x + (0 : ℝ) • z) := by simpa using hg_diff
    have hcomp := hg_diff0.hasFDerivAt.comp_hasDerivAt 0 hline
    have hcomp' : HasDerivAt (fun t : ℝ => g (x + t • z)) ((fderiv ℝ g x) z) 0 := by
      simpa [Function.comp_def] using hcomp
    have hfg : (fderiv ℝ g x) z = inner ℝ (gradient g x) z := by
      simpa using (inner_gradient_left hg_diff (y := z)).symm
    simpa [φ, hfg] using hcomp'
  have hslope := ConvexOn.le_slope_of_hasDerivAt hφ_conv
    (by simp : (0 : ℝ) ∈ Set.univ) (by simp : (1 : ℝ) ∈ Set.univ)
    (by norm_num : (0 : ℝ) < 1) hφ_deriv
  have hφ0 : φ 0 = g x := by simp [φ]
  have hφ1 : φ 1 = g y := by simp [φ, z]
  have hslope_eq : slope φ 0 1 = g y - g x := by simp [slope, hφ0, hφ1]
  have : inner ℝ (gradient g x) z ≤ g y - g x := by
    simpa [hslope_eq] using hslope
  dsimp [z] at this
  linarith

private theorem prop41_gradient_subderivative_eq (f : H → EReal)
    (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_conv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hf_C1 : ContDiff ℝ 1 (fun x => (f x).toReal)) :
    ∀ x, {gradient (fun y => (f y).toReal) x} =
      {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)} := by
  intro x
  let g : H → ℝ := fun y => (f y).toReal
  have hg_conv : ConvexOn ℝ Set.univ g := prop41_ereal_finite_convexOn_toReal f hfinite hf_conv
  have hfirst := prop41_convex_first_order_gradient g hg_conv hf_C1
  ext v
  constructor
  · intro hv
    rw [Set.mem_singleton_iff] at hv
    subst v
    intro y
    have hreal := hfirst x y
    have hxcoe : f x = ((f x).toReal : EReal) := by
      exact (EReal.coe_toReal (hfinite x).1 (hfinite x).2).symm
    have hycoe : f y = ((f y).toReal : EReal) := by
      exact (EReal.coe_toReal (hfinite y).1 (hfinite y).2).symm
    rw [hxcoe, hycoe]
    exact EReal.coe_le_coe_iff.mpr hreal
  · intro hv
    rw [Set.mem_singleton_iff]
    apply ext_inner_right ℝ
    intro z
    have hsub_real : ∀ y, g x + inner ℝ v (y - x) ≤ g y := by
      intro y
      have h := hv y
      have hxcoe : f x = ((f x).toReal : EReal) := by
        exact (EReal.coe_toReal (hfinite x).1 (hfinite x).2).symm
      have hleft : f x + (inner ℝ v (y - x) : EReal) =
          ((g x + inner ℝ v (y - x) : ℝ) : EReal) := by
        rw [hxcoe]
        simp [g]
      have h' : ((g x + inner ℝ v (y - x) : ℝ) : EReal) ≤ f y := by
        simpa [hleft] using h
      have hreal := EReal.toReal_le_toReal h' (EReal.coe_ne_bot _) (hfinite y).1
      simpa [g] using hreal
    let ψ : ℝ → ℝ := fun t => g (x + t • z) - t * inner ℝ v z
    have hmin : IsLocalMin ψ 0 := by
      refine Filter.Eventually.of_forall ?_
      intro t
      have h := hsub_real (x + t • z)
      have hlin : inner ℝ v (x + t • z - x) = t * inner ℝ v z := by
        have : x + t • z - x = t • z := by abel
        rw [this, inner_smul_right]
      change g (x + (0 : ℝ) • z) - 0 * inner ℝ v z ≤
        g (x + t • z) - t * inner ℝ v z
      simp only [zero_smul, add_zero, zero_mul, sub_zero]
      linarith
    have hg_diff : DifferentiableAt ℝ g x := (hf_C1.differentiable (by norm_num)) x
    have hline : HasDerivAt (fun t : ℝ => x + t • z) z 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const z).const_add x
    have hφ_deriv : HasDerivAt (fun t : ℝ => g (x + t • z))
        (inner ℝ (gradient g x) z) 0 := by
      have hg_diff0 : DifferentiableAt ℝ g (x + (0 : ℝ) • z) := by simpa using hg_diff
      have hcomp := hg_diff0.hasFDerivAt.comp_hasDerivAt 0 hline
      have hcomp' : HasDerivAt (fun t : ℝ => g (x + t • z)) ((fderiv ℝ g x) z) 0 := by
        simpa [Function.comp_def] using hcomp
      have hfg : (fderiv ℝ g x) z = inner ℝ (gradient g x) z := by
        simpa using (inner_gradient_left hg_diff (y := z)).symm
      simpa [hfg] using hcomp'
    have hlin_deriv : HasDerivAt (fun t : ℝ => t * inner ℝ v z) (inner ℝ v z) 0 := by
      simpa using (hasDerivAt_id (0 : ℝ)).mul_const (inner ℝ v z)
    have hψ_deriv : HasDerivAt ψ (inner ℝ (gradient g x) z - inner ℝ v z) 0 := by
      simpa [ψ] using hφ_deriv.sub hlin_deriv
    have hzero := hmin.hasDerivAt_eq_zero hψ_deriv
    linarith

private theorem prop41_B_eq_subderivative (B : SetValuedOperator H H) (f : H → EReal)
    (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_conv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hf_C1 : ContDiff ℝ 1 (fun x => (f x).toReal))
    (hB_eq_grad : B =
      SetValuedOperator.ofFunction Set.univ
        (fun x : (Set.univ : Set H) => gradient (fun y => (f y).toReal) x.1)) :
    ∀ x, B x = {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)} := by
  intro x
  have hsingleton : B x = {gradient (fun y => (f y).toReal) x} := by
    rw [hB_eq_grad]
    simpa using
      SetValuedOperator.ofFunction_apply_of_mem Set.univ
        (fun x : (Set.univ : Set H) => gradient (fun y => (f y).toReal) x.1)
        (by simp : x ∈ Set.univ)
  rw [hsingleton, prop41_gradient_subderivative_eq f hfinite hf_conv hf_C1 x]

private theorem prop41_theorem31_assumptions (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ)
    (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_conv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hf_C1 : ContDiff ℝ 1 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (hB_eq_grad : B =
      SetValuedOperator.ofFunction Set.univ
        (fun x : (Set.univ : Set H) => gradient (fun y => (f y).toReal) x.1))
    (lam : ℕ → ℝ) (hlam_pos : ∀ n, lam n > 0)
    (hlam_nondec : ∀ n, lam n ≤ lam (n+1))
    (x : ℕ → H) (halg : AlgorithmA A B x lam) :
    Theorem31Assumptions A B f lam x := by
  let g : H → ℝ := fun x => (f x).toReal
  have hB_sub := prop41_B_eq_subderivative B f hfinite hf_conv hf_C1 hB_eq_grad
  refine
    { maxMonotoneA := hA
      domA := hdomA
      zero_mem_interior_A_zero := hAzero_int
      convex_f := hf_conv
      lowerSemicontinuous_f :=
        prop41_lowerSemicontinuous_of_continuous_toReal f hfinite hf_C1.continuous
      B_eq_subderivative_f := hB_sub
      dom_subderivative_nonempty := ?_
      f_bddBelow := hinf
      lam_pos := hlam_pos
      lam_nondec := hlam_nondec
      initial_point_mem_dom := ?_
      generated_by_algorithm := halg }
  · refine ⟨0, ?_⟩
    rw [SetValuedOperator.mem_dom_iff]
    have hB0 : B (0 : H) = {gradient g (0 : H)} := by
      rw [hB_eq_grad]
      simpa [g] using
        SetValuedOperator.ofFunction_apply_of_mem Set.univ
          (fun x : (Set.univ : Set H) => gradient (fun y => (f y).toReal) x.1)
          (by simp : (0 : H) ∈ Set.univ)
    rw [hB0]
    exact Set.singleton_nonempty _
  · simpa [ERealFunction.dom, lt_top_iff_ne_top] using (hfinite (x 1)).1

omit [CompleteSpace H] in
private theorem prop41_normalizedIncrementDirection_norm_of_not_stationary
    (x : ℕ → H) {n : ℕ} (hn : n ∉ stationaryIndices x) :
    ‖normalizedIncrementDirection x n‖ = 1 := by
  simp [normalizedIncrementDirection, stationaryIndices] at hn ⊢
  have hne : x (n + 1) - x n ≠ 0 := sub_ne_zero.mpr hn
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos]
  · exact inv_mul_cancel₀ (norm_ne_zero_iff.mpr hne)
  · exact inv_pos.mpr (norm_pos_iff.mpr hne)

omit [CompleteSpace H] in
private theorem prop41_normalizedIncrementLimitPoint_norm_one {x : ℕ → H} {d : H}
    (hd : d ∈ normalizedIncrementLimitPoints x) :
    ‖d‖ = 1 := by
  rcases hd with ⟨φ, hφ, hφD, hlim⟩
  have hlim_norm : Tendsto (fun n => ‖normalizedIncrementDirection x (φ n)‖)
      atTop (𝓝 ‖d‖) := continuous_norm.tendsto d |>.comp hlim
  have hone : Tendsto (fun _ : ℕ => (1 : ℝ)) atTop (𝓝 (1 : ℝ)) := tendsto_const_nhds
  have heq : (fun n => ‖normalizedIncrementDirection x (φ n)‖) = fun _ : ℕ => (1 : ℝ) := by
    funext n
    exact prop41_normalizedIncrementDirection_norm_of_not_stationary x (hφD n)
  have hlim_one : Tendsto (fun n => ‖normalizedIncrementDirection x (φ n)‖)
      atTop (𝓝 (1 : ℝ)) := by
    simpa [heq] using hone
  exact tendsto_nhds_unique hlim_norm hlim_one

omit [CompleteSpace H] in
private theorem prop41_normalizedIncrementDirection_tendsto_of_limitPoints_subset_singleton
    [FiniteDimensional ℝ H] (x : ℕ → H) (D : Set ℕ) (hD : D = stationaryIndices x)
    (u : H) (hsubset : normalizedIncrementLimitPoints x ⊆ ({u} : Set H)) :
    Tendsto (normalizedIncrementDirection x) (atTop ⊓ Filter.principal {n | n ∉ D}) (𝓝 u) := by
  classical
  refine Filter.tendsto_of_subseq_tendsto ?_
  intro ns hns
  have hns_atTop : Tendsto ns atTop atTop := hns.mono_right inf_le_left
  rcases Filter.strictMono_subseq_of_tendsto_atTop hns_atTop with ⟨θ, hθ, hnsθ_strict⟩
  have hθ_tendsto : Tendsto θ atTop atTop := hθ.tendsto_atTop
  have hnsθ_tendsto : Tendsto (ns ∘ θ) atTop (atTop ⊓ Filter.principal {n | n ∉ D}) :=
    hns.comp hθ_tendsto
  have hmem : {n : ℕ | n ∉ D} ∈ (atTop ⊓ Filter.principal {n : ℕ | n ∉ D}) := by
    rw [Filter.mem_inf_iff]
    refine ⟨Set.univ, univ_mem, {n : ℕ | n ∉ D}, by simp, ?_⟩
    ext n
    simp
  have hev : ∀ᶠ n in atTop, ns (θ n) ∉ D := by
    simpa [Function.comp_def] using hnsθ_tendsto hmem
  rcases eventually_atTop.mp hev with ⟨N0, hN0⟩
  let φ : ℕ → ℕ := fun n => ns (θ (n + N0))
  have hφ_strict : StrictMono φ := by
    have hadd : StrictMono (fun n : ℕ => n + N0) :=
      fun a b hab => Nat.add_lt_add_right hab N0
    exact hnsθ_strict.comp hadd
  have hφD : ∀ n, φ n ∉ D := by
    intro n
    exact hN0 (n + N0) (Nat.le_add_left N0 n)
  have hφDstat : ∀ n, φ n ∉ stationaryIndices x := by
    intro n
    simpa [hD] using hφD n
  let yseq : ℕ → H := fun n => normalizedIncrementDirection x (φ n)
  have hy_mem : ∀ n, yseq n ∈ Metric.closedBall (0 : H) 1 := by
    intro n
    rw [Metric.mem_closedBall, dist_zero_right]
    exact le_of_eq (prop41_normalizedIncrementDirection_norm_of_not_stationary x (hφDstat n))
  have hbounded : Bornology.IsBounded (Metric.closedBall (0 : H) (1 : ℝ)) :=
    Metric.isBounded_closedBall
  rcases tendsto_subseq_of_bounded hbounded hy_mem with ⟨d, hdmem, ψ, hψ, hψlim⟩
  have hdlimpt : d ∈ normalizedIncrementLimitPoints x := by
    refine ⟨φ ∘ ψ, hφ_strict.comp hψ, ?_, ?_⟩
    · intro n
      exact hφDstat (ψ n)
    · simpa [yseq, Function.comp_def] using hψlim
  have hdu : d = u := by
    have := hsubset hdlimpt
    simpa using this
  refine ⟨fun n => θ (ψ n + N0), ?_⟩
  simpa [φ, yseq, Function.comp_def, hdu] using hψlim

private theorem prop41_increment_norm_summable (A B : SetValuedOperator H H)
    (f : H → EReal) (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x) :
    Summable (fun n => ‖x (n + 1) - x n‖) := by
  rcases (thm_3_1_i A B f lam x h).1 with ⟨S, hS⟩
  have hS' : Tendsto (fun N : ℕ =>
      (Finset.range N).sum (fun n => ‖x (n + 1) - x n‖)) atTop (𝓝 S) := by
    exact (Filter.tendsto_add_atTop_iff_nat 1).mp (by simpa [Nat.add_comm] using hS)
  have hhas : HasSum (fun n => ‖x (n + 1) - x n‖) S :=
    (hasSum_iff_tendsto_nat_of_nonneg (fun n => norm_nonneg _) S).2 hS'
  exact hhas.summable

omit [CompleteSpace H] in
private theorem prop41_direction_error_isLittleO (x : ℕ → H) (D : Set ℕ)
    (hD : D = stationaryIndices x) (u : H)
    (hdir : Tendsto (normalizedIncrementDirection x)
      (atTop ⊓ Filter.principal {n | n ∉ D}) (𝓝 u)) :
    (fun n => ‖x (n + 1) - x n‖ • u - (x (n + 1) - x n)) =o[atTop]
      (fun n => ‖x (n + 1) - x n‖) := by
  rw [Asymptotics.isLittleO_iff]
  intro c hc
  have hball : Metric.ball u c ∈ 𝓝 u := Metric.ball_mem_nhds u hc
  have hev_inf : ∀ᶠ n in atTop ⊓ Filter.principal {n | n ∉ D},
      normalizedIncrementDirection x n ∈ Metric.ball u c := hdir hball
  have hset : {n : ℕ | normalizedIncrementDirection x n ∈ Metric.ball u c} ∈
      (atTop ⊓ Filter.principal {n : ℕ | n ∉ D}) := hev_inf
  rw [Filter.mem_inf_iff] at hset
  rcases hset with ⟨S, hS, T, hT, hST⟩
  rw [mem_principal] at hT
  rcases eventually_atTop.mp hS with ⟨N, hN⟩
  refine eventually_atTop.mpr ⟨N, ?_⟩
  intro n hn
  by_cases hnD : n ∈ D
  · have hstat : n ∈ stationaryIndices x := by simpa [hD] using hnD
    have hzero : x (n + 1) - x n = 0 := by
      simpa [stationaryIndices] using sub_eq_zero.mpr hstat
    simp [hzero]
  · have hnclose_mem : n ∈
        {m : ℕ | normalizedIncrementDirection x m ∈ Metric.ball u c} := by
      rw [hST]
      exact ⟨hN n hn, hT hnD⟩
    have hclose : ‖normalizedIncrementDirection x n - u‖ < c := by
      simpa [Metric.mem_ball, dist_eq_norm] using hnclose_mem
    have hnstat : n ∉ stationaryIndices x := by simpa [hD] using hnD
    let inc : H := x (n + 1) - x n
    have hne : inc ≠ 0 := by
      dsimp [inc]
      simp [stationaryIndices] at hnstat
      exact sub_ne_zero.mpr hnstat
    have hdir_eq : ‖inc‖ • normalizedIncrementDirection x n = inc := by
      dsimp [inc, normalizedIncrementDirection]
      rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hne), one_smul]
    have hrewrite :
        ‖inc‖ • u - inc = ‖inc‖ • (u - normalizedIncrementDirection x n) := by
      calc
        ‖inc‖ • u - inc =
            ‖inc‖ • u - ‖inc‖ • normalizedIncrementDirection x n := by
          nth_rw 2 [← hdir_eq]
        _ = ‖inc‖ • (u - normalizedIncrementDirection x n) := by rw [smul_sub]
    have hclose' : ‖u - normalizedIncrementDirection x n‖ < c := by
      simpa [norm_sub_rev] using hclose
    have hnonneg : 0 ≤ ‖inc‖ := norm_nonneg _
    have hle : ‖‖inc‖ • (u - normalizedIncrementDirection x n)‖ ≤ c * ‖inc‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hnonneg]
      nlinarith [hclose', hnonneg]
    change ‖‖inc‖ • u - inc‖ ≤ c * ‖(‖inc‖ : ℝ)‖
    rw [hrewrite, Real.norm_eq_abs, abs_of_nonneg hnonneg]
    exact hle

omit [CompleteSpace H] in
private theorem prop41_tail_tsum_isLittleO {e : ℕ → H} {s : ℕ → ℝ}
    (hs_nonneg : ∀ n, 0 ≤ s n) (hs_sum : Summable s)
    (he_norm_sum : Summable (fun n => ‖e n‖)) (he_o : e =o[atTop] s) :
    (fun n => ∑' k : ℕ, e (n + k)) =o[atTop] (fun n => ∑' k : ℕ, s (n + k)) := by
  rw [Asymptotics.isLittleO_iff]
  intro c hc
  have hev := (Asymptotics.isLittleO_iff.mp he_o) hc
  rcases eventually_atTop.mp hev with ⟨N, hN⟩
  refine eventually_atTop.mpr ⟨N, ?_⟩
  intro n hn
  have htail_e_norm : Summable (fun k : ℕ => ‖e (n + k)‖) := by
    simpa [Nat.add_comm] using
      (summable_nat_add_iff (f := fun i => ‖e i‖) n).mpr he_norm_sum
  have htail_s : Summable (fun k : ℕ => s (n + k)) := by
    simpa [Nat.add_comm] using (summable_nat_add_iff (f := s) n).mpr hs_sum
  have htail_cs : Summable (fun k : ℕ => c * s (n + k)) := by
    exact htail_s.mul_left c
  have hnorm_le : ‖∑' k : ℕ, e (n + k)‖ ≤ ∑' k : ℕ, ‖e (n + k)‖ :=
    norm_tsum_le_tsum_norm htail_e_norm
  have hterm : ∀ k : ℕ, ‖e (n + k)‖ ≤ c * s (n + k) := by
    intro k
    have hnk : N ≤ n + k := le_trans hn (Nat.le_add_right n k)
    have h := hN (n + k) hnk
    have hs_abs : ‖s (n + k)‖ = s (n + k) := by
      rw [Real.norm_eq_abs, abs_of_nonneg (hs_nonneg _)]
    simpa [hs_abs] using h
  have hsum_le : (∑' k : ℕ, ‖e (n + k)‖) ≤ ∑' k : ℕ, c * s (n + k) :=
    Summable.tsum_le_tsum hterm htail_e_norm htail_cs
  have hmul : (∑' k : ℕ, c * s (n + k)) = c * (∑' k : ℕ, s (n + k)) := by
    rw [tsum_mul_left]
  have htail_nonneg : 0 ≤ (∑' k : ℕ, s (n + k)) :=
    tsum_nonneg (fun k => hs_nonneg _)
  calc
    ‖∑' k : ℕ, e (n + k)‖ ≤ ∑' k : ℕ, ‖e (n + k)‖ := hnorm_le
    _ ≤ ∑' k : ℕ, c * s (n + k) := hsum_le
    _ = c * ‖∑' k : ℕ, s (n + k)‖ := by
      rw [hmul, Real.norm_eq_abs, abs_of_nonneg htail_nonneg]

omit [CompleteSpace H] in
private theorem prop41_hasSum_tail_increments (x : ℕ → H) (xInf : H)
    (hxInf : Tendsto x atTop (𝓝 xInf))
    (hsum_norm : Summable (fun n => ‖x (n + 1) - x n‖)) (n : ℕ) :
    HasSum (fun k : ℕ => x (n + k + 1) - x (n + k)) (xInf - x n) := by
  have hnorm_tail : Summable (fun k : ℕ => ‖x (n + k + 1) - x (n + k)‖) := by
    simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
      (summable_nat_add_iff (f := fun i => ‖x (i + 1) - x i‖) n).mpr hsum_norm
  rw [hasSum_iff_tendsto_nat_of_summable_norm hnorm_tail]
  have hshift : Tendsto (fun N : ℕ => n + N) atTop atTop :=
    Filter.tendsto_atTop_mono (fun N => Nat.le_add_left N n) tendsto_id
  have hxshift : Tendsto (fun N : ℕ => x (n + N)) atTop (𝓝 xInf) := hxInf.comp hshift
  have htarget : Tendsto (fun N : ℕ => x (n + N) - x n) atTop (𝓝 (xInf - x n)) :=
    hxshift.sub tendsto_const_nhds
  refine htarget.congr' (Eventually.of_forall ?_)
  intro N
  have htel := Finset.sum_range_sub (fun k : ℕ => x (n + k)) N
  simpa [Nat.add_assoc] using htel.symm

private theorem prop41_expansion_from_tail_error (x : ℕ → H) (xInf u : H) (R : ℕ → ℝ)
    (hxInf : Tendsto x atTop (𝓝 xInf))
    (hsum_norm : Summable (fun n => ‖x (n + 1) - x n‖))
    (hR : R = fun n : ℕ => ∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖)
    (htail_o :
      (fun n => ∑' k : ℕ,
        (‖x (n + k + 1) - x (n + k)‖ • u -
          (x (n + k + 1) - x (n + k))))
      =o[atTop] (fun n => ∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖)) :
    (fun n => x n - xInf + (R n) • u) =o[atTop] R := by
  refine htail_o.congr ?_ ?_
  · intro n
    let s : ℕ → ℝ := fun i => ‖x (i + 1) - x i‖
    let tailS : ℝ := ∑' k : ℕ, s (n + k)
    have hs_tail : Summable (fun k : ℕ => s (n + k)) := by
      simpa [s, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        (summable_nat_add_iff (f := s) n).mpr hsum_norm
    let L : ℝ →L[ℝ] H := ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) u
    have hsmul_has : HasSum (fun k : ℕ => s (n + k) • u) (tailS • u) := by
      have hmap := L.hasSum hs_tail.hasSum
      simpa [L, tailS] using hmap
    have hinc_has := prop41_hasSum_tail_increments x xInf hxInf hsum_norm n
    have hsub_has : HasSum
        (fun k : ℕ => s (n + k) • u - (x (n + k + 1) - x (n + k)))
        (tailS • u - (xInf - x n)) := hsmul_has.sub hinc_has
    have htsum := hsub_has.tsum_eq
    have htailS_R : tailS = R n := by
      simpa [tailS, s, hR]
    calc
      (∑' k : ℕ,
          (‖x (n + k + 1) - x (n + k)‖ • u -
            (x (n + k + 1) - x (n + k))))
          = tailS • u - (xInf - x n) := by
            simpa [s, tailS, Nat.add_assoc] using htsum
      _ = x n - xInf + (R n) • u := by rw [htailS_R]; abel
  · intro n
    rw [hR]

/-- Proposition 4.1, direction conclusion in the non-finitely-convergent case. -/
theorem prop_4_1_direction [FiniteDimensional ℝ H] (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ) (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_conv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hf_C1 : ContDiff ℝ 1 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (hB_eq_grad : B =
      SetValuedOperator.ofFunction Set.univ
        (fun x : (Set.univ : Set H) => gradient (fun y => (f y).toReal) x.1))
    (lam : ℕ → ℝ) (hlam_pos : ∀ n, lam n > 0) (hlam_nondec : ∀ n, lam n ≤ lam (n+1))
    (x : ℕ → H) (halg : AlgorithmA A B x lam) (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (h_smooth : IsSmoothAt (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf))
    (D : Set ℕ) (hD2 : D = stationaryIndices x)
    (u : H) (hu_norm : ‖u‖ = 1)
    (R : ℕ → ℝ)
    (hR : R = fun (n : ℕ) => ∑' (k : ℕ), ‖x (n+k+1) - x (n+k)‖)
    (hu_normal : normalCone (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf) =
      {v | ∃ (t : ℝ), t ≥ 0 ∧ v = t • u})
    (hnot_finite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    Filter.Tendsto (normalizedIncrementDirection x)
      (atTop ⊓ Filter.principal {n | n ∉ D}) (𝓝 u) := by
  let g : H → ℝ := fun y => (f y).toReal
  have hth31 : Theorem31Assumptions A B f lam x :=
    prop41_theorem31_assumptions A B hA hdomA hAzero_int f hfinite hf_conv hf_C1 hinf
      hB_eq_grad lam hlam_pos hlam_nondec x halg
  have hB_xInf : B xInf = {gradient g xInf} := by
    rw [hB_eq_grad]
    simpa [g] using
      SetValuedOperator.ofFunction_apply_of_mem Set.univ
        (fun x : (Set.univ : Set H) => gradient (fun y => (f y).toReal) x.1)
        (by simp : xInf ∈ Set.univ)
  have hdirections :
      normalizedIncrementLimitPoints x ⊆ normalConeSet (A (0 : H)) (-(B xInf)) :=
    theorem31_limit_directions_normal_cone A B f lam x hth31 xInf hxInf hnot_finite
  have hsubset : normalizedIncrementLimitPoints x ⊆ ({u} : Set H) := by
    intro d hd
    have hd_normalSet := hdirections hd
    simp [normalConeSet] at hd_normalSet
    rcases hd_normalSet with ⟨ξ, hξ, hdcone⟩
    have hξ_eq : ξ = gradient g xInf := by
      rw [hB_xInf] at hξ
      simpa [g] using hξ
    subst ξ
    have hcone : d ∈ normalCone (A (0 : H)) (-gradient g xInf) := by
      simpa [g] using hdcone
    have hhalf : d ∈ {v | ∃ (t : ℝ), t ≥ 0 ∧ v = t • u} := by
      simpa [g, hu_normal] using hcone
    rcases hhalf with ⟨t, ht_nonneg, hdt⟩
    have hd_norm : ‖d‖ = 1 := prop41_normalizedIncrementLimitPoint_norm_one hd
    have ht_one : t = 1 := by
      rw [hdt, norm_smul, Real.norm_eq_abs, abs_of_nonneg ht_nonneg, hu_norm, mul_one] at hd_norm
      exact hd_norm
    rw [Set.mem_singleton_iff]
    rw [hdt, ht_one, one_smul]
  exact prop41_normalizedIncrementDirection_tendsto_of_limitPoints_subset_singleton x D hD2 u hsubset

/-- Proposition 4.1, tail-sum expansion in the non-finitely-convergent case. -/
theorem prop_4_1_expansion [FiniteDimensional ℝ H] (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ) (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_conv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hf_C1 : ContDiff ℝ 1 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (hB_eq_grad : B =
      SetValuedOperator.ofFunction Set.univ
        (fun x : (Set.univ : Set H) => gradient (fun y => (f y).toReal) x.1))
    (lam : ℕ → ℝ) (hlam_pos : ∀ n, lam n > 0) (hlam_nondec : ∀ n, lam n ≤ lam (n+1))
    (x : ℕ → H) (halg : AlgorithmA A B x lam) (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (h_smooth : IsSmoothAt (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf))
    (D : Set ℕ) (hD2 : D = stationaryIndices x)
    (u : H) (hu_norm : ‖u‖ = 1)
    (R : ℕ → ℝ)
    (hR : R = fun (n : ℕ) => ∑' (k : ℕ), ‖x (n+k+1) - x (n+k)‖)
    (hu_normal : normalCone (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf) =
      {v | ∃ (t : ℝ), t ≥ 0 ∧ v = t • u})
    (hnot_finite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    (fun n => x n - xInf + (R n) • u) =o[atTop] R := by
  have hth31 : Theorem31Assumptions A B f lam x :=
    prop41_theorem31_assumptions A B hA hdomA hAzero_int f hfinite hf_conv hf_C1 hinf
      hB_eq_grad lam hlam_pos hlam_nondec x halg
  have hdir :=
    prop_4_1_direction A B hA hdomA hAzero_int f hfinite hf_conv hf_C1 hinf hB_eq_grad
      lam hlam_pos hlam_nondec x halg xInf hxInf h_smooth D hD2 u hu_norm R hR hu_normal
      hnot_finite
  have hsum_norm : Summable (fun n => ‖x (n + 1) - x n‖) :=
    prop41_increment_norm_summable A B f lam x hth31
  let e : ℕ → H := fun n => ‖x (n + 1) - x n‖ • u - (x (n + 1) - x n)
  let s : ℕ → ℝ := fun n => ‖x (n + 1) - x n‖
  have he_o : e =o[atTop] s := by
    simpa [e, s] using prop41_direction_error_isLittleO x D hD2 u hdir
  have he_norm_sum : Summable (fun n => ‖e n‖) := by
    have hbig : (fun n => ‖e n‖) =O[atTop] s := he_o.isBigO.norm_left
    exact summable_of_isBigO_nat hsum_norm hbig
  have htail_o' :
      (fun n => ∑' k : ℕ,
        (‖x (n + k + 1) - x (n + k)‖ • u -
          (x (n + k + 1) - x (n + k))))
      =o[atTop] (fun n => ∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖) := by
    simpa [e, s, Nat.add_assoc] using
      (prop41_tail_tsum_isLittleO (e := e) (s := s)
        (fun n => norm_nonneg (x (n + 1) - x n)) hsum_norm he_norm_sum he_o)
  exact prop41_expansion_from_tail_error x xInf u R hxInf hsum_norm hR htail_o'

/-- Proposition 4.1, norm/tail-sum asymptotic equivalence. -/
theorem prop_4_1_norm_equiv [FiniteDimensional ℝ H] (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ) (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_conv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hf_C1 : ContDiff ℝ 1 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (hB_eq_grad : B =
      SetValuedOperator.ofFunction Set.univ
        (fun x : (Set.univ : Set H) => gradient (fun y => (f y).toReal) x.1))
    (lam : ℕ → ℝ) (hlam_pos : ∀ n, lam n > 0) (hlam_nondec : ∀ n, lam n ≤ lam (n+1))
    (x : ℕ → H) (halg : AlgorithmA A B x lam) (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (h_smooth : IsSmoothAt (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf))
    (D : Set ℕ) (hD2 : D = stationaryIndices x)
    (u : H) (hu_norm : ‖u‖ = 1)
    (R : ℕ → ℝ)
    (hR : R = fun (n : ℕ) => ∑' (k : ℕ), ‖x (n+k+1) - x (n+k)‖)
    (hu_normal : normalCone (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf) =
      {v | ∃ (t : ℝ), t ≥ 0 ∧ v = t • u})
    (hnot_finite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    (fun n => ‖x n - xInf‖) ~[atTop] R := by
  have hexp :=
    prop_4_1_expansion A B hA hdomA hAzero_int f hfinite hf_conv hf_C1 hinf hB_eq_grad
      lam hlam_pos hlam_nondec x halg xInf hxInf h_smooth D hD2 u hu_norm R hR hu_normal
      hnot_finite
  have hR_nonneg : ∀ n, 0 ≤ R n := by
    intro n
    rw [hR]
    exact tsum_nonneg (fun k => norm_nonneg (x (n + k + 1) - x (n + k)))
  rw [Asymptotics.IsEquivalent]
  rw [Asymptotics.isLittleO_iff] at hexp ⊢
  intro c hc
  have hev := hexp hc
  filter_upwards [hev] with n hn
  have hmain : ‖‖x n - xInf‖ - R n‖ ≤ ‖x n - xInf + R n • u‖ := by
    have hnorm_comp : ‖(-(R n)) • u‖ = R n := by
      rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg (hR_nonneg n), hu_norm,
        mul_one]
    calc
      ‖‖x n - xInf‖ - R n‖ = |‖x n - xInf‖ - R n| := by
        rw [Real.norm_eq_abs]
      _ = |‖x n - xInf‖ - ‖(-(R n)) • u‖| := by
        rw [hnorm_comp]
      _ ≤ ‖(x n - xInf) - (-(R n)) • u‖ := abs_norm_sub_norm_le _ _
      _ = ‖x n - xInf + R n • u‖ := by
        simp [sub_eq_add_neg]
  exact hmain.trans hn

/-- Proposition 4.1, eventual zero/nonzero alternative. -/
theorem prop_4_1_eventual_alternative [FiniteDimensional ℝ H] (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ) (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_conv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hf_C1 : ContDiff ℝ 1 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (hB_eq_grad : B =
      SetValuedOperator.ofFunction Set.univ
        (fun x : (Set.univ : Set H) => gradient (fun y => (f y).toReal) x.1))
    (lam : ℕ → ℝ) (hlam_pos : ∀ n, lam n > 0) (hlam_nondec : ∀ n, lam n ≤ lam (n+1))
    (x : ℕ → H) (halg : AlgorithmA A B x lam) (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (h_smooth : IsSmoothAt (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf))
    (D : Set ℕ) (hD2 : D = stationaryIndices x)
    (u : H) (hu_norm : ‖u‖ = 1)
    (R : ℕ → ℝ)
    (hR : R = fun (n : ℕ) => ∑' (k : ℕ), ‖x (n+k+1) - x (n+k)‖)
    (hu_normal : normalCone (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf) =
      {v | ∃ (t : ℝ), t ≥ 0 ∧ v = t • u})
    (hnot_finite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    (∃ N, ∀ n ≥ N, x n = xInf) ∨ (∃ N, ∀ n ≥ N, ‖x n - xInf‖ > 0) := by
  right
  have hth31 : Theorem31Assumptions A B f lam x :=
    prop41_theorem31_assumptions A B hA hdomA hAzero_int f hfinite hf_conv hf_C1 hinf
      hB_eq_grad lam hlam_pos hlam_nondec x halg
  have hsum_norm : Summable (fun n => ‖x (n + 1) - x n‖) :=
    prop41_increment_norm_summable A B f lam x hth31
  have hR_pos : ∀ n, 0 < R n := by
    intro n
    rw [hR]
    let s : ℕ → ℝ := fun k => ‖x (n + k + 1) - x (n + k)‖
    have hs_tail : Summable s := by
      simpa [s, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        (summable_nat_add_iff (f := fun i => ‖x (i + 1) - x i‖) n).mpr hsum_norm
    have hs_nonneg : ∀ k, 0 ≤ s k := by
      intro k
      exact norm_nonneg _
    have hexists : ∃ k, 0 < s k := by
      by_contra hnone
      have hzero : ∀ k, x (n + k + 1) = x (n + k) := by
        intro k
        have hnot_pos : ¬ 0 < s k := by
          intro hk
          exact hnone ⟨k, hk⟩
        have hle0 : s k ≤ 0 := le_of_not_gt hnot_pos
        have hz : s k = 0 := le_antisymm hle0 (hs_nonneg k)
        have hsub : x (n + k + 1) - x (n + k) = 0 := norm_eq_zero.mp hz
        exact sub_eq_zero.mp hsub
      have htail_const : ∀ k, x (n + k) = x n := by
        intro k
        induction k with
        | zero => simp
        | succ k ih =>
            calc
              x (n + Nat.succ k) = x (n + k) := by
                simpa [Nat.succ_eq_add_one, Nat.add_assoc] using hzero k
              _ = x n := ih
      exact hnot_finite ⟨n, by
        intro m hm
        rcases Nat.exists_eq_add_of_le hm with ⟨k, hk⟩
        subst hk
        exact htail_const k⟩
    rcases hexists with ⟨k, hk⟩
    exact Summable.tsum_pos hs_tail hs_nonneg k hk
  have hnorm_equiv :=
    prop_4_1_norm_equiv A B hA hdomA hAzero_int f hfinite hf_conv hf_C1 hinf hB_eq_grad
      lam hlam_pos hlam_nondec x halg xInf hxInf h_smooth D hD2 u hu_norm R hR hu_normal
      hnot_finite
  have hpos_eventual : ∀ᶠ n in atTop, 0 < ‖x n - xInf‖ :=
    hnorm_equiv.eventually_pos (Eventually.of_forall hR_pos)
  rcases eventually_atTop.mp hpos_eventual with ⟨N, hN⟩
  exact ⟨N, fun n hn => hN n hn⟩
