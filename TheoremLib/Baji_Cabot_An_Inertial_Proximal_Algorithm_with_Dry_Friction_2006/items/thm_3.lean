/-!
# Theorem 5.1
Let $C$ be a closed convex polyhedron of $H$ which is bounded and such that
$0 \in \operatorname{int}(C)$. Consider a single-valued maximal monotone operator
$A_0: H \to H$ of class $\mathcal{C}^2$. Assume that $A_0(0) = 0$ and that the
differential operator $\mathrm{d}A_0(0)$ at $0$ verifies the coercivity condition
$\forall x \in H, \quad \langle \mathrm{d}A_0(0) x, x \rangle \geqslant m |x|^2$,
for some $m > 0$. Define the maximal monotone operator $A: H \Rightarrow H$ by
$A := \partial\sigma_C + A_0$. The operator $B$ is supposed to be equal to $\nabla f$
for a convex function $f: H \to \mathbb{R}$ of class $\mathcal{C}^1$ which is bounded
from below. Assume that the function $f$ is strongly convex, i.e., there exists
$M > 0$ such that
$\forall x, y \in H, \quad f(x) \geqslant f(y) + \langle \nabla f(y), x - y \rangle +
\frac{M}{2} |x - y|^2$.
The sequence $(\lambda_n)$ is assumed to be constant, equal to $\lambda > 0$.
Let $(x_n)$ be the sequence generated by the algorithm $(\mathcal{A})$ and let us set
$x_\infty = s-\lim_{n \to +\infty} x_n$. Then, there exist $n_0 \in \mathbb{N}$,
$K > 0$ and $q \in ]0, 1[$ such that
$\forall n \geqslant n_0, \quad |x_{n+1} - x_n| \leqslant K q^n$.
-/
open SetValuedOperator
open scoped Topology
open scoped Pointwise
open Set
open Filter
variable {H : Type _} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- A bounded finite-halfspace polyhedron with nonempty interior forces finite dimension. -/
private theorem thm51_finiteDimensional_of_bounded_polyhedron_interior
    {C : Set H} (hC_polyhedron : ConvexPolyhedron C)
    (hC_bounded : Bornology.IsBounded C) (hC_int : (0 : H) ∈ interior C) :
    FiniteDimensional ℝ H := by
  classical
  rcases hC_polyhedron with ⟨m, a, b, hCeq⟩
  let V : Submodule ℝ H := Submodule.span ℝ (Set.range a)
  haveI hVfin : FiniteDimensional ℝ V :=
    FiniteDimensional.span_of_finite ℝ (Set.finite_range a)
  haveI : CompleteSpace V := FiniteDimensional.complete ℝ V
  haveI : V.HasOrthogonalProjection := inferInstance
  have hVorth_bot : Vᗮ = ⊥ := by
    rw [Submodule.eq_bot_iff]
    intro y hy
    by_contra hy_ne
    rcases hC_bounded.exists_norm_le with ⟨R, hR⟩
    have hC0 : (0 : H) ∈ C := interior_subset hC_int
    have hb_nonneg : ∀ i : Fin m, 0 ≤ b i := by
      intro i
      have h0constraints : (0 : H) ∈ {x : H | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} := by
        simpa [hCeq] using hC0
      simpa using h0constraints i
    have hline_mem : ∀ t : ℝ, t • y ∈ C := by
      intro t
      rw [hCeq]
      intro i
      have hai_mem : a i ∈ V := Submodule.subset_span ⟨i, rfl⟩
      have horth : inner ℝ (a i) y = 0 :=
        (V.mem_orthogonal y).mp hy (a i) hai_mem
      rw [inner_smul_right, horth, mul_zero]
      exact hb_nonneg i
    let t : ℝ := (|R| + 1) / ‖y‖
    have hynorm_pos : 0 < ‖y‖ := norm_pos_iff.mpr hy_ne
    have hnorm_line : ‖t • y‖ = |R| + 1 := by
      rw [norm_smul, Real.norm_eq_abs]
      have ht_nonneg : 0 ≤ t := by
        dsimp [t]
        positivity
      rw [abs_of_nonneg ht_nonneg]
      dsimp [t]
      exact div_mul_cancel₀ (|R| + 1) (ne_of_gt hynorm_pos)
    have hle := hR (t • y) (hline_mem t)
    rw [hnorm_line] at hle
    exact (not_le_of_gt (lt_add_one |R|)) (le_trans hle (le_abs_self R))
  have hVtop : V = ⊤ := (Submodule.orthogonal_eq_bot_iff (K := V)).mp hVorth_bot
  have htopfin : FiniteDimensional ℝ (⊤ : Submodule ℝ H) := by
    rwa [hVtop] at hVfin
  letI : FiniteDimensional ℝ (⊤ : Submodule ℝ H) := htopfin
  exact (Submodule.topEquiv : (⊤ : Submodule ℝ H) ≃ₗ[ℝ] H).finiteDimensional

/-- The support function of a set containing the origin vanishes at the origin. -/
private theorem thm51_supportFunction_zero (C : Set H) (hC0 : (0 : H) ∈ C) :
    supportFunction C (0 : H) = 0 := by
  unfold supportFunction
  have h_image :
      ((fun z : H => (inner ℝ z (0 : H) : EReal)) '' C) = ({0} : Set EReal) := by
    ext r
    constructor
    · rintro ⟨z, _hz, rfl⟩
      simp
    · intro hr
      refine ⟨0, hC0, ?_⟩
      simpa using hr.symm
  rw [h_image]
  simp

/-- Every point of a set lies below its support function. -/
private theorem thm51_inner_le_supportFunction {C : Set H} {z y : H} (hz : z ∈ C) :
    (inner ℝ z y : EReal) ≤ supportFunction C y := by
  unfold supportFunction
  exact le_sSup ⟨z, hz, rfl⟩

/-- Boundedness rules out `⊤` values of the support function. -/
private theorem thm51_supportFunction_ne_top_of_bounded (C : Set H)
    (hC_bounded : Bornology.IsBounded C) (y : H) :
    supportFunction C y ≠ ⊤ := by
  rcases (Metric.isBounded_iff_subset_closedBall (0 : H)).mp hC_bounded with ⟨R, hRball⟩
  have hR : ∀ z ∈ C, ‖z‖ ≤ R := by
    intro z hz
    have hzball := hRball hz
    simpa [Metric.mem_closedBall, dist_eq_norm] using hzball
  have hupper : supportFunction C y ≤ ((R * ‖y‖ : ℝ) : EReal) := by
    unfold supportFunction
    refine sSup_le ?_
    rintro _ ⟨z, hz, rfl⟩
    have hreal : inner ℝ z y ≤ R * ‖y‖ := by
      calc
        inner ℝ z y ≤ ‖z‖ * ‖y‖ := real_inner_le_norm z y
        _ ≤ R * ‖y‖ := mul_le_mul_of_nonneg_right (hR z hz) (norm_nonneg y)
    exact EReal.coe_le_coe_iff.mpr hreal
  intro htop
  have htop_le : (⊤ : EReal) ≤ ((R * ‖y‖ : ℝ) : EReal) := by
    simpa [htop] using hupper
  exact (EReal.coe_ne_top (R * ‖y‖)) (top_le_iff.mp htop_le)

/-- Nonemptiness rules out `⊥` values of the support function. -/
private theorem thm51_supportFunction_ne_bot_of_nonempty {C : Set H}
    (hC_nonempty : C.Nonempty) (y : H) :
    supportFunction C y ≠ ⊥ := by
  rcases hC_nonempty with ⟨z, hz⟩
  have hle : (inner ℝ z y : EReal) ≤ supportFunction C y :=
    thm51_inner_le_supportFunction hz
  intro hbot
  rw [hbot] at hle
  simp at hle

/-- The support function is subadditive. -/
private theorem thm51_supportFunction_add_le (C : Set H) (u v : H) :
    supportFunction C (u + v) ≤ supportFunction C u + supportFunction C v := by
  unfold supportFunction
  refine sSup_le ?_
  rintro _ ⟨c, hc, rfl⟩
  have hu : (inner ℝ c u : EReal) ≤
      sSup ((fun q : H => (inner ℝ q u : EReal)) '' C) :=
    thm51_inner_le_supportFunction hc
  have hv : (inner ℝ c v : EReal) ≤
      sSup ((fun q : H => (inner ℝ q v : EReal)) '' C) :=
    thm51_inner_le_supportFunction hc
  have hsum : ((inner ℝ c u + inner ℝ c v : ℝ) : EReal) ≤
      sSup ((fun q : H => (inner ℝ q u : EReal)) '' C) +
        sSup ((fun q : H => (inner ℝ q v : EReal)) '' C) := by
    simpa [EReal.coe_add] using add_le_add hu hv
  simpa [inner_add_right] using hsum

/-- A support-function subgradient bounds the support value by its evaluation. -/
private theorem thm51_subderivative_support_upper {C : Set H} {v xi : H}
    (hC0 : (0 : H) ∈ C) (hxi : xi ∈ subderivative (supportFunction C) v) :
    supportFunction C v ≤ (inner ℝ xi v : EReal) := by
  have h0 := hxi (0 : H)
  have h0' : supportFunction C v - (inner ℝ xi v : EReal) ≤ 0 := by
    simpa [thm51_supportFunction_zero C hC0, sub_eq_add_neg] using h0
  exact EReal.sub_nonpos.mp h0'

/-- A defining halfspace gives the corresponding one-sided support-function bound. -/
private theorem thm51_supportFunction_smul_halfspace_le {C : Set H} {a : H} {b t : ℝ}
    (hC : ∀ z ∈ C, inner ℝ a z ≤ b) (ht : 0 ≤ t) :
    supportFunction C (t • a) ≤ (t * b : EReal) := by
  unfold supportFunction
  refine sSup_le ?_
  rintro _ ⟨z, hz, rfl⟩
  have hzle : inner ℝ z a ≤ b := by
    simpa [real_inner_comm] using hC z hz
  have hmul : t * inner ℝ z a ≤ t * b := mul_le_mul_of_nonneg_left hzle ht
  have hinner : inner ℝ z (t • a) = t * inner ℝ z a := by
    simp [inner_smul_right]
  exact EReal.coe_le_coe_iff.mpr (by simpa [hinner] using hmul)

/-- A subgradient of a represented support function lies in the represented polyhedron. -/
private theorem thm51_subderivative_supportFunction_mem_polyhedron {C : Set H}
    (hpoly : ConvexPolyhedron C) (hC0 : (0 : H) ∈ C) {v xi : H}
    (hxi : xi ∈ subderivative (supportFunction C) v) :
    xi ∈ C := by
  have hCne : C.Nonempty := ⟨0, hC0⟩
  have hupper := thm51_subderivative_support_upper hC0 hxi
  have hlower : ((0 : ℝ) : EReal) ≤ supportFunction C v := by
    simpa using (thm51_inner_le_supportFunction (z := (0 : H)) (y := v) hC0)
  have hsup_ne_top : supportFunction C v ≠ ⊤ := by
    intro htop
    have htop_le : (⊤ : EReal) ≤ (inner ℝ xi v : EReal) := by
      simpa [htop] using hupper
    exact (not_le_of_gt (EReal.coe_lt_top (inner ℝ xi v))) htop_le
  have hsup_ne_bot : supportFunction C v ≠ ⊥ := by
    intro hbot
    have hzero_le_bot : ((0 : ℝ) : EReal) ≤ (⊥ : EReal) := by
      simpa [hbot] using hlower
    exact (not_le_of_gt (EReal.bot_lt_coe (0 : ℝ))) hzero_le_bot
  let s : ℝ := (supportFunction C v).toReal
  have hs : (s : EReal) = supportFunction C v := by
    simpa [s] using EReal.coe_toReal hsup_ne_top hsup_ne_bot
  rcases hpoly with ⟨m, a, b, hCeq⟩
  rw [hCeq]
  intro i
  have hhalf : ∀ z ∈ C, inner ℝ (a i) z ≤ b i := by
    intro z hz
    rw [hCeq] at hz
    exact hz i
  have hsub := hxi (v + (1 : ℝ) • a i)
  have hlow : supportFunction C v + (inner ℝ xi (a i) : EReal) ≤
      supportFunction C (v + (1 : ℝ) • a i) := by
    simpa using hsub
  have hadd := thm51_supportFunction_add_le C v ((1 : ℝ) • a i)
  have hsmul := thm51_supportFunction_smul_halfspace_le
    (C := C) (a := a i) (b := b i) (t := 1) hhalf (by norm_num)
  have hupper_y : supportFunction C (v + (1 : ℝ) • a i) ≤
      supportFunction C v + (b i : EReal) := by
    calc
      supportFunction C (v + (1 : ℝ) • a i)
          ≤ supportFunction C v + supportFunction C ((1 : ℝ) • a i) := hadd
      _ ≤ supportFunction C v + (b i : EReal) := by
          simpa [add_comm, add_left_comm, add_assoc] using
            add_le_add_left hsmul (supportFunction C v)
  have hcomb : supportFunction C v + (inner ℝ xi (a i) : EReal) ≤
      supportFunction C v + (b i : EReal) := le_trans hlow hupper_y
  have hcomb' : ((s + inner ℝ xi (a i) : ℝ) : EReal) ≤
      ((s + b i : ℝ) : EReal) := by
    simpa [hs, EReal.coe_add] using hcomb
  have hreal : s + inner ℝ xi (a i) ≤ s + b i :=
    EReal.coe_le_coe_iff.mp hcomb'
  have hgoal : inner ℝ (a i) xi ≤ b i := by
    simpa [real_inner_comm] using (by linarith : inner ℝ xi (a i) ≤ b i)
  exact hgoal

/-- If a support value is bounded above by evaluation at `xi`, then `v` is normal to `C`. -/
private theorem thm51_supportFunction_upper_mem_normalCone {C : Set H} {v xi : H}
    (hxiC : xi ∈ C) (hsup : supportFunction C v ≤ (inner ℝ xi v : EReal)) :
    v ∈ normalCone C xi := by
  rw [mem_normalCone_iff_forall]
  constructor
  · exact hxiC
  · intro y hy
    have hy_le_sup : (inner ℝ y v : EReal) ≤ supportFunction C v := by
      unfold supportFunction
      exact le_sSup (by exact ⟨y, hy, rfl⟩)
    have hy_le_xi_E : (inner ℝ y v : EReal) ≤ (inner ℝ xi v : EReal) :=
      le_trans hy_le_sup hsup
    have hy_le_xi : inner ℝ y v ≤ inner ℝ xi v := EReal.coe_le_coe_iff.mp hy_le_xi_E
    have hrewrite : inner ℝ v (y - xi) = inner ℝ y v - inner ℝ xi v := by
      rw [inner_sub_right]
      rw [real_inner_comm v y, real_inner_comm v xi]
    rw [real_inner_comm]
    rw [hrewrite]
    linarith

/-- Support-function subgradients of a represented polyhedron give support points and normals. -/
private theorem thm51_support_subgradient_mem_and_normal {C : Set H} {v xi : H}
    (hpoly : ConvexPolyhedron C) (hC0 : (0 : H) ∈ C)
    (hxi : xi ∈ subderivative (supportFunction C) v) :
    xi ∈ C ∧ v ∈ normalCone C xi := by
  have hxiC := thm51_subderivative_supportFunction_mem_polyhedron hpoly hC0 hxi
  have hsup := thm51_subderivative_support_upper hC0 hxi
  exact ⟨hxiC, thm51_supportFunction_upper_mem_normalCone hxiC hsup⟩

/-- A resolvent-surjective monotone operator is maximal monotone. -/
private theorem thm51_maximal_of_monotone_and_resolvent_surjective
    (B : SetValuedOperator H H) (hmono : IsMonotone B)
    (hres : ∀ z : H, ∃ p q : H, q ∈ B p ∧ z = p + q) :
    IsMaximalMonotone B := by
  refine ⟨hmono, ?_⟩
  intro A' hA'mono hsubset xu hxu
  rcases xu with ⟨x, u⟩
  rw [SetValuedOperator.mem_graph_iff] at hxu ⊢
  rcases hres (x + u) with ⟨p, q, hqB, hz⟩
  have hqA : q ∈ A' p := by
    exact (SetValuedOperator.mem_graph_iff A' p q).mp
      (hsubset ((SetValuedOperator.mem_graph_iff B p q).mpr hqB))
  have hmon := hA'mono u hxu q hqA
  have huq : u - q = -(x - p) := by
    calc
      u - q = (x + u) - q - x := by abel
      _ = (p + q) - q - x := by rw [hz]
      _ = -(x - p) := by abel
  have hinner : inner ℝ (u - q) (x - p) = - ‖x - p‖ ^ 2 := by
    rw [huq, inner_neg_left, real_inner_self_eq_norm_sq]
  have hsq_nonpos : ‖x - p‖ ^ 2 ≤ 0 := by
    nlinarith [hmon, hinner]
  have hx_p : x = p := by
    have hnorm_zero : ‖x - p‖ = 0 := by
      nlinarith [sq_nonneg ‖x - p‖]
    exact sub_eq_zero.mp (norm_eq_zero.mp hnorm_zero)
  have hu_q : u = q := by
    rw [hx_p] at hz
    exact add_left_cancel hz
  simpa [hx_p, hu_q] using hqB

/-- Select the `A` and `B` components from one algorithmic inclusion step. -/
private theorem thm51_algorithm_step_selection (A B : SetValuedOperator H H)
    (lam : ℕ → ℝ) (x : ℕ → H) (halg : AlgorithmA A B x lam) :
    ∀ n, ∃ a b : H,
      a ∈ A ((lam n)⁻¹ • (x (n + 2) - x (n + 1))) ∧
      b ∈ B (x (n + 2)) ∧
      ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n) + a + b = 0 := by
  intro n
  let v : H := (lam n)⁻¹ • (x (n + 2) - x (n + 1))
  let acc : H := ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)
  have hstep : (0 : H) ∈ ({acc} : Set H) + A v + B (x (n + 2)) := by
    simpa [AlgorithmA, acc, v] using halg.step n
  rw [Set.mem_add] at hstep
  rcases hstep with ⟨p, hp, b, hb, hpbeq⟩
  rw [Set.mem_add] at hp
  rcases hp with ⟨c, hc, a, ha, hp_eq⟩
  rw [Set.mem_singleton_iff] at hc
  subst c
  refine ⟨a, b, ?_, hb, ?_⟩
  · simpa [v]
  · have hp_eq' : acc + a = p := by simpa [hp_eq]
    rw [← hpbeq, ← hp_eq']

/-- A `C²` perturbation has a quadratic remainder after subtracting its derivative at the origin. -/
private theorem thm51_A0_quadratic_remainder_eventually
    [FiniteDimensional ℝ H] (A0 : H → H) (hA0_C2 : ContDiff ℝ 2 A0)
    (hA0_zero : A0 (0 : H) = 0) :
    ∃ C0 > 0, ∀ᶠ y in 𝓝 (0 : H),
      ‖A0 y - fderiv ℝ A0 (0 : H) y‖ ≤ C0 * ‖y‖^2 := by
  have hAt : ContDiffAt ℝ (1 : WithTop ℕ∞) (fun y : H => fderiv ℝ A0 y) (0 : H) := by
    simpa using
      (ContDiffAt.fderiv_right_succ
        (hA0_C2.contDiffAt (x := (0 : H)) :
          ContDiffAt ℝ ((1 : WithTop ℕ∞) + 1) A0 (0 : H)))
  have hstrict : HasStrictFDerivAt (fun y : H => fderiv ℝ A0 y)
      (fderiv ℝ (fun y : H => fderiv ℝ A0 y) (0 : H)) (0 : H) :=
    hAt.hasStrictFDerivAt (by norm_num : (1 : WithTop ℕ∞) ≠ 0)
  rcases hstrict.exists_lipschitzOnWith with ⟨Knn, s, hs_nhds, hLip⟩
  rcases Metric.mem_nhds_iff.mp hs_nhds with ⟨ε, hε, hball_subset⟩
  refine ⟨(Knn : ℝ) + 1, by positivity, ?_⟩
  filter_upwards [Metric.ball_mem_nhds (0 : H) hε] with y hy
  let seg : Set H := segment ℝ (0 : H) y
  have hy_norm_lt : ‖y‖ < ε := by
    simpa [Metric.mem_ball, dist_eq_norm] using hy
  have hseg_ball : seg ⊆ Metric.ball (0 : H) ε := by
    intro w hw
    have hwclosed : w ∈ Metric.closedBall (0 : H) (dist (0 : H) y) :=
      segment_subset_closedBall_left (0 : H) y hw
    exact (Metric.closedBall_subset_ball (by simpa [dist_eq_norm] using hy_norm_lt)) hwclosed
  have hseg_s : seg ⊆ s := fun w hw => hball_subset (hseg_ball hw)
  have hA0_diff : Differentiable ℝ A0 :=
    hA0_C2.differentiable (by norm_num : (2 : WithTop ℕ∞) ≠ 0)
  have hdiff : ∀ w ∈ seg, DifferentiableAt ℝ A0 w := fun w _hw => hA0_diff w
  have h0s : (0 : H) ∈ s := mem_of_mem_nhds hs_nhds
  have hbound : ∀ w ∈ seg,
      ‖fderiv ℝ A0 w - fderiv ℝ A0 (0 : H)‖ ≤ ((Knn : ℝ) + 1) * ‖y‖ := by
    intro w hw
    have hws : w ∈ s := hseg_s hw
    have hLipw := hLip.norm_sub_le hws h0s
    have hwclosed : w ∈ Metric.closedBall (0 : H) (dist (0 : H) y) :=
      segment_subset_closedBall_left (0 : H) y hw
    have hwnorm : ‖w‖ ≤ ‖y‖ := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hwclosed
    calc
      ‖fderiv ℝ A0 w - fderiv ℝ A0 (0 : H)‖ ≤ (Knn : ℝ) * ‖w - 0‖ := hLipw
      _ = (Knn : ℝ) * ‖w‖ := by simp
      _ ≤ (Knn : ℝ) * ‖y‖ := by
          have hK_nonneg : 0 ≤ (Knn : ℝ) := by positivity
          exact mul_le_mul_of_nonneg_left hwnorm hK_nonneg
      _ ≤ ((Knn : ℝ) + 1) * ‖y‖ := by
          exact mul_le_mul_of_nonneg_right (by linarith : (Knn : ℝ) ≤ (Knn : ℝ) + 1)
            (norm_nonneg y)
  have hmv := Convex.norm_image_sub_le_of_norm_fderiv_le'
      (f := A0) (C := ((Knn : ℝ) + 1) * ‖y‖) (s := seg)
      (x := (0 : H)) (y := y) (φ := fderiv ℝ A0 (0 : H))
      hdiff hbound (convex_segment (0 : H) y) (left_mem_segment ℝ (0 : H) y)
      (right_mem_segment ℝ (0 : H) y)
  calc
    ‖A0 y - fderiv ℝ A0 (0 : H) y‖
        = ‖A0 y - A0 (0 : H) - fderiv ℝ A0 (0 : H) (y - 0)‖ := by
            simp [hA0_zero]
    _ ≤ (((Knn : ℝ) + 1) * ‖y‖) * ‖y - 0‖ := hmv
    _ = ((Knn : ℝ) + 1) * ‖y‖ ^ 2 := by
        simp [pow_two, mul_assoc, mul_comm]

/-- Theorem 5.1: geometric decay of the velocity. -/
theorem thm_5_1 (C : Set H) (hC_closed : IsClosed C) (hC_conv : Convex ℝ C)
    (hC_polyhedron : ConvexPolyhedron C) (hC_bounded : Bornology.IsBounded C)
    (hC_int : (0 : H) ∈ interior C) (A0 : H → H) (hA0_C2 : ContDiff ℝ 2 A0)
    (hA0_mono : IsMaximalMonotone
      (SetValuedOperator.ofFunction Set.univ (fun x : (Set.univ : Set H) => A0 x.1)))
    (hA0_zero : A0 (0 : H) = 0)
    (m : ℝ) (hm : m > 0) (hA0_coercive : ∀ (x : H), inner ℝ (fderiv ℝ A0 (0 : H) x) x ≥ m * ‖x‖^2)
