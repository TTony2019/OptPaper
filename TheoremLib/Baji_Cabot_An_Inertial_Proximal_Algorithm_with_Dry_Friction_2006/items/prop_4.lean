import Mathlib
import Foundation.SetValued.Basic
import TheoremLib.Baji_Cabot_An_Inertial_Proximal_Algorithm_with_Dry_Friction_2006.items.def_1
import TheoremLib.Baji_Cabot_An_Inertial_Proximal_Algorithm_with_Dry_Friction_2006.items.def_2
import TheoremLib.Baji_Cabot_An_Inertial_Proximal_Algorithm_with_Dry_Friction_2006.items.def_3
import TheoremLib.Baji_Cabot_An_Inertial_Proximal_Algorithm_with_Dry_Friction_2006.items.thm_1
import TheoremLib.Baji_Cabot_An_Inertial_Proximal_Algorithm_with_Dry_Friction_2006.items.ext_def_3
import TheoremLib.Baji_Cabot_An_Inertial_Proximal_Algorithm_with_Dry_Friction_2006.items.ext_def_4

/-!
# Proposition 5.1
Let $A: H \Rightarrow H$ be a maximal monotone operator such that
$\operatorname{dom} A = H$ and $0 \in \operatorname{int}(A(0))$.
Assume that the set $A(0)$ is a convex polyhedron and that condition
$\lim_{x \to 0} e(A(x), \partial\sigma_{A(0)}(x)) = 0$ holds.
The operator $B$ is supposed to be equal to $\nabla f$ for a convex function
$f: H \to \mathbb{R}$ of class $\mathcal{C}^1$ satisfying $\inf f > -\infty$.
The positive sequence $(\lambda_n)$ is assumed to be nondecreasing.
Let $(x_n)$ be the sequence generated by the algorithm $(\mathcal{A})$ and let us set
$x_\infty = s-\lim_{n \to +\infty} x_n$. Then there exists $n_* \in \mathbb{N}$ such that:
$$\forall n \geqslant n_*, \quad x_{n+1} - x_n \in N_{A(0)}(-\nabla f(x_\infty)).$$
-/
open SetValuedOperator
open scoped Topology
open scoped Pointwise
open Set
open Filter
variable {H : Type _} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- Local copy of the subdifferential definition used by condition (22). -/
def subderivative (g : H → EReal) : SetValuedOperator H H :=
  fun x => {v | ∀ y, g y ≥ g x + (inner ℝ v (y - x) : EReal)}

/-- A convex polyhedron, encoded as a finite intersection of closed half-spaces. -/
def ConvexPolyhedron (C : Set H) : Prop :=
  ∃ (m : ℕ) (a : Fin m → H) (b : Fin m → ℝ), C = {x | ∀ i, inner ℝ (a i) x ≤ b i}

/-- Evaluate the singleton-valued gradient operator at a point. -/
private theorem prop51_gradient_operator_apply (B : SetValuedOperator H H) (f : H → ℝ)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x : (Set.univ : Set H) => gradient f x.1)) (z : H) :
    B z = {gradient f z} := by
  rw [hB_eq_grad]
  simp

/-- Membership in the singleton-valued gradient operator identifies the value. -/
private theorem prop51_gradient_operator_mem_eq (B : SetValuedOperator H H) (f : H → ℝ)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x : (Set.univ : Set H) => gradient f x.1)) {z b : H} (hb : b ∈ B z) :
    b = gradient f z := by
  rw [prop51_gradient_operator_apply B f hB_eq_grad z] at hb
  simpa using hb

omit [CompleteSpace H] in
/-- A normal cone is closed under multiplication by nonnegative scalars. -/
private theorem prop51_normalCone_smul_nonneg {C : Set H} {xbar u : H} {a : ℝ}
    (hu : u ∈ normalCone C xbar) (ha : 0 ≤ a) :
    a • u ∈ normalCone C xbar := by
  rw [mem_normalCone_iff_forall] at hu ⊢
  constructor
  · exact hu.1
  · intro y hy
    rw [inner_smul_right]
    exact mul_nonpos_of_nonneg_of_nonpos ha (hu.2 y hy)

omit [CompleteSpace H] in
/-- The support function of a nonempty set vanishes at the origin. -/
private theorem prop51_supportFunction_zero {C : Set H} (hCne : C.Nonempty) :
    supportFunction C (0 : H) = 0 := by
  unfold supportFunction
  have himage : ((fun z : H => (inner ℝ z (0 : H) : EReal)) '' C) = ({0} : Set EReal) := by
    ext t
    constructor
    · rintro ⟨z, hz, rfl⟩
      simp
    · intro ht
      rcases hCne with ⟨z, hz⟩
      rw [Set.mem_singleton_iff] at ht
      subst t
      exact ⟨z, hz, by simp⟩
  rw [himage]
  exact sSup_singleton

omit [CompleteSpace H] in
/-- A support-function subgradient gives an upper bound on the attained support value. -/
private theorem prop51_subderivative_support_upper {C : Set H} {v xi : H}
    (hCne : C.Nonempty) (hxi : xi ∈ subderivative (supportFunction C) v) :
    supportFunction C v ≤ (inner ℝ xi v : EReal) := by
  have h0 := hxi (0 : H)
  have h0' : supportFunction C v - (inner ℝ xi v : EReal) ≤ 0 := by
    simpa [prop51_supportFunction_zero hCne, sub_eq_add_neg] using h0
  exact EReal.sub_nonpos.mp h0'

omit [CompleteSpace H] in
/-- The support function is subadditive. -/
private theorem prop51_supportFunction_add_le (C : Set H) (u w : H) :
    supportFunction C (u + w) ≤ supportFunction C u + supportFunction C w := by
  unfold supportFunction
  refine sSup_le ?_
  rintro t ⟨z, hz, rfl⟩
  have hu : (inner ℝ z u : EReal) ≤
      sSup ((fun z : H => (inner ℝ z u : EReal)) '' C) := by
    exact le_sSup (⟨z, hz, rfl⟩)
  have hw : (inner ℝ z w : EReal) ≤
      sSup ((fun z : H => (inner ℝ z w : EReal)) '' C) := by
    exact le_sSup (⟨z, hz, rfl⟩)
  have h := add_le_add hu hw
  simpa [inner_add_right, EReal.coe_add] using h

omit [CompleteSpace H] in
/-- A defining halfspace gives the corresponding one-sided support-function bound. -/
private theorem prop51_supportFunction_smul_halfspace_le {C : Set H} {a : H} {b t : ℝ}
    (hC : ∀ z ∈ C, inner ℝ a z ≤ b) (ht : 0 ≤ t) :
    supportFunction C (t • a) ≤ (t * b : EReal) := by
  unfold supportFunction
  refine sSup_le ?_
  rintro r ⟨z, hz, rfl⟩
  have hzle : inner ℝ z a ≤ b := by
    simpa [real_inner_comm] using hC z hz
  have hmul : t * inner ℝ z a ≤ t * b := mul_le_mul_of_nonneg_left hzle ht
  have hinner : inner ℝ z (t • a) = t * inner ℝ z a := by
    simp [inner_smul_right]
  exact EReal.coe_le_coe_iff.mpr (by simpa [hinner] using hmul)

omit [CompleteSpace H] in
/-- A subgradient of the support function of a represented polyhedron lies in that polyhedron. -/
private theorem prop51_subderivative_supportFunction_mem_polyhedron {C : Set H}
    (hpoly : ConvexPolyhedron C) {v xi : H} (hCne : C.Nonempty)
    (hxi : xi ∈ subderivative (supportFunction C) v) :
    xi ∈ C := by
  rcases hCne with ⟨c0, hc0⟩
  have hCne' : C.Nonempty := ⟨c0, hc0⟩
  have hupper := prop51_subderivative_support_upper hCne' hxi
  have hlower : (inner ℝ c0 v : EReal) ≤ supportFunction C v := by
    unfold supportFunction
    exact le_sSup (⟨c0, hc0, rfl⟩)
  have hsup_ne_top : supportFunction C v ≠ ⊤ := by
    intro htop
    have htop_le : (⊤ : EReal) ≤ (inner ℝ xi v : EReal) := by
      rw [htop] at hupper
      exact hupper
    exact (not_le_of_gt (EReal.coe_lt_top (inner ℝ xi v))) htop_le
  have hsup_ne_bot : supportFunction C v ≠ ⊥ := by
    intro hbot
    have hcoe_le_bot : (inner ℝ c0 v : EReal) ≤ (⊥ : EReal) := by
      rw [hbot] at hlower
      exact hlower
    exact (not_le_of_gt (EReal.bot_lt_coe (inner ℝ c0 v))) hcoe_le_bot
  let s : ℝ := (supportFunction C v).toReal
  have hs : (s : EReal) = supportFunction C v := by
    simpa [s] using EReal.coe_toReal hsup_ne_top hsup_ne_bot
  rcases hpoly with ⟨m, a, b, hCeq⟩
  rw [hCeq]
  intro i
  have hhalf : ∀ z ∈ C, inner ℝ (a i) z ≤ b i := by
    intro z hz
    rw [hCeq] at hz
    exact hz i
  have hsub := hxi (v + (1 : ℝ) • a i)
  have hlow : supportFunction C v + (inner ℝ xi (a i) : EReal) ≤
      supportFunction C (v + (1 : ℝ) • a i) := by
    simpa using hsub
  have hadd := prop51_supportFunction_add_le C v ((1 : ℝ) • a i)
  have hsmul := prop51_supportFunction_smul_halfspace_le
    (C := C) (a := a i) (b := b i) (t := 1) hhalf (by norm_num)
  have hupper_y : supportFunction C (v + (1 : ℝ) • a i) ≤
      supportFunction C v + (b i : EReal) := by
    calc
      supportFunction C (v + (1 : ℝ) • a i)
          ≤ supportFunction C v + supportFunction C ((1 : ℝ) • a i) := hadd
      _ ≤ supportFunction C v + (b i : EReal) := by
          simpa [add_comm, add_left_comm, add_assoc] using
            add_le_add_left hsmul (supportFunction C v)
  have hcomb : supportFunction C v + (inner ℝ xi (a i) : EReal) ≤
      supportFunction C v + (b i : EReal) := le_trans hlow hupper_y
  have hcomb' : ((s + inner ℝ xi (a i) : ℝ) : EReal) ≤
      ((s + b i : ℝ) : EReal) := by
    simpa [hs, EReal.coe_add] using hcomb
  have hreal : s + inner ℝ xi (a i) ≤ s + b i :=
    EReal.coe_le_coe_iff.mp hcomb'
  have hgoal : inner ℝ (a i) xi ≤ b i := by
    simpa [real_inner_comm] using (by linarith : inner ℝ xi (a i) ≤ b i)
  exact hgoal

omit [CompleteSpace H] in
/-- If a support value is bounded above by evaluation at `xi`, then `v` is normal to `C`. -/
private theorem prop51_supportFunction_upper_mem_normalCone {C : Set H} {v xi : H}
    (hxiC : xi ∈ C) (hsup : supportFunction C v ≤ (inner ℝ xi v : EReal)) :
    v ∈ normalCone C xi := by
  rw [mem_normalCone_iff_forall]
  constructor
  · exact hxiC
  · intro y hy
    have hy_le_sup : (inner ℝ y v : EReal) ≤ supportFunction C v := by
      unfold supportFunction
      exact le_sSup (⟨y, hy, rfl⟩)
    have hy_le_xi_E : (inner ℝ y v : EReal) ≤ (inner ℝ xi v : EReal) :=
      le_trans hy_le_sup hsup
    have hy_le_xi : inner ℝ y v ≤ inner ℝ xi v := EReal.coe_le_coe_iff.mp hy_le_xi_E
    have hrewrite : inner ℝ v (y - xi) = inner ℝ y v - inner ℝ xi v := by
      rw [inner_sub_right]
      rw [real_inner_comm v y, real_inner_comm v xi]
    rw [real_inner_comm]
    rw [hrewrite]
    linarith

omit [CompleteSpace H] in
/-- Support-function subgradients of a represented polyhedron give normal-cone directions. -/
private theorem prop51_subderivative_supportFunction_mem_normalCone {C : Set H}
    (hpoly : ConvexPolyhedron C) {v xi : H} (hCne : C.Nonempty)
    (hxi : xi ∈ subderivative (supportFunction C) v) :
    v ∈ normalCone C xi := by
  have hxiC := prop51_subderivative_supportFunction_mem_polyhedron hpoly hCne hxi
  have hsup := prop51_subderivative_support_upper hCne hxi
  exact prop51_supportFunction_upper_mem_normalCone hxiC hsup

omit [CompleteSpace H] in
private theorem prop51_ereal_convex_of_convexOn (f : H → ℝ)
    (hf_conv : ConvexOn ℝ Set.univ f) :
    ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      ((f (a • x + b • y) : ℝ) : EReal) ≤
        (a : EReal) * (f x : EReal) + (b : EReal) * (f y : EReal) := by
  intro x y a b ha hb hab
  have hreal := hf_conv.2 (by simp : x ∈ (Set.univ : Set H))
    (by simp : y ∈ (Set.univ : Set H)) ha hb hab
  have hE : ((f (a • x + b • y) : ℝ) : EReal) ≤
      ((a * f x + b * f y : ℝ) : EReal) :=
    EReal.coe_le_coe_iff.mpr hreal
  simpa [EReal.coe_add, EReal.coe_mul] using hE

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem prop51_lowerSemicontinuous_real (f : H → ℝ) (hcont : Continuous f) :
    LowerSemicontinuous (fun x => (f x : EReal)) := by
  exact (continuous_coe_real_ereal.comp hcont).lowerSemicontinuous

private theorem prop51_convex_first_order_gradient (g : H → ℝ)
    (hg_conv : ConvexOn ℝ Set.univ g) (hg_C1 : ContDiff ℝ 1 g) :
    ∀ x y : H, g x + inner ℝ (gradient g x) (y - x) ≤ g y := by
  intro x y
  let z : H := y - x
  let φ : ℝ → ℝ := fun t => g (x + t • z)
  have hφ_conv : ConvexOn ℝ Set.univ φ := by
    constructor
    · exact convex_univ
    · intro s hs t ht a b ha hb hab
      have hmain := hg_conv.2 (by simp : x + s • z ∈ (Set.univ : Set H))
        (by simp : x + t • z ∈ (Set.univ : Set H)) ha hb hab
      have harg : a • (x + s • z) + b • (x + t • z) =
          x + (a * s + b * t) • z := by
        calc
          a • (x + s • z) + b • (x + t • z)
              = (a + b) • x + (a * s + b * t) • z := by
                  simp [smul_add, add_smul, mul_smul, add_left_comm, add_assoc]
          _ = x + (a * s + b * t) • z := by simp [hab]
      rw [harg] at hmain
      simpa [φ] using hmain
  have hg_diff : DifferentiableAt ℝ g x := (hg_C1.differentiable (by norm_num)) x
  have hline : HasDerivAt (fun t : ℝ => x + t • z) z 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const z).const_add x
  have hφ_deriv : HasDerivAt φ (inner ℝ (gradient g x) z) 0 := by
    have hg_diff0 : DifferentiableAt ℝ g (x + (0 : ℝ) • z) := by simpa using hg_diff
    have hcomp := hg_diff0.hasFDerivAt.comp_hasDerivAt 0 hline
    have hcomp' : HasDerivAt (fun t : ℝ => g (x + t • z)) ((fderiv ℝ g x) z) 0 := by
      simpa [Function.comp_def] using hcomp
    have hfg : (fderiv ℝ g x) z = inner ℝ (gradient g x) z := by
      simpa using (inner_gradient_left hg_diff (y := z)).symm
    simpa [φ, hfg] using hcomp'
  have hslope := ConvexOn.le_slope_of_hasDerivAt hφ_conv
    (by simp : (0 : ℝ) ∈ Set.univ) (by simp : (1 : ℝ) ∈ Set.univ)
    (by norm_num : (0 : ℝ) < 1) hφ_deriv
  have hφ0 : φ 0 = g x := by simp [φ]
  have hφ1 : φ 1 = g y := by simp [φ, z]
  have hslope_eq : slope φ 0 1 = g y - g x := by simp [slope, hφ0, hφ1]
  have : inner ℝ (gradient g x) z ≤ g y - g x := by
    simpa [hslope_eq] using hslope
  dsimp [z] at this
  linarith

private theorem prop51_gradient_subderivative_eq (f : H → ℝ)
    (hf_conv : ConvexOn ℝ Set.univ f) (hf_C1 : ContDiff ℝ 1 f) :
    ∀ x, {gradient f x} =
      {v | ∀ y, (f y : EReal) ≥ (f x : EReal) + (inner ℝ v (y - x) : EReal)} := by
  intro x
  have hfirst := prop51_convex_first_order_gradient f hf_conv hf_C1
  ext v
  constructor
  · intro hv
    rw [Set.mem_singleton_iff] at hv
    subst v
    intro y
    have hreal := hfirst x y
    have hE : ((f x + inner ℝ (gradient f x) (y - x) : ℝ) : EReal) ≤
        (f y : EReal) := EReal.coe_le_coe_iff.mpr hreal
    simpa [EReal.coe_add] using hE
  · intro hv
    rw [Set.mem_singleton_iff]
    apply ext_inner_right ℝ
    intro z
    have hsub_real : ∀ y, f x + inner ℝ v (y - x) ≤ f y := by
      intro y
      have h := hv y
      have hleft : (f x : EReal) + (inner ℝ v (y - x) : EReal) =
          ((f x + inner ℝ v (y - x) : ℝ) : EReal) := by
        simp [EReal.coe_add]
      have h' : ((f x + inner ℝ v (y - x) : ℝ) : EReal) ≤ (f y : EReal) := by
        rw [hleft] at h
        exact h
      exact EReal.coe_le_coe_iff.mp h'
    let ψ : ℝ → ℝ := fun t => f (x + t • z) - t * inner ℝ v z
    have hmin : IsLocalMin ψ 0 := by
      refine Filter.Eventually.of_forall ?_
      intro t
      have h := hsub_real (x + t • z)
      have hlin : inner ℝ v (x + t • z - x) = t * inner ℝ v z := by
        have : x + t • z - x = t • z := by abel
        rw [this, inner_smul_right]
      change f (x + (0 : ℝ) • z) - 0 * inner ℝ v z ≤
        f (x + t • z) - t * inner ℝ v z
      simp only [zero_smul, add_zero, zero_mul, sub_zero]
      linarith
    have hf_diff : DifferentiableAt ℝ f x := (hf_C1.differentiable (by norm_num)) x
    have hline : HasDerivAt (fun t : ℝ => x + t • z) z 0 := by
      simpa using ((hasDerivAt_id (0 : ℝ)).smul_const z).const_add x
    have hφ_deriv : HasDerivAt (fun t : ℝ => f (x + t • z))
        (inner ℝ (gradient f x) z) 0 := by
      have hf_diff0 : DifferentiableAt ℝ f (x + (0 : ℝ) • z) := by simpa using hf_diff
      have hcomp := hf_diff0.hasFDerivAt.comp_hasDerivAt 0 hline
      have hcomp' : HasDerivAt (fun t : ℝ => f (x + t • z)) ((fderiv ℝ f x) z) 0 := by
        simpa [Function.comp_def] using hcomp
      have hfg : (fderiv ℝ f x) z = inner ℝ (gradient f x) z := by
        simpa using (inner_gradient_left hf_diff (y := z)).symm
      simpa [hfg] using hcomp'
    have hlin_deriv : HasDerivAt (fun t : ℝ => t * inner ℝ v z) (inner ℝ v z) 0 := by
      simpa using (hasDerivAt_id (0 : ℝ)).mul_const (inner ℝ v z)
    have hψ_deriv : HasDerivAt ψ (inner ℝ (gradient f x) z - inner ℝ v z) 0 := by
      simpa [ψ] using hφ_deriv.sub hlin_deriv
    have hzero := hmin.hasDerivAt_eq_zero hψ_deriv
    linarith

private theorem prop51_B_eq_subderivative (B : SetValuedOperator H H) (f : H → ℝ)
    (hf_conv : ConvexOn ℝ Set.univ f) (hf_C1 : ContDiff ℝ 1 f)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x : (Set.univ : Set H) => gradient f x.1)) :
    ∀ x, B x = {v | ∀ y, (f y : EReal) ≥ (f x : EReal) +
      (inner ℝ v (y - x) : EReal)} := by
  intro x
  rw [prop51_gradient_operator_apply B f hB_eq_grad x,
    prop51_gradient_subderivative_eq f hf_conv hf_C1 x]

private theorem prop51_theorem31_assumptions (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ)
    (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (f : H → ℝ) (hf_conv : ConvexOn ℝ Set.univ f) (hf_C1 : ContDiff ℝ 1 f)
    (hinf : ∃ m : ℝ, ∀ x, f x ≥ m)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x : (Set.univ : Set H) => gradient f x.1))
    (lam : ℕ → ℝ) (hlam_pos : ∀ n, lam n > 0)
    (hlam_nondec : ∀ n, lam n ≤ lam (n+1))
    (x : ℕ → H) (halg : AlgorithmA A B x lam) :
    Theorem31Assumptions A B (fun z => (f z : EReal)) lam x := by
  refine
    { maxMonotoneA := hA
      domA := hdomA
      zero_mem_interior_A_zero := hAzero_int
      convex_f := prop51_ereal_convex_of_convexOn f hf_conv
      lowerSemicontinuous_f := prop51_lowerSemicontinuous_real f hf_C1.continuous
      B_eq_subderivative_f := prop51_B_eq_subderivative B f hf_conv hf_C1 hB_eq_grad
      dom_subderivative_nonempty := ?_
      f_bddBelow := ?_
      lam_pos := hlam_pos
      lam_nondec := hlam_nondec
      initial_point_mem_dom := ?_
      generated_by_algorithm := halg }
  · refine ⟨0, ?_⟩
    rw [SetValuedOperator.mem_dom_iff]
    rw [prop51_gradient_operator_apply B f hB_eq_grad (0 : H)]
    exact Set.singleton_nonempty _
  · rcases hinf with ⟨m, hm⟩
    refine ⟨m, ?_⟩
    intro y
    exact EReal.coe_le_coe_iff.mpr (hm y)
  · simp [ERealFunction.dom]

private theorem prop51_stationary_gradient_mem_A_zero (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ)
    (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (f : H → ℝ) (hf_conv : ConvexOn ℝ Set.univ f) (hf_C1 : ContDiff ℝ 1 f)
    (hinf : ∃ m : ℝ, ∀ x, f x ≥ m)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x : (Set.univ : Set H) => gradient f x.1))
    (lam : ℕ → ℝ) (hlam_pos : ∀ n, lam n > 0)
    (hlam_nondec : ∀ n, lam n ≤ lam (n+1))
    (x : ℕ → H) (halg : AlgorithmA A B x lam)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    -gradient f xInf ∈ A (0 : H) := by
  let fE : H → EReal := fun z => (f z : EReal)
  have h31 : Theorem31Assumptions A B fE lam x :=
    prop51_theorem31_assumptions A B hA hdomA hAzero_int f hf_conv hf_C1 hinf
      hB_eq_grad lam hlam_pos hlam_nondec x halg
  have hstat : (0 : H) ∈ A (0 : H) + B xInf :=
    thm_3_1_ii A B fE lam x h31 xInf hxInf
  rw [Set.mem_add] at hstat
  rcases hstat with ⟨a, ha, b, hb, hab⟩
  have hb_eq : b = gradient f xInf :=
    prop51_gradient_operator_mem_eq B f hB_eq_grad hb
  rw [hb_eq] at hab
  have ha_eq : a = -gradient f xInf := by
    exact eq_neg_of_add_eq_zero_left hab
  simpa [ha_eq] using ha

omit [CompleteSpace H] in
/-- Select the `A` and `B` components from one algorithmic inclusion step. -/
private theorem prop51_algorithm_step_selection (A B : SetValuedOperator H H)
    (lam : ℕ → ℝ) (x : ℕ → H) (halg : AlgorithmA A B x lam) :
    ∀ n, ∃ a b : H,
      a ∈ A ((lam n)⁻¹ • (x (n + 2) - x (n + 1))) ∧
      b ∈ B (x (n + 2)) ∧
      ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n) + a + b = 0 := by
  intro n
  let v : H := (lam n)⁻¹ • (x (n + 2) - x (n + 1))
  let acc : H := ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)
  have hstep : (0 : H) ∈ ({acc} : Set H) + A v + B (x (n + 2)) := by
    simpa [AlgorithmA, acc, v] using halg.step n
  rw [Set.mem_add] at hstep
  rcases hstep with ⟨p, hp, b, hb, hpbeq⟩
  rw [Set.mem_add] at hp
  rcases hp with ⟨c, hc, a, ha, hp_eq⟩
  rw [Set.mem_singleton_iff] at hc
  subst c
  refine ⟨a, b, ?_, hb, ?_⟩
  · simpa [v]
  · have hp_eq' : acc + a = p := by simp [hp_eq]
    rw [← hpbeq, ← hp_eq']

omit [CompleteSpace H] in
/-- Monotonicity bounds a graph point at `0` by the graph point at `v`. -/
private theorem prop51_monotone_bound (A : SetValuedOperator H H) (hmono : IsMonotone A)
    {v a y : H} (ha : a ∈ A v) (hy : y ∈ A (0 : H)) :
    inner ℝ y v ≤ inner ℝ a v := by
  have h := hmono a ha y hy
  rw [sub_zero, inner_sub_left] at h
  linarith

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- If `x n` converges, then the first difference tends to zero. -/
private theorem prop51_tendsto_shift_sub_self_zero (x : ℕ → H) (xInf : H)
    (hxInf : Tendsto x atTop (𝓝 xInf)) :
    Tendsto (fun n : ℕ => x (n + 1) - x n) atTop (𝓝 (0 : H)) := by
  have hshift : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
  have hxshift : Tendsto (fun n : ℕ => x (n + 1)) atTop (𝓝 xInf) := hxInf.comp hshift
  simpa using hxshift.sub hxInf

/-- A nondecreasing positive step sequence is bounded below by its first value. -/
private theorem prop51_lam_zero_le_lam (lam : ℕ → ℝ)
    (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) : ∀ n, lam 0 ≤ lam n := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih => exact le_trans ih (hlam_nondec n)

/-- Uniform bound for inverse step sizes. -/
private theorem prop51_inv_lam_bound (lam : ℕ → ℝ)
    (hlam_pos : ∀ n, 0 < lam n) (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) :
    ∀ n, ‖(lam n)⁻¹‖ ≤ (lam 0)⁻¹ := by
  intro n
  rw [Real.norm_eq_abs]
  rw [abs_of_pos (inv_pos.mpr (hlam_pos n))]
  exact inv_anti₀ (hlam_pos 0) (prop51_lam_zero_le_lam lam hlam_nondec n)

/-- Uniform bound for inverse squared step sizes. -/
private theorem prop51_inv_lam_sq_bound (lam : ℕ → ℝ)
    (hlam_pos : ∀ n, 0 < lam n) (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) :
    ∀ n, ‖((lam n)^2)⁻¹‖ ≤ ((lam 0)^2)⁻¹ := by
  intro n
  rw [Real.norm_eq_abs]
  have hsqpos0 : 0 < (lam 0)^2 := sq_pos_of_ne_zero (ne_of_gt (hlam_pos 0))
  have hsqposn : 0 < (lam n)^2 := sq_pos_of_ne_zero (ne_of_gt (hlam_pos n))
  rw [abs_of_pos (inv_pos.mpr hsqposn)]
  apply inv_anti₀ hsqpos0
  exact sq_le_sq.mpr (by
    simpa [abs_of_pos (hlam_pos 0), abs_of_pos (hlam_pos n)] using
      prop51_lam_zero_le_lam lam hlam_nondec n)

omit [CompleteSpace H] in
/-- A bounded scalar multiple of a sequence tending to zero also tends to zero. -/
private theorem prop51_tendsto_smul_zero_of_norm_bounded {c : ℕ → ℝ} {z : ℕ → H}
    {C : ℝ} (hC : ∀ n, ‖c n‖ ≤ C) (hz : Tendsto z atTop (𝓝 (0 : H))) :
    Tendsto (fun n => c n • z n) atTop (𝓝 (0 : H)) := by
  rw [tendsto_zero_iff_norm_tendsto_zero] at hz ⊢
  have hbound : ∀ n, ‖c n • z n‖ ≤ C * ‖z n‖ := by
    intro n
    rw [norm_smul]
    exact mul_le_mul_of_nonneg_right (hC n) (norm_nonneg _)
  have hprod : Tendsto (fun n => C * ‖z n‖) atTop (𝓝 (0 : ℝ)) := by
    simpa using (tendsto_const_nhds.mul hz)
  exact squeeze_zero (fun n => norm_nonneg _) hbound hprod

omit [CompleteSpace H] in
/-- The scaled velocity in Algorithm (A) tends to zero. -/
private theorem prop51_scaled_velocity_tendsto_zero (lam : ℕ → ℝ) (x : ℕ → H)
    (xInf : H) (hlam_pos : ∀ n, 0 < lam n)
    (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    Tendsto (fun n : ℕ => (lam n)⁻¹ • (x (n + 2) - x (n + 1))) atTop
      (𝓝 (0 : H)) := by
  have hshift : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
  have hxshift : Tendsto (fun n : ℕ => x (n + 1)) atTop (𝓝 xInf) := hxInf.comp hshift
  have hz : Tendsto (fun n : ℕ => x (n + 2) - x (n + 1)) atTop (𝓝 (0 : H)) := by
    simpa [Nat.add_assoc] using
      prop51_tendsto_shift_sub_self_zero (fun n => x (n + 1)) xInf hxshift
  exact prop51_tendsto_smul_zero_of_norm_bounded
    (prop51_inv_lam_bound lam hlam_pos hlam_nondec) hz

omit [CompleteSpace H] in
/-- The scaled acceleration in Algorithm (A) tends to zero. -/
private theorem prop51_acceleration_tendsto_zero (lam : ℕ → ℝ) (x : ℕ → H)
    (xInf : H) (hlam_pos : ∀ n, 0 < lam n)
    (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    Tendsto (fun n : ℕ =>
      ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)) atTop (𝓝 (0 : H)) := by
  have hshift : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
  have hxshift : Tendsto (fun n : ℕ => x (n + 1)) atTop (𝓝 xInf) := hxInf.comp hshift
  have hdiff0 : Tendsto (fun n : ℕ => x (n + 1) - x n) atTop (𝓝 (0 : H)) :=
    prop51_tendsto_shift_sub_self_zero x xInf hxInf
  have hdiff1 : Tendsto (fun n : ℕ => x (n + 2) - x (n + 1)) atTop
      (𝓝 (0 : H)) := by
    simpa [Nat.add_assoc] using
      prop51_tendsto_shift_sub_self_zero (fun n => x (n + 1)) xInf hxshift
  have hnum : Tendsto (fun n : ℕ => x (n + 2) - 2 • x (n + 1) + x n) atTop
      (𝓝 (0 : H)) := by
    have hsub : Tendsto
        (fun n : ℕ => (x (n + 2) - x (n + 1)) - (x (n + 1) - x n)) atTop
        (𝓝 (0 : H)) := by
      simpa using hdiff1.sub hdiff0
    convert hsub using 1
    · ext n
      abel
  exact prop51_tendsto_smul_zero_of_norm_bounded
    (prop51_inv_lam_sq_bound lam hlam_pos hlam_nondec) hnum

/-- The shifted gradients converge to the gradient at the limit point. -/
private theorem prop51_gradient_shift_tendsto (f : H → ℝ) (x : ℕ → H)
    (xInf : H) (hf_C1 : ContDiff ℝ 1 f) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    Tendsto (fun n : ℕ => gradient f (x (n + 2))) atTop (𝓝 (gradient f xInf)) := by
  have hshift : Tendsto (fun n : ℕ => n + 2) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_add_right n 2) tendsto_id
  have hxshift : Tendsto (fun n : ℕ => x (n + 2)) atTop (𝓝 xInf) := hxInf.comp hshift
  have hcont_grad : Continuous (fun y : H => gradient f y) := by
    change Continuous (fun y : H => (InnerProductSpace.toDual ℝ H).symm (fderiv ℝ f y))
    exact (InnerProductSpace.toDual ℝ H).symm.continuous.comp
      (hf_C1.continuous_fderiv (by norm_num))
  exact (hcont_grad.tendsto xInf).comp hxshift

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- A point can be selected within `infDist + ε` of a nonempty set. -/
private theorem prop51_exists_mem_dist_le_infDist_add {C : Set H} {z : H} {r ε : ℝ}
    (hC : C.Nonempty) (hε : 0 < ε) (h : Metric.infDist z C ≤ r) :
    ∃ ξ ∈ C, dist z ξ ≤ r + ε := by
  have hlt : Metric.infDist z C < r + ε := lt_of_le_of_lt h (lt_add_of_pos_right r hε)
  rcases (Metric.infDist_lt_iff hC).mp hlt with ⟨ξ, hξ, hξdist⟩
  exact ⟨ξ, hξ, le_of_lt hξdist⟩

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- Pointwise control by the excess when the defining supremum is bounded above. -/
private theorem prop51_excess_point_le_of_bdd {A B : Set H} {a : H} {c : ℝ}
    (hbdd : BddAbove (Set.range (fun x : A => Metric.infDist (x : H) B)))
    (ha : a ∈ A) (h : setExcess A B ≤ c) : Metric.infDist a B ≤ c := by
  let F : A → ℝ := fun x => Metric.infDist (x : H) B
  have hexcess_eq : setExcess A B = ⨆ x : A, F x := by
    simpa [F] using setExcess_eq_iSup_infDist A B
  have hsup_le : (⨆ x : A, F x) ≤ c := by
    simpa [hexcess_eq] using h
  have hpoint : F ⟨a, ha⟩ ≤ ⨆ x : A, F x := le_ciSup hbdd ⟨a, ha⟩
  exact le_trans hpoint hsup_le

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- Bounded sets have bounded point-to-set distances to a fixed nonempty set. -/
private theorem prop51_bddAbove_infDist_of_isBounded {A B : Set H}
    (hA_bdd : Bornology.IsBounded A) (hB : B.Nonempty) :
    BddAbove (Set.range (fun x : A => Metric.infDist (x : H) B)) := by
  rcases hB with ⟨b0, hb0⟩
  rcases (isBounded_iff_forall_norm_le (s := A)).mp hA_bdd with ⟨C, hC⟩
  refine ⟨C + ‖b0‖, ?_⟩
  intro r hr
  rcases hr with ⟨x, rfl⟩
  calc
    Metric.infDist (x : H) B ≤ dist (x : H) b0 := Metric.infDist_le_dist_of_mem hb0
    _ = ‖(x : H) - b0‖ := dist_eq_norm _ _
    _ ≤ ‖(x : H)‖ + ‖b0‖ := norm_sub_le _ _
    _ ≤ C + ‖b0‖ := by nlinarith [hC (x : H) x.2]

/-- Local Fitzpatrick-type bound used to prove local boundedness of full-domain operators. -/
private noncomputable def prop51_fitzLocal (A : SetValuedOperator H H) (x : H) :
    EReal :=
  ⨆ p : {p : H × H // p.2 ∈ A p.1},
    (((inner ℝ (x - p.val.1) p.val.2) / (1 + ‖p.val.1‖) : ℝ) : EReal)

omit [CompleteSpace H] in
/-- Each graph point contributes a lower bound to the local Fitzpatrick functional. -/
private theorem prop51_fitzLocal_ge (A : SetValuedOperator H H)
    {x y v : H} (hv : v ∈ A y) :
    (((inner ℝ (x - y) v) / (1 + ‖y‖) : ℝ) : EReal) ≤
      prop51_fitzLocal A x := by
  dsimp [prop51_fitzLocal]
  exact le_iSup_of_le (⟨(y, v), hv⟩ : {p : H × H // p.2 ∈ A p.1}) le_rfl

omit [CompleteSpace H] in
/-- The local Fitzpatrick functional is lower semicontinuous. -/
private theorem prop51_fitzLocal_lsc (A : SetValuedOperator H H) :
    LowerSemicontinuous (prop51_fitzLocal A) := by
  unfold prop51_fitzLocal
  refine lowerSemicontinuous_iSup ?_
  intro p
  have hreal : Continuous (fun x : H =>
      (inner ℝ (x - p.val.1) p.val.2) / (1 + ‖p.val.1‖)) := by
    exact ((continuous_id.sub continuous_const).inner continuous_const).div_const _
  exact (continuous_coe_real_ereal.comp hreal).lowerSemicontinuous

omit [CompleteSpace H] in
/-- Closed sublevel sets of the local Fitzpatrick functional. -/
private theorem prop51_fitzLocal_closed_sublevel
    (A : SetValuedOperator H H) (N : ℕ) :
    IsClosed {x : H | prop51_fitzLocal A x ≤ ((N : ℝ) : EReal)} := by
  have hlsc := prop51_fitzLocal_lsc A
  rw [lowerSemicontinuous_iff_isClosed_preimage] at hlsc
  simpa [Set.preimage, Set.Iic] using hlsc ((N : ℝ) : EReal)

omit [CompleteSpace H] in
/-- Convexity of the local Fitzpatrick functional. -/
private theorem prop51_fitzLocal_convex (A : SetValuedOperator H H) :
    ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      prop51_fitzLocal A (a • x + b • y) ≤
        (a : EReal) * prop51_fitzLocal A x +
          (b : EReal) * prop51_fitzLocal A y := by
  intro x y a b ha hb hab
  dsimp [prop51_fitzLocal]
  refine iSup_le ?_
  intro p
  let z : H := p.val.1
  let v : H := p.val.2
  let den : ℝ := 1 + ‖z‖
  have hden_pos : 0 < den := by
    dsimp [den]
    positivity
  have hsub : a • x + b • y - z = a • (x - z) + b • (y - z) := by
    calc
      a • x + b • y - z = a • x + b • y - (a + b) • z := by rw [hab, one_smul]
      _ = a • x + b • y - (a • z + b • z) := by rw [add_smul]
      _ = a • (x - z) + b • (y - z) := by
        simp [smul_sub]
        abel
  have hreal :
      inner ℝ (a • x + b • y - z) v / den =
        a * (inner ℝ (x - z) v / den) + b * (inner ℝ (y - z) v / den) := by
    rw [hsub, inner_add_left, real_inner_smul_left, real_inner_smul_left]
    field_simp [ne_of_gt hden_pos]
  calc
    (((inner ℝ (a • x + b • y - z) v) / den : ℝ) : EReal)
        = ((a * (inner ℝ (x - z) v / den) +
            b * (inner ℝ (y - z) v / den) : ℝ) : EReal) := by
          rw [hreal]
    _ = (a : EReal) * (((inner ℝ (x - z) v) / den : ℝ) : EReal) +
          (b : EReal) * (((inner ℝ (y - z) v) / den : ℝ) : EReal) := by
          simp [EReal.coe_add, EReal.coe_mul]
    _ ≤ (a : EReal) *
          (⨆ p : {p : H × H // p.2 ∈ A p.1},
            (((inner ℝ (x - p.val.1) p.val.2) / (1 + ‖p.val.1‖) : ℝ) : EReal)) +
          (b : EReal) *
          (⨆ p : {p : H × H // p.2 ∈ A p.1},
            (((inner ℝ (y - p.val.1) p.val.2) / (1 + ‖p.val.1‖) : ℝ) : EReal)) := by
          gcongr
          · exact le_iSup_of_le p le_rfl
          · exact le_iSup_of_le p le_rfl

omit [CompleteSpace H] in
/-- Full domain monotonicity makes the local Fitzpatrick functional finite above. -/
private theorem prop51_fitzLocal_finite_above
    (A : SetValuedOperator H H) (hAmono : IsMonotone A) (hdomA : A.dom = Set.univ) :
    ∀ x : H, ∃ N : ℕ, prop51_fitzLocal A x ≤ ((N : ℝ) : EReal) := by
  intro x
  have hxdom : x ∈ A.dom := by
    rw [hdomA]
    simp
  rcases (SetValuedOperator.mem_dom_iff A x).mp hxdom with ⟨u, hu⟩
  rcases exists_nat_ge (‖u‖ * (‖x‖ + 1)) with ⟨N, hN⟩
  refine ⟨N, ?_⟩
  dsimp [prop51_fitzLocal]
  refine iSup_le ?_
  intro p
  let y : H := p.val.1
  let v : H := p.val.2
  let den : ℝ := 1 + ‖y‖
  have hv : v ∈ A y := p.2
  have hden_pos : 0 < den := by
    dsimp [den]
    positivity
  have hmono := hAmono u hu v hv
  have hinner_le : inner ℝ (x - y) v ≤ inner ℝ (x - y) u := by
    rw [inner_sub_left] at hmono
    have h' : inner ℝ v (x - y) ≤ inner ℝ u (x - y) := sub_nonneg.mp hmono
    simpa [real_inner_comm] using h'
  have hnum_le : inner ℝ (x - y) v ≤ ‖u‖ * (‖x‖ + ‖y‖) := by
    calc
      inner ℝ (x - y) v ≤ inner ℝ (x - y) u := hinner_le
      _ ≤ |inner ℝ (x - y) u| := le_abs_self _
      _ ≤ ‖x - y‖ * ‖u‖ := abs_real_inner_le_norm _ _
      _ ≤ (‖x‖ + ‖y‖) * ‖u‖ := by
        gcongr
        exact norm_sub_le x y
      _ = ‖u‖ * (‖x‖ + ‖y‖) := by ring
  have hfrac_le :
      inner ℝ (x - y) v / den ≤ ‖u‖ * (‖x‖ + 1) := by
    calc
      inner ℝ (x - y) v / den ≤ (‖u‖ * (‖x‖ + ‖y‖)) / den := by
        gcongr
      _ ≤ ‖u‖ * (‖x‖ + 1) := by
        rw [div_le_iff₀ hden_pos]
        have hmiddle : ‖x‖ + ‖y‖ ≤ (‖x‖ + 1) * (1 + ‖y‖) := by
          nlinarith [mul_nonneg (norm_nonneg x) (norm_nonneg y)]
        calc
          ‖u‖ * (‖x‖ + ‖y‖)
              ≤ ‖u‖ * ((‖x‖ + 1) * (1 + ‖y‖)) :=
                mul_le_mul_of_nonneg_left hmiddle (norm_nonneg u)
          _ = ‖u‖ * (‖x‖ + 1) * den := by
            dsimp [den]
            ring
  exact EReal.coe_le_coe (le_trans hfrac_le hN)

/-- A finite-valued convex lower-semicontinuous `EReal` function is locally bounded above. -/
private theorem prop51_ereal_convex_finite_locally_bddAbove
    (f : H → EReal)
    (hclosed : ∀ N : ℕ, IsClosed {x : H | f x ≤ ((N : ℝ) : EReal)})
    (hfinite : ∀ x : H, ∃ N : ℕ, f x ≤ ((N : ℝ) : EReal))
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (z : H) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ M : ℝ, ∀ x ∈ Metric.ball z δ, f x ≤ (M : EReal) := by
  classical
  let C : ℕ → Set H := fun N => {x : H | f x ≤ ((N : ℝ) : EReal)}
  have hcover : (⋃ N : ℕ, C N) = Set.univ := by
    ext x
    constructor
    · intro _
      simp
    · intro _
      rcases hfinite x with ⟨N, hN⟩
      exact Set.mem_iUnion.2 ⟨N, hN⟩
  rcases nonempty_interior_of_iUnion_of_closed (fun N => by simpa [C] using hclosed N)
      hcover with ⟨N, hNint⟩
  rcases hNint with ⟨c, hc⟩
  have hnhds : C N ∈ 𝓝 c := mem_interior_iff_mem_nhds.mp hc
  rcases Metric.mem_nhds_iff.mp hnhds with ⟨ε, hε, hε_subset⟩
  let p : H := (2 : ℝ) • z - c
  rcases hfinite p with ⟨K, hK⟩
  refine ⟨ε / 4, by positivity, ((1 / 2 : ℝ) * (N : ℝ) + (1 / 2 : ℝ) * (K : ℝ)), ?_⟩
  intro x hx
  let q : H := (2 : ℝ) • x - p
  have hq_ball : q ∈ Metric.ball c ε := by
    have hq_sub : q - c = (2 : ℝ) • (x - z) := by
      dsimp [q, p]
      module
    have hx_norm : ‖x - z‖ < ε / 4 := by
      simpa [Metric.mem_ball, dist_eq_norm] using hx
    rw [Metric.mem_ball, dist_eq_norm, hq_sub, norm_smul]
    rw [show ‖(2 : ℝ)‖ = (2 : ℝ) from by norm_num]
    nlinarith [norm_nonneg (x - z)]
  have hqC : f q ≤ ((N : ℝ) : EReal) := hε_subset hq_ball
  have hx_combo : x = (1 / 2 : ℝ) • q + (1 / 2 : ℝ) • p := by
    dsimp [q]
    module
  have hfx := hconv q p (1 / 2) (1 / 2)
    (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (0 : ℝ) ≤ 1 / 2)
    (by norm_num : (1 / 2 : ℝ) + 1 / 2 = 1)
  rw [← hx_combo] at hfx
  calc
    f x ≤ (1 / 2 : EReal) * f q + (1 / 2 : EReal) * f p := hfx
    _ ≤ (1 / 2 : EReal) * ((N : ℝ) : EReal) +
          (1 / 2 : EReal) * ((K : ℝ) : EReal) := by
        gcongr
    _ = (((1 / 2 : ℝ) * (N : ℝ) + (1 / 2 : ℝ) * (K : ℝ) : ℝ) : EReal) := by
        have hhalf : ((1 / 2 : EReal) = ((1 / 2 : ℝ) : EReal)) := by
          change (((1 : ℝ) : EReal) / ((2 : ℝ) : EReal)) = ((1 / 2 : ℝ) : EReal)
          rw [← EReal.coe_div]
        rw [hhalf, ← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add]

/-- Full-domain maximal monotone operators are locally bounded. -/
private theorem prop51_full_domain_local_bounded
    (A : SetValuedOperator H H) (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ)
    (x0 : H) :
    ∃ δ : ℝ, 0 < δ ∧ Bornology.IsBounded (A.image (Metric.ball x0 δ)) := by
  let f : H → EReal := prop51_fitzLocal A
  rcases prop51_ereal_convex_finite_locally_bddAbove f
      (by intro N; simpa [f] using prop51_fitzLocal_closed_sublevel A N)
      (by intro x; simpa [f] using prop51_fitzLocal_finite_above A hA.1 hdomA x)
      (by
        intro x y a b ha hb hab
        simpa [f] using prop51_fitzLocal_convex A x y a b ha hb hab)
      x0 with ⟨ρ, hρ, M, hM⟩
  let Mpos : ℝ := max M 0 + 1
  have hMpos_pos : 0 < Mpos := by
    dsimp [Mpos]
    linarith [le_max_right M 0]
  have hMpos_nonneg : 0 ≤ Mpos := le_of_lt hMpos_pos
  have hM_le_Mpos : M ≤ Mpos := by
    dsimp [Mpos]
    linarith [le_max_left M 0]
  refine ⟨ρ / 4, by positivity, ?_⟩
  rw [isBounded_iff_forall_norm_le]
  refine ⟨(4 / ρ) * Mpos * (1 + ‖x0‖ + ρ / 4), ?_⟩
  intro w hw
  rcases (SetValuedOperator.mem_image A (Metric.ball x0 (ρ / 4)) w).mp hw with
    ⟨z, hzball, hwA⟩
  by_cases hw0 : w = 0
  · subst w
    have hC_nonneg : 0 ≤ (4 / ρ) * Mpos * (1 + ‖x0‖ + ρ / 4) := by
      positivity
    simpa using hC_nonneg
  · let e : H := ‖w‖⁻¹ • w
    let xeval : H := x0 + (ρ / 2) • e
    have hw_norm_pos : 0 < ‖w‖ := norm_pos_iff.mpr hw0
    have hw_norm_ne : ‖w‖ ≠ 0 := ne_of_gt hw_norm_pos
    have he_norm : ‖e‖ = 1 := by
      dsimp [e]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hw_norm_pos)]
      exact inv_mul_cancel₀ hw_norm_ne
    have hew : inner ℝ e w = ‖w‖ := by
      dsimp [e]
      rw [real_inner_smul_left, real_inner_self_eq_norm_sq]
      field_simp [hw_norm_ne]
    have hxeval_ball : xeval ∈ Metric.ball x0 ρ := by
      have hdist : dist xeval x0 = ρ / 2 := by
        rw [dist_eq_norm]
        have hsub : xeval - x0 = (ρ / 2) • e := by
          dsimp [xeval]
          abel
        rw [hsub, norm_smul, he_norm, mul_one]
        rw [Real.norm_eq_abs, abs_of_pos (by positivity : 0 < ρ / 2)]
      rw [Metric.mem_ball, hdist]
      linarith
    have hlocalM : prop51_fitzLocal A xeval ≤ (Mpos : EReal) := by
      exact le_trans (by simpa [f] using hM xeval hxeval_ball)
        (EReal.coe_le_coe hM_le_Mpos)
    have hfitz_ge :
        (((inner ℝ (xeval - z) w) / (1 + ‖z‖) : ℝ) : EReal) ≤
          prop51_fitzLocal A xeval :=
      prop51_fitzLocal_ge A hwA
    have htermE :
        (((inner ℝ (xeval - z) w) / (1 + ‖z‖) : ℝ) : EReal) ≤
          (Mpos : EReal) := le_trans hfitz_ge hlocalM
    have hterm_real :
        inner ℝ (xeval - z) w / (1 + ‖z‖) ≤ Mpos :=
      EReal.coe_le_coe_iff.mp htermE
    have hinner_le : inner ℝ (xeval - z) w ≤ Mpos * (1 + ‖z‖) := by
      rwa [div_le_iff₀ (by positivity)] at hterm_real
    have hxeval_sub : xeval - z = (x0 - z) + (ρ / 2) • e := by
      dsimp [xeval]
      abel
    have hinner_eq :
        inner ℝ (xeval - z) w =
          inner ℝ (x0 - z) w + (ρ / 2) * ‖w‖ := by
      rw [hxeval_sub, inner_add_left, real_inner_smul_left, hew]
    have hz_norm_lt : ‖z - x0‖ < ρ / 4 := by
      simpa [Metric.mem_ball, dist_eq_norm] using hzball
    have hxz_norm_lt : ‖x0 - z‖ < ρ / 4 := by
      simpa [norm_sub_rev] using hz_norm_lt
    have hinner_lower :
        -((ρ / 4) * ‖w‖) ≤ inner ℝ (x0 - z) w := by
      have habs := abs_real_inner_le_norm (x0 - z) w
      have hneg_abs : -|inner ℝ (x0 - z) w| ≤ inner ℝ (x0 - z) w :=
        neg_abs_le _
      have hneg_norm : -(‖x0 - z‖ * ‖w‖) ≤ -|inner ℝ (x0 - z) w| :=
        neg_le_neg habs
      have hnormprod : ‖x0 - z‖ * ‖w‖ ≤ (ρ / 4) * ‖w‖ :=
        mul_le_mul_of_nonneg_right (le_of_lt hxz_norm_lt) (norm_nonneg w)
      nlinarith
    have hmain :
        (ρ / 4) * ‖w‖ ≤ Mpos * (1 + ‖z‖) := by
      rw [hinner_eq] at hinner_le
      nlinarith
    have hz_norm_le : ‖z‖ ≤ ‖x0‖ + ρ / 4 := by
      calc
        ‖z‖ ≤ ‖x0‖ + ‖x0 - z‖ := norm_le_norm_add_norm_sub x0 z
        _ ≤ ‖x0‖ + ρ / 4 := by linarith [le_of_lt hxz_norm_lt]
    have hmain' :
        (ρ / 4) * ‖w‖ ≤ Mpos * (1 + ‖x0‖ + ρ / 4) := by
      have hright : Mpos * (1 + ‖z‖) ≤ Mpos * (1 + ‖x0‖ + ρ / 4) := by
        have harg : 1 + ‖z‖ ≤ 1 + ‖x0‖ + ρ / 4 := by
          linarith [hz_norm_le]
        exact mul_le_mul_of_nonneg_left harg hMpos_nonneg
      exact le_trans hmain hright
    have hρ4_pos : 0 < ρ / 4 := by positivity
    have hdiv : ‖w‖ ≤ (Mpos * (1 + ‖x0‖ + ρ / 4)) / (ρ / 4) := by
      rw [le_div_iff₀ hρ4_pos]
      nlinarith
    have hconst :
        (Mpos * (1 + ‖x0‖ + ρ / 4)) / (ρ / 4) =
          (4 / ρ) * Mpos * (1 + ‖x0‖ + ρ / 4) := by
      field_simp [ne_of_gt hρ]
    simpa [hconst] using hdiv

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
/-- Local boundedness supplies bounded point-to-set distances along one operator value. -/
private theorem prop51_bddAbove_infDist_of_local_bounded
    (A : SetValuedOperator H H) {v : H} {δ : ℝ} {B : Set H}
    (hAbdd : Bornology.IsBounded (A.image (Metric.ball (0 : H) δ)))
    (hv : v ∈ Metric.ball (0 : H) δ) (hB : B.Nonempty) :
    BddAbove (Set.range (fun x : A v => Metric.infDist (x : H) B)) := by
  have hAv_bdd : Bornology.IsBounded (A v) := by
    exact hAbdd.subset (by
      intro y hy
      exact (SetValuedOperator.mem_image A (Metric.ball (0 : H) δ) y).mpr
        ⟨v, hv, hy⟩)
  exact prop51_bddAbove_infDist_of_isBounded hAv_bdd hB

omit [CompleteSpace H] in
/-- Every point of a set lies below its support function. -/
private theorem prop51_inner_le_supportFunction {C : Set H} {xi y : H} (hxi : xi ∈ C) :
    (inner ℝ xi y : EReal) ≤ supportFunction C y := by
  unfold supportFunction
  exact le_sSup (⟨xi, hxi, rfl⟩)

omit [CompleteSpace H] in
/-- A point that maximizes a linear functional realizes the support value. -/
private theorem prop51_supportFunction_eq_of_maximizer {C : Set H} {xi v : H}
    (hxiC : xi ∈ C) (hmax : ∀ y ∈ C, inner ℝ y v ≤ inner ℝ xi v) :
    supportFunction C v = (inner ℝ xi v : EReal) := by
  apply le_antisymm
  · unfold supportFunction
    refine sSup_le ?_
    rintro _ ⟨y, hy, rfl⟩
    exact EReal.coe_le_coe_iff.mpr (hmax y hy)
  · exact prop51_inner_le_supportFunction hxiC

omit [CompleteSpace H] in
/-- A support-function maximizer is a subgradient. -/
private theorem prop51_support_attainer_mem_subderivative {C : Set H} {xi v : H}
    (hxiC : xi ∈ C) (hmax : supportFunction C v = (inner ℝ xi v : EReal)) :
    xi ∈ subderivative (supportFunction C) v := by
  intro y
  have hy : (inner ℝ xi y : EReal) ≤ supportFunction C y :=
    prop51_inner_le_supportFunction hxiC
  have hlin : inner ℝ xi y = inner ℝ xi v + inner ℝ xi (y - v) := by
    rw [inner_sub_right]
    abel
  have hE : (inner ℝ xi y : EReal) =
      (inner ℝ xi v : EReal) + (inner ℝ xi (y - v) : EReal) := by
    rw [hlin, EReal.coe_add]
  calc
    supportFunction C v + (inner ℝ xi (y - v) : EReal)
        = (inner ℝ xi y : EReal) := by rw [hmax, hE]
    _ ≤ supportFunction C y := hy

omit [CompleteSpace H] in
/-- A bounded objective on a finite halfspace polyhedron lies in the span of the normals. -/
private theorem prop51_objective_mem_span_normals_of_bddAbove
    {C : Set H} {m : ℕ} {a : Fin m → H} {b : Fin m → ℝ}
    (hCeq : C = {x | ∀ i : Fin m, inner ℝ (a i) x ≤ b i})
    (hCne : C.Nonempty) {v : H}
    (hbound : ∃ M : ℝ, ∀ y ∈ C, inner ℝ y v ≤ M) :
    v ∈ Submodule.span ℝ (Set.range a) := by
  classical
  let V : Submodule ℝ H := Submodule.span ℝ (Set.range a)
  haveI : FiniteDimensional ℝ V := FiniteDimensional.span_of_finite ℝ (Set.finite_range a)
  by_contra hv
  let r : H := v - V.starProjection v
  have hr_orth : r ∈ Vᗮ := by
    dsimp [r]
    rw [← Submodule.starProjection_orthogonal_val (K := V) v]
    exact Submodule.starProjection_apply_mem Vᗮ v
  have hr_ne : r ≠ 0 := by
    intro hr0
    have hvproj : V.starProjection v = v := by
      dsimp [r] at hr0
      exact (sub_eq_zero.mp hr0).symm
    have hv_mem : v ∈ V := by
      rw [← hvproj]
      exact Submodule.starProjection_apply_mem V v
    exact hv hv_mem
  have hr_norm_pos : 0 < ‖r‖ := norm_pos_iff.mpr hr_ne
  have hrv_pos : 0 < inner ℝ r v := by
    have hproj_mem : V.starProjection v ∈ V := Submodule.starProjection_apply_mem V v
    have horth : inner ℝ r (V.starProjection v) = 0 :=
      Submodule.inner_left_of_mem_orthogonal hproj_mem hr_orth
    have hvdecomp : v = V.starProjection v + r := by
      dsimp [r]
      abel
    rw [hvdecomp, inner_add_right, horth, zero_add, real_inner_self_eq_norm_sq]
    exact sq_pos_of_pos hr_norm_pos
  rcases hCne with ⟨c0, hc0⟩
  rcases hbound with ⟨M, hM⟩
  let t : ℝ := max 0 ((M - inner ℝ c0 v) / inner ℝ r v + 1)
  have ht_gt : M < inner ℝ c0 v + t * inner ℝ r v := by
    have ht_ge : (M - inner ℝ c0 v) / inner ℝ r v + 1 ≤ t := le_max_right _ _
    have hmul := mul_le_mul_of_nonneg_right ht_ge (le_of_lt hrv_pos)
    have hcalc : M - inner ℝ c0 v + inner ℝ r v ≤ t * inner ℝ r v := by
      field_simp [ne_of_gt hrv_pos] at hmul
      linarith
    linarith
  let y : H := c0 + t • r
  have hyC : y ∈ C := by
    rw [hCeq]
    intro i
    have hai_mem : a i ∈ V := Submodule.subset_span ⟨i, rfl⟩
    have hair : inner ℝ (a i) r = 0 :=
      Submodule.inner_right_of_mem_orthogonal hai_mem hr_orth
    have hc0_constraints : ∀ i : Fin m, inner ℝ (a i) c0 ≤ b i := by
      simpa [hCeq] using hc0
    calc
      inner ℝ (a i) y = inner ℝ (a i) c0 + t * inner ℝ (a i) r := by
        simp [y, inner_add_right, inner_smul_right]
      _ = inner ℝ (a i) c0 := by simp [hair]
      _ ≤ b i := hc0_constraints i
  have hy_gt : M < inner ℝ y v := by
    calc
      M < inner ℝ c0 v + t * inner ℝ r v := ht_gt
      _ = inner ℝ y v := by simp [y, inner_add_left, real_inner_smul_left]
  exact not_lt_of_ge (hM y hyC) hy_gt

omit [CompleteSpace H] in
/-- Orthogonal projection to the span of halfspace normals preserves the halfspace constraints. -/
private theorem prop51_projection_preserves_polyhedron_constraints
    {C : Set H} {m : ℕ} {a : Fin m → H} {b : Fin m → ℝ}
    (hCeq : C = {x | ∀ i : Fin m, inner ℝ (a i) x ≤ b i})
    (y : H) (hy : y ∈ C) :
    (let V : Submodule ℝ H := Submodule.span ℝ (Set.range a)
     haveI : FiniteDimensional ℝ V := FiniteDimensional.span_of_finite ℝ (Set.finite_range a)
     V.starProjection y) ∈ C := by
  classical
  let V : Submodule ℝ H := Submodule.span ℝ (Set.range a)
  haveI : FiniteDimensional ℝ V := FiniteDimensional.span_of_finite ℝ (Set.finite_range a)
  change V.starProjection y ∈ C
  have hres_orth : y - V.starProjection y ∈ Vᗮ := by
    rw [← Submodule.starProjection_orthogonal_val (K := V) y]
    exact Submodule.starProjection_apply_mem Vᗮ y
  rw [hCeq]
  intro i
  have hai_mem : a i ∈ V := Submodule.subset_span ⟨i, rfl⟩
  have hzero : inner ℝ (a i) (y - V.starProjection y) = 0 :=
    Submodule.inner_right_of_mem_orthogonal hai_mem hres_orth
  have heq : inner ℝ (a i) (V.starProjection y) = inner ℝ (a i) y := by
    rw [inner_sub_right] at hzero
    linarith
  have hy_constraints : ∀ i : Fin m, inner ℝ (a i) y ≤ b i := by
    simpa [hCeq] using hy
  simpa [heq] using hy_constraints i

omit [CompleteSpace H] in
/-- Orthogonal projection to the span of normals preserves objectives in that span. -/
private theorem prop51_projection_preserves_objective_of_mem_span
    {m : ℕ} {a : Fin m → H} {v y : H}
    (hv : v ∈ Submodule.span ℝ (Set.range a)) :
    (let V : Submodule ℝ H := Submodule.span ℝ (Set.range a)
     haveI : FiniteDimensional ℝ V := FiniteDimensional.span_of_finite ℝ (Set.finite_range a)
     inner ℝ (V.starProjection y) v) = inner ℝ y v := by
  classical
  let V : Submodule ℝ H := Submodule.span ℝ (Set.range a)
  haveI : FiniteDimensional ℝ V := FiniteDimensional.span_of_finite ℝ (Set.finite_range a)
  change inner ℝ (V.starProjection y) v = inner ℝ y v
  have hvV : v ∈ V := hv
  have hres_orth : y - V.starProjection y ∈ Vᗮ := by
    rw [← Submodule.starProjection_orthogonal_val (K := V) y]
    exact Submodule.starProjection_apply_mem Vᗮ y
  have hzero : inner ℝ v (y - V.starProjection y) = 0 :=
    Submodule.inner_right_of_mem_orthogonal hvV hres_orth
  rw [inner_sub_right] at hzero
  calc
    inner ℝ (V.starProjection y) v = inner ℝ v (V.starProjection y) := real_inner_comm _ _
    _ = inner ℝ v y := by linarith
    _ = inner ℝ y v := real_inner_comm _ _

/-- A direction in the affine hull of a set can be followed a small positive distance from an
intrinsic interior point while remaining in the set. -/
private lemma prop51_intrinsicInterior_add_smul_mem
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    {s : Set V} {p : V} (hp : p ∈ intrinsicInterior ℝ s)
    {w : V} (hw : w ∈ (affineSpan ℝ s).direction) :
    ∃ ε : ℝ, 0 < ε ∧ ∀ t : ℝ, 0 < t → t ≤ ε → p + t • w ∈ s := by
  classical
  rw [mem_intrinsicInterior] at hp
  obtain ⟨p', hp', hp'eq⟩ := hp
  rw [← hp'eq] at *
  clear hp'eq p
  rcases Metric.mem_nhds_iff.mp (isOpen_interior.mem_nhds hp') with ⟨e, he, hball⟩
  refine ⟨e / (‖w‖ + 1), div_pos he (by positivity), ?_⟩
  intro t ht0 htle
  have hmemA : (p' : V) + t • w ∈ affineSpan ℝ s := by
    have h := AffineSubspace.vadd_mem_of_mem_direction
      (s := affineSpan ℝ s) (v := t • w) (Submodule.smul_mem _ t hw) p'.2
    simpa [vadd_eq_add, add_comm] using h
  let q : ↥(affineSpan ℝ s) := ⟨(p' : V) + t • w, hmemA⟩
  have hdist : dist q p' < e := by
    have hdisteq : dist q p' = ‖t • w‖ := by
      rw [Subtype.dist_eq]
      simp only [q]
      rw [dist_eq_norm, add_sub_cancel_left]
    rw [hdisteq, norm_smul, Real.norm_eq_abs, abs_of_pos ht0]
    calc t * ‖w‖ ≤ (e / (‖w‖ + 1)) * ‖w‖ :=
          mul_le_mul_of_nonneg_right htle (norm_nonneg w)
      _ < (e / (‖w‖ + 1)) * (‖w‖ + 1) := by
          exact mul_lt_mul_of_pos_left (by linarith) (div_pos he (by positivity))
      _ = e := by field_simp
  have hq : q ∈ interior (Subtype.val ⁻¹' s) := hball hdist
  have hqs : (q : V) ∈ s := interior_subset (s := Subtype.val ⁻¹' s) hq
  simpa [q] using hqs

/-- Strengthened form of the polyhedral ray exit lemma: the active constraint at the exit point
is nontrivial, because the starting point satisfies it strictly. -/
private theorem prop51_ray_exit_to_active_face_aux
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    {m : ℕ} (a : Fin m → V) (b : Fin m → ℝ) (φ : V →ₗ[ℝ] ℝ)
    (hbdd : ∃ M : ℝ, ∀ x : V,
      (∀ i : Fin m, inner ℝ (a i) x ≤ b i) → φ x ≤ M)
    (x0 z : V)
    (hx0 : x0 ∈ intrinsicInterior ℝ
      ({x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} : Set V))
    (hz : ∀ i : Fin m, inner ℝ (a i) z ≤ b i)
    (hφ : φ x0 < φ z) :
    ∃ T : ℝ, 1 ≤ T ∧
      (∀ t : ℝ, 0 ≤ t → t ≤ T →
        ∀ i : Fin m, inner ℝ (a i) (x0 + t • (z - x0)) ≤ b i) ∧
      (∀ t : ℝ, T < t →
        ¬ (∀ i : Fin m, inner ℝ (a i) (x0 + t • (z - x0)) ≤ b i)) ∧
      (∃ i : Fin m, inner ℝ (a i) x0 < b i ∧
        inner ℝ (a i) (x0 + T • (z - x0)) = b i) ∧
      φ z ≤ φ (x0 + T • (z - x0)) ∧
      x0 + T • (z - x0) ∈ intrinsicFrontier ℝ
        ({x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} : Set V) := by
  classical
  cases m with
  | zero =>
      exfalso
      rcases hbdd with ⟨M, hM⟩
      have hd : 0 < φ z - φ x0 := sub_pos.mpr hφ
      have hval : φ (x0 + ((M - φ x0 + 1) / (φ z - φ x0)) • (z - x0)) = M + 1 := by
        rw [map_add, map_smul, map_sub, smul_eq_mul]
        field_simp
        ring
      have hle := hM (x0 + ((M - φ x0 + 1) / (φ z - φ x0)) • (z - x0))
        (fun i : Fin 0 => i.elim0)
      rw [hval] at hle
      linarith
  | succ k =>
      let P : Set V := {x : V | ∀ i : Fin (k+1), inner ℝ (a i) x ≤ b i}
      have hx0P : x0 ∈ P := intrinsicInterior_subset hx0
      have hzP : z ∈ P := hz
      have hP_closed : IsClosed P := by
        change IsClosed {x : V | ∀ i : Fin (k+1), inner ℝ (a i) x ≤ b i}
        rw [setOf_forall]
        exact isClosed_iInter fun i => isClosed_le (by fun_prop) continuous_const
      have hP_conv : Convex ℝ P := by
        intro x hx y hy s t hs ht hst i
        have hsplit : inner ℝ (a i) (s • x + t • y)
            = s * inner ℝ (a i) x + t * inner ℝ (a i) y := by
          rw [inner_add_right, inner_smul_right, inner_smul_right]
        rw [hsplit]
        have hxi : inner ℝ (a i) x ≤ b i := hx i
        have hyi : inner ℝ (a i) y ≤ b i := hy i
        have h1 : s * inner ℝ (a i) x ≤ s * b i := mul_le_mul_of_nonneg_left hxi hs
        have h2 : t * inner ℝ (a i) y ≤ t * b i := mul_le_mul_of_nonneg_left hyi ht
        have h3 : s * b i + t * b i = b i := by rw [← add_mul, hst, one_mul]
        linarith
      let w : V := z - x0
      let A : Set ℝ := {t : ℝ | 0 ≤ t ∧ x0 + t • w ∈ P}
      have hA_ne : A.Nonempty := ⟨0, le_refl 0, by simpa [w] using hx0P⟩
      have hA_bdd : BddAbove A := by
        rcases hbdd with ⟨M, hM⟩
        refine ⟨max 0 ((M - φ x0) / (φ z - φ x0)), ?_⟩
        rintro t ⟨ht0, htP⟩
        have h1 : φ (x0 + t • w) ≤ M := hM _ htP
        have hw : φ w = φ z - φ x0 := by simp only [w, map_sub]
        have h2 : φ (x0 + t • w) = φ x0 + t * (φ z - φ x0) := by
          rw [map_add, map_smul, hw, smul_eq_mul]
        rw [h2] at h1
        have hd : 0 < φ z - φ x0 := sub_pos.mpr hφ
        have h3 : t * (φ z - φ x0) ≤ M - φ x0 := by linarith
        have h4 : t ≤ (M - φ x0) / (φ z - φ x0) := by
          rw [le_div_iff₀ hd]
          linarith
        exact le_max_of_le_right h4
      have hA_closed : IsClosed A := by
        have hcont : Continuous fun t : ℝ => x0 + t • w := by fun_prop
        have hEq : A = Set.Ici (0:ℝ) ∩ (fun t : ℝ => x0 + t • w) ⁻¹' P := by
          ext t; simp [A]
        rw [hEq]
        exact isClosed_Ici.inter (hP_closed.preimage hcont)
      let T : ℝ := sSup A
      have hTmem : T ∈ A := hA_closed.csSup_mem hA_ne hA_bdd
      have hT0 : 0 ≤ T := hTmem.1
      have hTP : x0 + T • w ∈ P := hTmem.2
      have h1A : (1:ℝ) ∈ A := ⟨by norm_num, by simpa [w] using hzP⟩
      have hT1 : 1 ≤ T := le_csSup hA_bdd h1A
      have hTpos : 0 < T := lt_of_lt_of_le zero_lt_one hT1
      have hseg : ∀ t : ℝ, 0 ≤ t → t ≤ T → x0 + t • w ∈ P := by
        intro t ht0 htT
        have ha : 0 ≤ 1 - t / T := by
          have hle : t / T ≤ 1 := (div_le_one hTpos).mpr htT
          linarith
        have hb : 0 ≤ t / T := div_nonneg ht0 hTpos.le
        have hab : (1 - t / T) + t / T = 1 := by ring
        have hcombo := hP_conv hx0P hTP ha hb hab
        have hx : (1 - t / T) • x0 + (t / T) • (x0 + T • w) = x0 + t • w := by
          have hcoef : (t / T) * T = t := by field_simp
          rw [smul_add, smul_smul, hcoef, ← add_assoc, ← add_smul, hab, one_smul]
        rw [hx] at hcombo
        exact hcombo
      have hexit : ∀ t : ℝ, T < t → x0 + t • w ∉ P := by
        intro t ht hmem
        have ht0 : 0 ≤ t := le_of_lt (lt_of_le_of_lt hT0 ht)
        have hle : t ≤ T := le_csSup hA_bdd ⟨ht0, hmem⟩
        linarith
      have hactive : ∃ i : Fin (k+1), inner ℝ (a i) x0 < b i ∧
          inner ℝ (a i) (x0 + T • w) = b i := by
        by_contra hcon
        push Not at hcon
        have hEndP : ∀ i, inner ℝ (a i) (x0 + T • w) ≤ b i := hTP
        have hmain : ∀ᶠ t in 𝓝[>] T,
            ∀ i : Fin (k+1), inner ℝ (a i) (x0 + t • w) ≤ b i := by
          rw [Filter.eventually_all]
          intro i
          have hcont : Continuous fun t : ℝ => inner ℝ (a i) (x0 + t • w) := by fun_prop
          rcases lt_or_eq_of_le (hEndP i) with hlt | heq
          · refine eventually_nhdsWithin_iff.mpr ?_
            exact ((hcont.tendsto T).eventually_lt_const hlt).mono
              (fun t ht _ => le_of_lt ht)
          · have hx0eq : inner ℝ (a i) x0 = b i :=
              le_antisymm (hx0P i) (le_of_not_gt fun hlt => hcon i hlt heq)
            have hwle : inner ℝ (a i) w ≤ 0 := by
              have hzi : inner ℝ (a i) z ≤ b i := hz i
              have hsplit : inner ℝ (a i) w
                  = inner ℝ (a i) z - inner ℝ (a i) x0 := by
                simp only [w, inner_sub_right]
              rw [hsplit, hx0eq]
              linarith
            refine eventually_nhdsWithin_iff.mpr (Filter.Eventually.of_forall ?_)
            intro t ht
            have ht0 : 0 ≤ t := le_of_lt (lt_of_le_of_lt hT0 ht)
            have hsplit : inner ℝ (a i) (x0 + t • w)
                = inner ℝ (a i) x0 + t * inner ℝ (a i) w := by
              rw [inner_add_right, inner_smul_right]
            rw [hsplit, hx0eq]
            linarith [mul_nonpos_of_nonneg_of_nonpos ht0 hwle]
        have hTlt : ∀ᶠ t in 𝓝[>] T, T < t := self_mem_nhdsWithin
        haveI : (𝓝[>] T).NeBot := nhdsWithin_Ioi_neBot le_rfl
        obtain ⟨t, hconstr, ht⟩ := (hmain.and hTlt).exists
        exact (hexit t ht) hconstr
      obtain ⟨i, hx0lt, hTeq⟩ := hactive
      have hwpos : 0 < inner ℝ (a i) w := by
        have hsplit : inner ℝ (a i) (x0 + T • w)
            = inner ℝ (a i) x0 + T * inner ℝ (a i) w := by
          rw [inner_add_right, inner_smul_right]
        rw [hsplit] at hTeq
        nlinarith
      have hφend : φ z ≤ φ (x0 + T • w) := by
        have hw : φ w = φ z - φ x0 := by simp only [w, map_sub]
        have h2 : φ (x0 + T • w) = φ x0 + T * (φ z - φ x0) := by
          rw [map_add, map_smul, hw, smul_eq_mul]
        have hd : 0 < φ z - φ x0 := sub_pos.mpr hφ
        nlinarith
      have hfrontier : x0 + T • w ∈ intrinsicFrontier ℝ P := by
        rw [← intrinsicClosure_diff_intrinsicInterior]
        refine ⟨subset_intrinsicClosure hTP, ?_⟩
        intro hmem
        have hwdir : w ∈ (affineSpan ℝ P).direction := by
          have h1 : z ∈ affineSpan ℝ P := subset_affineSpan ℝ P hzP
          have h2 : x0 ∈ affineSpan ℝ P := subset_affineSpan ℝ P hx0P
          have := AffineSubspace.vsub_mem_direction (s := affineSpan ℝ P) h1 h2
          simpa only [w] using this
        obtain ⟨e, he, hmove⟩ := prop51_intrinsicInterior_add_smul_mem hmem hwdir
        have htmem : x0 + T • w + (e/2) • w ∈ P :=
          hmove (e/2) (by linarith) (by linarith)
        have hval := htmem i
        have hgt : b i < inner ℝ (a i) (x0 + T • w + (e/2) • w) := by
          have hsplit : inner ℝ (a i) (x0 + T • w + (e/2) • w)
              = inner ℝ (a i) (x0 + T • w) + (e/2) * inner ℝ (a i) w := by
            rw [inner_add_right, inner_smul_right]
          rw [hsplit, hTeq]
          nlinarith
        linarith
      exact ⟨T, hT1, fun t ht0 htT => hseg t ht0 htT, fun t ht => hexit t ht,
        ⟨i, hx0lt, hTeq⟩, hφend, hfrontier⟩

/-- The ray from an intrinsic interior point through a point of a polyhedron leaves the
polyhedron at a finite time, at a point of the intrinsic frontier where a defining inequality
is active, without decreasing a bounded-above linear objective. -/
private theorem prop51_ray_exit_to_active_face
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    {m : ℕ} (a : Fin m → V) (b : Fin m → ℝ) (φ : V →ₗ[ℝ] ℝ)
    (hbdd : ∃ M : ℝ, ∀ x : V,
      (∀ i : Fin m, inner ℝ (a i) x ≤ b i) → φ x ≤ M)
    (x0 z : V)
    (hx0 : x0 ∈ intrinsicInterior ℝ
      ({x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} : Set V))
    (hz : ∀ i : Fin m, inner ℝ (a i) z ≤ b i)
    (hφ : φ x0 < φ z) :
    ∃ T : ℝ,
      1 ≤ T ∧
      (∀ t : ℝ, 0 ≤ t → t ≤ T →
        ∀ i : Fin m, inner ℝ (a i) (x0 + t • (z - x0)) ≤ b i) ∧
      (∀ t : ℝ, T < t →
        ¬ (∀ i : Fin m, inner ℝ (a i) (x0 + t • (z - x0)) ≤ b i)) ∧
      (∃ i : Fin m, inner ℝ (a i) (x0 + T • (z - x0)) = b i) ∧
      φ z ≤ φ (x0 + T • (z - x0)) ∧
      x0 + T • (z - x0) ∈ intrinsicFrontier ℝ
        ({x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} : Set V) := by
  obtain ⟨T, hT1, hseg, hexit, ⟨i, _hstrict, hTeq⟩, hφend, hfront⟩ :=
    prop51_ray_exit_to_active_face_aux a b φ hbdd x0 z hx0 hz hφ
  exact ⟨T, hT1, hseg, hexit, ⟨i, hTeq⟩, hφend, hfront⟩

/-- For a nonconstant linear objective bounded above on a polyhedron, the supremum over the
polyhedron equals the supremum over the union of its nontrivial active faces. -/
private theorem prop51_boundary_carries_supremum
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    {m : ℕ} (a : Fin m → V) (b : Fin m → ℝ) (φ : V →ₗ[ℝ] ℝ)
    (hne : ({x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} : Set V).Nonempty)
    (hbdd : ∃ M : ℝ, ∀ x : V,
      (∀ i : Fin m, inner ℝ (a i) x ≤ b i) → φ x ≤ M)
    (hnonconst : ∃ x y : V,
      (∀ i : Fin m, inner ℝ (a i) x ≤ b i) ∧
      (∀ i : Fin m, inner ℝ (a i) y ≤ b i) ∧ φ x < φ y) :
    sSup (φ '' {x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i}) =
      sSup (φ '' {x : V |
        (∀ i : Fin m, inner ℝ (a i) x ≤ b i) ∧
        ∃ i : Fin m, inner ℝ (a i) x = b i ∧
          ∃ y : V, (∀ j : Fin m, inner ℝ (a j) y ≤ b j) ∧
            inner ℝ (a i) y < b i}) := by
  classical
  let P : Set V := {x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i}
  let B : Set V := {x : V | P x ∧ ∃ i : Fin m, inner ℝ (a i) x = b i ∧
    ∃ y : V, P y ∧ inner ℝ (a i) y < b i}
  change sSup (φ '' P) = sSup (φ '' B)
  have hP_conv : Convex ℝ P := by
    intro x hx y hy s t hs ht hst i
    have hsplit : inner ℝ (a i) (s • x + t • y)
        = s * inner ℝ (a i) x + t * inner ℝ (a i) y := by
      rw [inner_add_right, inner_smul_right, inner_smul_right]
    rw [hsplit]
    have hxi : inner ℝ (a i) x ≤ b i := hx i
    have hyi : inner ℝ (a i) y ≤ b i := hy i
    have h1 : s * inner ℝ (a i) x ≤ s * b i := mul_le_mul_of_nonneg_left hxi hs
    have h2 : t * inner ℝ (a i) y ≤ t * b i := mul_le_mul_of_nonneg_left hyi ht
    have h3 : s * b i + t * b i = b i := by rw [← add_mul, hst, one_mul]
    linarith
  have hBdd : BddAbove (φ '' P) := by
    rcases hbdd with ⟨M, hM⟩
    refine ⟨M, ?_⟩
    rintro y ⟨x, hxP, rfl⟩
    exact hM x hxP
  obtain ⟨x0, hx0⟩ := hne.intrinsicInterior hP_conv
  have hx0P : x0 ∈ P := intrinsicInterior_subset hx0
  have hneImage : (φ '' P).Nonempty := ⟨φ x0, x0, hx0P, rfl⟩
  have hx0_le_s : φ x0 ≤ sSup (φ '' P) := le_csSup hBdd ⟨x0, hx0P, rfl⟩
  have hs_lt : φ x0 < sSup (φ '' P) := by
    by_contra hnot
    have hEq : φ x0 = sSup (φ '' P) := le_antisymm hx0_le_s (le_of_not_gt hnot)
    rcases hnonconst with ⟨x, y, hxP, hyP, hxylt⟩
    have hyle : φ y ≤ φ x0 := by
      rw [hEq]
      exact le_csSup hBdd ⟨y, hyP, rfl⟩
    have hxlt : φ x < φ x0 := lt_of_lt_of_le hxylt hyle
    have hwdir : -(x - x0) ∈ (affineSpan ℝ P).direction := by
      have h1 : x ∈ affineSpan ℝ P := subset_affineSpan ℝ P hxP
      have h2 : x0 ∈ affineSpan ℝ P := subset_affineSpan ℝ P hx0P
      exact Submodule.neg_mem _ (AffineSubspace.vsub_mem_direction h1 h2)
    obtain ⟨e, he, hmove⟩ := prop51_intrinsicInterior_add_smul_mem hx0 hwdir
    have hmem : x0 + (e/2) • (-(x - x0)) ∈ P :=
      hmove (e/2) (by linarith) (by linarith)
    have hval : φ (x0 + (e/2) • (-(x - x0))) = φ x0 - (e/2) * (φ x - φ x0) := by
      rw [map_add, map_smul, map_neg, map_sub, smul_eq_mul]
      ring
    have hbound : φ (x0 + (e/2) • (-(x - x0))) ≤ sSup (φ '' P) :=
      le_csSup hBdd ⟨_, hmem, rfl⟩
    rw [hval, hEq] at hbound
    nlinarith
  have hclaim : ∀ c : ℝ, c < sSup (φ '' P) → ∃ q ∈ B, c < φ q := by
    intro c hc
    have hmaxlt : max c (φ x0) < sSup (φ '' P) := max_lt hc hs_lt
    obtain ⟨v, hv, hvgt⟩ := (lt_csSup_iff hBdd hneImage).mp hmaxlt
    obtain ⟨z, hzP, rfl⟩ := hv
    have hzgtc : c < φ z := lt_of_le_of_lt (le_max_left _ _) hvgt
    have hzgtx0 : φ x0 < φ z := lt_of_le_of_lt (le_max_right _ _) hvgt
    obtain ⟨T, hT1, hseg, _hexit, ⟨i, hx0strict, hTeq⟩, hφend, _hfront⟩ :=
      prop51_ray_exit_to_active_face_aux a b φ hbdd x0 z hx0 hzP hzgtx0
    refine ⟨x0 + T • (z - x0), ?_, lt_of_lt_of_le hzgtc hφend⟩
    exact ⟨hseg T (le_trans zero_le_one hT1) le_rfl, i, hTeq, x0, hx0P, hx0strict⟩
  have hB_subset_P : B ⊆ P := fun x hx => hx.1
  obtain ⟨q0, hq0B, _⟩ := hclaim (φ x0) hs_lt
  have hBne : (φ '' B).Nonempty := ⟨φ q0, q0, hq0B, rfl⟩
  have hBddB : BddAbove (φ '' B) := hBdd.mono (Set.image_mono hB_subset_P)
  have hle1 : sSup (φ '' B) ≤ sSup (φ '' P) :=
    csSup_le hBne fun y hy => le_csSup hBdd (Set.image_mono hB_subset_P hy)
  have hle2 : sSup (φ '' P) ≤ sSup (φ '' B) := by
    by_contra hnot
    have hlt : sSup (φ '' B) < sSup (φ '' P) := lt_of_not_ge hnot
    obtain ⟨q, hqB, hqgt⟩ := hclaim (sSup (φ '' B)) hlt
    have hle : φ q ≤ sSup (φ '' B) := le_csSup hBddB ⟨q, hqB, rfl⟩
    linarith
  exact le_antisymm hle2 hle1

/-- A bounded linear objective on a halfspace-free (full space) polyhedron is constant. -/
private theorem prop51_polyhedron_max_fin_zero
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
    {a : Fin 0 → V} (b : Fin 0 → ℝ) (φ : V →ₗ[ℝ] ℝ)
    (hbdd : ∃ M : ℝ, ∀ x : V,
      (∀ i : Fin 0, inner ℝ (a i) x ≤ b i) → φ x ≤ M) :
    ∃ x : V, (∀ i : Fin 0, inner ℝ (a i) x ≤ b i) ∧
      ∀ y : V, (∀ i : Fin 0, inner ℝ (a i) y ≤ b i) → φ y ≤ φ x := by
  have hphi : φ = 0 := by
    ext x
    rcases hbdd with ⟨M, hM⟩
    by_contra hxne
    rcases lt_or_gt_of_ne (Ne.symm hxne) with hpos | hneg
    · have htval : ((M + 1) / φ x) * φ x = M + 1 := by
        rw [div_mul_cancel₀ _ (ne_of_gt hpos)]
      have hle := hM (((M + 1) / φ x) • x) (fun i => i.elim0)
      rw [map_smul, smul_eq_mul, htval] at hle
      linarith
    · have hpos' : 0 < φ (-x) := by rw [map_neg]; exact neg_pos.mpr hneg
      have htval : ((M + 1) / φ (-x)) * φ (-x) = M + 1 := by
        rw [div_mul_cancel₀ _ (ne_of_gt hpos')]
      have hle := hM (((M + 1) / φ (-x)) • (-x)) (fun i => i.elim0)
      rw [map_smul, smul_eq_mul, htval] at hle
      linarith
  refine ⟨0, (fun i => i.elim0), fun y hy => ?_⟩
  simp [hphi]

/-- Activating one halfspace constraint cuts the affine dimension down by at least one,
provided the constraint is nontrivial on the polyhedron and the face is nonempty. -/
private theorem prop51_active_face_finrank_lt
    {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
    {m : ℕ} {a : Fin m → V} {b : Fin m → ℝ} (i : Fin m)
    {mF : ℕ} {aF : Fin mF → V} {bF : Fin mF → ℝ}
    (hF : ∀ x : V, (∀ k : Fin mF, inner ℝ (aF k) x ≤ bF k) ↔
      ((∀ j : Fin m, inner ℝ (a j) x ≤ b j) ∧ inner ℝ (a i) x = b i))
    (hne : ({x : V | (∀ j : Fin m, inner ℝ (a j) x ≤ b j) ∧
      inner ℝ (a i) x = b i} : Set V).Nonempty)
    (hntriv : ∃ y : V, (∀ j : Fin m, inner ℝ (a j) y ≤ b j) ∧
      inner ℝ (a i) y < b i) :
    Module.finrank ℝ (affineSpan ℝ
        ({x : V | ∀ k : Fin mF, inner ℝ (aF k) x ≤ bF k} : Set V)).direction <
      Module.finrank ℝ (affineSpan ℝ
        ({x : V | ∀ j : Fin m, inner ℝ (a j) x ≤ b j} : Set V)).direction := by
  classical
  set P : Set V := {x : V | ∀ j : Fin m, inner ℝ (a j) x ≤ b j} with hPdef
  set E : Set V := {x : V | ∀ k : Fin mF, inner ℝ (aF k) x ≤ bF k} with hEdef
  have hEP : E ⊆ P := by
    intro x hx
    exact ((hF x).mp hx).1
  obtain ⟨x₁, hx₁P, hx₁eq⟩ := hne
  have hx₁E : x₁ ∈ E := (hF x₁).mpr ⟨hx₁P, hx₁eq⟩
  set f : V →ₗ[ℝ] ℝ := (innerSL ℝ (a i) : V →ₗ[ℝ] ℝ) with hf
  have hfapply : ∀ x : V, f x = inner ℝ (a i) x := fun x => rfl
  set W : Submodule ℝ V := (affineSpan ℝ P).direction with hW
  set K : Submodule ℝ V := LinearMap.ker f with hK
  have hle : (affineSpan ℝ E).direction ≤ W ⊓ K := by
    refine le_inf ?_ ?_
    · exact AffineSubspace.direction_le (affineSpan_mono ℝ hEP)
    · rw [direction_affineSpan, vectorSpan_eq_span_vsub_set_right ℝ hx₁E]
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨x, hx, rfl⟩
      change f (x -ᵥ x₁) = 0
      have hxE := (hF x).mp hx
      have hsub : f (x -ᵥ x₁) = f x - f x₁ := by
        simp [vsub_eq_sub]
      rw [hsub, hfapply, hfapply, hxE.2, hx₁eq, sub_self]
  have hmono : Module.finrank ℝ (affineSpan ℝ E).direction ≤
      Module.finrank ℝ ↥(W ⊓ K) :=
    Submodule.finrank_mono hle
  obtain ⟨y, hyP, hylt⟩ := hntriv
  have hmemdir : x₁ -ᵥ y ∈ W :=
    AffineSubspace.vsub_mem_direction (subset_affineSpan ℝ P hx₁P)
      (subset_affineSpan ℝ P hyP)
  have hcomp_ne : f.comp W.subtype ≠ 0 := by
    intro hzero
    have hval : f (x₁ -ᵥ y) = 0 := by
      have := DFunLike.congr_fun hzero ⟨x₁ -ᵥ y, hmemdir⟩
      simpa using this
    have hsub : f (x₁ -ᵥ y) = f x₁ - f y := by
      simp [vsub_eq_sub]
    rw [hsub, hfapply, hfapply, hx₁eq] at hval
    linarith
  have hker_map : (LinearMap.ker (f.comp W.subtype)).map W.subtype = W ⊓ K := by
    rw [LinearMap.ker_comp]
    ext v
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact ⟨w.2, hw⟩
    · rintro ⟨hvW, hvker⟩
      exact ⟨⟨v, hvW⟩, hvker, rfl⟩
  have hfin : Module.finrank ℝ ↥(W ⊓ K) =
      Module.finrank ℝ (LinearMap.ker (f.comp W.subtype)) := by
    rw [← hker_map, Submodule.finrank_map_subtype_eq]
  have hdual := Module.Dual.finrank_ker_add_one_of_ne_zero hcomp_ne
  have hmono' : Module.finrank ℝ (affineSpan ℝ E).direction ≤
      Module.finrank ℝ (LinearMap.ker (f.comp W.subtype)) := by
    rw [← hfin]; exact hmono
  calc Module.finrank ℝ (affineSpan ℝ E).direction
      ≤ Module.finrank ℝ (LinearMap.ker (f.comp W.subtype)) := hmono'
    _ < Module.finrank ℝ (affineSpan ℝ P).direction := by
        rw [← hW]; omega

/-- Strong induction on the affine dimension: a linear functional that is bounded above on a
nonempty finite halfspace polyhedron attains its maximum. -/
private theorem prop51_finite_dim_polyhedron_max_aux :
    ∀ (n : ℕ) {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]
      [FiniteDimensional ℝ V]
      (m : ℕ) (a : Fin m → V) (b : Fin m → ℝ) (φ : V →ₗ[ℝ] ℝ),
      Module.finrank ℝ (affineSpan ℝ
        ({x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} : Set V)).direction ≤ n →
      ({x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} : Set V).Nonempty →
      (∃ M : ℝ, ∀ x : V, (∀ i : Fin m, inner ℝ (a i) x ≤ b i) → φ x ≤ M) →
      ∃ x : V, (∀ i : Fin m, inner ℝ (a i) x ≤ b i) ∧
        ∀ y : V, (∀ i : Fin m, inner ℝ (a i) y ≤ b i) → φ y ≤ φ x := by
  intro n
  induction n with
  | zero =>
    intro V _ _ _ m a b φ hdim hne _hbdd
    classical
    obtain ⟨p, hp⟩ := hne
    refine ⟨p, hp, fun y hy => ?_⟩
    have hdir : (affineSpan ℝ
        ({x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} : Set V)).direction = ⊥ :=
      Submodule.finrank_eq_zero.mp (Nat.le_zero.mp hdim)
    have hmem : y -ᵥ p ∈ (affineSpan ℝ
        ({x : V | ∀ i : Fin m, inner ℝ (a i) x ≤ b i} : Set V)).direction :=
      AffineSubspace.vsub_mem_direction (subset_affineSpan ℝ _ hy) (subset_affineSpan ℝ _ hp)
    rw [hdir, Submodule.mem_bot] at hmem
    have hyx : y = p := by
      have : y - p = 0 := by simpa [vsub_eq_sub] using hmem
      exact sub_eq_zero.mp this
    rw [hyx]
  | succ n ih =>
    intro V _ _ _ m a b φ hdim hne hbdd
    classical
    cases m with
    | zero => exact prop51_polyhedron_max_fin_zero b φ hbdd
    | succ m' =>
      let P : Set V := {x : V | ∀ i : Fin (m' + 1), inner ℝ (a i) x ≤ b i}
      by_cases hconst : ∀ x ∈ P, ∀ y ∈ P, φ x = φ y
      · obtain ⟨p, hp⟩ := hne
        exact ⟨p, hp, fun y hy => le_of_eq (hconst p hp y hy).symm⟩
      · push Not at hconst
        obtain ⟨xb, hxbP, yb, hybP, hneφ⟩ := hconst
        have hnonconst : ∃ x y : V, P x ∧ P y ∧ φ x < φ y := by
          rcases lt_or_gt_of_ne hneφ with h | h
          · exact ⟨xb, yb, hxbP, hybP, h⟩
          · exact ⟨yb, xb, hybP, hxbP, h⟩
        have hBdry := prop51_boundary_carries_supremum a b φ hne hbdd hnonconst
        let Ntriv : Fin (m' + 1) → Prop := fun i =>
          ∃ y : V, P y ∧ inner ℝ (a i) y < b i
        let B : Set V := {x : V | P x ∧ ∃ i : Fin (m' + 1),
          inner ℝ (a i) x = b i ∧ Ntriv i}
        have hsB : sSup (φ '' P) = sSup (φ '' B) := by
          simpa only [P, B, Ntriv] using hBdry
        have hBsubP : B ⊆ P := fun x hx => hx.1
        have hBddP : BddAbove (φ '' P) := by
          rcases hbdd with ⟨M, hM⟩
          exact ⟨M, by rintro _ ⟨x, hx, rfl⟩; exact hM x hx⟩
        have hPnonempty : (φ '' P).Nonempty := by
          obtain ⟨p, hp⟩ := hne
          exact ⟨φ p, p, hp, rfl⟩
        have hPconv : Convex ℝ P := by
          intro x hx y hy s t hs ht hst i
          simp only [P, Set.mem_setOf_eq] at hx hy ⊢
          have hsplit : inner ℝ (a i) (s • x + t • y) =
              s * inner ℝ (a i) x + t * inner ℝ (a i) y := by
            rw [inner_add_right, inner_smul_right, inner_smul_right]
          rw [hsplit]
          have h1 := mul_le_mul_of_nonneg_left (hx i) hs
          have h2 := mul_le_mul_of_nonneg_left (hy i) ht
          have h3 : s * b i + t * b i = b i := by rw [← add_mul, hst, one_mul]
          linarith
        obtain ⟨x0, hx0int⟩ := hne.intrinsicInterior hPconv
        have hx0P : x0 ∈ P := intrinsicInterior_subset hx0int
        by_cases hatt : φ x0 = sSup (φ '' P)
        · exact ⟨x0, hx0P, fun y hy => by
            rw [hatt]; exact le_csSup hBddP ⟨y, hy, rfl⟩⟩
        · have hslt : φ x0 < sSup (φ '' P) :=
            lt_of_le_of_ne (le_csSup hBddP ⟨x0, hx0P, rfl⟩) hatt
          obtain ⟨rz, hrzmem, hzgt⟩ := (lt_csSup_iff hBddP hPnonempty).mp hslt
          obtain ⟨z, hzP, rfl⟩ := hrzmem
          obtain ⟨T, hT1, hseg, _hexit, ⟨iray, hx0strict, hTeq⟩, _hφend, _hfront⟩ :=
            prop51_ray_exit_to_active_face_aux a b φ hbdd x0 z
              (by simpa only [P] using hx0int) (by simpa only [P] using hzP) hzgt
          have hBne : (φ '' B).Nonempty := by
            refine ⟨φ (x0 + T • (z - x0)), x0 + T • (z - x0), ?_, rfl⟩
            exact ⟨hseg T (le_trans zero_le_one hT1) le_rfl, iray, hTeq, x0, hx0P, hx0strict⟩
          let aE : Fin (m' + 1) → Fin ((m' + 1) + 2) → V := fun i =>
            Fin.append a (fun j : Fin 2 => if j = 0 then a i else -a i)
          let bE : Fin (m' + 1) → Fin ((m' + 1) + 2) → ℝ := fun i =>
            Fin.append b (fun j : Fin 2 => if j = 0 then b i else -b i)
          let Eset : Fin (m' + 1) → Set V := fun i =>
            {x : V | ∀ k : Fin ((m' + 1) + 2), inner ℝ (aE i k) x ≤ bE i k}
          have hface : ∀ i : Fin (m' + 1), ∀ x : V,
              (x ∈ Eset i) ↔ (P x ∧ inner ℝ (a i) x = b i) := by
            intro i x
            change (∀ k : Fin ((m' + 1) + 2), inner ℝ (aE i k) x ≤ bE i k) ↔
              ((∀ j : Fin (m' + 1), inner ℝ (a j) x ≤ b j) ∧
                inner ℝ (a i) x = b i)
            rw [Fin.forall_fin_add (fun k => inner ℝ (aE i k) x ≤ bE i k)]
            simp only [aE, bE, Fin.append_left, Fin.append_right]
            constructor
            · intro h
              exact ⟨h.1, le_antisymm (by simpa using h.2 0)
                (by simpa [inner_neg_left, neg_le_neg_iff] using h.2 1)⟩
            · rintro ⟨hall, heq⟩
              exact ⟨hall, by intro j; fin_cases j <;> simp [heq, inner_neg_left]⟩
          have ihface : ∀ i : Fin (m' + 1), (Eset i).Nonempty → Ntriv i →
              ∃ x : V, x ∈ Eset i ∧ ∀ y : V, y ∈ Eset i → φ y ≤ φ x := by
            intro i hE hN
            have hEne : ({x : V | (∀ j : Fin (m' + 1), inner ℝ (a j) x ≤ b j) ∧
                inner ℝ (a i) x = b i} : Set V).Nonempty :=
              hE.mono (fun x hx => by
                have := (hface i x).mp hx
                simpa only [P] using this)
            have hlt := prop51_active_face_finrank_lt (a := a) (b := b) i
              (aF := aE i) (bF := bE i)
              (fun x => by simpa only [Eset] using hface i x) hEne
              (by simpa only [P, Ntriv] using hN)
            have hdimE : Module.finrank ℝ (affineSpan ℝ (Eset i)).direction ≤ n := by
              have hlt' : Module.finrank ℝ (affineSpan ℝ (Eset i)).direction <
                  Module.finrank ℝ (affineSpan ℝ P).direction := hlt
              have hPdim : Module.finrank ℝ (affineSpan ℝ P).direction ≤ n + 1 := hdim
              omega
            have hbddE : ∃ M : ℝ, ∀ x : V,
                (∀ k : Fin ((m' + 1) + 2), inner ℝ (aE i k) x ≤ bE i k) →
                  φ x ≤ M := by
              rcases hbdd with ⟨M, hM⟩
              refine ⟨M, fun x hx => hM x ?_⟩
              exact ((hface i x).mp hx).1
            obtain ⟨x, hxmem, hxmax⟩ := ih ((m' + 1) + 2) (aE i) (bE i) φ hdimE hE hbddE
            exact ⟨x, hxmem, hxmax⟩
          let gm : Fin (m' + 1) → V := fun i =>
            if h : (Eset i).Nonempty ∧ Ntriv i then
              Classical.choose (ihface i h.1 h.2)
            else x0
          have hgm_mem : ∀ i, gm i ∈ P := by
            intro i
            by_cases h : (Eset i).Nonempty ∧ Ntriv i
            · have hmem : gm i ∈ Eset i := by
                simp only [gm]
                rw [dif_pos h]
                exact (Classical.choose_spec (ihface i h.1 h.2)).1
              exact ((hface i (gm i)).mp hmem).1
            · have hx : gm i = x0 := by
                simp only [gm]
                rw [dif_neg h]
              rw [hx]; exact hx0P
          have hgm_max : ∀ i (h : (Eset i).Nonempty ∧ Ntriv i), ∀ y : V,
              y ∈ Eset i → φ y ≤ φ (gm i) := by
            intro i h y hy
            have hgi : gm i = Classical.choose (ihface i h.1 h.2) := by
              simp only [gm]
              rw [dif_pos h]
            rw [hgi]
            exact (Classical.choose_spec (ihface i h.1 h.2)).2 y hy
          obtain ⟨iStar, _, hiStar⟩ := Finset.exists_max_image
            (Finset.univ : Finset (Fin (m' + 1))) (fun i => φ (gm i))
            Finset.univ_nonempty
          refine ⟨gm iStar, hgm_mem iStar, fun y hy => ?_⟩
          have hle : φ (gm iStar) ≤ sSup (φ '' P) :=
            le_csSup hBddP ⟨gm iStar, hgm_mem iStar, rfl⟩
          have hge : sSup (φ '' P) ≤ φ (gm iStar) := by
            by_contra hcon
            have hlt : φ (gm iStar) < sSup (φ '' P) := lt_of_not_ge hcon
            rw [hsB] at hlt
            have hBddB : BddAbove (φ '' B) := hBddP.mono (Set.image_mono hBsubP)
            obtain ⟨rw, hrwmem, hwgt⟩ := (lt_csSup_iff hBddB hBne).mp hlt
            obtain ⟨w, hwB, rfl⟩ := hrwmem
            obtain ⟨hwP, i, hweq, hwiN⟩ := hwB
            have hwE : w ∈ Eset i := (hface i w).mpr ⟨hwP, hweq⟩
            have hmaxi := hgm_max i ⟨⟨w, hwE⟩, hwiN⟩ w hwE
            have hmi := hiStar i (Finset.mem_univ i)
            linarith
          have heq : φ (gm iStar) = sSup (φ '' P) := le_antisymm hle hge
          rw [heq]
          exact le_csSup hBddP ⟨y, hy, rfl⟩

