/-!
# Theorem 4.1
Let $H$ be a finite dimensional space and let $A: H \Rightarrow H$ be a maximal monotone
operator such that $\operatorname{dom} A = H$ and $0 \in \operatorname{int}(A(0))$.
Assume that there exist $\eta > 0$ and $\alpha \geqslant 0$ such that the linear growth
condition $|x| \leqslant \eta \Rightarrow e(A(x), A(0)) \leqslant \alpha |x|$ holds.
Suppose that the finite-valued function $f: H \to \mathbb{R} \cup \{+\infty\}$ is of
class $\mathcal{C}^{1,1}$ after taking real values, bounded from below and satisfies
the strong convexity assumption (11); the operator $B$ is defined by $B := \nabla f$.
The sequence $(\lambda_n)$ is assumed to be constant, equal to $\lambda > 0$.
Let $(x_n)$ be the sequence generated by the algorithm $(\mathcal{A})$ and let us set
$x_\infty = \lim_{n \to +\infty} x_n$. If the set $A(0)$ is smooth at the point
$-\nabla f(x_\infty)$, then one of the following cases holds:
(i) The sequence $(x_n)$ is finitely convergent.
(ii) There exist $n_0 \in \mathbb{N}$, $C_1, C_2 > 0$ and $q_1, q_2 \in ]0, 1[$ such that
for every $n \geqslant n_0$,
$|x_n - x_\infty| \geqslant C_1 q_1^n$ and $\sum_{k=n}^{+\infty} |x_k - x_\infty| \leqslant C_2 q_2^n$.
Any $q_1 \in ]0, 1[$ (resp. $q_2 \in ]0, 1[$) such that
$q_1 < 1/(\alpha\lambda + 1)$ (resp. $q_2 > \alpha/(\alpha + M\lambda)$) satisfies the
previous estimate. If moreover $\alpha < \sqrt{M}$ then the convergence is finite.
-/
open SetValuedOperator
open scoped Topology
open scoped Asymptotics
open scoped Pointwise
open Set
open Real
open Filter
variable {H : Type _} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

set_option maxHeartbeats 800000

private theorem thm41_rate_interval_nonempty (α M lam : ℝ) (hα : 0 ≤ α)
    (hM : 0 < M) (hlam : 0 < lam) (hαM : α ^ 2 < M) :
    ∃ q2 q1, 0 < q2 ∧ q2 < q1 ∧ q1 < 1 ∧ q1 < 1 / (α * lam + 1) ∧
      q2 > α / (α + M * lam) := by
  have hαlam_nonneg : 0 ≤ α * lam := mul_nonneg hα (le_of_lt hlam)
  have hden1 : 0 < α * lam + 1 := by nlinarith
  have hden1_ge_one : 1 ≤ α * lam + 1 := by nlinarith
  have hMlam_pos : 0 < M * lam := mul_pos hM hlam
  have hden2 : 0 < α + M * lam := by nlinarith
  have ha_nonneg : 0 ≤ α / (α + M * lam) := div_nonneg hα (le_of_lt hden2)
  have hb_le_one : 1 / (α * lam + 1) ≤ 1 := by
    rw [div_le_iff₀ hden1]
    nlinarith
  have hab : α / (α + M * lam) < 1 / (α * lam + 1) := by
    rw [div_lt_div_iff₀ hden2 hden1]
    nlinarith [mul_pos hlam (sub_pos.mpr hαM)]
  rcases exists_between hab with ⟨q2, hq2_gt, hq2_lt⟩
  rcases exists_between hq2_lt with ⟨q1, hq1_gt, hq1_lt⟩
  refine ⟨q2, q1, ?_, hq1_gt, ?_, hq1_lt, hq2_gt⟩
  · exact lt_of_le_of_lt ha_nonneg hq2_gt
  · exact lt_of_lt_of_le hq1_lt hb_le_one

omit [CompleteSpace H] in
private theorem thm41_smoothAt_unit_normal {C : Set H} {xbar : H} (h : IsSmoothAt C xbar) :
    ∃ u : H, ‖u‖ = 1 ∧ normalCone C xbar = {v | ∃ t : ℝ, t ≥ 0 ∧ v = t • u} := by
  rcases h with ⟨_hxbar, u, hu_ne, hucone⟩
  let e : H := (‖u‖)⁻¹ • u
  have hu_norm_pos : 0 < ‖u‖ := norm_pos_iff.mpr hu_ne
  have he_norm : ‖e‖ = 1 := by
    change ‖(‖u‖)⁻¹ • u‖ = 1
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hu_norm_pos)]
    exact inv_mul_cancel₀ hu_norm_pos.ne'
  refine ⟨e, he_norm, ?_⟩
  rw [hucone]
  ext v
  constructor
  · rintro ⟨t, ht, rfl⟩
    refine ⟨t * ‖u‖, mul_nonneg ht (norm_nonneg u), ?_⟩
    simp [e, smul_smul, hu_norm_pos.ne']
  · rintro ⟨t, ht, rfl⟩
    refine ⟨t * (‖u‖)⁻¹, mul_nonneg ht (inv_nonneg.mpr (norm_nonneg u)), ?_⟩
    simp [e, smul_smul]

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem thm41_locallyLipschitz_tendsto_norm_sub_le {F : Type _} [NormedAddCommGroup F]
    (g : H → F) (hg : LocallyLipschitz g) (x : ℕ → H) (xInf : H)
    (hx : Tendsto x atTop (𝓝 xInf)) :
    ∃ K : ℝ, 0 < K ∧ ∃ N : ℕ, ∀ n ≥ N,
      ‖g (x n) - g xInf‖ ≤ K * ‖x n - xInf‖ := by
  rcases hg xInf with ⟨Knn, t, ht, hLip⟩
  have hx_event : ∀ᶠ n in atTop, x n ∈ t := hx ht
  rcases eventually_atTop.mp hx_event with ⟨N, hN⟩
  refine ⟨(Knn : ℝ) + 1, by positivity, N, ?_⟩
  intro n hn
  have hxnt : x n ∈ t := hN n hn
  have hxInft : xInf ∈ t := mem_of_mem_nhds ht
  have hdist := hLip.dist_le_mul (x n) hxnt xInf hxInft
  calc
    ‖g (x n) - g xInf‖ = dist (g (x n)) (g xInf) := by rw [dist_eq_norm]
    _ ≤ (Knn : ℝ) * dist (x n) xInf := hdist
    _ ≤ ((Knn : ℝ) + 1) * ‖x n - xInf‖ := by
      rw [dist_eq_norm]
      have hnorm_nonneg : 0 ≤ ‖x n - xInf‖ := norm_nonneg _
      nlinarith [hnorm_nonneg, Knn.2]

omit [CompleteSpace H] in
private theorem thm41_eventually_scaled_increment_norm_le_eta (x : ℕ → H) (xInf : H)
    (hxInf : Tendsto x atTop (𝓝 xInf)) (lam η : ℝ) (hη : 0 < η) :
    ∀ᶠ n in atTop, ‖lam⁻¹ • (x (n + 2) - x (n + 1))‖ ≤ η := by
  have hshift1 : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
  have hshift2 : Tendsto (fun n : ℕ => n + 2) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_add_right n 2) tendsto_id
  have hx1 : Tendsto (fun n : ℕ => x (n + 1)) atTop (𝓝 xInf) := hxInf.comp hshift1
  have hx2 : Tendsto (fun n : ℕ => x (n + 2)) atTop (𝓝 xInf) := hxInf.comp hshift2
  have hdiff : Tendsto (fun n : ℕ => x (n + 2) - x (n + 1)) atTop
      (𝓝 (0 : H)) := by
    simpa using hx2.sub hx1
  have hscaled : Tendsto (fun n : ℕ => lam⁻¹ • (x (n + 2) - x (n + 1))) atTop
      (𝓝 (0 : H)) := by
    have hc : Tendsto (fun _ : ℕ => lam⁻¹) atTop (𝓝 lam⁻¹) := tendsto_const_nhds
    simpa using hc.smul hdiff
  have hnorm : Tendsto (fun n : ℕ => ‖lam⁻¹ • (x (n + 2) - x (n + 1))‖) atTop
      (𝓝 (0 : ℝ)) := by
    simpa using (continuous_norm.tendsto (0 : H)).comp hscaled
  have hev : ∀ᶠ n : ℕ in atTop,
      ‖lam⁻¹ • (x (n + 2) - x (n + 1))‖ ∈ Metric.ball (0 : ℝ) η :=
    hnorm (Metric.ball_mem_nhds (0 : ℝ) hη)
  filter_upwards [hev] with n hn
  have hlt_abs : |‖lam⁻¹ • (x (n + 2) - x (n + 1))‖ - 0| < η := by
    simpa [Metric.mem_ball, dist_eq_norm, Real.norm_eq_abs] using hn
  have hlt : ‖lam⁻¹ • (x (n + 2) - x (n + 1))‖ < η := by
    simpa [abs_of_nonneg (norm_nonneg _)] using hlt_abs
  exact le_of_lt hlt

private theorem thm41_eventual_geometric_bounds_incompatible {a : ℕ → ℝ} {n0 : ℕ}
    {C1 C2 q1 q2 : ℝ} (hC1 : 0 < C1) (hq2 : 0 < q2) (hq21 : q2 < q1)
    (hlower : ∀ n ≥ n0, C1 * q1 ^ n ≤ a n)
    (hupper : ∀ n ≥ n0, a n ≤ C2 * q2 ^ n) : False := by
  have hratio_gt : 1 < q1 / q2 := (one_lt_div hq2).mpr hq21
  have htend : Tendsto (fun n : ℕ => (q1 / q2) ^ n) atTop atTop :=
    tendsto_pow_atTop_atTop_of_one_lt hratio_gt
  have hIoi : Set.Ioi (C2 / C1) ∈ (atTop : Filter ℝ) := Ioi_mem_atTop (C2 / C1)
  have hev : ∀ᶠ n : ℕ in atTop, C2 / C1 < (q1 / q2) ^ n := htend hIoi
  rcases eventually_atTop.mp hev with ⟨N, hN⟩
  let n := max n0 N
  have hn0 : n0 ≤ n := le_max_left n0 N
  have hNn : N ≤ n := le_max_right n0 N
  have hineq : C1 * q1 ^ n ≤ C2 * q2 ^ n := le_trans (hlower n hn0) (hupper n hn0)
  have hq2pow : 0 < q2 ^ n := pow_pos hq2 n
  have hratio_le : (q1 / q2) ^ n ≤ C2 / C1 := by
    rw [div_pow]
    rw [div_le_div_iff₀ hq2pow hC1]
    nlinarith [hineq]
  exact not_lt_of_ge hratio_le (hN n hNn)

private theorem thm41_term_le_tsum_of_nonneg_summable {f : ℕ → ℝ}
    (hf_nonneg : ∀ n, 0 ≤ f n) (hf_sum : Summable f) (i : ℕ) :
    f i ≤ ∑' n : ℕ, f n := by
  let g : ℕ → ℝ := fun n => if n = i then f i else 0
  have hg_single : ∀ n, n ≠ i → g n = 0 := by
    intro n hn
    simp [g, hn]
  have hg_sum : Summable g := (hasSum_single i hg_single).summable
  have hgle : ∀ n, g n ≤ f n := by
    intro n
    by_cases hn : n = i
    · simp [g, hn]
    · simp [g, hn, hf_nonneg n]
  have hmain : (∑' n : ℕ, g n) ≤ ∑' n : ℕ, f n :=
    Summable.tsum_le_tsum hgle hg_sum hf_sum
  have hg_tsum : (∑' n : ℕ, g n) = g i := tsum_eq_single i hg_single
  have hgi : g i = f i := by simp [g]
  rwa [hg_tsum, hgi] at hmain

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem thm41_pointwise_upper_of_tail_tsum_upper (x : ℕ → H) (xInf : H)
    {n0 : ℕ} {C q : ℝ}
    (hsum_tail : ∀ n ≥ n0, Summable (fun k : ℕ => ‖x (n + k) - xInf‖))
    (hupper : ∀ n ≥ n0, (∑' k : ℕ, ‖x (n + k) - xInf‖) ≤ C * q ^ n) :
    ∀ n ≥ n0, ‖x n - xInf‖ ≤ C * q ^ n := by
  intro n hn
  have hterm : ‖x (n + 0) - xInf‖ ≤ ∑' k : ℕ, ‖x (n + k) - xInf‖ :=
    thm41_term_le_tsum_of_nonneg_summable (fun k => norm_nonneg (x (n + k) - xInf))
      (hsum_tail n hn) 0
  simpa using le_trans hterm (hupper n hn)

private theorem thm41_eventual_lower_geometric_of_step {u : ℕ → ℝ} {N : ℕ} {q : ℝ}
    (hq : 0 < q) (hstep : ∀ n ≥ N, q * u n ≤ u (n + 1)) (hN : 0 < u N) :
    ∃ C, 0 < C ∧ ∀ n ≥ N, C * q ^ n ≤ u n := by
  refine ⟨u N * (q ^ N)⁻¹, ?_, ?_⟩
  · exact mul_pos hN (inv_pos.mpr (pow_pos hq N))
  · intro n hn
    rcases Nat.exists_eq_add_of_le hn with ⟨k, rfl⟩
    have hgeom : q ^ k * u N ≤ u (N + k) := by
      let v : ℕ → ℝ := fun k => u (N + k)
      have hv : ∀ j < k, q * v j ≤ v (j + 1) := by
        intro j hj
        dsimp [v]
        simpa [Nat.add_assoc] using hstep (N + j) (Nat.le_add_right N j)
      simpa [v] using geom_le (le_of_lt hq) k hv
    calc
      (u N * (q ^ N)⁻¹) * q ^ (N + k)
          = q ^ k * u N := by
              rw [pow_add]
              field_simp [ne_of_gt (pow_pos hq N)]
      _ ≤ u (N + k) := hgeom

private theorem thm41_eventual_upper_geometric_of_step {u : ℕ → ℝ} {N : ℕ} {q : ℝ}
    (hq : 0 < q) (hstep : ∀ n ≥ N, u (n + 1) ≤ q * u n) (hN_nonneg : 0 ≤ u N) :
    ∃ C, 0 < C ∧ ∀ n ≥ N, u n ≤ C * q ^ n := by
  refine ⟨(u N + 1) * (q ^ N)⁻¹, ?_, ?_⟩
  · exact mul_pos (by linarith) (inv_pos.mpr (pow_pos hq N))
  · intro n hn
    rcases Nat.exists_eq_add_of_le hn with ⟨k, rfl⟩
    have hgeom : u (N + k) ≤ q ^ k * u N := by
      let v : ℕ → ℝ := fun k => u (N + k)
      have hv : ∀ j < k, v (j + 1) ≤ q * v j := by
        intro j hj
        dsimp [v]
        simpa [Nat.add_assoc] using hstep (N + j) (Nat.le_add_right N j)
      simpa [v] using le_geom (le_of_lt hq) k hv
    have hqk_nonneg : 0 ≤ q ^ k := pow_nonneg (le_of_lt hq) k
    calc
      u (N + k) ≤ q ^ k * u N := hgeom
      _ ≤ q ^ k * (u N + 1) := by nlinarith
      _ = ((u N + 1) * (q ^ N)⁻¹) * q ^ (N + k) := by
          rw [pow_add]
          field_simp [ne_of_gt (pow_pos hq N)]

private theorem thm41_summable_of_eventual_norm_le_geometric {u : ℕ → ℝ} {N : ℕ}
    {C q : ℝ} (hq_nonneg : 0 ≤ q) (hq_lt_one : q < 1)
    (hbound : ∀ n ≥ N, ‖u n‖ ≤ C * q ^ n) :
    Summable u := by
  have hev : ∀ᶠ n : ℕ in atTop, ‖u n‖ ≤ C * ‖q ^ n‖ := by
    filter_upwards [eventually_atTop.mpr ⟨N, hbound⟩] with n hn
    simpa [Real.norm_eq_abs, abs_of_nonneg hq_nonneg] using hn
  have hbig : u =O[atTop] (fun n : ℕ => q ^ n) := by
    rw [Asymptotics.isBigO_iff]
    exact ⟨C, hev⟩
  exact summable_of_isBigO_nat (summable_geometric_of_lt_one hq_nonneg hq_lt_one) hbig

private theorem thm41_summable_of_eventual_nonneg_le_geometric {u : ℕ → ℝ} {N : ℕ}
    {C q : ℝ} (hq_nonneg : 0 ≤ q) (hq_lt_one : q < 1)
    (hu_nonneg : ∀ n ≥ N, 0 ≤ u n)
    (hbound : ∀ n ≥ N, u n ≤ C * q ^ n) :
    Summable u := by
  exact thm41_summable_of_eventual_norm_le_geometric hq_nonneg hq_lt_one
    (fun n hn => by
      simpa [Real.norm_eq_abs, abs_of_nonneg (hu_nonneg n hn)] using hbound n hn)

private theorem thm41_summable_of_eventual_contract_step {u : ℕ → ℝ} {N : ℕ}
    {q : ℝ} (hq_pos : 0 < q) (hq_lt_one : q < 1)
    (hu_nonneg : ∀ n ≥ N, 0 ≤ u n)
    (hstep : ∀ n ≥ N, u (n + 1) ≤ q * u n) :
    Summable u := by
  rcases thm41_eventual_upper_geometric_of_step hq_pos hstep (hu_nonneg N le_rfl) with
    ⟨C, _hCpos, hC⟩
  exact thm41_summable_of_eventual_nonneg_le_geometric (le_of_lt hq_pos) hq_lt_one
    hu_nonneg hC

private theorem thm41_eventually_half_le_of_equiv {a b : ℕ → ℝ}
    (hequiv : a ~[atTop] b) (hb_nonneg : ∀ᶠ n in atTop, 0 ≤ b n) :
    ∀ᶠ n in atTop, (1 / 2 : ℝ) * b n ≤ a n := by
  rw [Asymptotics.IsEquivalent] at hequiv
  have hsmall := (Asymptotics.isLittleO_iff.mp hequiv) (by norm_num : (0 : ℝ) < 1 / 2)
  filter_upwards [hsmall, hb_nonneg] with n hn hb
  have hb_abs : ‖b n‖ = b n := by
    rw [Real.norm_eq_abs, abs_of_nonneg hb]
  have hnorm : ‖a n - b n‖ ≤ (1 / 2 : ℝ) * b n := by
    simpa [hb_abs] using hn
  have habs : |a n - b n| ≤ (1 / 2 : ℝ) * b n := by
    simpa [Real.norm_eq_abs] using hnorm
  have hneg := (abs_le.mp habs).1
  nlinarith

private theorem thm41_eventually_le_three_halves_of_equiv {a b : ℕ → ℝ}
    (hequiv : a ~[atTop] b) (hb_nonneg : ∀ᶠ n in atTop, 0 ≤ b n) :
    ∀ᶠ n in atTop, a n ≤ (3 / 2 : ℝ) * b n := by
  rw [Asymptotics.IsEquivalent] at hequiv
  have hsmall := (Asymptotics.isLittleO_iff.mp hequiv) (by norm_num : (0 : ℝ) < 1 / 2)
  filter_upwards [hsmall, hb_nonneg] with n hn hb
  have hb_abs : ‖b n‖ = b n := by
    rw [Real.norm_eq_abs, abs_of_nonneg hb]
  have hnorm : ‖a n - b n‖ ≤ (1 / 2 : ℝ) * b n := by
    simpa [hb_abs] using hn
  have habs : |a n - b n| ≤ (1 / 2 : ℝ) * b n := by
    simpa [Real.norm_eq_abs] using hnorm
  have hpos := (abs_le.mp habs).2
  nlinarith

private theorem thm41_lower_geometric_of_equiv_and_step {d R : ℕ → ℝ} {N : ℕ}
    {q : ℝ} (hq : 0 < q) (hstep : ∀ n ≥ N, q * R n ≤ R (n + 1))
    (hRN : 0 < R N) (hequiv : d ~[atTop] R) (hR_nonneg : ∀ n, 0 ≤ R n) :
    ∃ N0 C, 0 < C ∧ ∀ n ≥ N0, C * q ^ n ≤ d n := by
  rcases thm41_eventual_lower_geometric_of_step hq hstep hRN with ⟨CR, hCRpos, hCR⟩
  have hhalf_event := thm41_eventually_half_le_of_equiv hequiv (Eventually.of_forall hR_nonneg)
  rcases eventually_atTop.mp hhalf_event with ⟨Ne, hNe⟩
  refine ⟨max N Ne, CR / 2, by positivity, ?_⟩
  intro n hn
  have hnN : N ≤ n := le_trans (le_max_left N Ne) hn
  have hnNe : Ne ≤ n := le_trans (le_max_right N Ne) hn
  have h1 := hCR n hnN
  have h2 := hNe n hnNe
  have hqpow_nonneg : 0 ≤ q ^ n := pow_nonneg (le_of_lt hq) n
  nlinarith

private theorem thm41_tail_tsum_le_of_geometric_bound {a : ℕ → ℝ} {N : ℕ}
    {C q : ℝ} (hq_nonneg : 0 ≤ q) (hq_lt_one : q < 1)
    (ha_nonneg : ∀ n, 0 ≤ a n)
    (hbound : ∀ n ≥ N, a n ≤ C * q ^ n) :
    ∃ Ctail, 0 < Ctail ∧ ∀ n ≥ N,
      Summable (fun k : ℕ => a (n + k)) ∧
        (∑' k : ℕ, a (n + k)) ≤ Ctail * q ^ n := by
  let Cpos : ℝ := |C| + 1
  have hCpos_pos : 0 < Cpos := by
    dsimp [Cpos]
    positivity
  have hC_le : C ≤ Cpos := by
    dsimp [Cpos]
    exact le_trans (le_abs_self C) (by linarith)
  have hgeom_sum : Summable (fun k : ℕ => q ^ k) :=
    summable_geometric_of_lt_one hq_nonneg hq_lt_one
  refine ⟨Cpos * (1 - q)⁻¹, ?_, ?_⟩
  · have hden : 0 < (1 - q)⁻¹ := inv_pos.mpr (by linarith)
    exact mul_pos hCpos_pos hden
  · intro n hn
    have htail_bound : ∀ k : ℕ, a (n + k) ≤ Cpos * q ^ (n + k) := by
      intro k
      have hnki : N ≤ n + k := le_trans hn (Nat.le_add_right n k)
      have h1 := hbound (n + k) hnki
      have hqpow_nonneg : 0 ≤ q ^ (n + k) := pow_nonneg hq_nonneg _
      calc
        a (n + k) ≤ C * q ^ (n + k) := h1
        _ ≤ Cpos * q ^ (n + k) := mul_le_mul_of_nonneg_right hC_le hqpow_nonneg
    have htail_summable : Summable (fun k : ℕ => a (n + k)) := by
      have hbig : (fun k : ℕ => a (n + k)) =O[atTop] (fun k : ℕ => q ^ k) := by
        rw [Asymptotics.isBigO_iff]
        refine ⟨Cpos * q ^ n, Eventually.of_forall ?_⟩
        intro k
        have hleft_abs : ‖a (n + k)‖ = a (n + k) := by
          rw [Real.norm_eq_abs, abs_of_nonneg (ha_nonneg _)]
        have hright_abs : ‖q ^ k‖ = q ^ k := by
          rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hq_nonneg k)]
        have h := htail_bound k
        rw [hleft_abs, hright_abs]
        calc
          a (n + k) ≤ Cpos * q ^ (n + k) := h
          _ = Cpos * q ^ n * q ^ k := by rw [pow_add]; ring
      exact summable_of_isBigO_nat hgeom_sum hbig
    have hgeom_tail_sum :
        (∑' k : ℕ, Cpos * q ^ (n + k)) = Cpos * (1 - q)⁻¹ * q ^ n := by
      calc
        (∑' k : ℕ, Cpos * q ^ (n + k))
            = ∑' k : ℕ, (Cpos * q ^ n) * q ^ k := by
                apply tsum_congr
                intro k
                rw [pow_add]
                ring
        _ = (Cpos * q ^ n) * (∑' k : ℕ, q ^ k) := by rw [tsum_mul_left]
        _ = (Cpos * q ^ n) * (1 - q)⁻¹ := by
          rw [tsum_geometric_of_lt_one hq_nonneg hq_lt_one]
        _ = Cpos * (1 - q)⁻¹ * q ^ n := by ring
    have hgeom_tail_summable : Summable (fun k : ℕ => Cpos * q ^ (n + k)) := by
      simpa [pow_add, mul_assoc, mul_left_comm, mul_comm] using
        (hgeom_sum.mul_left (Cpos * q ^ n))
    have hsum_le :
        (∑' k : ℕ, a (n + k)) ≤ ∑' k : ℕ, Cpos * q ^ (n + k) :=
      Summable.tsum_le_tsum htail_bound htail_summable hgeom_tail_summable
    refine ⟨htail_summable, ?_⟩
    calc
      (∑' k : ℕ, a (n + k)) ≤ ∑' k : ℕ, Cpos * q ^ (n + k) := hsum_le
      _ = (Cpos * (1 - q)⁻¹) * q ^ n := hgeom_tail_sum

private theorem thm41_convexOn_of_strongConvex (g : H → ℝ) (M : ℝ)
    (hstrong : IsStronglyConvex g M) :
    ConvexOn ℝ Set.univ g := by
  classical
  constructor
  · exact convex_univ
  · intro x hx y hy a b ha hb hab
    let z : H := y - x
    let φ : ℝ → ℝ := fun t => g (x + t • z)
    have hg_cont : Continuous g := hstrong.2.1.continuous
    have hφ_cont : Continuous φ := by
      have hline : Continuous fun t : ℝ => x + t • z := by fun_prop
      exact hg_cont.comp hline
    have hφ_diff_at : ∀ t : ℝ, HasDerivAt φ (inner ℝ (gradient g (x + t • z)) z) t := by
      intro t
      have hg_diff : DifferentiableAt ℝ g (x + t • z) :=
        (hstrong.2.1.differentiable (by norm_num)) _
      have hline : HasDerivAt (fun s : ℝ => x + s • z) z t := by
        simpa using ((hasDerivAt_id t).smul_const z).const_add x
      have hcomp := hg_diff.hasFDerivAt.comp_hasDerivAt t hline
      have hcomp' : HasDerivAt (fun s : ℝ => g (x + s • z))
          ((fderiv ℝ g (x + t • z)) z) t := by
        simpa [Function.comp_def] using hcomp
      have hfg : (fderiv ℝ g (x + t • z)) z =
          inner ℝ (gradient g (x + t • z)) z := by
        simpa using (inner_gradient_left hg_diff (y := z)).symm
      simpa [φ, hfg] using hcomp'
    have hφ_deriv : ∀ t : ℝ, deriv φ t = inner ℝ (gradient g (x + t • z)) z := by
      intro t
      exact (hφ_diff_at t).deriv
    have hφ_deriv_mono : MonotoneOn (deriv φ) (interior (Set.univ : Set ℝ)) := by
      intro s hs t ht hst
      rw [hφ_deriv s, hφ_deriv t]
      by_cases heq : s = t
      · subst t
        rfl
      have hlt : s < t := lt_of_le_of_ne hst heq
      let xs : H := x + s • z
      let xt : H := x + t • z
      have hmono := hstrong.2.2 xt xs
      have hdiff : xt - xs = (t - s) • z := by
        dsimp [xt, xs]
        module
      have hpos : 0 < t - s := sub_pos.mpr hlt
      have hnonneg_inner : 0 ≤ inner ℝ (gradient g xt - gradient g xs) z := by
        have hmain : 0 ≤ (t - s) * inner ℝ (gradient g xt - gradient g xs) z := by
          have hnorm_nonneg : 0 ≤ M * ‖xt - xs‖ ^ 2 :=
            mul_nonneg (le_of_lt hstrong.1) (sq_nonneg _)
          have hleft : inner ℝ (gradient g xt - gradient g xs) (xt - xs) =
              (t - s) * inner ℝ (gradient g xt - gradient g xs) z := by
            rw [hdiff, inner_smul_right]
          nlinarith [hmono, hnorm_nonneg, hleft]
        exact nonneg_of_mul_nonneg_right hmain hpos
      have hinner_eq : inner ℝ (gradient g xt - gradient g xs) z =
          inner ℝ (gradient g xt) z - inner ℝ (gradient g xs) z := by
        rw [inner_sub_left]
      nlinarith
    have hφ_conv : ConvexOn ℝ Set.univ φ := by
      exact MonotoneOn.convexOn_of_deriv convex_univ hφ_cont.continuousOn
        (fun t ht => (hφ_diff_at t).differentiableAt.differentiableWithinAt)
        hφ_deriv_mono
    have hφ01 := hφ_conv.2 (by simp : (0 : ℝ) ∈ Set.univ)
      (by simp : (1 : ℝ) ∈ Set.univ) ha hb hab
    have harg : x + b • z = a • x + b • y := by
      dsimp [z]
      calc
        x + b • (y - x) = (1 - b) • x + b • y := by module
        _ = a • x + b • y := by
          have haeq : a = 1 - b := by linarith
          rw [haeq]
    have hxz : x + z = y := by
      dsimp [z]
      abel
    simpa [φ, harg, hxz] using hφ01

omit [CompleteSpace H] in
private theorem thm41_ereal_convex_of_toReal_convex (f : H → EReal)
    (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hconv : ConvexOn ℝ Set.univ (fun x => (f x).toReal)) :
    ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y := by
  intro x y a b ha hb hab
  have hreal := hconv.2 (by simp : x ∈ (Set.univ : Set H))
    (by simp : y ∈ (Set.univ : Set H)) ha hb hab
  have hleft : f (a • x + b • y) = ((f (a • x + b • y)).toReal : EReal) := by
    exact (EReal.coe_toReal (hfinite _).1 (hfinite _).2).symm
  have hxcoe : f x = ((f x).toReal : EReal) := by
    exact (EReal.coe_toReal (hfinite x).1 (hfinite x).2).symm
  have hycoe : f y = ((f y).toReal : EReal) := by
    exact (EReal.coe_toReal (hfinite y).1 (hfinite y).2).symm
  rw [hleft, hxcoe, hycoe]
  simp only [ge_iff_le]
  exact EReal.coe_le_coe_iff.mpr hreal

private theorem thm41_ereal_convex_of_strongConvex (f : H → EReal) (M : ℝ)
    (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hstrong : IsStronglyConvex (fun x => (f x).toReal) M) :
    ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y := by
  exact thm41_ereal_convex_of_toReal_convex f hfinite
    (thm41_convexOn_of_strongConvex (fun x => (f x).toReal) M hstrong)

private theorem thm41_eventual_distance_pos_of_not_finite [FiniteDimensional ℝ H]
    (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ)
    (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_C11 : IsC11 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (M : ℝ) (hf_strongConv : IsStronglyConvex (fun x => (f x).toReal) M)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x => gradient (fun y => (f y).toReal) x))
    (lam_seq : ℕ → ℝ) (hlam_pos : ∀ n, lam_seq n > 0)
    (hlam_nondec : ∀ n, lam_seq n ≤ lam_seq (n + 1))
    (x : ℕ → H) (halg : AlgorithmA A B x lam_seq)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (h_smooth : IsSmoothAt (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf))
    (hnot_finite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    ∃ N, ∀ n ≥ N, 0 < ‖x n - xInf‖ := by
  rcases thm41_smoothAt_unit_normal h_smooth with ⟨u, hu_norm, hu_normal⟩
  let D : Set ℕ := stationaryIndices x
  let R : ℕ → ℝ := fun n => ∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖
  have hf_conv :
      ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
        f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y :=
    thm41_ereal_convex_of_strongConvex f M hfinite hf_strongConv
  have halt :=
    prop_4_1_eventual_alternative A B hA hdomA hAzero_int f hfinite hf_conv
      hf_C11.1 hinf hB_eq_grad lam_seq hlam_pos hlam_nondec x halg xInf hxInf
      h_smooth D rfl u hu_norm R rfl hu_normal hnot_finite
  rcases halt with hzero | hpos
  · exfalso
    rcases hzero with ⟨N, hN⟩
    exact hnot_finite ⟨N, by
      intro n hn
      calc
        x n = xInf := hN n hn
        _ = x N := (hN N le_rfl).symm⟩
  · exact hpos

private theorem thm41_tail_summable_of_isBigO_summable {a R : ℕ → ℝ}
    (hR_sum : Summable R) (hbig : a =O[atTop] R) :
    ∃ n0, ∀ n ≥ n0, Summable (fun k : ℕ => a (n + k)) := by
  have ha_sum : Summable a := summable_of_isBigO_nat hR_sum hbig
  refine ⟨0, ?_⟩
  intro n hn
  simpa [Nat.add_comm] using (summable_nat_add_iff (f := a) n).mpr ha_sum

private theorem thm41_tail_summable_of_equiv_summable {a R : ℕ → ℝ}
    (hR_sum : Summable R) (hequiv : a ~[atTop] R) :
    ∃ n0, ∀ n ≥ n0, Summable (fun k : ℕ => a (n + k)) := by
  exact thm41_tail_summable_of_isBigO_summable hR_sum hequiv.isBigO

private theorem thm41_summable_of_tsum_pos {f : ℕ → ℝ}
    (hpos : 0 < ∑' n : ℕ, f n) : Summable f := by
  by_contra hnot
  rw [tsum_eq_zero_of_not_summable hnot] at hpos
  exact (lt_irrefl (0 : ℝ)) hpos

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem thm41_exists_mem_dist_le_infDist_add {C : Set H} {z : H} {r ε : ℝ}
    (hC : C.Nonempty) (hε : 0 < ε) (h : Metric.infDist z C ≤ r) :
    ∃ ξ ∈ C, dist z ξ ≤ r + ε := by
  have hlt : Metric.infDist z C < r + ε := lt_of_le_of_lt h (lt_add_of_pos_right r hε)
  rcases (Metric.infDist_lt_iff hC).mp hlt with ⟨ξ, hξ, hξdist⟩
  exact ⟨ξ, hξ, le_of_lt hξdist⟩

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem thm41_excess_point_le_of_bdd {A B : Set H} {a : H} {c : ℝ}
    (hbdd : BddAbove (Set.range (fun x : A => Metric.infDist (x : H) B)))
    (ha : a ∈ A) (h : excess A B ≤ c) : Metric.infDist a B ≤ c := by
  let F : A → ℝ := fun x => Metric.infDist (x : H) B
  have hbot : sSup (∅ : Set ℝ) ≤ ⨆ x : A, F x := by
    simp only [Real.sSup_empty]
    exact le_trans Metric.infDist_nonneg (le_ciSup hbdd ⟨a, ha⟩)
  have hexcess_eq : excess A B = ⨆ x : A, F x := by
    unfold excess
    exact (ciSup_subtype (p := fun x : H => x ∈ A) (f := F) hbdd hbot).symm
  have hsup_le : (⨆ x : A, F x) ≤ c := by
    simpa [hexcess_eq] using h
  have hpoint : F ⟨a, ha⟩ ≤ ⨆ x : A, F x := le_ciSup hbdd ⟨a, ha⟩
  exact le_trans hpoint hsup_le

