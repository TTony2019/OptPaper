private theorem thm41_bddAbove_infDist_of_isBounded {A B : Set H}
    (hA_bdd : Bornology.IsBounded A) (hB : B.Nonempty) :
    BddAbove (Set.range (fun x : A => Metric.infDist (x : H) B)) := by
  rcases hB with ⟨b0, hb0⟩
  rcases (isBounded_iff_forall_norm_le (s := A)).mp hA_bdd with ⟨C, hC⟩
  refine ⟨C + ‖b0‖, ?_⟩
  intro r hr
  rcases hr with ⟨x, rfl⟩
  calc
    Metric.infDist (x : H) B ≤ dist (x : H) b0 := Metric.infDist_le_dist_of_mem hb0
    _ = ‖(x : H) - b0‖ := dist_eq_norm _ _
    _ ≤ ‖(x : H)‖ + ‖b0‖ := norm_sub_le _ _
    _ ≤ C + ‖b0‖ := by nlinarith [hC (x : H) x.2]

private noncomputable def thm41_fitzLocal (A : SetValuedOperator H H) (x : H) :
    EReal :=
  ⨆ p : {p : H × H // p.2 ∈ A p.1},
    (((inner ℝ (x - p.val.1) p.val.2) / (1 + ‖p.val.1‖) : ℝ) : EReal)

private theorem thm41_fitzLocal_ge (A : SetValuedOperator H H)
    {x y v : H} (hv : v ∈ A y) :
    (((inner ℝ (x - y) v) / (1 + ‖y‖) : ℝ) : EReal) ≤
      thm41_fitzLocal A x := by
  dsimp [thm41_fitzLocal]
  exact le_iSup_of_le (⟨(y, v), hv⟩ : {p : H × H // p.2 ∈ A p.1}) le_rfl

private theorem thm41_fitzLocal_lsc (A : SetValuedOperator H H) :
    LowerSemicontinuous (thm41_fitzLocal A) := by
  unfold thm41_fitzLocal
  refine lowerSemicontinuous_iSup ?_
  intro p
  have hreal : Continuous (fun x : H =>
      (inner ℝ (x - p.val.1) p.val.2) / (1 + ‖p.val.1‖)) := by
    exact ((continuous_id.sub continuous_const).inner continuous_const).div_const _
  exact (continuous_coe_real_ereal.comp hreal).lowerSemicontinuous

private theorem thm41_fitzLocal_closed_sublevel
    (A : SetValuedOperator H H) (N : ℕ) :
    IsClosed {x : H | thm41_fitzLocal A x ≤ ((N : ℝ) : EReal)} := by
  have hlsc := thm41_fitzLocal_lsc A
  rw [lowerSemicontinuous_iff_isClosed_preimage] at hlsc
  simpa [Set.preimage, Set.Iic] using hlsc ((N : ℝ) : EReal)

private theorem thm41_fitzLocal_convex (A : SetValuedOperator H H) :
    ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      thm41_fitzLocal A (a • x + b • y) ≤
        (a : EReal) * thm41_fitzLocal A x +
          (b : EReal) * thm41_fitzLocal A y := by
  intro x y a b ha hb hab
  dsimp [thm41_fitzLocal]
  refine iSup_le ?_
  intro p
  let z : H := p.val.1
  let v : H := p.val.2
  let den : ℝ := 1 + ‖z‖
  have hden_pos : 0 < den := by
    dsimp [den]
    positivity
  have hsub : a • x + b • y - z = a • (x - z) + b • (y - z) := by
    calc
      a • x + b • y - z = a • x + b • y - (a + b) • z := by rw [hab, one_smul]
      _ = a • x + b • y - (a • z + b • z) := by rw [add_smul]
      _ = a • (x - z) + b • (y - z) := by
        simp [smul_sub]
        abel
  have hreal :
      inner ℝ (a • x + b • y - z) v / den =
        a * (inner ℝ (x - z) v / den) + b * (inner ℝ (y - z) v / den) := by
    rw [hsub, inner_add_left, real_inner_smul_left, real_inner_smul_left]
    field_simp [ne_of_gt hden_pos]
  calc
    (((inner ℝ (a • x + b • y - z) v) / den : ℝ) : EReal)
        = ((a * (inner ℝ (x - z) v / den) +
            b * (inner ℝ (y - z) v / den) : ℝ) : EReal) := by
          rw [hreal]
    _ = (a : EReal) * (((inner ℝ (x - z) v) / den : ℝ) : EReal) +
          (b : EReal) * (((inner ℝ (y - z) v) / den : ℝ) : EReal) := by
          simp [EReal.coe_add, EReal.coe_mul]
    _ ≤ (a : EReal) *
          (⨆ p : {p : H × H // p.2 ∈ A p.1},
            (((inner ℝ (x - p.val.1) p.val.2) / (1 + ‖p.val.1‖) : ℝ) : EReal)) +
          (b : EReal) *
          (⨆ p : {p : H × H // p.2 ∈ A p.1},
            (((inner ℝ (y - p.val.1) p.val.2) / (1 + ‖p.val.1‖) : ℝ) : EReal)) := by
          gcongr
          · exact le_iSup_of_le p le_rfl
          · exact le_iSup_of_le p le_rfl

private theorem thm41_fitzLocal_finite_above
    (A : SetValuedOperator H H) (hAmono : IsMonotone A) (hdomA : A.dom = Set.univ) :
    ∀ x : H, ∃ N : ℕ, thm41_fitzLocal A x ≤ ((N : ℝ) : EReal) := by
  intro x
  have hxdom : x ∈ A.dom := by
    rw [hdomA]
    simp
  rcases (SetValuedOperator.mem_dom_iff A x).mp hxdom with ⟨u, hu⟩
  rcases exists_nat_ge (‖u‖ * (‖x‖ + 1)) with ⟨N, hN⟩
  refine ⟨N, ?_⟩
  dsimp [thm41_fitzLocal]
  refine iSup_le ?_
  intro p
  let y : H := p.val.1
  let v : H := p.val.2
  let den : ℝ := 1 + ‖y‖
  have hv : v ∈ A y := p.2
  have hden_pos : 0 < den := by
    dsimp [den]
    positivity
  have hmono := hAmono u hu v hv
  have hinner_le : inner ℝ (x - y) v ≤ inner ℝ (x - y) u := by
    rw [inner_sub_left] at hmono
    have h' : inner ℝ v (x - y) ≤ inner ℝ u (x - y) := sub_nonneg.mp hmono
    simpa [real_inner_comm] using h'
  have hnum_le : inner ℝ (x - y) v ≤ ‖u‖ * (‖x‖ + ‖y‖) := by
    calc
      inner ℝ (x - y) v ≤ inner ℝ (x - y) u := hinner_le
      _ ≤ |inner ℝ (x - y) u| := le_abs_self _
      _ ≤ ‖x - y‖ * ‖u‖ := abs_real_inner_le_norm _ _
      _ ≤ (‖x‖ + ‖y‖) * ‖u‖ := by
        gcongr
        exact norm_sub_le x y
      _ = ‖u‖ * (‖x‖ + ‖y‖) := by ring
  have hfrac_le :
      inner ℝ (x - y) v / den ≤ ‖u‖ * (‖x‖ + 1) := by
    calc
      inner ℝ (x - y) v / den ≤ (‖u‖ * (‖x‖ + ‖y‖)) / den := by
        gcongr
      _ ≤ ‖u‖ * (‖x‖ + 1) := by
        rw [div_le_iff₀ hden_pos]
        have hmiddle : ‖x‖ + ‖y‖ ≤ (‖x‖ + 1) * (1 + ‖y‖) := by
          nlinarith [mul_nonneg (norm_nonneg x) (norm_nonneg y)]
        calc
          ‖u‖ * (‖x‖ + ‖y‖)
              ≤ ‖u‖ * ((‖x‖ + 1) * (1 + ‖y‖)) :=
                mul_le_mul_of_nonneg_left hmiddle (norm_nonneg u)
          _ = ‖u‖ * (‖x‖ + 1) * den := by
            dsimp [den]
            ring
  exact EReal.coe_le_coe (le_trans hfrac_le hN)

private theorem thm41_ereal_convex_finite_locally_bddAbove
    (f : H → EReal)
    (hclosed : ∀ N : ℕ, IsClosed {x : H | f x ≤ ((N : ℝ) : EReal)})
    (hfinite : ∀ x : H, ∃ N : ℕ, f x ≤ ((N : ℝ) : EReal))
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (z : H) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ M : ℝ, ∀ x ∈ Metric.ball z δ, f x ≤ (M : EReal) := by
  classical
  let C : ℕ → Set H := fun N => {x : H | f x ≤ ((N : ℝ) : EReal)}
  have hcover : (⋃ N : ℕ, C N) = Set.univ := by
    ext x
    constructor
    · intro _
      simp
    · intro _
      rcases hfinite x with ⟨N, hN⟩
      exact Set.mem_iUnion.2 ⟨N, hN⟩
  rcases nonempty_interior_of_iUnion_of_closed (fun N => by simpa [C] using hclosed N)
      hcover with ⟨N, hNint⟩
  rcases hNint with ⟨c, hc⟩
  have hnhds : C N ∈ 𝓝 c := mem_interior_iff_mem_nhds.mp hc
  rcases Metric.mem_nhds_iff.mp hnhds with ⟨ε, hε, hε_subset⟩
  let p : H := (2 : ℝ) • z - c
  rcases hfinite p with ⟨K, hK⟩
  refine ⟨ε / 4, by positivity, ((1 / 2 : ℝ) * (N : ℝ) + (1 / 2 : ℝ) * (K : ℝ)), ?_⟩
  intro x hx
  let q : H := (2 : ℝ) • x - p
  have hq_ball : q ∈ Metric.ball c ε := by
    have hq_sub : q - c = (2 : ℝ) • (x - z) := by
      dsimp [q, p]
      module
    have hx_norm : ‖x - z‖ < ε / 4 := by
      simpa [Metric.mem_ball, dist_eq_norm] using hx
    rw [Metric.mem_ball, dist_eq_norm, hq_sub, norm_smul]
    have htwo : ‖(2 : ℝ)‖ = (2 : ℝ) := by norm_num
    rw [htwo]
    nlinarith [norm_nonneg (x - z)]
  have hqC : f q ≤ ((N : ℝ) : EReal) := hε_subset hq_ball
  have hx_combo : x = (1 / 2 : ℝ) • q + (1 / 2 : ℝ) • p := by
    dsimp [q]
    module
  have hfx := hconv q p (1 / 2) (1 / 2)
    (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (0 : ℝ) ≤ 1 / 2)
    (by norm_num : (1 / 2 : ℝ) + 1 / 2 = 1)
  rw [← hx_combo] at hfx
  calc
    f x ≤ (1 / 2 : EReal) * f q + (1 / 2 : EReal) * f p := hfx
    _ ≤ (1 / 2 : EReal) * ((N : ℝ) : EReal) +
          (1 / 2 : EReal) * ((K : ℝ) : EReal) := by
        gcongr
    _ = (((1 / 2 : ℝ) * (N : ℝ) + (1 / 2 : ℝ) * (K : ℝ) : ℝ) : EReal) := by
        have hhalf : ((1 / 2 : EReal) = ((1 / 2 : ℝ) : EReal)) := by
          change (((1 : ℝ) : EReal) / ((2 : ℝ) : EReal)) = ((1 / 2 : ℝ) : EReal)
          rw [← EReal.coe_div]
        rw [hhalf, ← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add]

private theorem thm41_full_domain_local_bounded
    (A : SetValuedOperator H H) (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ)
    (x0 : H) :
    ∃ δ : ℝ, 0 < δ ∧ Bornology.IsBounded (A.image (Metric.ball x0 δ)) := by
  let f : H → EReal := thm41_fitzLocal A
  rcases thm41_ereal_convex_finite_locally_bddAbove f
      (by intro N; simpa [f] using thm41_fitzLocal_closed_sublevel A N)
      (by intro x; simpa [f] using thm41_fitzLocal_finite_above A hA.1 hdomA x)
      (by
        intro x y a b ha hb hab
        simpa [f] using thm41_fitzLocal_convex A x y a b ha hb hab)
      x0 with ⟨ρ, hρ, M, hM⟩
  let Mpos : ℝ := max M 0 + 1
  have hMpos_pos : 0 < Mpos := by
    dsimp [Mpos]
    linarith [le_max_right M 0]
  have hMpos_nonneg : 0 ≤ Mpos := le_of_lt hMpos_pos
  have hM_le_Mpos : M ≤ Mpos := by
    dsimp [Mpos]
    linarith [le_max_left M 0]
  refine ⟨ρ / 4, by positivity, ?_⟩
  rw [isBounded_iff_forall_norm_le]
  refine ⟨(4 / ρ) * Mpos * (1 + ‖x0‖ + ρ / 4), ?_⟩
  intro w hw
  rcases (SetValuedOperator.mem_image A (Metric.ball x0 (ρ / 4)) w).mp hw with
    ⟨z, hzball, hwA⟩
  by_cases hw0 : w = 0
  · subst w
    have hC_nonneg : 0 ≤ (4 / ρ) * Mpos * (1 + ‖x0‖ + ρ / 4) := by
      positivity
    simpa using hC_nonneg
  · let e : H := ‖w‖⁻¹ • w
    let xeval : H := x0 + (ρ / 2) • e
    have hw_norm_pos : 0 < ‖w‖ := norm_pos_iff.mpr hw0
    have hw_norm_ne : ‖w‖ ≠ 0 := ne_of_gt hw_norm_pos
    have he_norm : ‖e‖ = 1 := by
      dsimp [e]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hw_norm_pos)]
      exact inv_mul_cancel₀ hw_norm_ne
    have hew : inner ℝ e w = ‖w‖ := by
      dsimp [e]
      rw [real_inner_smul_left, real_inner_self_eq_norm_sq]
      field_simp [hw_norm_ne]
    have hxeval_ball : xeval ∈ Metric.ball x0 ρ := by
      have hdist : dist xeval x0 = ρ / 2 := by
        rw [dist_eq_norm]
        have hsub : xeval - x0 = (ρ / 2) • e := by
          dsimp [xeval]
          abel
        rw [hsub, norm_smul, he_norm, mul_one]
        rw [Real.norm_eq_abs, abs_of_pos (by positivity : 0 < ρ / 2)]
      rw [Metric.mem_ball, hdist]
      linarith
    have hlocalM : thm41_fitzLocal A xeval ≤ (Mpos : EReal) := by
      exact le_trans (by simpa [f] using hM xeval hxeval_ball)
        (EReal.coe_le_coe hM_le_Mpos)
    have hfitz_ge :
        (((inner ℝ (xeval - z) w) / (1 + ‖z‖) : ℝ) : EReal) ≤
          thm41_fitzLocal A xeval :=
      thm41_fitzLocal_ge A hwA
    have htermE :
        (((inner ℝ (xeval - z) w) / (1 + ‖z‖) : ℝ) : EReal) ≤
          (Mpos : EReal) := le_trans hfitz_ge hlocalM
    have hterm_real :
        inner ℝ (xeval - z) w / (1 + ‖z‖) ≤ Mpos :=
      EReal.coe_le_coe_iff.mp htermE
    have hden_pos : 0 < 1 + ‖z‖ := by positivity
    have hinner_le : inner ℝ (xeval - z) w ≤ Mpos * (1 + ‖z‖) := by
      rwa [div_le_iff₀ hden_pos] at hterm_real
    have hxeval_sub : xeval - z = (x0 - z) + (ρ / 2) • e := by
      dsimp [xeval]
      abel
    have hinner_eq :
        inner ℝ (xeval - z) w =
          inner ℝ (x0 - z) w + (ρ / 2) * ‖w‖ := by
      rw [hxeval_sub, inner_add_left, real_inner_smul_left, hew]
    have hz_norm_lt : ‖z - x0‖ < ρ / 4 := by
      simpa [Metric.mem_ball, dist_eq_norm] using hzball
    have hxz_norm_lt : ‖x0 - z‖ < ρ / 4 := by
      simpa [norm_sub_rev] using hz_norm_lt
    have hinner_lower :
        -((ρ / 4) * ‖w‖) ≤ inner ℝ (x0 - z) w := by
      have habs := abs_real_inner_le_norm (x0 - z) w
      have hneg_abs : -|inner ℝ (x0 - z) w| ≤ inner ℝ (x0 - z) w :=
        neg_abs_le _
      have hneg_norm : -(‖x0 - z‖ * ‖w‖) ≤ -|inner ℝ (x0 - z) w| :=
        neg_le_neg habs
      have hnormprod : ‖x0 - z‖ * ‖w‖ ≤ (ρ / 4) * ‖w‖ :=
        mul_le_mul_of_nonneg_right (le_of_lt hxz_norm_lt) (norm_nonneg w)
      nlinarith
    have hmain :
        (ρ / 4) * ‖w‖ ≤ Mpos * (1 + ‖z‖) := by
      rw [hinner_eq] at hinner_le
      nlinarith
    have hz_norm_le : ‖z‖ ≤ ‖x0‖ + ρ / 4 := by
      calc
        ‖z‖ ≤ ‖x0‖ + ‖x0 - z‖ := norm_le_norm_add_norm_sub x0 z
        _ ≤ ‖x0‖ + ρ / 4 := by linarith [le_of_lt hxz_norm_lt]
    have hmain' :
        (ρ / 4) * ‖w‖ ≤ Mpos * (1 + ‖x0‖ + ρ / 4) := by
      have hright : Mpos * (1 + ‖z‖) ≤ Mpos * (1 + ‖x0‖ + ρ / 4) := by
        have harg : 1 + ‖z‖ ≤ 1 + ‖x0‖ + ρ / 4 := by
          linarith [hz_norm_le]
        exact mul_le_mul_of_nonneg_left harg hMpos_nonneg
      exact le_trans hmain hright
    have hρ4_pos : 0 < ρ / 4 := by positivity
    have hdiv : ‖w‖ ≤ (Mpos * (1 + ‖x0‖ + ρ / 4)) / (ρ / 4) := by
      rw [le_div_iff₀ hρ4_pos]
      nlinarith
    have hconst :
        (Mpos * (1 + ‖x0‖ + ρ / 4)) / (ρ / 4) =
          (4 / ρ) * Mpos * (1 + ‖x0‖ + ρ / 4) := by
      field_simp [ne_of_gt hρ]
    simpa [hconst] using hdiv

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem thm41_bddAbove_infDist_of_local_bounded
    (A : SetValuedOperator H H) {v : H} {δ : ℝ} {B : Set H}
    (hAbdd : Bornology.IsBounded (A.image (Metric.ball (0 : H) δ)))
    (hv : v ∈ Metric.ball (0 : H) δ) (hB : B.Nonempty) :
    BddAbove (Set.range (fun x : A v => Metric.infDist (x : H) B)) := by
  have hAv_bdd : Bornology.IsBounded (A v) := by
    exact hAbdd.subset (by
      intro y hy
      exact (SetValuedOperator.mem_image A (Metric.ball (0 : H) δ) y).mpr
        ⟨v, hv, hy⟩)
  exact thm41_bddAbove_infDist_of_isBounded hAv_bdd hB

omit [CompleteSpace H] in
private theorem thm41_ray_generator_mem_normalCone {C : Set H} {xbar u : H}
    (hcone : normalCone C xbar = {v | ∃ t : ℝ, t ≥ 0 ∧ v = t • u}) :
    u ∈ normalCone C xbar := by
  rw [hcone]
  exact ⟨1, by norm_num, by simp⟩

omit [CompleteSpace H] in
private theorem thm41_normalCone_inner_nonpos {C : Set H} {xbar u y : H}
    (hxbar : xbar ∈ C) (hu : u ∈ normalCone C xbar) (hy : y ∈ C) :
    inner ℝ u (y - xbar) ≤ 0 := by
  rw [mem_normalCone_iff_forall] at hu
  simpa [real_inner_comm] using hu.2 y hy

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem thm41_increment_tail_tsum_eq_head_add_tail (x : ℕ → H) (n : ℕ)
    (hs : Summable (fun k : ℕ => ‖x (n + k + 1) - x (n + k)‖)) :
    (∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖) =
      ‖x (n + 1) - x n‖ +
        (∑' k : ℕ, ‖x (n + 1 + k + 1) - x (n + 1 + k)‖) := by
  let s : ℕ → ℝ := fun k => ‖x (n + k + 1) - x (n + k)‖
  have h := (Summable.sum_add_tsum_nat_add (f := s) 1 hs).symm
  simpa [s, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using h

omit [CompleteSpace H] in
private theorem thm41_dist_le_increment_tail_tsum (x : ℕ → H) (xInf : H)
    (hxInf : Tendsto x atTop (𝓝 xInf)) (n : ℕ)
    (hs : Summable (fun k : ℕ => ‖x (n + k + 1) - x (n + k)‖)) :
    ‖x n - xInf‖ ≤ ∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖ := by
  have hhas : HasSum (fun k : ℕ => x (n + k + 1) - x (n + k)) (xInf - x n) := by
    rw [hasSum_iff_tendsto_nat_of_summable_norm hs]
    have hshift : Tendsto (fun N : ℕ => n + N) atTop atTop :=
      Filter.tendsto_atTop_mono (fun N => Nat.le_add_left N n) tendsto_id
    have hxshift : Tendsto (fun N : ℕ => x (n + N)) atTop (𝓝 xInf) :=
      hxInf.comp hshift
    have htarget : Tendsto (fun N : ℕ => x (n + N) - x n) atTop (𝓝 (xInf - x n)) :=
      hxshift.sub tendsto_const_nhds
    refine htarget.congr' (Eventually.of_forall ?_)
    intro N
    have htel := Finset.sum_range_sub (fun k : ℕ => x (n + k)) N
    simpa [Nat.add_assoc] using htel.symm
  have hnorm :
      ‖tsum (fun k : ℕ => x (n + k + 1) - x (n + k))‖ ≤
        tsum (fun k : ℕ => ‖x (n + k + 1) - x (n + k)‖) :=
    norm_tsum_le_tsum_norm hs
  calc
    ‖x n - xInf‖ = ‖xInf - x n‖ := by rw [norm_sub_rev]
    _ = ‖tsum (fun k : ℕ => x (n + k + 1) - x (n + k))‖ := by rw [hhas.tsum_eq]
    _ ≤ tsum (fun k : ℕ => ‖x (n + k + 1) - x (n + k)‖) := hnorm

private theorem thm41_algorithm_step_selection (A B : SetValuedOperator H H)
    (lam : ℕ → ℝ) (x : ℕ → H) (halg : AlgorithmA A B x lam) :
    ∀ n, ∃ a b : H,
      a ∈ A ((lam n)⁻¹ • (x (n + 2) - x (n + 1))) ∧
      b ∈ B (x (n + 2)) ∧
      ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n) + a + b = 0 := by
  intro n
  let v : H := (lam n)⁻¹ • (x (n + 2) - x (n + 1))
  let acc : H := ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)
  have hstep : (0 : H) ∈ ({acc} : Set H) + A v + B (x (n + 2)) := by
    simpa [AlgorithmA, acc, v] using halg.step n
  rw [Set.mem_add] at hstep
  rcases hstep with ⟨p, hp, b, hb, hpbeq⟩
  rw [Set.mem_add] at hp
  rcases hp with ⟨c, hc, a, ha, hp_eq⟩
  rw [Set.mem_singleton_iff] at hc
  subst c
  refine ⟨a, b, ?_, hb, ?_⟩
  · simpa [v]
  · have hp_eq' : acc + a = p := by simpa [hp_eq]
    rw [← hpbeq, ← hp_eq']

private theorem thm41_mem_gradient_operator_eq (B : SetValuedOperator H H) (g : H → ℝ)
    (hB : B = SetValuedOperator.ofFunction Set.univ
      (fun x : (Set.univ : Set H) => gradient g x.1)) {y b : H}
    (hb : b ∈ B y) :
    b = gradient g y := by
  rw [hB] at hb
  have hset := SetValuedOperator.ofFunction_apply_of_mem Set.univ
    (fun x : (Set.univ : Set H) => gradient g x.1) (by simp : y ∈ Set.univ)
  rw [hset] at hb
  simpa using hb

omit [CompleteSpace H] in
private theorem thm41_direction_error_isLittleO (x : ℕ → H) (D : Set ℕ)
    (hD : D = stationaryIndices x) (u : H)
    (hdir : Tendsto (normalizedIncrementDirection x)
      (atTop ⊓ Filter.principal {n | n ∉ D}) (𝓝 u)) :
    (fun n => ‖x (n + 1) - x n‖ • u - (x (n + 1) - x n)) =o[atTop]
      (fun n => ‖x (n + 1) - x n‖) := by
  rw [Asymptotics.isLittleO_iff]
  intro c hc
  have hball : Metric.ball u c ∈ 𝓝 u := Metric.ball_mem_nhds u hc
  have hev_inf : ∀ᶠ n in atTop ⊓ Filter.principal {n | n ∉ D},
      normalizedIncrementDirection x n ∈ Metric.ball u c := hdir hball
  have hset : {n : ℕ | normalizedIncrementDirection x n ∈ Metric.ball u c} ∈
      (atTop ⊓ Filter.principal {n : ℕ | n ∉ D}) := hev_inf
  rw [Filter.mem_inf_iff] at hset
  rcases hset with ⟨S, hS, T, hT, hST⟩
  rw [mem_principal] at hT
  rcases eventually_atTop.mp hS with ⟨N, hN⟩
  refine eventually_atTop.mpr ⟨N, ?_⟩
  intro n hn
  by_cases hnD : n ∈ D
  · have hstat : n ∈ stationaryIndices x := by simpa [hD] using hnD
    have hzero : x (n + 1) - x n = 0 := by
      simpa [stationaryIndices] using sub_eq_zero.mpr hstat
    simp [hzero]
  · have hnclose_mem : n ∈
        {m : ℕ | normalizedIncrementDirection x m ∈ Metric.ball u c} := by
      rw [hST]
      exact ⟨hN n hn, hT hnD⟩
    have hclose : ‖normalizedIncrementDirection x n - u‖ < c := by
      simpa [Metric.mem_ball, dist_eq_norm] using hnclose_mem
    have hnstat : n ∉ stationaryIndices x := by simpa [hD] using hnD
    let inc : H := x (n + 1) - x n
    have hne : inc ≠ 0 := by
      dsimp [inc]
      simp [stationaryIndices] at hnstat
      exact sub_ne_zero.mpr hnstat
    have hdir_eq : ‖inc‖ • normalizedIncrementDirection x n = inc := by
      dsimp [inc, normalizedIncrementDirection]
      rw [smul_smul, mul_inv_cancel₀ (norm_ne_zero_iff.mpr hne), one_smul]
    have hrewrite :
        ‖inc‖ • u - inc = ‖inc‖ • (u - normalizedIncrementDirection x n) := by
      calc
        ‖inc‖ • u - inc =
            ‖inc‖ • u - ‖inc‖ • normalizedIncrementDirection x n := by
          nth_rw 2 [← hdir_eq]
        _ = ‖inc‖ • (u - normalizedIncrementDirection x n) := by rw [smul_sub]
    have hclose' : ‖u - normalizedIncrementDirection x n‖ < c := by
      simpa [norm_sub_rev] using hclose
    have hnonneg : 0 ≤ ‖inc‖ := norm_nonneg _
    have hle : ‖‖inc‖ • (u - normalizedIncrementDirection x n)‖ ≤ c * ‖inc‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hnonneg]
      nlinarith [hclose', hnonneg]
    change ‖‖inc‖ • u - inc‖ ≤ c * ‖(‖inc‖ : ℝ)‖
    rw [hrewrite, Real.norm_eq_abs, abs_of_nonneg hnonneg]
    exact hle

omit [CompleteSpace H] in
private theorem thm41_increment_inner_eventually_ge (x : ℕ → H) (D : Set ℕ)
    (hD : D = stationaryIndices x) (u : H) (hu_norm : ‖u‖ = 1)
    (hdir : Tendsto (normalizedIncrementDirection x)
      (atTop ⊓ Filter.principal {n | n ∉ D}) (𝓝 u)) :
    ∀ ε : ℝ, 0 < ε →
      ∀ᶠ n in atTop,
        (1 - ε) * ‖x (n + 1) - x n‖ ≤ inner ℝ (x (n + 1) - x n) u := by
  intro ε hε
  have herr := (Asymptotics.isLittleO_iff.mp
    (thm41_direction_error_isLittleO x D hD u hdir)) hε
  filter_upwards [herr] with n hn
  let inc : H := x (n + 1) - x n
  have hnorm_err : ‖‖inc‖ • u - inc‖ ≤ ε * ‖inc‖ := by
    simpa [inc, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg inc)] using hn
  have hinner_abs :
      |inner ℝ (‖inc‖ • u - inc) u| ≤ ε * ‖inc‖ := by
    calc
      |inner ℝ (‖inc‖ • u - inc) u| ≤ ‖‖inc‖ • u - inc‖ * ‖u‖ :=
        abs_real_inner_le_norm _ _
      _ = ‖‖inc‖ • u - inc‖ := by rw [hu_norm, mul_one]
      _ ≤ ε * ‖inc‖ := hnorm_err
  have hinner_high := (abs_le.mp hinner_abs).2
  have hinner_expand :
      inner ℝ (‖inc‖ • u - inc) u = ‖inc‖ - inner ℝ inc u := by
    rw [inner_sub_left, real_inner_smul_left, real_inner_self_eq_norm_sq, hu_norm]
    norm_num
  rw [hinner_expand] at hinner_high
  nlinarith

private theorem thm41_eventually_abs_sub_le_of_equiv {a b : ℕ → ℝ}
    (hequiv : a ~[atTop] b) (hb_nonneg : ∀ n, 0 ≤ b n) :
    ∀ ε : ℝ, 0 < ε → ∀ᶠ n in atTop, |a n - b n| ≤ ε * b n := by
  intro ε hε
  rw [Asymptotics.IsEquivalent] at hequiv
  have hsmall := (Asymptotics.isLittleO_iff.mp hequiv) hε
  filter_upwards [hsmall] with n hn
  have hb_abs : ‖b n‖ = b n := by
    rw [Real.norm_eq_abs, abs_of_nonneg (hb_nonneg n)]
  simpa [Real.norm_eq_abs, hb_abs] using hn

private theorem thm41_gradient_inner_eventually_ge (g : H → ℝ) (M : ℝ)
    (hstrong : IsStronglyConvex g M)
    (x : ℕ → H) (xInf u : H) (R : ℕ → ℝ) (hu_norm : ‖u‖ = 1)
    (hexp : (fun n => x n - xInf + (R n) • u) =o[atTop] R)
    (hequiv : (fun n => ‖x n - xInf‖) ~[atTop] R)
    (hR_nonneg : ∀ n, 0 ≤ R n) (hR_eventually_pos : ∀ᶠ n in atTop, 0 < R n)
    (Lgrad : ℝ) (hLgrad_pos : 0 < Lgrad) (NLip : ℕ)
    (hgrad_lip : ∀ n ≥ NLip, ‖gradient g (x n) - gradient g xInf‖ ≤
      Lgrad * ‖x n - xInf‖) :
    ∀ ε : ℝ, 0 < ε →
      ∀ᶠ n in atTop,
        (M - ε) * R n ≤ inner ℝ (gradient g (x n) - gradient g xInf) (-u) := by
  intro ε hε
  have hMpos : 0 < M := hstrong.1
  let denom : ℝ := 2 * M + 2 * Lgrad + 1
  have hdenom_pos : 0 < denom := by
    dsimp [denom]
    nlinarith
  let δ : ℝ := min (1 / 2) (ε / denom)
  have hδpos : 0 < δ := by
    dsimp [δ]
    exact lt_min (by norm_num) (div_pos hε hdenom_pos)
  have hδnonneg : 0 ≤ δ := le_of_lt hδpos
  have hδle_one : δ ≤ 1 := by
    dsimp [δ]
    exact le_trans (min_le_left _ _) (by norm_num)
  have hδle_half : δ ≤ 1 / 2 := by
    dsimp [δ]
    exact min_le_left _ _
  have hδsmall : δ * (2 * M + 2 * Lgrad) ≤ ε := by
    have hδle : δ ≤ ε / denom := by
      dsimp [δ]
      exact min_le_right _ _
    have hcoef_nonneg : 0 ≤ 2 * M + 2 * Lgrad := by nlinarith
    calc
      δ * (2 * M + 2 * Lgrad) ≤ (ε / denom) * (2 * M + 2 * Lgrad) :=
        mul_le_mul_of_nonneg_right hδle hcoef_nonneg
      _ ≤ ε := by
        rw [div_mul_eq_mul_div]
        rw [div_le_iff₀ hdenom_pos]
        have hε_nonneg : 0 ≤ ε := le_of_lt hε
        dsimp [denom]
        nlinarith
  have herr_event := (Asymptotics.isLittleO_iff.mp hexp) hδpos
  have hequiv_event := thm41_eventually_abs_sub_le_of_equiv hequiv hR_nonneg δ hδpos
  have hLip_event : ∀ᶠ n : ℕ in atTop, NLip ≤ n :=
    eventually_atTop.mpr ⟨NLip, fun n hn => hn⟩
  filter_upwards [herr_event, hequiv_event, hR_eventually_pos, hLip_event] with
    n herr heqv hRpos hnLip
  let y : H := x n - xInf
  let gd : H := gradient g (x n) - gradient g xInf
  let e : H := x n - xInf + (R n) • u
  have hRnonneg : 0 ≤ R n := hR_nonneg n
  have he_norm : ‖e‖ ≤ δ * R n := by
    simpa [e, Real.norm_eq_abs, abs_of_nonneg hRnonneg] using herr
  have hy_abs : |‖y‖ - R n| ≤ δ * R n := by
    simpa [y] using heqv
  have hy_lower : (1 - δ) * R n ≤ ‖y‖ := by
    have h := (abs_le.mp hy_abs).1
    nlinarith
  have hy_upper : ‖y‖ ≤ (1 + δ) * R n := by
    have h := (abs_le.mp hy_abs).2
    nlinarith
  have hgd_lip : ‖gd‖ ≤ Lgrad * ‖y‖ := by
    simpa [gd, y] using hgrad_lip n hnLip
  have herr_inner_abs :
      |inner ℝ gd e| ≤ Lgrad * (1 + δ) * δ * (R n)^2 := by
    calc
      |inner ℝ gd e| ≤ ‖gd‖ * ‖e‖ := abs_real_inner_le_norm gd e
      _ ≤ (Lgrad * ‖y‖) * (δ * R n) := by
        exact mul_le_mul hgd_lip he_norm
          (norm_nonneg e)
          (mul_nonneg (le_of_lt hLgrad_pos) (norm_nonneg y))
      _ ≤ (Lgrad * ((1 + δ) * R n)) * (δ * R n) := by
        exact mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hy_upper (le_of_lt hLgrad_pos))
          (mul_nonneg hδnonneg hRnonneg)
      _ = Lgrad * (1 + δ) * δ * (R n)^2 := by ring
  have herr_inner_le : inner ℝ gd e ≤ Lgrad * (1 + δ) * δ * (R n)^2 :=
    le_trans (le_abs_self _) herr_inner_abs
  have hstrong_n : M * ‖y‖^2 ≤ inner ℝ gd y := by
    have h := hstrong.2.2 (x n) xInf
    simpa [gd, y] using h
  have hstrong_lower : M * ((1 - δ) * R n)^2 ≤ inner ℝ gd y := by
    have hbase : ((1 - δ) * R n)^2 ≤ ‖y‖^2 := by
      have hleft_nonneg : 0 ≤ (1 - δ) * R n := by
        exact mul_nonneg (by nlinarith) hRnonneg
      exact pow_le_pow_left₀ hleft_nonneg hy_lower 2
    exact le_trans (mul_le_mul_of_nonneg_left hbase (le_of_lt hMpos)) hstrong_n
  have hscaled_inner :
      R n * inner ℝ gd (-u) = inner ℝ gd (y - e) := by
    have hy_sub_e : y - e = R n • (-u) := by
      dsimp [y, e]
      module
    rw [hy_sub_e, inner_smul_right]
  have hmain_scaled :
      R n * ((M - ε) * R n) ≤ R n * inner ℝ gd (-u) := by
    rw [hscaled_inner]
    rw [inner_sub_right]
    calc
      R n * ((M - ε) * R n)
          = (M - ε) * (R n)^2 := by ring
      _ ≤ (M - δ * (2 * M + 2 * Lgrad)) * (R n)^2 := by
          have hR2_nonneg : 0 ≤ (R n)^2 := sq_nonneg _
          exact mul_le_mul_of_nonneg_right (by linarith) hR2_nonneg
      _ ≤ M * ((1 - δ) * R n)^2 - Lgrad * (1 + δ) * δ * (R n)^2 := by
          have hR2_nonneg : 0 ≤ (R n)^2 := sq_nonneg _
          have hcoef_nonneg : 0 ≤ M * δ ^ 2 + Lgrad * δ * (1 - δ) := by
            have hδ2_nonneg : 0 ≤ δ ^ 2 := sq_nonneg δ
            have hone_minus_nonneg : 0 ≤ 1 - δ := by nlinarith
            have hterm1 : 0 ≤ M * δ ^ 2 :=
              mul_nonneg (le_of_lt hMpos) hδ2_nonneg
            have hterm2 : 0 ≤ Lgrad * δ * (1 - δ) := by
              exact mul_nonneg
                (mul_nonneg (le_of_lt hLgrad_pos) hδnonneg) hone_minus_nonneg
            linarith
          calc
            (M - δ * (2 * M + 2 * Lgrad)) * (R n)^2
                ≤ (M - δ * (2 * M + 2 * Lgrad)) * (R n)^2 +
                    (M * δ ^ 2 + Lgrad * δ * (1 - δ)) * (R n)^2 := by
                  exact le_add_of_nonneg_right
                    (mul_nonneg hcoef_nonneg hR2_nonneg)
            _ = M * ((1 - δ) * R n)^2 -
                  Lgrad * (1 + δ) * δ * (R n)^2 := by ring
      _ ≤ inner ℝ gd y - inner ℝ gd e := by
          linarith
  exact le_of_mul_le_mul_left hmain_scaled hRpos

private theorem thm41_R_step_of_increment_bound {inc R : ℕ → ℝ} {n : ℕ}
    {q c : ℝ} (hq_nonneg : 0 ≤ q) (hRnext_nonneg : 0 ≤ R (n + 1))
    (hR_eq : R n = inc n + R (n + 1))
    (hinc_bound : inc n ≤ c * R (n + 1)) (hq_bound : q * (c + 1) ≤ 1) :
    q * R n ≤ R (n + 1) := by
  calc
    q * R n = q * (inc n + R (n + 1)) := by rw [hR_eq]
    _ ≤ q * (c * R (n + 1) + R (n + 1)) := by
      have hadd : inc n + R (n + 1) ≤ c * R (n + 1) + R (n + 1) := by
        simpa [add_comm, add_left_comm, add_assoc] using
          add_le_add_right hinc_bound (R (n + 1))
      exact mul_le_mul_of_nonneg_left hadd hq_nonneg
    _ = (q * (c + 1)) * R (n + 1) := by ring
    _ ≤ 1 * R (n + 1) := by
      exact mul_le_mul_of_nonneg_right hq_bound hRnext_nonneg
    _ = R (n + 1) := by ring

private theorem thm41_tail_step_of_sum_bound {R S : ℕ → ℝ} {n : ℕ}
    {q a m : ℝ} (hS_nonneg : 0 ≤ S n) (hR_nonneg : 0 ≤ R n)
    (hSprev_eq : S (n - 1) = R n + S n)
    (hbound : m * S n ≤ a * R n) (hm_pos : 0 < m) (ha_nonneg : 0 ≤ a)
    (hq_bound : a / (a + m) ≤ q) :
    S n ≤ q * S (n - 1) := by
  have hden_pos : 0 < a + m := by linarith
  have hS_le : S n ≤ (a / (a + m)) * S (n - 1) := by
    rw [hSprev_eq]
    rw [div_mul_eq_mul_div, le_div_iff₀ hden_pos]
    nlinarith
  calc
    S n ≤ (a / (a + m)) * S (n - 1) := hS_le
    _ ≤ q * S (n - 1) := by
      exact mul_le_mul_of_nonneg_right hq_bound (by nlinarith)

private theorem thm41_exists_lower_eps {A q : ℝ} (hA : 0 ≤ A)
    (hqpos : 0 < q) (hqlt1 : q < 1) (hq : q < 1 / (A + 1)) :
    ∃ ε : ℝ, 0 < ε ∧ ε < 1 ∧ q * (A / (1 - ε) + 1) ≤ 1 := by
  have hdenA : 0 < A + 1 := by nlinarith
  have hgap : 0 < 1 - q * (A + 1) := by
    rw [lt_div_iff₀ hdenA] at hq
    nlinarith
  have hdenq : 0 < 2 * (1 - q) := by nlinarith
  let ε : ℝ := min (1 / 2) ((1 - q * (A + 1)) / (2 * (1 - q)))
  have hεpos : 0 < ε := by
    dsimp [ε]
    exact lt_min (by norm_num) (div_pos hgap hdenq)
  have hεlt1 : ε < 1 := by
    dsimp [ε]
    exact lt_of_le_of_lt (min_le_left _ _) (by norm_num)
  have hεle : ε ≤ (1 - q * (A + 1)) / (2 * (1 - q)) := by
    dsimp [ε]
    exact min_le_right _ _
  have hsmall : ε * (1 - q) ≤ 1 - q * (A + 1) := by
    have hnonneg : 0 ≤ 1 - q := by linarith
    calc
      ε * (1 - q) ≤ ((1 - q * (A + 1)) / (2 * (1 - q))) * (1 - q) :=
        mul_le_mul_of_nonneg_right hεle hnonneg
      _ = (1 - q * (A + 1)) / 2 := by
        field_simp [ne_of_gt (by linarith : 0 < 1 - q)]
      _ ≤ 1 - q * (A + 1) := by linarith
  have hone_minus_pos : 0 < 1 - ε := by linarith
  refine ⟨ε, hεpos, hεlt1, ?_⟩
  field_simp [ne_of_gt hone_minus_pos]
  nlinarith

private theorem thm41_summable_R_of_step_ineq {inc R p : ℕ → ℝ} {N : ℕ}
    {a m β : ℝ} (hinc_nonneg : ∀ n, 0 ≤ inc n) (hR_nonneg : ∀ n, 0 ≤ R n)
    (hinc_sum : Summable inc) (hm_pos : 0 < m) (ha_nonneg : 0 ≤ a)
    (hβ_nonneg : 0 ≤ β) (hp_abs : ∀ n, |p n| ≤ β * inc n)
    (hstep : ∀ n ≥ N, -a * inc (n + 1) + m * R (n + 2) ≤ p (n + 1) - p n) :
    Summable R := by
  let tailInc : ℕ → ℝ := fun i => inc (N + 1 + i)
  let tailR : ℕ → ℝ := fun i => R (N + 2 + i)
  have htailInc_sum : Summable tailInc := by
    have htail : Summable (fun i : ℕ => inc (i + (N + 1))) :=
      (summable_nat_add_iff (f := inc) (N + 1)).mpr hinc_sum
    simpa [tailInc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using htail
  let C : ℝ := (β * (∑' i : ℕ, inc i) + |p N| + a * (∑' i : ℕ, tailInc i)) / m
  have hpartial : ∀ j : ℕ, ∑ i ∈ Finset.range j, tailR i ≤ C := by
    intro j
    let sumR : ℝ := ∑ i ∈ Finset.range j, R (N + i + 2)
    let sumInc : ℝ := ∑ i ∈ Finset.range j, inc (N + i + 1)
    have hsum_step :
        (∑ i ∈ Finset.range j, (-a * inc (N + i + 1) + m * R (N + i + 2))) ≤
          ∑ i ∈ Finset.range j, (p (N + i + 1) - p (N + i)) := by
      refine Finset.sum_le_sum ?_
      intro i hi
      exact hstep (N + i) (Nat.le_add_right N i)
    have hleft :
        (∑ i ∈ Finset.range j, (-a * inc (N + i + 1) + m * R (N + i + 2))) =
          -a * sumInc + m * sumR := by
      dsimp [sumInc, sumR]
      rw [Finset.sum_add_distrib]
      simp [Finset.mul_sum]
    have hright :
        (∑ i ∈ Finset.range j, (p (N + i + 1) - p (N + i))) =
          p (N + j) - p N := by
      let q : ℕ → ℝ := fun i => p (N + i)
      have htel := Finset.sum_range_sub q j
      simpa [q, Nat.add_assoc] using htel
    have hmain : m * sumR ≤ p (N + j) - p N + a * sumInc := by
      nlinarith
    have hterm_bound : inc (N + j) ≤ ∑' i : ℕ, inc i :=
      thm41_term_le_tsum_of_nonneg_summable hinc_nonneg hinc_sum (N + j)
    have hpNj_le : p (N + j) ≤ β * (∑' i : ℕ, inc i) := by
      calc
        p (N + j) ≤ |p (N + j)| := le_abs_self _
        _ ≤ β * inc (N + j) := hp_abs (N + j)
        _ ≤ β * (∑' i : ℕ, inc i) :=
          mul_le_mul_of_nonneg_left hterm_bound hβ_nonneg
    have hneg_pN_le : -p N ≤ |p N| := by
      simpa using neg_le_abs (p N)
    have hsumInc_le : sumInc ≤ ∑' i : ℕ, tailInc i := by
      have hsplit := Summable.sum_add_tsum_nat_add (f := tailInc) j htailInc_sum
      have htail_nonneg : 0 ≤ ∑' i : ℕ, tailInc (i + j) := by
        exact tsum_nonneg (fun i => hinc_nonneg _)
      have hsum_eq :
          (∑ i ∈ Finset.range j, tailInc i) = sumInc := by
        dsimp [tailInc, sumInc]
        apply Finset.sum_congr rfl
        intro i hi
        congr 1
        omega
      rw [← hsum_eq]
      nlinarith
    have hsumR_bound :
        m * sumR ≤ β * (∑' i : ℕ, inc i) + |p N| + a * (∑' i : ℕ, tailInc i) := by
      have ha_sumInc : a * sumInc ≤ a * (∑' i : ℕ, tailInc i) :=
        mul_le_mul_of_nonneg_left hsumInc_le ha_nonneg
      nlinarith
    have hsumR_le : sumR ≤ C := by
      dsimp [C]
      rw [le_div_iff₀ hm_pos]
      simpa [mul_comm] using hsumR_bound
    simpa [tailR, sumR, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hsumR_le
  have htailR_sum : Summable tailR := by
    exact summable_of_sum_range_le (fun i => by dsimp [tailR]; exact hR_nonneg _) hpartial
  have htailR_sum' : Summable (fun i : ℕ => R (i + (N + 2))) := by
    simpa [tailR, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using htailR_sum
  exact (summable_nat_add_iff (f := R) (N + 2)).mp htailR_sum'

private theorem thm41_p_le_tail_of_step_ineq {inc R p : ℕ → ℝ} {N : ℕ}
    {a μ : ℝ} (hR_nonneg : ∀ n, 0 ≤ R n) (hinc_sum : Summable inc)
    (hp_tendsto_zero : Tendsto p atTop (𝓝 (0 : ℝ))) (ha_nonneg : 0 ≤ a)
    (hμ_nonneg : 0 ≤ μ)
    (hR_tail : ∀ n, R n = ∑' k : ℕ, inc (n + k))
    (hstep : ∀ n ≥ N, -a * inc (n + 1) + μ * R (n + 2) ≤ p (n + 1) - p n) :
    ∀ n ≥ N, p n ≤ a * R (n + 1) := by
  intro n hn
  let tailInc : ℕ → ℝ := fun i => inc (n + 1 + i)
  have htailInc_sum : Summable tailInc := by
    have htail : Summable (fun i : ℕ => inc (i + (n + 1))) :=
      (summable_nat_add_iff (f := inc) (n + 1)).mpr hinc_sum
    simpa [tailInc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using htail
  have htailInc_tendsto :
      Tendsto (fun j : ℕ => ∑ i ∈ Finset.range j, inc (n + 1 + i))
        atTop (𝓝 (R (n + 1))) := by
    have ht := htailInc_sum.hasSum.tendsto_sum_nat
    have htsum : (∑' i : ℕ, inc (n + (i + 1))) = R (n + 1) := by
      rw [hR_tail (n + 1)]
      apply tsum_congr
      intro i
      congr 1
      omega
    simpa [tailInc, htsum, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using ht
  have hshift : Tendsto (fun j : ℕ => n + j) atTop atTop :=
    Filter.tendsto_atTop_mono (fun j => Nat.le_add_left j n) tendsto_id
  have hp_shift : Tendsto (fun j : ℕ => p (n + j)) atTop (𝓝 (0 : ℝ)) :=
    hp_tendsto_zero.comp hshift
  have hrhs_tendsto :
      Tendsto (fun j : ℕ => p (n + j) +
          a * (∑ i ∈ Finset.range j, inc (n + 1 + i)))
        atTop (𝓝 (a * R (n + 1))) := by
    have hscaled :
        Tendsto (fun j : ℕ => a * (∑ i ∈ Finset.range j, inc (n + 1 + i)))
          atTop (𝓝 (a * R (n + 1))) :=
      tendsto_const_nhds.mul htailInc_tendsto
    simpa using hp_shift.add hscaled
  have hevent :
      (fun _ : ℕ => p n) ≤ᶠ[atTop]
        (fun j : ℕ => p (n + j) +
          a * (∑ i ∈ Finset.range j, inc (n + 1 + i))) := by
    refine Eventually.of_forall ?_
    intro j
    let sumInc : ℝ := ∑ i ∈ Finset.range j, inc (n + i + 1)
    let sumR : ℝ := ∑ i ∈ Finset.range j, R (n + i + 2)
    have hsum_step :
        (∑ i ∈ Finset.range j, (-a * inc (n + i + 1) + μ * R (n + i + 2))) ≤
          ∑ i ∈ Finset.range j, (p (n + i + 1) - p (n + i)) := by
      refine Finset.sum_le_sum ?_
      intro i hi
      exact hstep (n + i) (le_trans hn (Nat.le_add_right n i))
    have hleft :
        (∑ i ∈ Finset.range j, (-a * inc (n + i + 1) + μ * R (n + i + 2))) =
          -a * sumInc + μ * sumR := by
      dsimp [sumInc, sumR]
      rw [Finset.sum_add_distrib]
      simp [Finset.mul_sum]
    have hright :
        (∑ i ∈ Finset.range j, (p (n + i + 1) - p (n + i))) =
          p (n + j) - p n := by
      let q : ℕ → ℝ := fun i => p (n + i)
      have htel := Finset.sum_range_sub q j
      simpa [q, Nat.add_assoc] using htel
    have hsumR_nonneg : 0 ≤ sumR := by
      dsimp [sumR]
      exact Finset.sum_nonneg (fun i hi => hR_nonneg _)
    have hsumInc_rewrite :
        (∑ i ∈ Finset.range j, inc (n + 1 + i)) = sumInc := by
      dsimp [sumInc]
      apply Finset.sum_congr rfl
      intro i hi
      congr 1
      omega
    change p n ≤ p (n + j) + a * (∑ i ∈ Finset.range j, inc (n + 1 + i))
    rw [hsumInc_rewrite]
    nlinarith
  have hconst : Tendsto (fun _ : ℕ => p n) atTop (𝓝 (p n)) := tendsto_const_nhds
  simpa [zero_add] using le_of_tendsto_of_tendsto hconst hrhs_tendsto hevent

private theorem thm41_eventual_step_ineq [FiniteDimensional ℝ H]
    (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ)
    (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (η : ℝ) (hη : η > 0) (α : ℝ) (hα : α ≥ 0)
    (h_linear_growth : ∀ x, ‖x‖ ≤ η → excess (A x) (A (0 : H)) ≤ α * ‖x‖)
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_C11 : IsC11 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (M : ℝ) (hf_strongConv : IsStronglyConvex (fun x => (f x).toReal) M)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x => gradient (fun y => (f y).toReal) x))
    (lam : ℝ) (hlam : lam > 0) (lam_seq : ℕ → ℝ) (hlam_seq : ∀ n, lam_seq n = lam)
    (x : ℕ → H) (halg : AlgorithmA A B x lam_seq)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (h_smooth : IsSmoothAt (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf))
    (u : H) (hu_norm : ‖u‖ = 1)
    (hu_normal : normalCone (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf) =
      {v | ∃ (t : ℝ), t ≥ 0 ∧ v = t • u})
    (hnot_finite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    ∀ μ : ℝ, μ < M →
      ∃ N : ℕ, ∀ n ≥ N,
        -(α / lam) * ‖x (n + 2) - x (n + 1)‖ +
            μ * (∑' k : ℕ, ‖x (n + 2 + k + 1) - x (n + 2 + k)‖) ≤
          (lam ^ 2)⁻¹ * inner ℝ (x (n + 2) - x (n + 1)) u -
            (lam ^ 2)⁻¹ * inner ℝ (x (n + 1) - x n) u := by
  intro μ hμ
  let g : H → ℝ := fun y => (f y).toReal
  let D : Set ℕ := stationaryIndices x
  let R : ℕ → ℝ := fun n => ∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖
  have hf_conv :
      ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
        f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y :=
    thm41_ereal_convex_of_strongConvex f M hfinite hf_strongConv
  have hlam_pos : ∀ n, lam_seq n > 0 := by
    intro n
    rw [hlam_seq n]
    exact hlam
  have hlam_nondec : ∀ n, lam_seq n ≤ lam_seq (n + 1) := by
    intro n
    rw [hlam_seq n, hlam_seq (n + 1)]
  have hexp :
      (fun n => x n - xInf + (R n) • u) =o[atTop] R :=
    prop_4_1_expansion A B hA hdomA hAzero_int f hfinite hf_conv hf_C11.1
      hinf hB_eq_grad lam_seq hlam_pos hlam_nondec x halg xInf hxInf h_smooth
      D rfl u hu_norm R rfl hu_normal hnot_finite
  have hnorm_equiv :
      (fun n => ‖x n - xInf‖) ~[atTop] R :=
    prop_4_1_norm_equiv A B hA hdomA hAzero_int f hfinite hf_conv hf_C11.1
      hinf hB_eq_grad lam_seq hlam_pos hlam_nondec x halg xInf hxInf h_smooth
      D rfl u hu_norm R rfl hu_normal hnot_finite
  have hR_nonneg : ∀ n, 0 ≤ R n := by
    intro n
    dsimp [R]
    exact tsum_nonneg (fun k => norm_nonneg (x (n + k + 1) - x (n + k)))
  have hdist_tendsto_zero :
      Tendsto (fun n : ℕ => ‖x n - xInf‖) atTop (𝓝 (0 : ℝ)) := by
    have hx_sub : Tendsto (fun n : ℕ => x n - xInf) atTop (𝓝 (0 : H)) := by
      have hconst : Tendsto (fun _ : ℕ => xInf) atTop (𝓝 xInf) := tendsto_const_nhds
      simpa using hxInf.sub hconst
    simpa using (continuous_norm.tendsto (0 : H)).comp hx_sub
  have hR_tendsto_zero : Tendsto R atTop (𝓝 (0 : ℝ)) :=
    hnorm_equiv.tendsto_nhds hdist_tendsto_zero
  have hR_eventually_pos : ∀ᶠ n in atTop, 0 < R n := by
    rcases thm41_eventual_distance_pos_of_not_finite A B hA hdomA hAzero_int f
        hfinite hf_C11 hinf M hf_strongConv hB_eq_grad lam_seq hlam_pos hlam_nondec
        x halg xInf hxInf h_smooth hnot_finite with
      ⟨Npos, hNpos⟩
    have hdist_eventually_pos : ∀ᶠ n in atTop, 0 < ‖x n - xInf‖ :=
      eventually_atTop.mpr ⟨Npos, hNpos⟩
    exact hnorm_equiv.symm.eventually_pos hdist_eventually_pos
  rcases eventually_atTop.mp hR_eventually_pos with ⟨NRpos, hNRpos⟩
  rcases thm41_locallyLipschitz_tendsto_norm_sub_le (gradient g) hf_C11.2 x xInf hxInf with
    ⟨Lgrad, hLgrad_pos, NLip, hgrad_lip⟩
  have hμgap_pos : 0 < (M - μ) / 2 := by linarith
  have hgrad_event :=
    thm41_gradient_inner_eventually_ge g M hf_strongConv x xInf u R hu_norm hexp
      hnorm_equiv hR_nonneg hR_eventually_pos Lgrad hLgrad_pos NLip hgrad_lip
      ((M - μ) / 2) hμgap_pos
  rcases eventually_atTop.mp hgrad_event with ⟨Ngrad, hNgrad⟩
  have hscaled_event := thm41_eventually_scaled_increment_norm_le_eta x xInf hxInf lam η hη
  rcases eventually_atTop.mp hscaled_event with ⟨Nη, hNη⟩
  rcases thm41_full_domain_local_bounded A hA hdomA (0 : H) with
    ⟨δloc, hδloc, hA_loc_bdd⟩
  have hscaled_local_event :=
    thm41_eventually_scaled_increment_norm_le_eta x xInf hxInf lam (δloc / 2) (by positivity)
  rcases eventually_atTop.mp hscaled_local_event with ⟨Nδ, hNδ⟩
  refine ⟨max NRpos (max Ngrad (max Nη Nδ)), ?_⟩
  intro n hn
  have hnGrad : Ngrad ≤ n + 2 := by
    exact le_trans
      (le_trans (le_trans (le_max_left Ngrad (max Nη Nδ))
        (le_max_right NRpos (max Ngrad (max Nη Nδ)))) hn)
      (Nat.le_add_right n 2)
  have hnRpos : NRpos ≤ n + 2 := by
    have hnRpos0 : NRpos ≤ n :=
      le_trans (le_max_left NRpos (max Ngrad (max Nη Nδ))) hn
    exact le_trans hnRpos0 (Nat.le_add_right n 2)
  have hnη : Nη ≤ n :=
    le_trans
      (le_trans
        (le_trans (le_max_left Nη Nδ) (le_max_right Ngrad (max Nη Nδ)))
        (le_max_right NRpos (max Ngrad (max Nη Nδ)))) hn
  have hnδ : Nδ ≤ n :=
    le_trans
      (le_trans
        (le_trans (le_max_right Nη Nδ) (le_max_right Ngrad (max Nη Nδ)))
        (le_max_right NRpos (max Ngrad (max Nη Nδ)))) hn
  rcases thm41_algorithm_step_selection A B lam_seq x halg n with
    ⟨a, b, ha, hb, hstep_eq⟩
  have hb_grad : b = gradient g (x (n + 2)) :=
    thm41_mem_gradient_operator_eq B g (by simpa [g] using hB_eq_grad) hb
  have hvel_small : ‖lam⁻¹ • (x (n + 2) - x (n + 1))‖ ≤ η := hNη n hnη
  have hu_mem_normal :
      u ∈ normalCone (A (0 : H)) (-gradient g xInf) := by
    simpa [g] using thm41_ray_generator_mem_normalCone hu_normal
  have hnormal_term_nonpos :
      ∀ ξ ∈ A (0 : H), inner ℝ (ξ + gradient g xInf) u ≤ 0 := by
    intro ξ hξ
    have h := thm41_normalCone_inner_nonpos h_smooth.1 (by simpa [g] using hu_mem_normal) hξ
    have h' : inner ℝ u (ξ + gradient g xInf) ≤ 0 := by
      simpa [g, sub_eq_add_neg] using h
    simpa [real_inner_comm] using h'
  have hA0_nonempty : (A (0 : H)).Nonempty := by
    refine ⟨-gradient g xInf, ?_⟩
    simpa [g] using h_smooth.1
  have hvel_small_seq :
      ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ ≤ η := by
    simpa [hlam_seq n] using hvel_small
  have hvel_local : ‖lam⁻¹ • (x (n + 2) - x (n + 1))‖ ≤ δloc / 2 := hNδ n hnδ
  have hvel_local_seq :
      ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ ≤ δloc / 2 := by
    simpa [hlam_seq n] using hvel_local
  have hv_ball :
      (lam_seq n)⁻¹ • (x (n + 2) - x (n + 1)) ∈ Metric.ball (0 : H) δloc := by
    rw [Metric.mem_ball, dist_eq_norm, sub_zero]
    exact lt_of_le_of_lt hvel_local_seq (by linarith)
  have hexcess_step :
      excess (A ((lam_seq n)⁻¹ • (x (n + 2) - x (n + 1)))) (A (0 : H)) ≤
        α * ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ :=
    h_linear_growth _ hvel_small_seq
  have hbdd_infDist :
      BddAbove (Set.range (fun z :
        A ((lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))) =>
          Metric.infDist (z : H) (A (0 : H)))) :=
    thm41_bddAbove_infDist_of_local_bounded A hA_loc_bdd hv_ball hA0_nonempty
  have hinfdist_a :
      Metric.infDist a (A (0 : H)) ≤
        α * ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ :=
    thm41_excess_point_le_of_bdd hbdd_infDist ha hexcess_step
  have hacc_eq :
      (lam_seq n ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n) =
        -a - gradient g (x (n + 2)) := by
    rw [hb_grad] at hstep_eq
    calc
      (lam_seq n ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)
          =
            ((lam_seq n ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n) +
                a + gradient g (x (n + 2))) - a - gradient g (x (n + 2)) := by
              abel
      _ = 0 - a - gradient g (x (n + 2)) := by rw [hstep_eq]
      _ = -a - gradient g (x (n + 2)) := by abel
  have hxi_approx :
      ∀ εerr : ℝ, 0 < εerr →
        ∃ ξ ∈ A (0 : H),
          ‖ξ + (lam_seq n ^ 2)⁻¹ •
              (x (n + 2) - 2 • x (n + 1) + x n) +
              gradient g (x (n + 2))‖ ≤
            α * ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ + εerr := by
    intro εerr hεerr
    rcases thm41_exists_mem_dist_le_infDist_add hA0_nonempty hεerr hinfdist_a with
      ⟨ξ, hξ, hξdist⟩
    refine ⟨ξ, hξ, ?_⟩
    have hnorm_eq :
        ‖ξ + (lam_seq n ^ 2)⁻¹ •
            (x (n + 2) - 2 • x (n + 1) + x n) +
            gradient g (x (n + 2))‖ = dist a ξ := by
      rw [hacc_eq, dist_eq_norm]
      rw [show ξ + (-a - gradient g (x (n + 2))) + gradient g (x (n + 2)) = ξ - a by
        abel]
      rw [norm_sub_rev]
    exact le_trans (le_of_eq hnorm_eq) hξdist
  have hxi_error_inner_lower :
      ∀ εerr : ℝ, 0 < εerr →
        ∃ ξ ∈ A (0 : H),
          -(α * ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ + εerr) ≤
            inner ℝ
              (ξ + (lam_seq n ^ 2)⁻¹ •
                (x (n + 2) - 2 • x (n + 1) + x n) +
                gradient g (x (n + 2))) u := by
    intro εerr hεerr
    rcases hxi_approx εerr hεerr with ⟨ξ, hξ, hξerr⟩
    refine ⟨ξ, hξ, ?_⟩
    let err : H :=
      ξ + (lam_seq n ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n) +
        gradient g (x (n + 2))
    have herr_norm :
        ‖err‖ ≤ α * ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ + εerr := by
      simpa [err] using hξerr
    have hinner_abs :
        |inner ℝ err u| ≤
          α * ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ + εerr := by
      calc
        |inner ℝ err u| ≤ ‖err‖ * ‖u‖ := abs_real_inner_le_norm err u
        _ = ‖err‖ := by rw [hu_norm, mul_one]
        _ ≤ α * ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ + εerr :=
          herr_norm
    have hmain :
        -(α * ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ + εerr) ≤
          inner ℝ err u := by
      exact (abs_le.mp hinner_abs).1
    simpa [err] using hmain
  have hinner_decomp :
      ∀ ξ : H,
        inner ℝ
            ((lam_seq n ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)) u =
          inner ℝ
              (ξ + (lam_seq n ^ 2)⁻¹ •
                (x (n + 2) - 2 • x (n + 1) + x n) +
                gradient g (x (n + 2))) u +
            inner ℝ (gradient g (x (n + 2)) - gradient g xInf) (-u) -
              inner ℝ (ξ + gradient g xInf) u := by
    intro ξ
    simp [inner_add_left, inner_sub_left, inner_neg_right]
  have hacc_inner_lower_of_gradient :
      ∀ εerr : ℝ, 0 < εerr →
        -(α * ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ + εerr) +
            inner ℝ (gradient g (x (n + 2)) - gradient g xInf) (-u) ≤
          inner ℝ
            ((lam_seq n ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)) u := by
    intro εerr hεerr
    rcases hxi_error_inner_lower εerr hεerr with ⟨ξ, hξ, herr⟩
    have hnormal := hnormal_term_nonpos ξ hξ
    have hdecomp := hinner_decomp ξ
    linarith
  have hRpos2 : 0 < R (n + 2) := by
    exact hNRpos (n + 2) hnRpos
  have hεerr_pos : 0 < ((M - μ) / 2) * R (n + 2) :=
    mul_pos hμgap_pos hRpos2
  have hacc_low := hacc_inner_lower_of_gradient (((M - μ) / 2) * R (n + 2)) hεerr_pos
  have hgrad_low := hNgrad (n + 2) hnGrad
  have hscale_norm :
      ‖(lam_seq n)⁻¹ • (x (n + 2) - x (n + 1))‖ =
        lam⁻¹ * ‖x (n + 2) - x (n + 1)‖ := by
    rw [hlam_seq n, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlam)]
  have hacc_mu :
      -(α / lam) * ‖x (n + 2) - x (n + 1)‖ + μ * R (n + 2) ≤
        inner ℝ
          ((lam_seq n ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)) u := by
    rw [hscale_norm] at hacc_low
    have halpha_div : α / lam = α * lam⁻¹ := by ring
    rw [halpha_div]
    nlinarith
  have hacc_rewrite :
      inner ℝ
          ((lam_seq n ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)) u =
        (lam ^ 2)⁻¹ * inner ℝ (x (n + 2) - x (n + 1)) u -
          (lam ^ 2)⁻¹ * inner ℝ (x (n + 1) - x n) u := by
    rw [hlam_seq n]
    have hdiff :
        x (n + 2) - 2 • x (n + 1) + x n =
          (x (n + 2) - x (n + 1)) - (x (n + 1) - x n) := by
      module
    rw [hdiff, real_inner_smul_left, inner_sub_left]
    ring
  rw [hacc_rewrite] at hacc_mu
  simpa [R, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hacc_mu

private theorem thm41_extend_lower_geometric_one {d : ℕ → ℝ} {N : ℕ} {q C : ℝ}
    (hq : 0 < q) (hNpos : 0 < d N) (hC : 0 < C)
    (hbound : ∀ n ≥ N + 1, C * q ^ n ≤ d n) :
    ∃ C', 0 < C' ∧ ∀ n ≥ N, C' * q ^ n ≤ d n := by
  let C' : ℝ := min C (d N / q ^ N) / 2
  have hqpow_pos : 0 < q ^ N := pow_pos hq N
  have hratio_pos : 0 < d N / q ^ N := div_pos hNpos hqpow_pos
  have hC'pos : 0 < C' := by
    dsimp [C']
    exact half_pos (lt_min hC hratio_pos)
  refine ⟨C', hC'pos, ?_⟩
  intro n hn
  by_cases hnN : n = N
  · subst n
    have hC'le : C' ≤ d N / q ^ N := by
      dsimp [C']
      have hhalf_le : min C (d N / q ^ N) / 2 ≤ min C (d N / q ^ N) := by
        linarith [le_of_lt (lt_min hC hratio_pos)]
      exact le_trans hhalf_le (min_le_right _ _)
    rw [← le_div_iff₀ hqpow_pos]
    simpa [mul_comm] using hC'le
  · have hn_succ : N + 1 ≤ n := by omega
    have hC'leC : C' ≤ C := by
      dsimp [C']
      have hhalf_le : min C (d N / q ^ N) / 2 ≤ min C (d N / q ^ N) := by
        linarith [le_of_lt (lt_min hC hratio_pos)]
      exact le_trans hhalf_le (min_le_left _ _)
    exact le_trans
      (mul_le_mul_of_nonneg_right hC'leC (pow_nonneg (le_of_lt hq) n))
      (hbound n hn_succ)

private theorem thm41_extend_lower_geometric_backward {d : ℕ → ℝ} {n0 N : ℕ}
    {q C : ℝ} (hq : 0 < q) (hn0N : n0 ≤ N) (hpos : ∀ n ≥ n0, 0 < d n)
    (hC : 0 < C) (hbound : ∀ n ≥ N, C * q ^ n ≤ d n) :
    ∃ C', 0 < C' ∧ ∀ n ≥ n0, C' * q ^ n ≤ d n := by
  induction N generalizing C with
  | zero =>
      have hn0 : n0 = 0 := by omega
      subst n0
      exact ⟨C, hC, hbound⟩
  | succ N ih =>
      by_cases hn0N' : n0 ≤ N
      · rcases thm41_extend_lower_geometric_one (d := d) (N := N) (q := q)
          (C := C) hq (hpos N hn0N') hC
          (by intro n hn; exact hbound n (by omega)) with
          ⟨Cstep, hCstep, hstep⟩
        exact ih hn0N' hCstep hstep
      · have hn0eq : n0 = N + 1 := by omega
        subst n0
        exact ⟨C, hC, hbound⟩

private theorem thm41_extend_upper_geometric_one {d : ℕ → ℝ} {N : ℕ} {q C : ℝ}
    (hq : 0 < q) (hC : 0 < C)
    (hbound : ∀ n ≥ N + 1, d n ≤ C * q ^ n) :
    ∃ C', 0 < C' ∧ ∀ n ≥ N, d n ≤ C' * q ^ n := by
  let C' : ℝ := max C (d N / q ^ N) + 1
  have hqpow_pos : 0 < q ^ N := pow_pos hq N
  have hC'pos : 0 < C' := by
    dsimp [C']
    have hle : C ≤ max C (d N / q ^ N) := le_max_left _ _
    linarith
  refine ⟨C', hC'pos, ?_⟩
  intro n hn
  by_cases hnN : n = N
  · subst n
    have hle : d N / q ^ N ≤ C' := by
      dsimp [C']
      have hlemax : d N / q ^ N ≤ max C (d N / q ^ N) := le_max_right _ _
      linarith
    rw [div_le_iff₀ hqpow_pos] at hle
    simpa [mul_comm] using hle
  · have hn_succ : N + 1 ≤ n := by omega
    have hCle : C ≤ C' := by
      dsimp [C']
      have hlemax : C ≤ max C (d N / q ^ N) := le_max_left _ _
      linarith
    exact le_trans (hbound n hn_succ)
      (mul_le_mul_of_nonneg_right hCle (pow_nonneg (le_of_lt hq) n))

private theorem thm41_extend_upper_geometric_backward {d : ℕ → ℝ} {n0 N : ℕ}
    {q C : ℝ} (hq : 0 < q) (hn0N : n0 ≤ N) (hC : 0 < C)
    (hbound : ∀ n ≥ N, d n ≤ C * q ^ n) :
    ∃ C', 0 < C' ∧ ∀ n ≥ n0, d n ≤ C' * q ^ n := by
  induction N generalizing C with
  | zero =>
      have hn0 : n0 = 0 := by omega
      subst n0
      exact ⟨C, hC, hbound⟩
  | succ N ih =>
      by_cases hn0N' : n0 ≤ N
      · rcases thm41_extend_upper_geometric_one (d := d) (N := N) (q := q)
          (C := C) hq hC (by intro n hn; exact hbound n (by omega)) with
          ⟨Cstep, hCstep, hstep⟩
        exact ih hn0N' hCstep hstep
      · have hn0eq : n0 = N + 1 := by omega
        subst n0
        exact ⟨C, hC, hbound⟩

private theorem thm41_exists_tail_mu (α M lam q : ℝ) (hα : 0 ≤ α) (hM : 0 < M)
    (hlam : 0 < lam) (hqpos : 0 < q) (hqlt1 : q < 1)
    (hq : α / (α + M * lam) < q) :
    ∃ μ : ℝ, 0 < μ ∧ μ < M ∧ α / (α + μ * lam) ≤ q := by
  by_cases hαzero : α = 0
  · refine ⟨M / 2, by linarith, by linarith, ?_⟩
    rw [hαzero, zero_div]
    exact le_of_lt hqpos
  · have hαpos : 0 < α := lt_of_le_of_ne hα (Ne.symm hαzero)
    let μ0 : ℝ := α * (1 - q) / (q * lam)
    have hdenM : 0 < α + M * lam := by positivity
    have hgap : α < q * (α + M * lam) := by
      rw [div_lt_iff₀ hdenM] at hq
      exact hq
    have hμ0_lt_M : μ0 < M := by
      dsimp [μ0]
      rw [div_lt_iff₀ (mul_pos hqpos hlam)]
      nlinarith
    have hμ0_pos : 0 < μ0 := by
      dsimp [μ0]
      exact div_pos (mul_pos hαpos (sub_pos.mpr hqlt1)) (mul_pos hqpos hlam)
    let μ : ℝ := (μ0 + M) / 2
    have hμpos : 0 < μ := by dsimp [μ]; linarith
    have hμltM : μ < M := by dsimp [μ]; linarith
    have hμgtμ0 : μ0 < μ := by dsimp [μ]; linarith
    refine ⟨μ, hμpos, hμltM, ?_⟩
    have hdenμ : 0 < α + μ * lam := by positivity
    have hμ0_mul : μ0 * lam = α * (1 - q) / q := by
      dsimp [μ0]
      field_simp [ne_of_gt hqpos, ne_of_gt hlam]
    have hμlam_ge : α * (1 - q) / q ≤ μ * lam := by
      have hmul := mul_le_mul_of_nonneg_right (le_of_lt hμgtμ0) (le_of_lt hlam)
      rw [hμ0_mul] at hmul
      exact hmul
    have hmul2 : α * (1 - q) ≤ q * (μ * lam) := by
      rw [div_le_iff₀ hqpos] at hμlam_ge
      nlinarith
    rw [div_le_iff₀ hdenμ]
    nlinarith

private theorem thm41_tail_tsum_bound_of_step_ineq {inc R p : ℕ → ℝ} {N : ℕ}
    {a μ : ℝ} (hR_sum : Summable R) (hinc_sum : Summable inc)
    (hp_tendsto_zero : Tendsto p atTop (𝓝 (0 : ℝ)))
    (hp_nonneg : ∀ n ≥ N, 0 ≤ p n)
    (hR_tail : ∀ n, R n = ∑' k : ℕ, inc (n + k))
    (hstep : ∀ n ≥ N,
      -a * inc (n + 1) + μ * R (n + 2) ≤ p (n + 1) - p n) :
    ∀ n ≥ N + 1, μ * (∑' k : ℕ, R (n + 1 + k)) ≤ a * R n := by
  intro n hn
  have hnprev : N ≤ n - 1 := by omega
  let tailInc : ℕ → ℝ := fun i => inc (n + i)
  let tailR : ℕ → ℝ := fun i => R (n + 1 + i)
  have htailInc_sum : Summable tailInc := by
    have htail : Summable (fun i : ℕ => inc (i + n)) :=
      (summable_nat_add_iff (f := inc) n).mpr hinc_sum
    simpa [tailInc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using htail
  have htailR_sum : Summable tailR := by
    have htail : Summable (fun i : ℕ => R (i + (n + 1))) :=
      (summable_nat_add_iff (f := R) (n + 1)).mpr hR_sum
    simpa [tailR, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using htail
  have htailInc_tendsto :
      Tendsto (fun j : ℕ => ∑ i ∈ Finset.range j, inc (n + i)) atTop (𝓝 (R n)) := by
    have ht := htailInc_sum.hasSum.tendsto_sum_nat
    have htsum : (∑' i : ℕ, tailInc i) = R n := by
      rw [hR_tail n]
    simpa [tailInc, htsum] using ht
  have htailR_tendsto :
      Tendsto (fun j : ℕ => ∑ i ∈ Finset.range j, R (n + 1 + i)) atTop
        (𝓝 (∑' k : ℕ, R (n + 1 + k))) := by
    have ht := htailR_sum.hasSum.tendsto_sum_nat
    simpa [tailR] using ht
  have hshift : Tendsto (fun j : ℕ => (n - 1) + j) atTop atTop :=
    Filter.tendsto_atTop_mono (fun j => Nat.le_add_left j (n - 1)) tendsto_id
  have hp_shift : Tendsto (fun j : ℕ => p ((n - 1) + j)) atTop (𝓝 (0 : ℝ)) :=
    hp_tendsto_zero.comp hshift
  have hrhs_tendsto :
      Tendsto (fun j : ℕ => p ((n - 1) + j) +
          a * (∑ i ∈ Finset.range j, inc (n + i)))
        atTop (𝓝 (a * R n)) := by
    have hscaled :
        Tendsto (fun j : ℕ => a * (∑ i ∈ Finset.range j, inc (n + i)))
          atTop (𝓝 (a * R n)) :=
      tendsto_const_nhds.mul htailInc_tendsto
    simpa using hp_shift.add hscaled
  have hlhs_tendsto :
      Tendsto (fun j : ℕ => μ * (∑ i ∈ Finset.range j, R (n + 1 + i)))
        atTop (𝓝 (μ * (∑' k : ℕ, R (n + 1 + k)))) :=
    tendsto_const_nhds.mul htailR_tendsto
  have hevent :
      (fun j : ℕ => μ * (∑ i ∈ Finset.range j, R (n + 1 + i))) ≤ᶠ[atTop]
        (fun j : ℕ => p ((n - 1) + j) +
          a * (∑ i ∈ Finset.range j, inc (n + i))) := by
    refine Eventually.of_forall ?_
    intro j
    let sumInc : ℝ := ∑ i ∈ Finset.range j, inc (n + i)
    let sumR : ℝ := ∑ i ∈ Finset.range j, R (n + 1 + i)
    have hsum_step :
        (∑ i ∈ Finset.range j,
            (-a * inc ((n - 1) + i + 1) + μ * R ((n - 1) + i + 2))) ≤
          ∑ i ∈ Finset.range j, (p ((n - 1) + i + 1) - p ((n - 1) + i)) := by
      refine Finset.sum_le_sum ?_
      intro i _hi
      exact hstep ((n - 1) + i) (le_trans hnprev (Nat.le_add_right (n - 1) i))
    have hinc_index :
        (∑ i ∈ Finset.range j, inc ((n - 1) + i + 1)) = sumInc := by
      dsimp [sumInc]
      apply Finset.sum_congr rfl
      intro i _hi
      congr 1
      omega
    have hR_index :
        (∑ i ∈ Finset.range j, R ((n - 1) + i + 2)) = sumR := by
      dsimp [sumR]
      apply Finset.sum_congr rfl
      intro i _hi
      congr 1
      omega
    have hleft :
        (∑ i ∈ Finset.range j,
            (-a * inc ((n - 1) + i + 1) + μ * R ((n - 1) + i + 2))) =
          -a * sumInc + μ * sumR := by
      rw [Finset.sum_add_distrib]
      rw [← Finset.mul_sum, ← Finset.mul_sum]
      rw [hinc_index, hR_index]
    have hright :
        (∑ i ∈ Finset.range j, (p ((n - 1) + i + 1) - p ((n - 1) + i))) =
          p ((n - 1) + j) - p (n - 1) := by
      let q : ℕ → ℝ := fun i => p ((n - 1) + i)
      have htel := Finset.sum_range_sub q j
      simpa [q, Nat.add_assoc] using htel
    have hp_prev_nonneg : 0 ≤ p (n - 1) := hp_nonneg (n - 1) hnprev
    change μ * sumR ≤ p ((n - 1) + j) + a * sumInc
    rw [hleft, hright] at hsum_step
    nlinarith
  simpa using le_of_tendsto_of_tendsto hlhs_tendsto hrhs_tendsto hevent

/-- Theorem 4.1: in the non-finitely-convergent case, the distance has the lower
geometric estimate. -/
theorem thm_4_1_lower_rate_of_not_finite [FiniteDimensional ℝ H] (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ) (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (η : ℝ) (hη : η > 0) (α : ℝ) (hα : α ≥ 0)
    (h_linear_growth : ∀ x, ‖x‖ ≤ η → excess (A x) (A (0 : H)) ≤ α * ‖x‖)
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_C11 : IsC11 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (M : ℝ) (hf_strongConv : IsStronglyConvex (fun x => (f x).toReal) M)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x => gradient (fun y => (f y).toReal) x))
    (lam : ℝ) (hlam : lam > 0) (lam_seq : ℕ → ℝ) (hlam_seq : ∀ n, lam_seq n = lam)
    (x : ℕ → H) (halg : AlgorithmA A B x lam_seq) (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (h_smooth : IsSmoothAt (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf))
    (hnot_finite : ¬ ∃ N, ∀ n ≥ N, x n = x (N)) :
    ∃ (n0 : ℕ), ∀ q1, 0 < q1 → q1 < 1 → q1 < 1 / (α * lam + 1) →
      ∃ (C1 : ℝ), C1 > 0 ∧ ∀ n ≥ n0, ‖x n - xInf‖ ≥ C1 * q1 ^ n := by
  rcases thm41_smoothAt_unit_normal h_smooth with ⟨u, hu_norm, hu_normal⟩
  let D : Set ℕ := stationaryIndices x
  let R : ℕ → ℝ := fun n => ∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖
  let inc : ℕ → ℝ := fun n => ‖x (n + 1) - x n‖
  let pseq : ℕ → ℝ := fun n => (lam ^ 2)⁻¹ * inner ℝ (x (n + 1) - x n) u
  have hf_conv :
      ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
        f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y :=
    thm41_ereal_convex_of_strongConvex f M hfinite hf_strongConv
  have hlam_pos : ∀ n, lam_seq n > 0 := by
    intro n
    rw [hlam_seq n]
    exact hlam
  have hlam_nondec : ∀ n, lam_seq n ≤ lam_seq (n + 1) := by
    intro n
    rw [hlam_seq n, hlam_seq (n + 1)]
  have hdir :
      Tendsto (normalizedIncrementDirection x)
        (atTop ⊓ Filter.principal {n | n ∉ D}) (𝓝 u) :=
    prop_4_1_direction A B hA hdomA hAzero_int f hfinite hf_conv hf_C11.1
      hinf hB_eq_grad lam_seq hlam_pos hlam_nondec x halg xInf hxInf h_smooth
      D rfl u hu_norm R rfl hu_normal hnot_finite
  have hnorm_equiv :
      (fun n => ‖x n - xInf‖) ~[atTop] R :=
    prop_4_1_norm_equiv A B hA hdomA hAzero_int f hfinite hf_conv hf_C11.1
      hinf hB_eq_grad lam_seq hlam_pos hlam_nondec x halg xInf hxInf h_smooth
      D rfl u hu_norm R rfl hu_normal hnot_finite
  have hR_nonneg : ∀ n, 0 ≤ R n := by
    intro n
    dsimp [R]
    exact tsum_nonneg (fun k => norm_nonneg (x (n + k + 1) - x (n + k)))
  rcases thm41_eventual_distance_pos_of_not_finite A B hA hdomA hAzero_int f
      hfinite hf_C11 hinf M hf_strongConv hB_eq_grad lam_seq hlam_pos hlam_nondec
      x halg xInf hxInf h_smooth hnot_finite with
    ⟨Npos, hNpos⟩
  have hdist_eventually_pos : ∀ᶠ n in atTop, 0 < ‖x n - xInf‖ :=
    eventually_atTop.mpr ⟨Npos, hNpos⟩
  have hR_eventually_pos : ∀ᶠ n in atTop, 0 < R n :=
    hnorm_equiv.symm.eventually_pos hdist_eventually_pos
  rcases eventually_atTop.mp hR_eventually_pos with ⟨NRpos, hNRpos⟩
  have hinc_tail_summable_eventually :
      ∀ᶠ n in atTop, Summable (fun k : ℕ => ‖x (n + k + 1) - x (n + k)‖) := by
    filter_upwards [hR_eventually_pos] with n hn
    exact thm41_summable_of_tsum_pos (by simpa [R] using hn)
  rcases eventually_atTop.mp hinc_tail_summable_eventually with ⟨Ninc, hNinc⟩
  have hinc_sum : Summable inc := by
    have htail := hNinc Ninc le_rfl
    have htail' : Summable (fun k : ℕ => inc (k + Ninc)) := by
      simpa [inc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using htail
    exact (summable_nat_add_iff (f := inc) Ninc).mp htail'
  have hR_tail : ∀ n, R n = ∑' k : ℕ, inc (n + k) := by
    intro n
    rfl
  have hp_tendsto_zero : Tendsto pseq atTop (𝓝 (0 : ℝ)) := by
    have hshift1 : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
      Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
    have hx1 : Tendsto (fun n : ℕ => x (n + 1)) atTop (𝓝 xInf) := hxInf.comp hshift1
    have hdiff : Tendsto (fun n : ℕ => x (n + 1) - x n) atTop (𝓝 (0 : H)) := by
      simpa using hx1.sub hxInf
    have hinner :
        Tendsto (fun n : ℕ => inner ℝ (x (n + 1) - x n) u) atTop (𝓝 (0 : ℝ)) := by
      simpa using hdiff.inner tendsto_const_nhds
    simpa [pseq] using tendsto_const_nhds.mul hinner
  have hMpos : 0 < M := hf_strongConv.1
  rcases thm41_eventual_step_ineq A B hA hdomA hAzero_int η hη α hα
      h_linear_growth f hfinite hf_C11 hinf M hf_strongConv hB_eq_grad lam hlam
      lam_seq hlam_seq x halg xInf hxInf h_smooth u hu_norm hu_normal hnot_finite
      (M / 2) (by nlinarith [hMpos]) with
    ⟨Nstep, hNstep⟩
  have hstep :
      ∀ n ≥ Nstep,
        -(α / lam) * inc (n + 1) + (M / 2) * R (n + 2) ≤
          pseq (n + 1) - pseq n := by
    intro n hn
    simpa [inc, pseq, R, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
      hNstep n hn
  have hp_le :
      ∀ n ≥ Nstep, pseq n ≤ (α / lam) * R (n + 1) :=
    thm41_p_le_tail_of_step_ineq (inc := inc) (R := R) (p := pseq)
      (N := Nstep) (a := α / lam) (μ := M / 2)
      hR_nonneg hinc_sum hp_tendsto_zero (div_nonneg hα (le_of_lt hlam))
      (by nlinarith [hMpos]) hR_tail hstep
  refine ⟨Npos, ?_⟩
  intro q1 hq1pos hq1lt1 hq1bound
  rcases thm41_exists_lower_eps (A := α * lam) (q := q1)
      (mul_nonneg hα (le_of_lt hlam)) hq1pos hq1lt1 hq1bound with
    ⟨ε, hεpos, hεlt1, hqeps⟩
  have hinner_event :=
    thm41_increment_inner_eventually_ge x D rfl u hu_norm hdir ε hεpos
  rcases eventually_atTop.mp hinner_event with ⟨Ndir, hNdir⟩
  let Nq := max Npos (max NRpos (max Ninc (max Nstep Ndir)))
  have hRstep : ∀ n ≥ Nq, q1 * R n ≤ R (n + 1) := by
    intro n hn
    have hninc : Ninc ≤ n :=
      le_trans
        (le_trans (le_max_left Ninc (max Nstep Ndir))
          (le_max_right NRpos (max Ninc (max Nstep Ndir))))
        (le_trans (le_max_right Npos (max NRpos (max Ninc (max Nstep Ndir)))) hn)
    have hnstep : Nstep ≤ n :=
      le_trans
        (le_trans
          (le_trans (le_max_left Nstep Ndir) (le_max_right Ninc (max Nstep Ndir)))
          (le_max_right NRpos (max Ninc (max Nstep Ndir))))
        (le_trans (le_max_right Npos (max NRpos (max Ninc (max Nstep Ndir)))) hn)
    have hndir : Ndir ≤ n :=
      le_trans
        (le_trans
          (le_trans (le_max_right Nstep Ndir) (le_max_right Ninc (max Nstep Ndir)))
          (le_max_right NRpos (max Ninc (max Nstep Ndir))))
        (le_trans (le_max_right Npos (max NRpos (max Ninc (max Nstep Ndir)))) hn)
    have hinner_lower := hNdir n hndir
    have hp_upper := hp_le n hnstep
    have hp_lower :
        (lam ^ 2)⁻¹ * ((1 - ε) * inc n) ≤ pseq n := by
      dsimp [pseq, inc]
      exact mul_le_mul_of_nonneg_left hinner_lower (inv_nonneg.mpr (sq_nonneg lam))
    have hinc_to_R :
        inc n ≤ (α * lam / (1 - ε)) * R (n + 1) := by
      have hle := le_trans hp_lower hp_upper
      have hβpos : 0 < (lam ^ 2)⁻¹ := by positivity
      have hone : 0 < 1 - ε := by linarith
      have hdenpos : 0 < (lam ^ 2)⁻¹ * (1 - ε) := mul_pos hβpos hone
      calc
        inc n = ((lam ^ 2)⁻¹ * ((1 - ε) * inc n)) /
            ((lam ^ 2)⁻¹ * (1 - ε)) := by
              field_simp [ne_of_gt hlam, ne_of_gt hone]
        _ ≤ ((α / lam) * R (n + 1)) / ((lam ^ 2)⁻¹ * (1 - ε)) := by
              exact div_le_div_of_nonneg_right hle (le_of_lt hdenpos)
        _ = (α * lam / (1 - ε)) * R (n + 1) := by
              field_simp [ne_of_gt hlam, ne_of_gt hone]
    have hR_eq : R n = inc n + R (n + 1) := by
      dsimp [R, inc]
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
        thm41_increment_tail_tsum_eq_head_add_tail x n (hNinc n hninc)
    exact thm41_R_step_of_increment_bound (inc := inc) (R := R) (n := n)
      (q := q1) (c := α * lam / (1 - ε)) (le_of_lt hq1pos) (hR_nonneg _)
      hR_eq hinc_to_R hqeps
  have hRNpos : 0 < R Nq := by
    have hNR : NRpos ≤ Nq := by
      exact le_trans (le_max_left NRpos (max Ninc (max Nstep Ndir)))
        (le_max_right Npos (max NRpos (max Ninc (max Nstep Ndir))))
    exact hNRpos Nq hNR
  rcases thm41_eventual_lower_geometric_of_step hq1pos hRstep hRNpos with
    ⟨CR, hCRpos, hCR⟩
  have hhalf_event :=
    thm41_eventually_half_le_of_equiv hnorm_equiv (Eventually.of_forall hR_nonneg)
  rcases eventually_atTop.mp hhalf_event with ⟨Nequiv, hNequiv⟩
  let Nfinal := max Nq Nequiv
  have hbound_event :
      ∀ n ≥ Nfinal, (CR / 2) * q1 ^ n ≤ ‖x n - xInf‖ := by
    intro n hn
    have hnNq : Nq ≤ n := le_trans (le_max_left Nq Nequiv) hn
    have hnEq : Nequiv ≤ n := le_trans (le_max_right Nq Nequiv) hn
    have hRlower := hCR n hnNq
    have hnorm_lower := hNequiv n hnEq
    nlinarith
  have hNpos_le_final : Npos ≤ Nfinal := by
    exact le_trans (le_max_left Npos (max NRpos (max Ninc (max Nstep Ndir))))
      (le_trans (le_max_left Nq Nequiv) le_rfl)
  rcases thm41_extend_lower_geometric_backward
      (d := fun n => ‖x n - xInf‖) (n0 := Npos) (N := Nfinal) (q := q1)
      (C := CR / 2) hq1pos hNpos_le_final hNpos (by positivity) hbound_event with
    ⟨C1, hC1pos, hC1⟩
  exact ⟨C1, hC1pos, fun n hn => hC1 n hn⟩

/-- Theorem 4.1: in the non-finitely-convergent case, the tail distance has the upper
geometric estimate. -/
theorem thm_4_1_tail_rate_of_not_finite [FiniteDimensional ℝ H] (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ) (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (η : ℝ) (hη : η > 0) (α : ℝ) (hα : α ≥ 0)
    (h_linear_growth : ∀ x, ‖x‖ ≤ η → excess (A x) (A (0 : H)) ≤ α * ‖x‖)
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_C11 : IsC11 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (M : ℝ) (hf_strongConv : IsStronglyConvex (fun x => (f x).toReal) M)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x => gradient (fun y => (f y).toReal) x))
    (lam : ℝ) (hlam : lam > 0) (lam_seq : ℕ → ℝ) (hlam_seq : ∀ n, lam_seq n = lam)
    (x : ℕ → H) (halg : AlgorithmA A B x lam_seq) (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (h_smooth : IsSmoothAt (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf))
    (hnot_finite : ¬ ∃ N, ∀ n ≥ N, x n = x (N)) :
    ∃ (n0 : ℕ), ∀ q2, 0 < q2 → q2 < 1 → q2 > α / (α + M * lam) →
      ∃ (C2 : ℝ), C2 > 0 ∧ ∀ n ≥ n0, ∑' (k : ℕ), ‖x (n+k) - xInf‖ ≤ C2 * q2 ^ n := by
  rcases thm41_smoothAt_unit_normal h_smooth with ⟨u, hu_norm, hu_normal⟩
  let D : Set ℕ := stationaryIndices x
  let R : ℕ → ℝ := fun n => ∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖
  let inc : ℕ → ℝ := fun n => ‖x (n + 1) - x n‖
  let pseq : ℕ → ℝ := fun n => (lam ^ 2)⁻¹ * inner ℝ (x (n + 1) - x n) u
  have hf_conv :
      ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
        f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y :=
    thm41_ereal_convex_of_strongConvex f M hfinite hf_strongConv
  have hlam_pos : ∀ n, lam_seq n > 0 := by
    intro n
    rw [hlam_seq n]
    exact hlam
  have hlam_nondec : ∀ n, lam_seq n ≤ lam_seq (n + 1) := by
    intro n
    rw [hlam_seq n, hlam_seq (n + 1)]
  have hdir :
      Tendsto (normalizedIncrementDirection x)
        (atTop ⊓ Filter.principal {n | n ∉ D}) (𝓝 u) :=
    prop_4_1_direction A B hA hdomA hAzero_int f hfinite hf_conv hf_C11.1
      hinf hB_eq_grad lam_seq hlam_pos hlam_nondec x halg xInf hxInf h_smooth
      D rfl u hu_norm R rfl hu_normal hnot_finite
  have hnorm_equiv :
      (fun n => ‖x n - xInf‖) ~[atTop] R :=
    prop_4_1_norm_equiv A B hA hdomA hAzero_int f hfinite hf_conv hf_C11.1
      hinf hB_eq_grad lam_seq hlam_pos hlam_nondec x halg xInf hxInf h_smooth
      D rfl u hu_norm R rfl hu_normal hnot_finite
  have hR_nonneg : ∀ n, 0 ≤ R n := by
    intro n
    dsimp [R]
    exact tsum_nonneg (fun k => norm_nonneg (x (n + k + 1) - x (n + k)))
  rcases thm41_eventual_distance_pos_of_not_finite A B hA hdomA hAzero_int f
      hfinite hf_C11 hinf M hf_strongConv hB_eq_grad lam_seq hlam_pos hlam_nondec
      x halg xInf hxInf h_smooth hnot_finite with
    ⟨Npos, hNpos⟩
  have hdist_eventually_pos : ∀ᶠ n in atTop, 0 < ‖x n - xInf‖ :=
    eventually_atTop.mpr ⟨Npos, hNpos⟩
  have hR_eventually_pos : ∀ᶠ n in atTop, 0 < R n :=
    hnorm_equiv.symm.eventually_pos hdist_eventually_pos
  have hinc_tail_summable_eventually :
      ∀ᶠ n in atTop, Summable (fun k : ℕ => ‖x (n + k + 1) - x (n + k)‖) := by
    filter_upwards [hR_eventually_pos] with n hn
    exact thm41_summable_of_tsum_pos (by simpa [R] using hn)
  rcases eventually_atTop.mp hinc_tail_summable_eventually with ⟨Ninc, hNinc⟩
  have hinc_sum : Summable inc := by
    have htail := hNinc Ninc le_rfl
    have htail' : Summable (fun k : ℕ => inc (k + Ninc)) := by
      simpa [inc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using htail
    exact (summable_nat_add_iff (f := inc) Ninc).mp htail'
  have hR_tail : ∀ n, R n = ∑' k : ℕ, inc (n + k) := by
    intro n
    rfl
  have hp_tendsto_zero : Tendsto pseq atTop (𝓝 (0 : ℝ)) := by
    have hshift1 : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
      Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
    have hx1 : Tendsto (fun n : ℕ => x (n + 1)) atTop (𝓝 xInf) := hxInf.comp hshift1
    have hdiff : Tendsto (fun n : ℕ => x (n + 1) - x n) atTop (𝓝 (0 : H)) := by
      simpa using hx1.sub hxInf
    have hinner :
        Tendsto (fun n : ℕ => inner ℝ (x (n + 1) - x n) u) atTop (𝓝 (0 : ℝ)) := by
      simpa using hdiff.inner tendsto_const_nhds
    simpa [pseq] using tendsto_const_nhds.mul hinner
  have hMpos : 0 < M := hf_strongConv.1
  refine ⟨0, ?_⟩
  intro q2 hq2pos hq2lt1 hq2bound
  rcases thm41_exists_tail_mu α M lam q2 hα hMpos hlam hq2pos hq2lt1 hq2bound with
    ⟨μ, hμpos, hμltM, hμratio⟩
  rcases thm41_eventual_step_ineq A B hA hdomA hAzero_int η hη α hα
      h_linear_growth f hfinite hf_C11 hinf M hf_strongConv hB_eq_grad lam hlam
      lam_seq hlam_seq x halg xInf hxInf h_smooth u hu_norm hu_normal hnot_finite
      μ hμltM with
    ⟨Nstep, hNstep⟩
  have hstep :
      ∀ n ≥ Nstep,
        -(α / lam) * inc (n + 1) + μ * R (n + 2) ≤
          pseq (n + 1) - pseq n := by
    intro n hn
    simpa [inc, pseq, R, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
      hNstep n hn
  have hβ_nonneg : 0 ≤ (lam ^ 2)⁻¹ := inv_nonneg.mpr (sq_nonneg lam)
  have hp_abs : ∀ n, |pseq n| ≤ (lam ^ 2)⁻¹ * inc n := by
    intro n
    let d : H := x (n + 1) - x n
    have hinner_abs : |inner ℝ d u| ≤ ‖d‖ := by
      calc
        |inner ℝ d u| ≤ ‖d‖ * ‖u‖ := abs_real_inner_le_norm d u
        _ = ‖d‖ := by rw [hu_norm, mul_one]
    have hβ_pos : 0 < (lam ^ 2)⁻¹ := by positivity
    calc
      |pseq n| = (lam ^ 2)⁻¹ * |inner ℝ d u| := by
        dsimp [pseq, d]
        rw [abs_mul, abs_of_pos hβ_pos]
      _ ≤ (lam ^ 2)⁻¹ * ‖d‖ :=
        mul_le_mul_of_nonneg_left hinner_abs hβ_nonneg
      _ = (lam ^ 2)⁻¹ * inc n := by rfl
  have hR_sum : Summable R :=
    thm41_summable_R_of_step_ineq (inc := inc) (R := R) (p := pseq)
      (N := Nstep) (a := α / lam) (m := μ) (β := (lam ^ 2)⁻¹)
      (fun n => norm_nonneg _) hR_nonneg hinc_sum hμpos
      (div_nonneg hα (le_of_lt hlam)) hβ_nonneg hp_abs hstep
  have hinner_event :=
    thm41_increment_inner_eventually_ge x D rfl u hu_norm hdir (1 / 2)
      (by norm_num : (0 : ℝ) < 1 / 2)
  rcases eventually_atTop.mp hinner_event with ⟨Ndir, hNdir⟩
  have hp_nonneg : ∀ n ≥ Ndir, 0 ≤ pseq n := by
    intro n hn
    have hinner_lower := hNdir n hn
    have hinc_nonneg : 0 ≤ inc n := norm_nonneg _
    have hinner_nonneg : 0 ≤ inner ℝ (x (n + 1) - x n) u := by
      nlinarith
    dsimp [pseq]
    exact mul_nonneg hβ_nonneg hinner_nonneg
  let Nbase := max Nstep Ndir
  have hstep_base :
      ∀ n ≥ Nbase,
        -(α / lam) * inc (n + 1) + μ * R (n + 2) ≤
          pseq (n + 1) - pseq n := by
    intro n hn
    exact hstep n (le_trans (le_max_left Nstep Ndir) hn)
  have hp_nonneg_base : ∀ n ≥ Nbase, 0 ≤ pseq n := by
    intro n hn
    exact hp_nonneg n (le_trans (le_max_right Nstep Ndir) hn)
  let S : ℕ → ℝ := fun n => ∑' k : ℕ, R (n + 1 + k)
  have hS_bound :
      ∀ n ≥ Nbase + 1, μ * S n ≤ (α / lam) * R n := by
    intro n hn
    simpa [S] using
      thm41_tail_tsum_bound_of_step_ineq (inc := inc) (R := R) (p := pseq)
        (N := Nbase) (a := α / lam) (μ := μ)
        hR_sum hinc_sum hp_tendsto_zero hp_nonneg_base hR_tail hstep_base n hn
  have htail_ratio : (α / lam) / (α / lam + μ) ≤ q2 := by
    have hden : α / lam + μ = (α + μ * lam) / lam := by
      field_simp [ne_of_gt hlam]
    calc
      (α / lam) / (α / lam + μ) = α / (α + μ * lam) := by
        rw [hden]
        field_simp [ne_of_gt hlam]
      _ ≤ q2 := hμratio
  have hSprev_eq : ∀ n ≥ Nbase + 1, S (n - 1) = R n + S n := by
    intro n hn
    have hnpos : 1 ≤ n := by omega
    have htail : Summable (fun k : ℕ => R (n + k)) := by
      have htail' : Summable (fun k : ℕ => R (k + n)) :=
        (summable_nat_add_iff (f := R) n).mpr hR_sum
      simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using htail'
    have h := (Summable.sum_add_tsum_nat_add (f := fun k : ℕ => R (n + k)) 1 htail).symm
    have hprev : S (n - 1) = ∑' k : ℕ, R (n + k) := by
      dsimp [S]
      apply tsum_congr
      intro k
      congr 1
      omega
    have hnext : S n = ∑' k : ℕ, R (n + (k + 1)) := by
      dsimp [S]
      apply tsum_congr
      intro k
      congr 1
      omega
    have hhead : (∑ i ∈ Finset.range 1, R (n + i)) = R n := by simp
    rw [hhead] at h
    rw [hprev, hnext]
    exact h
  have hSstep : ∀ n ≥ Nbase, S (n + 1) ≤ q2 * S n := by
    intro n hn
    have hidx : n + 1 ≥ Nbase + 1 := by omega
    have hS_nonneg : 0 ≤ S (n + 1) := by
      dsimp [S]
      exact tsum_nonneg (fun k => hR_nonneg _)
    have hR_nonneg_n : 0 ≤ R (n + 1) := hR_nonneg _
    have hprev := hSprev_eq (n + 1) hidx
    have hbound := hS_bound (n + 1) hidx
    have hrec := thm41_tail_step_of_sum_bound (R := R) (S := S) (n := n + 1)
      (q := q2) (a := α / lam) (m := μ) hS_nonneg hR_nonneg_n hprev hbound
      hμpos (div_nonneg hα (le_of_lt hlam)) htail_ratio
    simpa using hrec
  have hS_N_nonneg : 0 ≤ S Nbase := by
    dsimp [S]
    exact tsum_nonneg (fun k => hR_nonneg _)
  rcases thm41_eventual_upper_geometric_of_step hq2pos hSstep hS_N_nonneg with
    ⟨CS, hCSpos, hSgeom⟩
  have hdist_upper_event :=
    thm41_eventually_le_three_halves_of_equiv hnorm_equiv (Eventually.of_forall hR_nonneg)
  rcases eventually_atTop.mp hdist_upper_event with ⟨Nequiv, hNequiv⟩
  let Npoint := max Nequiv (Nbase + 1)
  let Cdist : ℝ := (3 / 2 : ℝ) * CS / q2
  have hCdist_pos : 0 < Cdist := by
    dsimp [Cdist]
    positivity
  have hdist_bound : ∀ n ≥ Npoint, ‖x n - xInf‖ ≤ Cdist * q2 ^ n := by
    intro n hn
    have hnEq : Nequiv ≤ n := le_trans (le_max_left Nequiv (Nbase + 1)) hn
    have hnBase1 : Nbase + 1 ≤ n := le_trans (le_max_right Nequiv (Nbase + 1)) hn
    have hnBase : Nbase ≤ n - 1 := by omega
    have hnpos : 1 ≤ n := by omega
    have hnorm_le := hNequiv n hnEq
    have hprev := hSprev_eq n hnBase1
    have hR_le_Sprev : R n ≤ S (n - 1) := by
      have hS_nonneg : 0 ≤ S n := by
        dsimp [S]
        exact tsum_nonneg (fun k => hR_nonneg _)
      nlinarith
    have hS_le := hSgeom (n - 1) hnBase
    have hpow : q2 ^ n = q2 ^ (n - 1) * q2 := by
      nth_rewrite 1 [show n = (n - 1) + 1 by omega]
      rw [pow_succ]
    have hscale :
        (3 / 2 : ℝ) * (CS * q2 ^ (n - 1)) = Cdist * q2 ^ n := by
      dsimp [Cdist]
      rw [hpow]
      field_simp [ne_of_gt hq2pos]
    calc
      ‖x n - xInf‖ ≤ (3 / 2 : ℝ) * R n := hnorm_le
      _ ≤ (3 / 2 : ℝ) * S (n - 1) := by
        exact mul_le_mul_of_nonneg_left hR_le_Sprev (by norm_num)
      _ ≤ (3 / 2 : ℝ) * (CS * q2 ^ (n - 1)) := by
        exact mul_le_mul_of_nonneg_left hS_le (by norm_num)
      _ = Cdist * q2 ^ n := hscale
  rcases thm41_tail_tsum_le_of_geometric_bound
      (a := fun n => ‖x n - xInf‖) (N := Npoint) (C := Cdist) (q := q2)
      (le_of_lt hq2pos) hq2lt1 (fun n => norm_nonneg _) hdist_bound with
    ⟨Ctail, hCtailpos, htail_bound⟩
  rcases thm41_extend_upper_geometric_backward
      (d := fun n => ∑' k : ℕ, ‖x (n + k) - xInf‖) (n0 := 0) (N := Npoint)
      (q := q2) (C := Ctail) hq2pos (Nat.zero_le Npoint) hCtailpos
      (fun n hn => (htail_bound n hn).2) with
    ⟨C2, hC2pos, hC2⟩
  exact ⟨C2, hC2pos, fun n hn => hC2 n hn⟩

/-- Theorem 4.1: if `alpha^2 < M`, then convergence is finite. -/
theorem thm_4_1_finite_of_alpha_sq_lt [FiniteDimensional ℝ H] (A B : SetValuedOperator H H)
    (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ) (hAzero_int : (0 : H) ∈ interior (A (0 : H)))
    (η : ℝ) (hη : η > 0) (α : ℝ) (hα : α ≥ 0)
    (h_linear_growth : ∀ x, ‖x‖ ≤ η → excess (A x) (A (0 : H)) ≤ α * ‖x‖)
    (f : H → EReal) (hfinite : ∀ x, f x ≠ ⊤ ∧ f x ≠ ⊥)
    (hf_C11 : IsC11 (fun x => (f x).toReal))
    (hinf : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (M : ℝ) (hf_strongConv : IsStronglyConvex (fun x => (f x).toReal) M)
    (hB_eq_grad : B = SetValuedOperator.ofFunction Set.univ
      (fun x => gradient (fun y => (f y).toReal) x))
    (lam : ℝ) (hlam : lam > 0) (lam_seq : ℕ → ℝ) (hlam_seq : ∀ n, lam_seq n = lam)
    (x : ℕ → H) (halg : AlgorithmA A B x lam_seq) (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (h_smooth : IsSmoothAt (A (0 : H)) (-gradient (fun y => (f y).toReal) xInf))
    (h_alpha_sq_lt : α ^ 2 < M) :
    ∃ N, ∀ n ≥ N, x n = x (N) := by
  by_contra hnot_finite
  have hMpos : 0 < M := hf_strongConv.1
  rcases thm41_rate_interval_nonempty α M lam hα hMpos hlam h_alpha_sq_lt with
    ⟨q2, q1, hq2pos, hq2q1, hq1lt1, hq1bound, hq2bound⟩
  have hq1pos : 0 < q1 := lt_trans hq2pos hq2q1
  have hq2lt1 : q2 < 1 := lt_trans hq2q1 hq1lt1
  rcases thm_4_1_lower_rate_of_not_finite A B hA hdomA hAzero_int η hη α hα
      h_linear_growth f hfinite hf_C11 hinf M hf_strongConv hB_eq_grad lam hlam
      lam_seq hlam_seq x halg xInf hxInf h_smooth hnot_finite with
    ⟨nLower, hLowerRate⟩
  rcases thm_4_1_tail_rate_of_not_finite A B hA hdomA hAzero_int η hη α hα
      h_linear_growth f hfinite hf_C11 hinf M hf_strongConv hB_eq_grad lam hlam
      lam_seq hlam_seq x halg xInf hxInf h_smooth hnot_finite with
    ⟨nTail, hTailRate⟩
  rcases hLowerRate q1 hq1pos hq1lt1 hq1bound with ⟨C1, hC1pos, hLower⟩
  rcases hTailRate q2 hq2pos hq2lt1 hq2bound with ⟨C2, hC2pos, hTailUpper⟩
  have hPointUpper : ∃ n0, ∀ n ≥ n0, ‖x n - xInf‖ ≤ C2 * q2 ^ n := by
    have hTailSummable :
        ∃ n0, ∀ n ≥ n0, Summable (fun k : ℕ => ‖x (n + k) - xInf‖) := by
      rcases thm41_smoothAt_unit_normal h_smooth with ⟨u, hu_norm, hu_normal⟩
      let D : Set ℕ := stationaryIndices x
      let R : ℕ → ℝ := fun n => ∑' k : ℕ, ‖x (n + k + 1) - x (n + k)‖
      have hf_conv :
          ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
            f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y :=
        thm41_ereal_convex_of_strongConvex f M hfinite hf_strongConv
      have hlam_pos : ∀ n, lam_seq n > 0 := by
        intro n
        rw [hlam_seq n]
        exact hlam
      have hlam_nondec : ∀ n, lam_seq n ≤ lam_seq (n + 1) := by
        intro n
        rw [hlam_seq n, hlam_seq (n + 1)]
      have hnorm_equiv :
          (fun n => ‖x n - xInf‖) ~[atTop] R :=
        prop_4_1_norm_equiv A B hA hdomA hAzero_int f hfinite hf_conv hf_C11.1
          hinf hB_eq_grad lam_seq hlam_pos hlam_nondec x halg xInf hxInf h_smooth
          D rfl u hu_norm R rfl hu_normal hnot_finite
      have hR_sum : Summable R := by
        have hR_nonneg : ∀ n, 0 ≤ R n := by
          intro n
          dsimp [R]
          exact tsum_nonneg (fun k => norm_nonneg (x (n + k + 1) - x (n + k)))
        have hdist_tendsto_zero :
            Tendsto (fun n : ℕ => ‖x n - xInf‖) atTop (𝓝 (0 : ℝ)) := by
          have hx_sub : Tendsto (fun n : ℕ => x n - xInf) atTop (𝓝 (0 : H)) := by
            have hconst : Tendsto (fun _ : ℕ => xInf) atTop (𝓝 xInf) :=
              tendsto_const_nhds
            simpa using hxInf.sub hconst
          simpa using (continuous_norm.tendsto (0 : H)).comp hx_sub
        have hR_tendsto_zero : Tendsto R atTop (𝓝 (0 : ℝ)) :=
          hnorm_equiv.tendsto_nhds hdist_tendsto_zero
        have hR_eventually_pos : ∀ᶠ n in atTop, 0 < R n := by
          rcases thm41_eventual_distance_pos_of_not_finite A B hA hdomA hAzero_int f
              hfinite hf_C11 hinf M hf_strongConv hB_eq_grad lam_seq hlam_pos
              hlam_nondec x halg xInf hxInf h_smooth hnot_finite with
            ⟨Npos, hNpos⟩
          have hdist_eventually_pos :
              ∀ᶠ n in atTop, 0 < ‖x n - xInf‖ :=
            eventually_atTop.mpr ⟨Npos, hNpos⟩
          exact hnorm_equiv.symm.eventually_pos hdist_eventually_pos
        have hinc_tail_summable_eventually :
            ∀ᶠ n in atTop,
              Summable (fun k : ℕ => ‖x (n + k + 1) - x (n + k)‖) := by
          filter_upwards [hR_eventually_pos] with n hn
          exact thm41_summable_of_tsum_pos (by simpa [R] using hn)
        have hR_eq_add_eventually :
            ∀ᶠ n in atTop,
              R n = ‖x (n + 1) - x n‖ + R (n + 1) := by
          filter_upwards [hinc_tail_summable_eventually] with n hn
          dsimp [R]
          simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
            thm41_increment_tail_tsum_eq_head_add_tail x n hn
        have hR_antitone_eventually :
            ∀ᶠ n in atTop, R (n + 1) ≤ R n := by
          filter_upwards [hR_eq_add_eventually] with n hn
          rw [hn]
          exact le_add_of_nonneg_left (norm_nonneg (x (n + 1) - x n))
        let inc : ℕ → ℝ := fun n => ‖x (n + 1) - x n‖
        let pseq : ℕ → ℝ := fun n => (lam ^ 2)⁻¹ * inner ℝ (x (n + 1) - x n) u
        rcases eventually_atTop.mp hinc_tail_summable_eventually with ⟨Ninc, hNinc⟩
        have hinc_sum : Summable inc := by
          have htail := hNinc Ninc le_rfl
          have htail' : Summable (fun k : ℕ => inc (k + Ninc)) := by
            simpa [inc, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using htail
          exact (summable_nat_add_iff (f := inc) Ninc).mp htail'
        rcases thm41_eventual_step_ineq A B hA hdomA hAzero_int η hη α hα
            h_linear_growth f hfinite hf_C11 hinf M hf_strongConv hB_eq_grad lam hlam
            lam_seq hlam_seq x halg xInf hxInf h_smooth u hu_norm hu_normal hnot_finite
            (M / 2) (by nlinarith [hMpos]) with
          ⟨Nstep, hNstep⟩
        have hstep :
            ∀ n ≥ Nstep,
              -(α / lam) * inc (n + 1) + (M / 2) * R (n + 2) ≤
                pseq (n + 1) - pseq n := by
          intro n hn
          simpa [inc, pseq, R, Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using
            hNstep n hn
        have hβ_nonneg : 0 ≤ (lam ^ 2)⁻¹ := by positivity
        have hp_abs : ∀ n, |pseq n| ≤ (lam ^ 2)⁻¹ * inc n := by
          intro n
          let d : H := x (n + 1) - x n
          have hinner_abs : |inner ℝ d u| ≤ ‖d‖ := by
            calc
              |inner ℝ d u| ≤ ‖d‖ * ‖u‖ := abs_real_inner_le_norm d u
              _ = ‖d‖ := by rw [hu_norm, mul_one]
          have hβ_pos : 0 < (lam ^ 2)⁻¹ := by positivity
          calc
            |pseq n| = (lam ^ 2)⁻¹ * |inner ℝ d u| := by
              dsimp [pseq, d]
              rw [abs_mul, abs_of_pos hβ_pos]
            _ ≤ (lam ^ 2)⁻¹ * ‖d‖ :=
              mul_le_mul_of_nonneg_left hinner_abs hβ_nonneg
            _ = (lam ^ 2)⁻¹ * inc n := by rfl
        exact thm41_summable_R_of_step_ineq
          (inc := inc) (R := R) (p := pseq) (N := Nstep)
          (a := α / lam) (m := M / 2) (β := (lam ^ 2)⁻¹)
          (fun n => norm_nonneg _) hR_nonneg hinc_sum
          (by nlinarith [hMpos]) (div_nonneg hα (le_of_lt hlam)) hβ_nonneg
          hp_abs hstep
      exact thm41_tail_summable_of_equiv_summable hR_sum hnorm_equiv
    rcases hTailSummable with ⟨nSummable, hSummable⟩
    refine ⟨max nTail nSummable, ?_⟩
    intro n hn
    exact thm41_pointwise_upper_of_tail_tsum_upper x xInf
      (fun m hm => hSummable m (le_trans (le_max_right nTail nSummable) hm))
      (fun m hm => hTailUpper m (le_trans (le_max_left nTail nSummable) hm)) n hn
  rcases hPointUpper with ⟨nUpper, hUpper⟩
  let n0 := max nLower nUpper
  have hLower' : ∀ n ≥ n0, C1 * q1 ^ n ≤ ‖x n - xInf‖ := by
    intro n hn
    exact hLower n (le_trans (le_max_left nLower nUpper) hn)
  have hUpper' : ∀ n ≥ n0, ‖x n - xInf‖ ≤ C2 * q2 ^ n := by
    intro n hn
    exact hUpper n (le_trans (le_max_right nLower nUpper) hn)
  exact thm41_eventual_geometric_bounds_incompatible (a := fun n => ‖x n - xInf‖)
    hC1pos hq2pos hq2q1 hLower' hUpper'
