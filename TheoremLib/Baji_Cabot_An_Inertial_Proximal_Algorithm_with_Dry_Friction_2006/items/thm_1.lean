/-!
# Theorem 3.1
Let $A: H \Rightarrow H$ be a maximal monotone operator such that
$\operatorname{dom} A = H$ and $0 \in \operatorname{int}(A(0))$.
The operator $B$ is supposed to be equal to $\partial f$ for a closed convex function
$f: H \to \mathbb{R} \cup \{+\infty\}$ satisfying $\operatorname{dom} \partial f \neq \emptyset$
and $\inf f > -\infty$. The positive sequence $(\lambda_n)$ is assumed to be
nondecreasing. Then, the sequence $(x_n)$ defined by algorithm $(\mathcal{A})$ satisfies:
(i) $(|x_{n+1} - x_n|) \in \ell^1$ and therefore $x_\infty := s-\lim_{n \to +\infty} x_n$ exists.
(ii) The vector $x_\infty$ is such that $0 \in A(0) + \partial f(x_\infty)$.
(iii) If $H$ is finite-dimensional, then either the sequence $(x_n)$ is finitely convergent
or the limit points of $((x_{n+1} - x_n)/|x_{n+1} - x_n|)_{n \in \mathbb{N} \setminus \mathcal{D}}$
are contained in $N_{A(0)}(-\partial f(x_\infty))$.
If moreover $-\partial f(x_\infty) \subset \operatorname{int}(A(0))$, the sequence $(x_n)$
is finitely convergent.
-/
open SetValuedOperator
open scoped Topology
open Set
open Filter
open scoped Pointwise
variable {H : Type _} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- Directions of non-stationary increments of the sequence generated by Algorithm (A). -/
noncomputable def normalizedIncrementDirection (x : ℕ → H) (n : ℕ) : H :=
  ‖x (n+1) - x n‖⁻¹ • (x (n+1) - x n)

/-- Limit points of the normalized non-stationary increments. -/
def normalizedIncrementLimitPoints (x : ℕ → H) : Set H :=
  {d | ∃ φ : ℕ → ℕ,
    StrictMono φ ∧
    (∀ n, φ n ∉ stationaryIndices x) ∧
    Tendsto (fun n => normalizedIncrementDirection x (φ n)) atTop (𝓝 d)}

/-- Common hypotheses of Theorem 3.1. -/
structure Theorem31Assumptions (A B : SetValuedOperator H H) (f : H → EReal)
    (lam : ℕ → ℝ) (x : ℕ → H) : Prop where
  maxMonotoneA : IsMaximalMonotone A
  domA : A.dom = Set.univ
  zero_mem_interior_A_zero : (0 : H) ∈ interior (A (0 : H))
  convex_f : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
    f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y
  lowerSemicontinuous_f : LowerSemicontinuous f
  B_eq_subderivative_f : ∀ x, B x = {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)}
  dom_subderivative_nonempty : (SetValuedOperator.dom B).Nonempty
  f_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x
  lam_pos : ∀ n, lam n > 0
  lam_nondec : ∀ n, lam n ≤ lam (n+1)
  initial_point_mem_dom : x 1 ∈ ERealFunction.dom f
  generated_by_algorithm : AlgorithmA A B x lam

/-!
The following auxiliary statements isolate the analytic steps used in the proof of
Theorem 3.1.  They are stated as separate prerequisites because they are exactly the
places where the paper uses nontrivial facts not developed in the current item file:
domain propagation for the subgradient algorithm, conversion of the weighted
`Φ_A` estimate to finite total variation, strong/weak closedness of maximal monotone
and subdifferential graphs, and the finite-dimensional limit-direction argument.
-/

omit [CompleteSpace H] in
private theorem theorem31_algorithm_step_selection (A B : SetValuedOperator H H)
    (lam : ℕ → ℝ) (x : ℕ → H) (halg : AlgorithmA A B x lam) :
    ∀ n, ∃ a b : H,
      a ∈ A ((lam n)⁻¹ • (x (n + 2) - x (n + 1))) ∧
      b ∈ B (x (n + 2)) ∧
      ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n) + a + b = 0 := by
  intro n
  let v : H := (lam n)⁻¹ • (x (n + 2) - x (n + 1))
  let acc : H := ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)
  have hstep : (0 : H) ∈ ({acc} : Set H) + A v + B (x (n + 2)) := by
    simpa [AlgorithmA, acc, v] using halg.step n
  rw [Set.mem_add] at hstep
  rcases hstep with ⟨p, hp, b, hb, hpbeq⟩
  rw [Set.mem_add] at hp
  rcases hp with ⟨c, hc, a, ha, hp_eq⟩
  rw [Set.mem_singleton_iff] at hc
  subst c
  refine ⟨a, b, ?_, hb, ?_⟩
  · simpa [v]
  · have hp_eq' : acc + a = p := by simp [hp_eq]
    rw [← hpbeq, ← hp_eq']

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem tendsto_shift_sub_self_zero (x : ℕ → H) (xInf : H)
    (hxInf : Tendsto x atTop (𝓝 xInf)) :
    Tendsto (fun n : ℕ => x (n + 1) - x n) atTop (𝓝 (0 : H)) := by
  have hshift : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
  have hxshift : Tendsto (fun n : ℕ => x (n + 1)) atTop (𝓝 xInf) := hxInf.comp hshift
  simpa using hxshift.sub hxInf

private theorem theorem31_lam_zero_le_lam (lam : ℕ → ℝ)
    (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) : ∀ n, lam 0 ≤ lam n := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih => exact le_trans ih (hlam_nondec n)

private theorem theorem31_inv_lam_bound (lam : ℕ → ℝ)
    (hlam_pos : ∀ n, 0 < lam n) (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) :
    ∀ n, ‖(lam n)⁻¹‖ ≤ (lam 0)⁻¹ := by
  intro n
  rw [Real.norm_eq_abs]
  rw [abs_of_pos (inv_pos.mpr (hlam_pos n))]
  exact inv_anti₀ (hlam_pos 0) (theorem31_lam_zero_le_lam lam hlam_nondec n)

private theorem theorem31_inv_lam_sq_bound (lam : ℕ → ℝ)
    (hlam_pos : ∀ n, 0 < lam n) (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) :
    ∀ n, ‖((lam n)^2)⁻¹‖ ≤ ((lam 0)^2)⁻¹ := by
  intro n
  rw [Real.norm_eq_abs]
  have hsqpos0 : 0 < (lam 0)^2 := sq_pos_of_ne_zero (ne_of_gt (hlam_pos 0))
  have hsqposn : 0 < (lam n)^2 := sq_pos_of_ne_zero (ne_of_gt (hlam_pos n))
  rw [abs_of_pos (inv_pos.mpr hsqposn)]
  apply inv_anti₀ hsqpos0
  exact sq_le_sq.mpr (by
    simpa [abs_of_pos (hlam_pos 0), abs_of_pos (hlam_pos n)] using
      theorem31_lam_zero_le_lam lam hlam_nondec n)

omit [CompleteSpace H] in
private theorem tendsto_smul_zero_of_norm_bounded {c : ℕ → ℝ} {z : ℕ → H} {C : ℝ}
    (hC : ∀ n, ‖c n‖ ≤ C) (hz : Tendsto z atTop (𝓝 (0 : H))) :
    Tendsto (fun n => c n • z n) atTop (𝓝 (0 : H)) := by
  rw [tendsto_zero_iff_norm_tendsto_zero] at hz ⊢
  have hbound : ∀ n, ‖c n • z n‖ ≤ C * ‖z n‖ := by
    intro n
    rw [norm_smul]
    exact mul_le_mul_of_nonneg_right (hC n) (norm_nonneg _)
  have hprod : Tendsto (fun n => C * ‖z n‖) atTop (𝓝 (0 : ℝ)) := by
    simpa using (tendsto_const_nhds.mul hz)
  exact squeeze_zero (fun n => norm_nonneg _) hbound hprod

omit [CompleteSpace H] in
private theorem theorem31_scaled_velocity_tendsto_zero (lam : ℕ → ℝ) (x : ℕ → H)
    (xInf : H) (hlam_pos : ∀ n, 0 < lam n)
    (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    Tendsto (fun n : ℕ => (lam n)⁻¹ • (x (n + 2) - x (n + 1))) atTop
      (𝓝 (0 : H)) := by
  have hshift : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
  have hxshift : Tendsto (fun n : ℕ => x (n + 1)) atTop (𝓝 xInf) := hxInf.comp hshift
  have hz : Tendsto (fun n : ℕ => x (n + 2) - x (n + 1)) atTop (𝓝 (0 : H)) := by
    simpa [Nat.add_assoc] using
      tendsto_shift_sub_self_zero (fun n => x (n + 1)) xInf hxshift
  exact tendsto_smul_zero_of_norm_bounded
    (theorem31_inv_lam_bound lam hlam_pos hlam_nondec) hz

omit [CompleteSpace H] in
private theorem theorem31_acceleration_tendsto_zero (lam : ℕ → ℝ) (x : ℕ → H)
    (xInf : H) (hlam_pos : ∀ n, 0 < lam n)
    (hlam_nondec : ∀ n, lam n ≤ lam (n + 1)) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    Tendsto (fun n : ℕ =>
      ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)) atTop (𝓝 (0 : H)) := by
  have hshift : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
  have hxshift : Tendsto (fun n : ℕ => x (n + 1)) atTop (𝓝 xInf) := hxInf.comp hshift
  have hdiff0 : Tendsto (fun n : ℕ => x (n + 1) - x n) atTop (𝓝 (0 : H)) :=
    tendsto_shift_sub_self_zero x xInf hxInf
  have hdiff1 : Tendsto (fun n : ℕ => x (n + 2) - x (n + 1)) atTop
      (𝓝 (0 : H)) := by
    simpa [Nat.add_assoc] using
      tendsto_shift_sub_self_zero (fun n => x (n + 1)) xInf hxshift
  have hnum : Tendsto (fun n : ℕ => x (n + 2) - 2 • x (n + 1) + x n) atTop
      (𝓝 (0 : H)) := by
    have hsub : Tendsto
        (fun n : ℕ => (x (n + 2) - x (n + 1)) - (x (n + 1) - x n)) atTop
        (𝓝 (0 : H)) := by
      simpa using hdiff1.sub hdiff0
    convert hsub using 1
    · ext n
      abel
  exact tendsto_smul_zero_of_norm_bounded
    (theorem31_inv_lam_sq_bound lam hlam_pos hlam_nondec) hnum

omit [CompleteSpace H] in
private theorem subderivative_mem_ne_top (B : SetValuedOperator H H) (f : H → EReal)
    (hB : ∀ x, B x = {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)})
    (hfinite : ∃ z, f z < ⊤) {x u : H} (hu : u ∈ B x) :
    f x ≠ ⊤ := by
  rcases hfinite with ⟨z, hzfinite⟩
  have husub : ∀ y, f y ≥ f x + (inner ℝ u (y - x) : EReal) := by
    have : u ∈ {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)} := by
      simpa [hB] using hu
    simpa using this
  intro hx_top
  have h := husub z
  rw [hx_top] at h
  rw [EReal.top_add_of_ne_bot (EReal.coe_ne_bot _)] at h
  exact (ne_of_lt hzfinite) (top_le_iff.mp h)

omit [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem subderivative_mem_ne_bot (f : H → EReal)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x) {x : H} : f x ≠ ⊥ := by
  rcases hf_bddBelow with ⟨m, hm⟩
  intro hx
  have h := hm x
  rw [hx] at h
  simp at h

omit [CompleteSpace H] in
private theorem theorem31_subderivative_monotone (B : SetValuedOperator H H) (f : H → EReal)
    (hB : ∀ x, B x = {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)})
    (hfinite : ∃ z, f z < ⊤)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x) :
    IsMonotone B := by
  intro x y u hu v hv
  have husub : ∀ z, f z ≥ f x + (inner ℝ u (z - x) : EReal) := by
    have : u ∈ {v | ∀ z, f z ≥ f x + (inner ℝ v (z - x) : EReal)} := by
      simpa [hB] using hu
    simpa using this
  have hvsub : ∀ z, f z ≥ f y + (inner ℝ v (z - y) : EReal) := by
    have : v ∈ {v | ∀ z, f z ≥ f y + (inner ℝ v (z - y) : EReal)} := by
      simpa [hB] using hv
    simpa using this
  have hx_top : f x ≠ ⊤ := subderivative_mem_ne_top B f hB hfinite hu
  have hy_top : f y ≠ ⊤ := subderivative_mem_ne_top B f hB hfinite hv
  have hx_bot : f x ≠ ⊥ := subderivative_mem_ne_bot f hf_bddBelow
  have hy_bot : f y ≠ ⊥ := subderivative_mem_ne_bot f hf_bddBelow
  have hyx := husub y
  have hxy := hvsub x
  have h_add_bot_y : f x + (inner ℝ u (y - x) : EReal) ≠ ⊥ := by
    rw [← EReal.coe_toReal hx_top hx_bot]
    simp
  have h_add_bot_x : f y + (inner ℝ v (x - y) : EReal) ≠ ⊥ := by
    rw [← EReal.coe_toReal hy_top hy_bot]
    simp
  have hyx_real := EReal.toReal_le_toReal hyx h_add_bot_y hy_top
  have hxy_real := EReal.toReal_le_toReal hxy h_add_bot_x hx_top
  have hyx_add :
      (f x + (inner ℝ u (y - x) : EReal)).toReal =
        (f x).toReal + inner ℝ u (y - x) := by
    exact EReal.toReal_add hx_top hx_bot (EReal.coe_ne_top _) (EReal.coe_ne_bot _)
  have hxy_add :
      (f y + (inner ℝ v (x - y) : EReal)).toReal =
        (f y).toReal + inner ℝ v (x - y) := by
    exact EReal.toReal_add hy_top hy_bot (EReal.coe_ne_top _) (EReal.coe_ne_bot _)
  have h1 : (f x).toReal + inner ℝ u (y - x) ≤ (f y).toReal := by
    simpa [hyx_add] using hyx_real
  have h2 : (f y).toReal + inner ℝ v (x - y) ≤ (f x).toReal := by
    simpa [hxy_add] using hxy_real
  have hsum : inner ℝ u (y - x) + inner ℝ v (x - y) ≤ 0 := by
    linarith
  have hgoal_eq :
      inner ℝ (u - v) (x - y) = -(inner ℝ u (y - x) + inner ℝ v (x - y)) := by
    rw [inner_sub_left]
    rw [show y - x = -(x - y) by abel]
    rw [inner_neg_right]
    ring
  rw [hgoal_eq]
  linarith

theorem theorem31_variation_converges_from_phi_bound_core (A : SetValuedOperator H H)
    (lam : ℕ → ℝ) (x : ℕ → H) (α : ℝ) (hα : 0 < α)
    (hPhi : ∀ z, PhiA A z ≥ ((α * ‖z‖ : ℝ) : EReal))
    (hlam_pos : ∀ n, lam n > 0) (_hlam_nondec : ∀ n, lam n ≤ lam (n + 1))
    (hWeighted : ∃ S : ℝ,
      Tendsto (fun N : ℕ => (Finset.range (N + 1)).sum (fun n =>
        (lam n : EReal) * PhiA A ((lam n)⁻¹ • (x (n + 2) - x (n + 1)))))
        atTop (𝓝 S)) :
    (∃ S : ℝ,
    Tendsto (fun N : ℕ =>
        (Finset.range (N + 1)).sum (fun n => ‖x (n + 1) - x n‖)) atTop (𝓝 S)) ∧
    ∃ xInf : H, Tendsto x atTop (𝓝 xInf) := by
  classical
  let tail : ℕ → ℝ := fun n => ‖x (n + 2) - x (n + 1)‖
  let termE : ℕ → EReal := fun n =>
    (lam n : EReal) * PhiA A ((lam n)⁻¹ • (x (n + 2) - x (n + 1)))
  have hterm_lower : ∀ n, ((α * tail n : ℝ) : EReal) ≤ termE n := by
    intro n
    have h1 : ((α * ‖(lam n)⁻¹ • (x (n + 2) - x (n + 1))‖ : ℝ) : EReal) ≤
        PhiA A ((lam n)⁻¹ • (x (n + 2) - x (n + 1))) := by
      simpa using hPhi ((lam n)⁻¹ • (x (n + 2) - x (n + 1)))
    have hlam_nonnegE : (0 : EReal) ≤ (lam n : EReal) := by
      exact (EReal.coe_nonneg).2 (le_of_lt (hlam_pos n))
    have hmul : (lam n : EReal) *
          ((α * ‖(lam n)⁻¹ • (x (n + 2) - x (n + 1))‖ : ℝ) : EReal) ≤
        (lam n : EReal) * PhiA A ((lam n)⁻¹ • (x (n + 2) - x (n + 1))) := by
      exact mul_le_mul_of_nonneg_left h1 hlam_nonnegE
    have hreal : lam n * (α * ‖(lam n)⁻¹ • (x (n + 2) - x (n + 1))‖) =
        α * ‖x (n + 2) - x (n + 1)‖ := by
      rw [norm_smul]
      simp [Real.norm_eq_abs, abs_of_pos (hlam_pos n)]
      field_simp [ne_of_gt (hlam_pos n)]
    calc
      ((α * tail n : ℝ) : EReal)
          = (lam n : EReal) *
              ((α * ‖(lam n)⁻¹ • (x (n + 2) - x (n + 1))‖ : ℝ) : EReal) := by
              rw [← hreal]
              simp
      _ ≤ termE n := by simpa [termE, tail] using hmul
  have hsum_lower : ∀ N : ℕ,
      (((Finset.range (N + 1)).sum (fun n => α * tail n) : ℝ) : EReal) ≤
        (Finset.range (N + 1)).sum termE := by
    intro N
    have hcoe_sum :
        (((Finset.range (N + 1)).sum (fun n => α * tail n) : ℝ) : EReal) =
          (Finset.range (N + 1)).sum (fun n => ((α * tail n : ℝ) : EReal)) := by
      refine Finset.induction_on (Finset.range (N + 1)) ?_ ?_
      · simp
      · intro a s ha ih
        simp [Finset.sum_insert, ha, ih]
    rw [hcoe_sum]
    exact Finset.sum_le_sum (fun n _ => hterm_lower n)
  rcases hWeighted with ⟨S, hS⟩
  have hS' : Tendsto (fun N : ℕ => (Finset.range (N + 1)).sum termE) atTop
      (𝓝 (S : EReal)) := by
    simpa [termE] using hS
  have hlt : ((S : EReal) < ((S + 1 : ℝ) : EReal)) := EReal.coe_lt_coe (lt_add_one S)
  have hev : ∀ᶠ N in atTop,
      (Finset.range (N + 1)).sum termE < ((S + 1 : ℝ) : EReal) :=
    (tendsto_order.mp hS').2 ((S + 1 : ℝ) : EReal) hlt
  rcases Filter.eventually_atTop.mp hev with ⟨N0, hN0⟩
  have hsum_alpha_bound :
      ∀ N : ℕ, (Finset.range N).sum (fun n => α * tail n) ≤ S + 1 := by
    intro N
    let K := max N N0
    have hsubset : Finset.range N ⊆ Finset.range (K + 1) := by
      intro n hn
      rw [Finset.mem_range] at hn ⊢
      exact lt_of_lt_of_le hn (Nat.le_succ_of_le (le_max_left N N0))
    have hmono_real :
        (Finset.range N).sum (fun n => α * tail n) ≤
          (Finset.range (K + 1)).sum (fun n => α * tail n) := by
      refine Finset.sum_le_sum_of_subset_of_nonneg hsubset ?_
      intro n hnK hnN
      exact mul_nonneg (le_of_lt hα) (norm_nonneg _)
    have hmonoE :
        (((Finset.range N).sum (fun n => α * tail n) : ℝ) : EReal) ≤
          (((Finset.range (K + 1)).sum (fun n => α * tail n) : ℝ) : EReal) :=
      EReal.coe_le_coe hmono_real
    have hle_weight := le_trans hmonoE (hsum_lower K)
    have hlt_bound := lt_of_le_of_lt hle_weight (hN0 K (le_max_right N N0))
    exact le_of_lt (EReal.coe_lt_coe_iff.mp hlt_bound)
  have htail_summable : Summable tail := by
    refine summable_of_sum_range_le (c := (S + 1) / α) (fun n => norm_nonneg _) ?_
    intro N
    have hbound := hsum_alpha_bound N
    have hsum_mul : (Finset.range N).sum (fun n => α * tail n) =
        α * (Finset.range N).sum tail := by
      rw [Finset.mul_sum]
    have hbound' : α * (Finset.range N).sum tail ≤ S + 1 := by
      simpa [hsum_mul] using hbound
    have hαpos := hα
    nlinarith [div_mul_cancel₀ (S + 1) (ne_of_gt hαpos)]
  have hinc_summable : Summable (fun n => ‖x (n + 1) - x n‖) := by
    have hshift : Summable (fun n => ‖x (n + 1 + 1) - x (n + 1)‖) := by
      simpa [tail, Nat.add_assoc] using htail_summable
    simpa [Nat.add_assoc] using
      (summable_nat_add_iff (f := fun n => ‖x (n + 1) - x n‖) 1).mp hshift
  constructor
  · refine ⟨∑' n, ‖x (n + 1) - x n‖, ?_⟩
    have ht := hinc_summable.hasSum.tendsto_sum_nat
    have hshiftN : Filter.Tendsto (fun N : ℕ => N + 1) atTop atTop :=
      Filter.tendsto_atTop_mono (fun N => Nat.le_succ N) tendsto_id
    exact ht.comp hshiftN
  · have hdist_summable : Summable (fun n => dist (x n) (x n.succ)) := by
      simpa [dist_eq_norm, Nat.succ_eq_add_one, norm_sub_rev] using hinc_summable
    exact cauchySeq_tendsto_of_complete (cauchySeq_of_summable_dist hdist_summable)

omit [CompleteSpace H] in
/-- A graph point of a monotone operator belongs to its zero-enlargement. -/
private theorem theorem21_18_mem_enlargement_zero_of_mem {T : SetValuedOperator H H}
    (hT : IsMonotone T) {x u : H} (hu : u ∈ T x) :
    u ∈ enlargement T 0 x := by
  rw [enlargement, Set.mem_setOf_eq]
  intro y v hv
  have hmono : 0 ≤ inner ℝ (u - v) (x - y) := hT u hu v hv
  have hEq : inner ℝ (u - v) (x - y) = inner ℝ (v - u) (y - x) := by
    rw [show u - v = -(v - u) by abel]
    rw [show x - y = -(y - x) by abel]
    rw [inner_neg_left, inner_neg_right, neg_neg]
  simpa [← hEq] using hmono

omit [CompleteSpace H] in
/-- For a maximal monotone operator, the zero-enlargement is contained in the operator. -/
private theorem theorem21_18_enlargement_zero_subset_of_maximal {T : SetValuedOperator H H}
    (hT : IsMaximalMonotone T) {x v : H} (hv : v ∈ enlargement T 0 x) :
    v ∈ T x := by
  rcases hT with ⟨hT_mono, hT_max⟩
  let T' : SetValuedOperator H H := fun y => T y ∪ {w | y = x ∧ w = v}
  have hT_subset : T.graph ⊆ T'.graph := by
    intro p hp
    exact Or.inl hp
  have hT'_mono : IsMonotone T' := by
    intro y z uy huy uz huz
    rcases huy with huy | huy
    · rcases huz with huz | huz
      · exact hT_mono uy huy uz huz
      · rcases huz with ⟨rfl, rfl⟩
        rw [enlargement, Set.mem_setOf_eq] at hv
        have h := hv y uy huy
        simpa [inner_neg_right] using h
    · rcases huy with ⟨rfl, rfl⟩
      rcases huz with huz | huz
      · rw [enlargement, Set.mem_setOf_eq] at hv
        have h := hv z uz huz
        have hEq : inner ℝ (uy - uz) (y - z) = inner ℝ (uz - uy) (z - y) := by
          rw [show uy - uz = -(uz - uy) by abel]
          rw [show y - z = -(z - y) by abel]
          rw [inner_neg_left, inner_neg_right, neg_neg]
        rw [hEq]
        simpa using h
      · rcases huz with ⟨rfl, rfl⟩
        simp
  have hgraph : T'.graph ⊆ T.graph := hT_max T' hT'_mono hT_subset
  have hp : (x, v) ∈ T'.graph := by
    change v ∈ T' x
    exact Or.inr ⟨rfl, rfl⟩
  exact hgraph hp

/-- In the Baire proof of Theorem 21.18, the set of points with a value of norm at most `N`
is closed. -/
private theorem theorem21_18_isClosed_bounded_value_slice
    (A : SetValuedOperator H H) (hA : IsMaximalMonotone A) (N : ℕ) :
    IsClosed {x : H | ∃ u : H, u ∈ A x ∧ ‖u‖ ≤ (N : ℝ)} := by
  rw [← isSeqClosed_iff_isClosed]
  intro xseq x hxseq hx
  choose u huA huN using hxseq
  have hu_bdd : Bornology.IsBounded (Set.range u) := by
    rw [isBounded_iff_forall_norm_le]
    exact ⟨(N : ℝ), fun y hy => by
      rcases hy with ⟨n, rfl⟩
      exact huN n⟩
  rcases bounded_sequence_has_weakly_convergent_subsequence u hu_bdd with
    ⟨u0, φ, hφ, huweak⟩
  have hxφ : Tendsto (fun k : ℕ => xseq (φ k)) atTop (𝓝 x) :=
    hx.comp hφ.tendsto_atTop
  have hu_enl : ∀ k, u (φ k) ∈ enlargement A 0 (xseq (φ k)) := by
    intro k
    exact theorem21_18_mem_enlargement_zero_of_mem hA.1 (huA (φ k))
  have hzero : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 (0 : ℝ)) := tendsto_const_nhds
  have hu0_enl : u0 ∈ enlargement A 0 x :=
    demiclosed_strong_x_weakStar_u hA.1 hxφ huweak hzero hu_enl
  have hu0A : u0 ∈ A x :=
    theorem21_18_enlargement_zero_subset_of_maximal hA hu0_enl
  have hu0_closedBall : u0 ∈ Metric.closedBall (0 : H) (N : ℝ) := by
    have hclosed : IsClosed (Metric.closedBall (0 : H) (N : ℝ)) :=
      Metric.isClosed_closedBall
    have hconv : Convex ℝ (Metric.closedBall (0 : H) (N : ℝ)) := by
      simpa using (convex_closedBall (0 : H) (N : ℝ))
    have humem : ∀ k, u (φ k) ∈ Metric.closedBall (0 : H) (N : ℝ) := by
      intro k
      simpa [Metric.mem_closedBall, dist_zero_right] using huN (φ k)
    exact mem_of_tendsto_weakly_of_isClosed_convex hclosed hconv humem huweak
  refine ⟨u0, hu0A, ?_⟩
  simpa [Metric.mem_closedBall, dist_zero_right] using hu0_closedBall

/-- Baire-category entry point for Theorem 21.18: when `A` has full domain, one of the
closed slices of points with a bounded value has nonempty interior. -/
private theorem theorem21_18_exists_interior_bounded_value_slice
    (A : SetValuedOperator H H) (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ) :
    ∃ N : ℕ, (interior {x : H | ∃ u : H, u ∈ A x ∧ ‖u‖ ≤ (N : ℝ)}).Nonempty := by
  let C : ℕ → Set H := fun N => {x : H | ∃ u : H, u ∈ A x ∧ ‖u‖ ≤ (N : ℝ)}
  have hclosed : ∀ N, IsClosed (C N) := by
    intro N
    simpa [C] using theorem21_18_isClosed_bounded_value_slice A hA N
  have hcover : (⋃ N : ℕ, C N) = Set.univ := by
    ext x
    constructor
    · intro _
      simp
    · intro _
      have hxdom : x ∈ A.dom := by
        rw [hdomA]
        simp
      rcases (SetValuedOperator.mem_dom_iff A x).mp hxdom with ⟨u, hu⟩
      rcases exists_nat_ge ‖u‖ with ⟨N, hN⟩
      exact Set.mem_iUnion.2 ⟨N, u, hu, hN⟩
  simpa [C] using nonempty_interior_of_iUnion_of_closed hclosed hcover

omit [CompleteSpace H] in
/-- If a bounded-value slice has interior at `c`, monotonicity upgrades the bounded selection
there into local boundedness of all nearby values. -/
private theorem theorem21_18_local_bounded_at_interior_slice
    (A : SetValuedOperator H H) (hAmono : IsMonotone A) {N : ℕ} {c : H}
    (hc : c ∈ interior {x : H | ∃ u : H, u ∈ A x ∧ ‖u‖ ≤ (N : ℝ)}) :
    ∃ δ : ℝ, 0 < δ ∧ Bornology.IsBounded (A.image (Metric.ball c δ)) := by
  have hnhds : {x : H | ∃ u : H, u ∈ A x ∧ ‖u‖ ≤ (N : ℝ)} ∈ 𝓝 c :=
    mem_interior_iff_mem_nhds.mp hc
  rcases Metric.mem_nhds_iff.mp hnhds with ⟨ε, hε, hε_subset⟩
  refine ⟨ε / 4, by positivity, ?_⟩
  rw [isBounded_iff_forall_norm_le]
  refine ⟨3 * (N : ℝ), ?_⟩
  intro w hw
  rcases (SetValuedOperator.mem_image A (Metric.ball c (ε / 4)) w).mp hw with
    ⟨z, hzball, hwA⟩
  by_cases hw0 : w = 0
  · subst w
    rw [norm_zero]
    exact mul_nonneg (by norm_num : (0 : ℝ) ≤ 3) (Nat.cast_nonneg N)
  · let e : H := ‖w‖⁻¹ • w
    let y : H := c + (ε / 2) • e
    have hw_norm_pos : 0 < ‖w‖ := norm_pos_iff.mpr hw0
    have hw_norm_ne : ‖w‖ ≠ 0 := ne_of_gt hw_norm_pos
    have he_norm : ‖e‖ = 1 := by
      dsimp [e]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hw_norm_pos)]
      exact inv_mul_cancel₀ hw_norm_ne
    have hwe : inner ℝ w e = ‖w‖ := by
      dsimp [e]
      rw [inner_smul_right, real_inner_self_eq_norm_sq]
      field_simp [hw_norm_ne]
    have hz_norm_lt : ‖z - c‖ < ε / 4 := by
      simpa [Metric.mem_ball, dist_eq_norm] using hzball
    have hy_ball : y ∈ Metric.ball c ε := by
      have hy_dist : dist y c = ε / 2 := by
        rw [dist_eq_norm]
        have hy_sub : y - c = (ε / 2) • e := by
          dsimp [y]
          abel
        rw [hy_sub, norm_smul, he_norm, mul_one]
        rw [Real.norm_eq_abs, abs_of_pos (by positivity : 0 < ε / 2)]
      rw [Metric.mem_ball, hy_dist]
      linarith
    rcases hε_subset hy_ball with ⟨v, hvA, hvN⟩
    have hmono : 0 ≤ inner ℝ (w - v) (z - y) := hAmono w hwA v hvA
    have hzy_eq : z - y = (z - c) - (ε / 2) • e := by
      dsimp [y]
      abel
    have hrewrite :
        inner ℝ (w - v) (z - y) =
          inner ℝ w (z - c) - (ε / 2) * ‖w‖ - inner ℝ v (z - y) := by
      rw [hzy_eq]
      rw [inner_sub_left, inner_sub_right, inner_smul_right, hwe]
    have hbase :
        (ε / 2) * ‖w‖ ≤ inner ℝ w (z - c) - inner ℝ v (z - y) := by
      rw [hrewrite] at hmono
      linarith
    have hwd :
        inner ℝ w (z - c) ≤ ‖w‖ * ‖z - c‖ := by
      exact le_trans (le_abs_self _) (abs_real_inner_le_norm _ _)
    have hvzy :
        -inner ℝ v (z - y) ≤ ‖v‖ * ‖z - y‖ := by
      have habs : -inner ℝ v (z - y) ≤ |inner ℝ v (z - y)| := by
        calc
          -inner ℝ v (z - y) ≤ |(-inner ℝ v (z - y))| := le_abs_self _
          _ = |inner ℝ v (z - y)| := by rw [abs_neg]
      exact le_trans habs (abs_real_inner_le_norm v (z - y))
    have hzy_norm_le : ‖z - y‖ ≤ ‖z - c‖ + ε / 2 := by
      calc
        ‖z - y‖ = ‖(z - c) - (ε / 2) • e‖ := by rw [hzy_eq]
        _ ≤ ‖z - c‖ + ‖(ε / 2) • e‖ := norm_sub_le _ _
        _ = ‖z - c‖ + ε / 2 := by
          rw [norm_smul, he_norm, mul_one]
          rw [Real.norm_eq_abs, abs_of_pos (by positivity : 0 < ε / 2)]
    have hN_nonneg : 0 ≤ (N : ℝ) := by exact_mod_cast Nat.zero_le N
    have hstep1 :
        (ε / 2) * ‖w‖ ≤ ‖w‖ * ‖z - c‖ + (N : ℝ) * ‖z - y‖ := by
      calc
        (ε / 2) * ‖w‖ ≤ inner ℝ w (z - c) - inner ℝ v (z - y) := hbase
        _ ≤ ‖w‖ * ‖z - c‖ + ‖v‖ * ‖z - y‖ := by
          linarith [hwd, hvzy]
        _ ≤ ‖w‖ * ‖z - c‖ + (N : ℝ) * ‖z - y‖ := by
          gcongr
    have hstep2 :
        (ε / 4) * ‖w‖ ≤ (N : ℝ) * ‖z - y‖ := by
      have hz_le : ‖z - c‖ ≤ ε / 4 := le_of_lt hz_norm_lt
      nlinarith [hstep1, hz_le, norm_nonneg w]
    have hzy_le : ‖z - y‖ ≤ 3 * ε / 4 := by
      nlinarith [hzy_norm_le, le_of_lt hz_norm_lt]
    have hstep3 : (ε / 4) * ‖w‖ ≤ (N : ℝ) * (3 * ε / 4) := by
      calc
        (ε / 4) * ‖w‖ ≤ (N : ℝ) * ‖z - y‖ := hstep2
        _ ≤ (N : ℝ) * (3 * ε / 4) := by
          gcongr
    have hε4_pos : 0 < ε / 4 := by positivity
    nlinarith

/-- Fitzpatrick-type auxiliary function used in the local-boundedness proof.  It is the
function `x ↦ sup_{(y,v) ∈ gra A} ⟪x-y,v⟫/(1+‖y‖)` from Bauschke--Combettes,
Proposition 21.11, written as an `EReal` supremum. -/
private noncomputable def theorem21_18_fitzLocal (A : SetValuedOperator H H) (x : H) :
    EReal :=
  ⨆ p : {p : H × H // p.2 ∈ A p.1},
    (((inner ℝ (x - p.val.1) p.val.2) / (1 + ‖p.val.1‖) : ℝ) : EReal)

omit [CompleteSpace H] in
private theorem theorem21_18_fitzLocal_ge (A : SetValuedOperator H H)
    {x y v : H} (hv : v ∈ A y) :
    (((inner ℝ (x - y) v) / (1 + ‖y‖) : ℝ) : EReal) ≤
      theorem21_18_fitzLocal A x := by
  dsimp [theorem21_18_fitzLocal]
  exact le_iSup_of_le (⟨(y, v), hv⟩ : {p : H × H // p.2 ∈ A p.1}) le_rfl

omit [CompleteSpace H] in
private theorem theorem21_18_fitzLocal_lsc (A : SetValuedOperator H H) :
    LowerSemicontinuous (theorem21_18_fitzLocal A) := by
  unfold theorem21_18_fitzLocal
  refine lowerSemicontinuous_iSup ?_
  intro p
  have hreal : Continuous (fun x : H =>
      (inner ℝ (x - p.val.1) p.val.2) / (1 + ‖p.val.1‖)) := by
    exact ((continuous_id.sub continuous_const).inner continuous_const).div_const _
  exact (continuous_coe_real_ereal.comp hreal).lowerSemicontinuous

omit [CompleteSpace H] in
private theorem theorem21_18_fitzLocal_closed_sublevel
    (A : SetValuedOperator H H) (N : ℕ) :
    IsClosed {x : H | theorem21_18_fitzLocal A x ≤ ((N : ℝ) : EReal)} := by
  have hlsc := theorem21_18_fitzLocal_lsc A
  rw [lowerSemicontinuous_iff_isClosed_preimage] at hlsc
  simpa [Set.preimage, Set.Iic] using hlsc ((N : ℝ) : EReal)

omit [CompleteSpace H] in
private theorem theorem21_18_fitzLocal_convex (A : SetValuedOperator H H) :
    ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      theorem21_18_fitzLocal A (a • x + b • y) ≤
        (a : EReal) * theorem21_18_fitzLocal A x +
          (b : EReal) * theorem21_18_fitzLocal A y := by
  intro x y a b ha hb hab
  dsimp [theorem21_18_fitzLocal]
  refine iSup_le ?_
  intro p
  let z : H := p.val.1
  let v : H := p.val.2
  let den : ℝ := 1 + ‖z‖
  have hden_pos : 0 < den := by
    dsimp [den]
    positivity
  have hsub : a • x + b • y - z = a • (x - z) + b • (y - z) := by
    calc
      a • x + b • y - z = a • x + b • y - (a + b) • z := by rw [hab, one_smul]
      _ = a • x + b • y - (a • z + b • z) := by rw [add_smul]
      _ = a • (x - z) + b • (y - z) := by
        simp [smul_sub]
        abel
  have hreal :
      inner ℝ (a • x + b • y - z) v / den =
        a * (inner ℝ (x - z) v / den) + b * (inner ℝ (y - z) v / den) := by
    rw [hsub, inner_add_left, real_inner_smul_left, real_inner_smul_left]
    field_simp [ne_of_gt hden_pos]
  calc
    (((inner ℝ (a • x + b • y - z) v) / den : ℝ) : EReal)
        = ((a * (inner ℝ (x - z) v / den) +
            b * (inner ℝ (y - z) v / den) : ℝ) : EReal) := by
          rw [hreal]
    _ = (a : EReal) * (((inner ℝ (x - z) v) / den : ℝ) : EReal) +
          (b : EReal) * (((inner ℝ (y - z) v) / den : ℝ) : EReal) := by
          simp [EReal.coe_add, EReal.coe_mul]
    _ ≤ (a : EReal) *
          (⨆ p : {p : H × H // p.2 ∈ A p.1},
            (((inner ℝ (x - p.val.1) p.val.2) / (1 + ‖p.val.1‖) : ℝ) : EReal)) +
          (b : EReal) *
          (⨆ p : {p : H × H // p.2 ∈ A p.1},
            (((inner ℝ (y - p.val.1) p.val.2) / (1 + ‖p.val.1‖) : ℝ) : EReal)) := by
          gcongr
          · exact le_iSup_of_le p le_rfl
          · exact le_iSup_of_le p le_rfl

omit [CompleteSpace H] in
private theorem theorem21_18_fitzLocal_finite_above
    (A : SetValuedOperator H H) (hAmono : IsMonotone A) (hdomA : A.dom = Set.univ) :
    ∀ x : H, ∃ N : ℕ, theorem21_18_fitzLocal A x ≤ ((N : ℝ) : EReal) := by
  intro x
  have hxdom : x ∈ A.dom := by
    rw [hdomA]
    simp
  rcases (SetValuedOperator.mem_dom_iff A x).mp hxdom with ⟨u, hu⟩
  rcases exists_nat_ge (‖u‖ * (‖x‖ + 1)) with ⟨N, hN⟩
  refine ⟨N, ?_⟩
  dsimp [theorem21_18_fitzLocal]
  refine iSup_le ?_
  intro p
  let y : H := p.val.1
  let v : H := p.val.2
  let den : ℝ := 1 + ‖y‖
  have hv : v ∈ A y := p.2
  have hden_pos : 0 < den := by
    dsimp [den]
    positivity
  have hmono := hAmono u hu v hv
  have hinner_le : inner ℝ (x - y) v ≤ inner ℝ (x - y) u := by
    rw [inner_sub_left] at hmono
    have h' : inner ℝ v (x - y) ≤ inner ℝ u (x - y) := sub_nonneg.mp hmono
    simpa [real_inner_comm] using h'
  have hnum_le : inner ℝ (x - y) v ≤ ‖u‖ * (‖x‖ + ‖y‖) := by
    calc
      inner ℝ (x - y) v ≤ inner ℝ (x - y) u := hinner_le
      _ ≤ |inner ℝ (x - y) u| := le_abs_self _
      _ ≤ ‖x - y‖ * ‖u‖ := abs_real_inner_le_norm _ _
      _ ≤ (‖x‖ + ‖y‖) * ‖u‖ := by
        gcongr
        exact norm_sub_le x y
      _ = ‖u‖ * (‖x‖ + ‖y‖) := by ring
  have hfrac_le :
      inner ℝ (x - y) v / den ≤ ‖u‖ * (‖x‖ + 1) := by
    calc
      inner ℝ (x - y) v / den ≤ (‖u‖ * (‖x‖ + ‖y‖)) / den := by
        gcongr
      _ ≤ ‖u‖ * (‖x‖ + 1) := by
        rw [div_le_iff₀ hden_pos]
        have hmiddle : ‖x‖ + ‖y‖ ≤ (‖x‖ + 1) * (1 + ‖y‖) := by
          nlinarith [mul_nonneg (norm_nonneg x) (norm_nonneg y)]
        calc
          ‖u‖ * (‖x‖ + ‖y‖)
              ≤ ‖u‖ * ((‖x‖ + 1) * (1 + ‖y‖)) :=
                mul_le_mul_of_nonneg_left hmiddle (norm_nonneg u)
          _ = ‖u‖ * (‖x‖ + 1) * den := by
            dsimp [den]
            ring
  exact EReal.coe_le_coe (le_trans hfrac_le hN)

/-- Baire plus convexity: a finite-valued lower-semicontinuous convex `EReal` function is
locally bounded above at every point.  This is the convex-analysis core used in
Bauschke--Combettes, Proposition 21.11. -/
private theorem theorem21_18_ereal_convex_finite_locally_bddAbove
    (f : H → EReal)
    (hclosed : ∀ N : ℕ, IsClosed {x : H | f x ≤ ((N : ℝ) : EReal)})
    (hfinite : ∀ x : H, ∃ N : ℕ, f x ≤ ((N : ℝ) : EReal))
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (z : H) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ M : ℝ, ∀ x ∈ Metric.ball z δ, f x ≤ (M : EReal) := by
  classical
  let C : ℕ → Set H := fun N => {x : H | f x ≤ ((N : ℝ) : EReal)}
  have hcover : (⋃ N : ℕ, C N) = Set.univ := by
    ext x
    constructor
    · intro _
      simp
    · intro _
      rcases hfinite x with ⟨N, hN⟩
      exact Set.mem_iUnion.2 ⟨N, hN⟩
  rcases nonempty_interior_of_iUnion_of_closed (fun N => by simpa [C] using hclosed N)
      hcover with ⟨N, hNint⟩
  rcases hNint with ⟨c, hc⟩
  have hnhds : C N ∈ 𝓝 c := mem_interior_iff_mem_nhds.mp hc
  rcases Metric.mem_nhds_iff.mp hnhds with ⟨ε, hε, hε_subset⟩
  let p : H := (2 : ℝ) • z - c
  rcases hfinite p with ⟨K, hK⟩
  refine ⟨ε / 4, by positivity, ((1 / 2 : ℝ) * (N : ℝ) + (1 / 2 : ℝ) * (K : ℝ)), ?_⟩
  intro x hx
  let q : H := (2 : ℝ) • x - p
  have hq_ball : q ∈ Metric.ball c ε := by
    have hq_sub : q - c = (2 : ℝ) • (x - z) := by
      dsimp [q, p]
      module
    have hx_norm : ‖x - z‖ < ε / 4 := by
      simpa [Metric.mem_ball, dist_eq_norm] using hx
    rw [Metric.mem_ball, dist_eq_norm, hq_sub, norm_smul]
    have htwo : ‖(2 : ℝ)‖ = (2 : ℝ) := by norm_num
    rw [htwo]
    nlinarith [norm_nonneg (x - z)]
  have hqC : f q ≤ ((N : ℝ) : EReal) := hε_subset hq_ball
  have hx_combo : x = (1 / 2 : ℝ) • q + (1 / 2 : ℝ) • p := by
    dsimp [q]
    module
  have hfx := hconv q p (1 / 2) (1 / 2)
    (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (0 : ℝ) ≤ 1 / 2)
    (by norm_num : (1 / 2 : ℝ) + 1 / 2 = 1)
  rw [← hx_combo] at hfx
  calc
    f x ≤ (1 / 2 : EReal) * f q + (1 / 2 : EReal) * f p := hfx
    _ ≤ (1 / 2 : EReal) * ((N : ℝ) : EReal) +
          (1 / 2 : EReal) * ((K : ℝ) : EReal) := by
        gcongr
    _ = (((1 / 2 : ℝ) * (N : ℝ) + (1 / 2 : ℝ) * (K : ℝ) : ℝ) : EReal) := by
        have hhalf : ((1 / 2 : EReal) = ((1 / 2 : ℝ) : EReal)) := by
          change (((1 : ℝ) : EReal) / ((2 : ℝ) : EReal)) = ((1 / 2 : ℝ) : EReal)
          rw [← EReal.coe_div]
        rw [hhalf, ← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add]

private theorem theorem21_18_full_domain_local_bounded
    (A : SetValuedOperator H H) (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ)
    (x0 : H) :
    ∃ δ : ℝ, 0 < δ ∧ Bornology.IsBounded (A.image (Metric.ball x0 δ)) := by
  /-
  Bauschke--Combettes, Theorem 21.18 (Rockafellar--Vesely), specialized to the
  full-domain case: a maximally monotone operator is locally bounded at every point
  when its domain is all of `H`.
  -/
  let f : H → EReal := theorem21_18_fitzLocal A
  rcases theorem21_18_ereal_convex_finite_locally_bddAbove f
      (by intro N; simpa [f] using theorem21_18_fitzLocal_closed_sublevel A N)
      (by intro x; simpa [f] using theorem21_18_fitzLocal_finite_above A hA.1 hdomA x)
      (by
        intro x y a b ha hb hab
        simpa [f] using theorem21_18_fitzLocal_convex A x y a b ha hb hab)
      x0 with ⟨ρ, hρ, M, hM⟩
  let Mpos : ℝ := max M 0 + 1
  have hMpos_pos : 0 < Mpos := by
    dsimp [Mpos]
    linarith [le_max_right M 0]
  have hMpos_nonneg : 0 ≤ Mpos := le_of_lt hMpos_pos
  have hM_le_Mpos : M ≤ Mpos := by
    dsimp [Mpos]
    linarith [le_max_left M 0]
  refine ⟨ρ / 4, by positivity, ?_⟩
  rw [isBounded_iff_forall_norm_le]
  refine ⟨(4 / ρ) * Mpos * (1 + ‖x0‖ + ρ / 4), ?_⟩
  intro w hw
  rcases (SetValuedOperator.mem_image A (Metric.ball x0 (ρ / 4)) w).mp hw with
    ⟨z, hzball, hwA⟩
  by_cases hw0 : w = 0
  · subst w
    have hC_nonneg : 0 ≤ (4 / ρ) * Mpos * (1 + ‖x0‖ + ρ / 4) := by
      positivity
    simpa using hC_nonneg
  · let e : H := ‖w‖⁻¹ • w
    let xeval : H := x0 + (ρ / 2) • e
    have hw_norm_pos : 0 < ‖w‖ := norm_pos_iff.mpr hw0
    have hw_norm_ne : ‖w‖ ≠ 0 := ne_of_gt hw_norm_pos
    have he_norm : ‖e‖ = 1 := by
      dsimp [e]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hw_norm_pos)]
      exact inv_mul_cancel₀ hw_norm_ne
    have hew : inner ℝ e w = ‖w‖ := by
      dsimp [e]
      rw [real_inner_smul_left, real_inner_self_eq_norm_sq]
      field_simp [hw_norm_ne]
    have hxeval_ball : xeval ∈ Metric.ball x0 ρ := by
      have hdist : dist xeval x0 = ρ / 2 := by
        rw [dist_eq_norm]
        have hsub : xeval - x0 = (ρ / 2) • e := by
          dsimp [xeval]
          abel
        rw [hsub, norm_smul, he_norm, mul_one]
        rw [Real.norm_eq_abs, abs_of_pos (by positivity : 0 < ρ / 2)]
      rw [Metric.mem_ball, hdist]
      linarith
    have hlocalM : theorem21_18_fitzLocal A xeval ≤ (Mpos : EReal) := by
      exact le_trans (by simpa [f] using hM xeval hxeval_ball)
        (EReal.coe_le_coe hM_le_Mpos)
    have hfitz_ge :
        (((inner ℝ (xeval - z) w) / (1 + ‖z‖) : ℝ) : EReal) ≤
          theorem21_18_fitzLocal A xeval :=
      theorem21_18_fitzLocal_ge A hwA
    have htermE :
        (((inner ℝ (xeval - z) w) / (1 + ‖z‖) : ℝ) : EReal) ≤
          (Mpos : EReal) := le_trans hfitz_ge hlocalM
    have hterm_real :
        inner ℝ (xeval - z) w / (1 + ‖z‖) ≤ Mpos :=
      EReal.coe_le_coe_iff.mp htermE
    have hden_pos : 0 < 1 + ‖z‖ := by positivity
    have hinner_le : inner ℝ (xeval - z) w ≤ Mpos * (1 + ‖z‖) := by
      rwa [div_le_iff₀ hden_pos] at hterm_real
    have hxeval_sub : xeval - z = (x0 - z) + (ρ / 2) • e := by
      dsimp [xeval]
      abel
    have hinner_eq :
        inner ℝ (xeval - z) w =
          inner ℝ (x0 - z) w + (ρ / 2) * ‖w‖ := by
      rw [hxeval_sub, inner_add_left, real_inner_smul_left, hew]
    have hz_norm_lt : ‖z - x0‖ < ρ / 4 := by
      simpa [Metric.mem_ball, dist_eq_norm] using hzball
    have hxz_norm_lt : ‖x0 - z‖ < ρ / 4 := by
      simpa [norm_sub_rev] using hz_norm_lt
    have hinner_lower :
        -((ρ / 4) * ‖w‖) ≤ inner ℝ (x0 - z) w := by
      have habs := abs_real_inner_le_norm (x0 - z) w
      have hneg_abs : -|inner ℝ (x0 - z) w| ≤ inner ℝ (x0 - z) w :=
        neg_abs_le _
      have hneg_norm : -(‖x0 - z‖ * ‖w‖) ≤ -|inner ℝ (x0 - z) w| :=
        neg_le_neg habs
      have hnormprod : ‖x0 - z‖ * ‖w‖ ≤ (ρ / 4) * ‖w‖ :=
        mul_le_mul_of_nonneg_right (le_of_lt hxz_norm_lt) (norm_nonneg w)
      nlinarith
    have hmain :
        (ρ / 4) * ‖w‖ ≤ Mpos * (1 + ‖z‖) := by
      rw [hinner_eq] at hinner_le
      nlinarith
    have hz_norm_le : ‖z‖ ≤ ‖x0‖ + ρ / 4 := by
      calc
        ‖z‖ ≤ ‖x0‖ + ‖x0 - z‖ := norm_le_norm_add_norm_sub x0 z
        _ ≤ ‖x0‖ + ρ / 4 := by linarith [le_of_lt hxz_norm_lt]
    have hmain' :
        (ρ / 4) * ‖w‖ ≤ Mpos * (1 + ‖x0‖ + ρ / 4) := by
      have hright : Mpos * (1 + ‖z‖) ≤ Mpos * (1 + ‖x0‖ + ρ / 4) := by
        have harg : 1 + ‖z‖ ≤ 1 + ‖x0‖ + ρ / 4 := by
          linarith [hz_norm_le]
        exact mul_le_mul_of_nonneg_left harg hMpos_nonneg
      exact le_trans hmain hright
    have hρ4_pos : 0 < ρ / 4 := by positivity
    have hdiv : ‖w‖ ≤ (Mpos * (1 + ‖x0‖ + ρ / 4)) / (ρ / 4) := by
      rw [le_div_iff₀ hρ4_pos]
      nlinarith
    have hconst :
        (Mpos * (1 + ‖x0‖ + ρ / 4)) / (ρ / 4) =
          (4 / ρ) * Mpos * (1 + ‖x0‖ + ρ / 4) := by
      field_simp [ne_of_gt hρ]
    simpa [hconst] using hdiv

private theorem theorem31_maximal_monotone_selection_bounded_near_zero
    (A : SetValuedOperator H H) (hA : IsMaximalMonotone A) (hdomA : A.dom = Set.univ)
    (z a : ℕ → H) (hz : Tendsto z atTop (𝓝 (0 : H)))
    (ha : ∀ n, a n ∈ A (z n)) :
    Bornology.IsBounded (Set.range a) := by
  rcases theorem21_18_full_domain_local_bounded A hA hdomA (0 : H) with
    ⟨δ, hδ, hAbdd⟩
  have hev : ∀ᶠ n in atTop, dist (z n) (0 : H) < δ :=
    (Metric.tendsto_nhds.mp hz) δ hδ
  rcases Filter.eventually_atTop.mp hev with ⟨N, hN⟩
  have hprefix_bdd : Bornology.IsBounded (a '' {n : ℕ | n < N}) := by
    exact ((Set.finite_lt_nat N).image a).isBounded
  refine (hprefix_bdd.union hAbdd).subset ?_
  intro y hy
  rcases hy with ⟨n, rfl⟩
  by_cases hn : n < N
  · exact Or.inl ⟨n, hn, rfl⟩
  · exact Or.inr ((SetValuedOperator.mem_image A (Metric.ball (0 : H) δ) (a n)).mpr
      ⟨z n, by simpa [Metric.mem_ball] using hN n (le_of_not_gt hn), ha n⟩)

private theorem theorem31_subgradient_selection_bounded
    (A B : SetValuedOperator H H) (f : H → EReal) (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (a b : ℕ → H)
    (ha : ∀ n, a n ∈ A ((lam n)⁻¹ • (x (n + 2) - x (n + 1))))
    (_hb : ∀ n, b n ∈ B (x (n + 2)))
    (heq : ∀ n,
      ((lam n) ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n) + a n + b n = 0) :
    Bornology.IsBounded (Set.range b) := by
  let z : ℕ → H := fun n => (lam n)⁻¹ • (x (n + 2) - x (n + 1))
  let acc : ℕ → H := fun n =>
    ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)
  have hz : Tendsto z atTop (𝓝 (0 : H)) :=
    theorem31_scaled_velocity_tendsto_zero lam x xInf h.lam_pos h.lam_nondec hxInf
  have hacc : Tendsto acc atTop (𝓝 (0 : H)) :=
    theorem31_acceleration_tendsto_zero lam x xInf h.lam_pos h.lam_nondec hxInf
  have ha_bdd : Bornology.IsBounded (Set.range a) :=
    theorem31_maximal_monotone_selection_bounded_near_zero A h.maxMonotoneA h.domA z a hz
      (by intro n; simpa [z] using ha n)
  have hacc_bdd : Bornology.IsBounded (Set.range acc) :=
    Metric.isBounded_range_of_tendsto acc hacc
  rcases (isBounded_iff_forall_norm_le (s := Set.range a)).mp ha_bdd with ⟨Ca, hCa⟩
  rcases (isBounded_iff_forall_norm_le (s := Set.range acc)).mp hacc_bdd with
    ⟨Cacc, hCacc⟩
  refine (isBounded_iff_forall_norm_le (s := Set.range b)).mpr ?_
  refine ⟨Cacc + Ca, ?_⟩
  intro y hy
  rcases hy with ⟨n, rfl⟩
  have hb_eq : b n = -acc n - a n := by
    have hsum : acc n + a n + b n = 0 := by
      simpa [acc] using heq n
    have htmp : -acc n - a n = b n := by
      calc
        -acc n - a n = -acc n - a n + 0 := by simp
        _ = -acc n - a n + (acc n + a n + b n) := by rw [hsum]
        _ = b n := by abel
    exact htmp.symm
  calc
    ‖b n‖ = ‖-acc n - a n‖ := by rw [hb_eq]
    _ ≤ ‖acc n‖ + ‖a n‖ := by
      simpa [sub_eq_add_neg, norm_neg] using norm_add_le (-acc n) (-a n)
    _ ≤ Cacc + Ca := by
      exact add_le_add (hCacc (acc n) ⟨n, rfl⟩) (hCa (a n) ⟨n, rfl⟩)

private theorem theorem31_weak_cluster_of_bounded_selection (b : ℕ → H)
    (hbdd : Bornology.IsBounded (Set.range b)) :
    ∃ vBar : H, ∃ φ : ℕ → ℕ, StrictMono φ ∧
      Tendsto (fun n => toWeakSpace ℝ H (b (φ n))) atTop
        (𝓝 (toWeakSpace ℝ H vBar)) := by
  exact bounded_sequence_has_weakly_convergent_subsequence b hbdd

omit [CompleteSpace H] in
private theorem maximal_of_monotone_and_resolvent_surjective
    (B : SetValuedOperator H H) (hmono : IsMonotone B)
    (hres : ∀ z : H, ∃ p q : H, q ∈ B p ∧ z = p + q) :
    IsMaximalMonotone B := by
  refine ⟨hmono, ?_⟩
  intro A' hA'mono hsubset xu hxu
  rcases xu with ⟨x, u⟩
  rw [SetValuedOperator.mem_graph_iff] at hxu ⊢
  rcases hres (x + u) with ⟨p, q, hqB, hz⟩
  have hqA : q ∈ A' p := by
    exact (SetValuedOperator.mem_graph_iff A' p q).mp
      (hsubset ((SetValuedOperator.mem_graph_iff B p q).mpr hqB))
  have hmon := hA'mono u hxu q hqA
  have huq : u - q = -(x - p) := by
    calc
      u - q = (x + u) - q - x := by abel
      _ = (p + q) - q - x := by rw [hz]
      _ = -(x - p) := by abel
  have hinner : inner ℝ (u - q) (x - p) = - ‖x - p‖ ^ 2 := by
    rw [huq, inner_neg_left, real_inner_self_eq_norm_sq]
  have hsq_nonpos : ‖x - p‖ ^ 2 ≤ 0 := by
    nlinarith [hmon, hinner]
  have hx_p : x = p := by
    have hnorm_zero : ‖x - p‖ = 0 := by
      nlinarith [sq_nonneg ‖x - p‖]
    exact sub_eq_zero.mp (norm_eq_zero.mp hnorm_zero)
  have hu_q : u = q := by
    rw [hx_p] at hz
    exact add_left_cancel hz
  simpa [hx_p, hu_q] using hqB

private theorem exists_isMinOn_of_level_closed_convex_on_bounded_closed_convex
    (g : H → EReal) {C : Set H}
    (hCne : C.Nonempty) (hCbdd : Bornology.IsBounded C) (hCclosed : IsClosed C)
    (hCconv : Convex ℝ C)
    (hlevel_closed : ∀ r : EReal, IsClosed {x : H | g x ≤ r})
    (hlevel_conv : ∀ r : EReal, Convex ℝ {x : H | g x ≤ r}) :
    ∃ p ∈ C, IsMinOn g C p := by
  let e := toWeakSpace ℝ H
  let gW : WeakSpace ℝ H → EReal := fun w => g (e.symm w)
  have hgW_lsc : LowerSemicontinuous gW := by
    rw [lowerSemicontinuous_iff_isClosed_preimage]
    intro r
    have hpre : gW ⁻¹' Set.Iic r = e '' {x : H | g x ≤ r} := by
      ext w
      constructor
      · intro hw
        refine ⟨e.symm w, hw, ?_⟩
        simp [e]
      · rintro ⟨x, hx, rfl⟩
        simpa [gW, e] using hx
    rw [hpre]
    exact (isClosed_iff_weak_image_isClosed_of_convex (hlevel_conv r)).1 (hlevel_closed r)
  let S : Set (WeakSpace ℝ H) := e '' C
  have hScompact : IsCompact S := by
    simpa [S, e] using weaklyCompact_of_bounded_closed_convex (C := C) hCbdd hCclosed hCconv
  have hSne : S.Nonempty := by
    rcases hCne with ⟨x, hx⟩
    exact ⟨e x, ⟨x, hx, rfl⟩⟩
  rcases (hgW_lsc.lowerSemicontinuousOn S).exists_isMinOn hSne hScompact with
    ⟨w, hwS, hwmin⟩
  rcases hwS with ⟨p, hpC, hpw⟩
  refine ⟨p, hpC, ?_⟩
  rw [isMinOn_iff] at hwmin ⊢
  intro y hyC
  have hyS : e y ∈ S := ⟨y, hyC, rfl⟩
  have h := hwmin (e y) hyS
  have hp_symm : e.symm w = p := by
    rw [← hpw]
    simp [e]
  simpa [gW, e, hp_symm] using h

private lemma lowerSemicontinuous_add_ereal {X : Type _} [TopologicalSpace X]
    {g h : X → EReal} (hg : LowerSemicontinuous g)
    (hh : LowerSemicontinuous h) :
    LowerSemicontinuous (fun x ↦ g x + h x) := by
  rw [lowerSemicontinuous_iff_le_liminf]
  intro x
  calc
    g x + h x ≤ Filter.liminf g (nhds x) + Filter.liminf h (nhds x) := by
      exact add_le_add (lowerSemicontinuous_iff_le_liminf.mp hg x)
        (lowerSemicontinuous_iff_le_liminf.mp hh x)
    _ ≤ Filter.liminf (fun y ↦ g y + h y) (nhds x) := by
      simpa using (EReal.le_liminf_add :
        Filter.liminf g (nhds x) + Filter.liminf h (nhds x) ≤
        Filter.liminf (fun y ↦ g y + h y) (nhds x))

private noncomputable def moreauObjective (f : H → EReal) (z : H) (x : H) : EReal :=
  f x + (((1 / 2 : ℝ) * ‖x - z‖ ^ 2 : ℝ) : EReal)

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem moreauObjective_lsc (f : H → EReal) (z : H)
    (hf : LowerSemicontinuous f) : LowerSemicontinuous (moreauObjective f z) := by
  have hquad_cont : Continuous fun x : H => ((1 / 2 : ℝ) * ‖x - z‖ ^ 2 : ℝ) := by
    fun_prop
  have hquad_lsc : LowerSemicontinuous fun x : H =>
      (((1 / 2 : ℝ) * ‖x - z‖ ^ 2 : ℝ) : EReal) := by
    exact (continuous_coe_real_ereal.comp hquad_cont).lowerSemicontinuous
  change LowerSemicontinuous
    (fun x : H => f x + (((1 / 2 : ℝ) * ‖x - z‖ ^ 2 : ℝ) : EReal))
  exact lowerSemicontinuous_add_ereal hf hquad_lsc

private theorem ereal_top_add_of_ne_bot {q : EReal} (hq : q ≠ ⊥) :
    (⊤ : EReal) + q = ⊤ := by
  induction q using EReal.rec with
  | bot => exact (hq rfl).elim
  | coe r => simp
  | top => simp

private theorem ereal_coe_add_ne_top {r : ℝ} {q : EReal} (hq : q ≠ ⊤) :
    (r : EReal) + q ≠ ⊤ := by
  induction q using EReal.rec with
  | bot => simp
  | coe s => rw [← EReal.coe_add]; exact EReal.coe_ne_top _
  | top => exact (hq rfl).elim

private theorem ereal_add_coe_ne_top {q : EReal} {r : ℝ} (hq : q ≠ ⊤) :
    q + (r : EReal) ≠ ⊤ := by
  induction q using EReal.rec with
  | bot => simp
  | coe s => rw [← EReal.coe_add]; exact EReal.coe_ne_top _
  | top => exact (hq rfl).elim

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem moreauObjective_ne_bot (f : H → EReal) (z : H)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x) (x : H) :
    moreauObjective f z x ≠ ⊥ := by
  rcases hf_bddBelow with ⟨m, hm⟩
  have hq_nonneg : (0 : EReal) ≤
      (((1 / 2 : ℝ) * ‖x - z‖ ^ 2 : ℝ) : EReal) := by
    exact EReal.coe_nonneg.mpr (by positivity)
  have hle : (m : EReal) ≤ moreauObjective f z x := by
    dsimp [moreauObjective]
    exact le_trans (hm x) (le_add_of_nonneg_right hq_nonneg)
  intro hbot
  rw [hbot] at hle
  exact (not_le_of_gt (EReal.bot_lt_coe m)) hle

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem moreauObjective_toReal_of_finite (f : H → EReal) (z x : H)
    (hf_top : f x ≠ ⊤) (hf_bot : f x ≠ ⊥) :
    (moreauObjective f z x).toReal =
      (f x).toReal + (1 / 2 : ℝ) * ‖x - z‖ ^ 2 := by
  dsimp [moreauObjective]
  exact EReal.toReal_add hf_top hf_bot (EReal.coe_ne_top _) (EReal.coe_ne_bot _)

private theorem ereal_real_linear_combination_toReal
    (a b fx fy : ℝ) :
    ((a : EReal) * (fx : EReal) + (b : EReal) * (fy : EReal)).toReal =
      a * fx + b * fy := by
  have h :
      (a : EReal) * (fx : EReal) + (b : EReal) * (fy : EReal) =
        ((a * fx + b * fy : ℝ) : EReal) := by
    norm_num [EReal.coe_mul, EReal.coe_add]
  rw [h]
  exact EReal.toReal_coe _

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem moreauObjective_f_ne_top_of_le_coe (f : H → EReal) (z x : H) {R : ℝ}
    (_hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (hle : moreauObjective f z x ≤ (R : EReal)) :
    f x ≠ ⊤ := by
  have hq_bot :
      (((1 / 2 : ℝ) * ‖x - z‖ ^ 2 : ℝ) : EReal) ≠ ⊥ := EReal.coe_ne_bot _
  intro hx_top
  have h' : (⊤ : EReal) ≤ (R : EReal) := by
    rw [moreauObjective, hx_top, ereal_top_add_of_ne_bot hq_bot] at hle
    exact hle
  exact (EReal.coe_ne_top R) (top_le_iff.mp h')

omit [CompleteSpace H] in
private theorem quad_convex_real (z : H) :
    ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      (1 / 2 : ℝ) * ‖a • x + b • y - z‖ ^ 2 ≤
        a * ((1 / 2 : ℝ) * ‖x - z‖ ^ 2) +
          b * ((1 / 2 : ℝ) * ‖y - z‖ ^ 2) := by
  intro x y a b ha hb hab
  have hb_eq : b = 1 - a := by linarith
  subst b
  have ha_le_one : a ≤ 1 := by linarith
  have hiden :
      a • x + (1 - a) • y - z =
        a • (x - z) + (1 - a) • (y - z) := by
    have hcoeff : a • z + (1 - a) • z = z := by
      rw [← add_smul]
      simp
    calc
      a • x + (1 - a) • y - z =
          a • x + (1 - a) • y - (a • z + (1 - a) • z) := by rw [hcoeff]
      _ = a • (x - z) + (1 - a) • (y - z) := by
        rw [smul_sub, smul_sub]
        abel
  have hnorm :=
    norm_sq_affine_combination_add_weighted_norm_sub_sq (x - z) (y - z) a
  have hnonneg : 0 ≤ a * (1 - a) * ‖(x - z) - (y - z)‖ ^ 2 := by
    positivity
  have hsq :
      ‖a • (x - z) + (1 - a) • (y - z)‖ ^ 2 ≤
        a * ‖x - z‖ ^ 2 + (1 - a) * ‖y - z‖ ^ 2 := by
    nlinarith [hnorm, hnonneg]
  rw [hiden]
  nlinarith

omit [CompleteSpace H] in
private theorem moreauObjective_convex_level (f : H → EReal) (z : H)
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x) :
    ∀ r : EReal, Convex ℝ {x : H | moreauObjective f z x ≤ r} := by
  intro r x hx y hy a b ha hb hab
  by_cases hr_top : r = ⊤
  · simp [hr_top]
  have hx_f_top : f x ≠ ⊤ := by
    have hx_lt : moreauObjective f z x < ⊤ := lt_of_le_of_lt hx (lt_top_iff_ne_top.mpr hr_top)
    rcases EReal.lt_iff_exists_real_btwn.mp hx_lt with
      ⟨R, hxR, _⟩
    exact moreauObjective_f_ne_top_of_le_coe f z x hf_bddBelow (le_of_lt hxR)
  have hy_f_top : f y ≠ ⊤ := by
    have hy_lt : moreauObjective f z y < ⊤ := lt_of_le_of_lt hy (lt_top_iff_ne_top.mpr hr_top)
    rcases EReal.lt_iff_exists_real_btwn.mp hy_lt with
      ⟨R, hyR, _⟩
    exact moreauObjective_f_ne_top_of_le_coe f z y hf_bddBelow (le_of_lt hyR)
  have hx_f_bot : f x ≠ ⊥ := by
    rcases hf_bddBelow with ⟨m, hm⟩
    intro hbot
    have hle := hm x
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  have hy_f_bot : f y ≠ ⊥ := by
    rcases hf_bddBelow with ⟨m, hm⟩
    intro hbot
    have hle := hm y
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  have hx_obj_top : moreauObjective f z x ≠ ⊤ := by
    dsimp [moreauObjective]
    exact ereal_add_coe_ne_top (q := f x) hx_f_top
  have hy_obj_top : moreauObjective f z y ≠ ⊤ := by
    dsimp [moreauObjective]
    exact ereal_add_coe_ne_top (q := f y) hy_f_top
  have hx_obj_bot : moreauObjective f z x ≠ ⊥ :=
    moreauObjective_ne_bot f z hf_bddBelow x
  have hy_obj_bot : moreauObjective f z y ≠ ⊥ :=
    moreauObjective_ne_bot f z hf_bddBelow y
  have hx_real_le : (moreauObjective f z x).toReal ≤ r.toReal :=
    EReal.toReal_le_toReal hx hx_obj_bot hr_top
  have hy_real_le : (moreauObjective f z y).toReal ≤ r.toReal :=
    EReal.toReal_le_toReal hy hy_obj_bot hr_top
  have hf_conv := hconv x y a b ha hb hab
  have hquad := quad_convex_real z x y a b ha hb hab
  have hfxy_top : f (a • x + b • y) ≠ ⊤ := by
    intro htop
    have hright_ne_top : (a : EReal) * f x + (b : EReal) * f y ≠ ⊤ := by
      rw [← EReal.coe_toReal hx_f_top hx_f_bot, ← EReal.coe_toReal hy_f_top hy_f_bot]
      rw [← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add]
      exact EReal.coe_ne_top _
    exact hright_ne_top (top_le_iff.mp (by simpa [htop] using hf_conv))
  have hfxy_bot : f (a • x + b • y) ≠ ⊥ := by
    rcases hf_bddBelow with ⟨m, hm⟩
    intro hbot
    have hle := hm (a • x + b • y)
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  have hf_conv_real :
      (f (a • x + b • y)).toReal ≤
        a * (f x).toReal + b * (f y).toReal := by
    have hright_bot : (a : EReal) * f x + (b : EReal) * f y ≠ ⊥ := by
      rw [← EReal.coe_toReal hx_f_top hx_f_bot, ← EReal.coe_toReal hy_f_top hy_f_bot]
      rw [← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add]
      exact EReal.coe_ne_bot _
    have hright_top : (a : EReal) * f x + (b : EReal) * f y ≠ ⊤ := by
      rw [← EReal.coe_toReal hx_f_top hx_f_bot, ← EReal.coe_toReal hy_f_top hy_f_bot]
      rw [← EReal.coe_mul, ← EReal.coe_mul, ← EReal.coe_add]
      exact EReal.coe_ne_top _
    have hle_real := EReal.toReal_le_toReal hf_conv hfxy_bot hright_top
    have hright_toReal :
        ((a : EReal) * f x + (b : EReal) * f y).toReal =
          a * (f x).toReal + b * (f y).toReal := by
      rw [← EReal.coe_toReal hx_f_top hx_f_bot, ← EReal.coe_toReal hy_f_top hy_f_bot]
      exact ereal_real_linear_combination_toReal a b (f x).toReal (f y).toReal
    simpa [hright_toReal] using hle_real
  have hx_toReal := moreauObjective_toReal_of_finite f z x hx_f_top hx_f_bot
  have hy_toReal := moreauObjective_toReal_of_finite f z y hy_f_top hy_f_bot
  have hxy_toReal := moreauObjective_toReal_of_finite f z (a • x + b • y) hfxy_top hfxy_bot
  have hxy_real :
      (moreauObjective f z (a • x + b • y)).toReal ≤ r.toReal := by
    rw [hxy_toReal]
    rw [hx_toReal] at hx_real_le
    rw [hy_toReal] at hy_real_le
    have hconv_obj :
        (f (a • x + b • y)).toReal +
            (1 / 2 : ℝ) * ‖a • x + b • y - z‖ ^ 2 ≤
          a * ((f x).toReal + (1 / 2 : ℝ) * ‖x - z‖ ^ 2) +
            b * ((f y).toReal + (1 / 2 : ℝ) * ‖y - z‖ ^ 2) := by
      nlinarith [hf_conv_real, hquad]
    have hweighted :
        a * ((f x).toReal + (1 / 2 : ℝ) * ‖x - z‖ ^ 2) +
            b * ((f y).toReal + (1 / 2 : ℝ) * ‖y - z‖ ^ 2) ≤ r.toReal := by
      have hxmul :
          a * ((f x).toReal + (1 / 2 : ℝ) * ‖x - z‖ ^ 2) ≤ a * r.toReal :=
        mul_le_mul_of_nonneg_left hx_real_le ha
      have hymul :
          b * ((f y).toReal + (1 / 2 : ℝ) * ‖y - z‖ ^ 2) ≤ b * r.toReal :=
        mul_le_mul_of_nonneg_left hy_real_le hb
      calc
        a * ((f x).toReal + (1 / 2 : ℝ) * ‖x - z‖ ^ 2) +
            b * ((f y).toReal + (1 / 2 : ℝ) * ‖y - z‖ ^ 2)
            ≤ a * r.toReal + b * r.toReal := add_le_add hxmul hymul
        _ = (a + b) * r.toReal := by ring
        _ = r.toReal := by rw [hab]; ring
    exact le_trans hconv_obj hweighted
  have hxy_obj_bot : moreauObjective f z (a • x + b • y) ≠ ⊥ :=
    moreauObjective_ne_bot f z hf_bddBelow (a • x + b • y)
  have hxy_obj_top : moreauObjective f z (a • x + b • y) ≠ ⊤ := by
    dsimp [moreauObjective]
    exact ereal_add_coe_ne_top (q := f (a • x + b • y)) hfxy_top
  have hr_bot : r ≠ ⊥ := by
    have hx_not_bot : moreauObjective f z x ≠ ⊥ :=
      moreauObjective_ne_bot f z hf_bddBelow x
    have hx_gt_bot : ⊥ < moreauObjective f z x := bot_lt_iff_ne_bot.mpr hx_not_bot
    exact ne_of_gt (lt_of_lt_of_le hx_gt_bot hx)
  have hcoe : ((moreauObjective f z (a • x + b • y)).toReal : EReal) ≤
      (r.toReal : EReal) := EReal.coe_le_coe hxy_real
  rwa [EReal.coe_toReal hxy_obj_top hxy_obj_bot, EReal.coe_toReal hr_top hr_bot] at hcoe

omit [InnerProductSpace ℝ H] [CompleteSpace H] in
private theorem moreauObjective_sublevel_bounded (f : H → EReal) (z x0 : H)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (hx0_top : f x0 ≠ ⊤) :
    Bornology.IsBounded {x : H | moreauObjective f z x ≤ moreauObjective f z x0} := by
  rcases hf_bddBelow with ⟨m, hm⟩
  have hx0_bot : f x0 ≠ ⊥ := by
    intro hbot
    have hle := hm x0
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  let R : ℝ := Real.sqrt (2 * ((moreauObjective f z x0).toReal - m))
  refine (Metric.isBounded_closedBall (x := z) (r := R)).subset ?_
  intro x hx
  have hx_f_top : f x ≠ ⊤ := by
    have hx0_obj_top : moreauObjective f z x0 ≠ ⊤ := by
      dsimp [moreauObjective]
      exact ereal_add_coe_ne_top (q := f x0) hx0_top
    have hx_lt_top : moreauObjective f z x < ⊤ :=
      lt_of_le_of_lt hx (lt_top_iff_ne_top.mpr hx0_obj_top)
    rcases EReal.lt_iff_exists_real_btwn.mp hx_lt_top with ⟨T, hxT, _⟩
    exact moreauObjective_f_ne_top_of_le_coe f z x ⟨m, hm⟩ (le_of_lt hxT)
  have hx_f_bot : f x ≠ ⊥ := by
    intro hbot
    have hle := hm x
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  have hx_obj_bot : moreauObjective f z x ≠ ⊥ :=
    moreauObjective_ne_bot f z ⟨m, hm⟩ x
  have hx0_obj_top : moreauObjective f z x0 ≠ ⊤ := by
    dsimp [moreauObjective]
    exact ereal_add_coe_ne_top (q := f x0) hx0_top
  have hx_real_le :
      (moreauObjective f z x).toReal ≤ (moreauObjective f z x0).toReal :=
    EReal.toReal_le_toReal hx hx_obj_bot hx0_obj_top
  have hm_real : m ≤ (f x).toReal := by
    have hle := EReal.toReal_le_toReal (hm x) (EReal.coe_ne_bot m) hx_f_top
    simpa using hle
  have hx_toReal := moreauObjective_toReal_of_finite f z x hx_f_top hx_f_bot
  have hquad_le :
      (1 / 2 : ℝ) * ‖x - z‖ ^ 2 ≤ (moreauObjective f z x0).toReal - m := by
    rw [hx_toReal] at hx_real_le
    linarith
  have hnonneg : 0 ≤ 2 * ((moreauObjective f z x0).toReal - m) := by
    have hq_nonneg : 0 ≤ (1 / 2 : ℝ) * ‖x0 - z‖ ^ 2 := by positivity
    have hx0_toReal := moreauObjective_toReal_of_finite f z x0 hx0_top hx0_bot
    have hm0 : m ≤ (f x0).toReal := by
      have hle := EReal.toReal_le_toReal (hm x0) (EReal.coe_ne_bot m) hx0_top
      simpa using hle
    rw [hx0_toReal]
    nlinarith
  have hnorm_sq_le : ‖x - z‖ ^ 2 ≤ R ^ 2 := by
    dsimp [R]
    rw [Real.sq_sqrt hnonneg]
    nlinarith
  have hnorm_le : ‖x - z‖ ≤ R := by
    have hR_nonneg : 0 ≤ R := Real.sqrt_nonneg _
    have h := sq_le_sq.mp hnorm_sq_le
    rwa [abs_of_nonneg (norm_nonneg _), abs_of_nonneg hR_nonneg] at h
  simpa [Metric.mem_closedBall, dist_eq_norm, norm_sub_rev] using hnorm_le

private theorem exists_moreau_minimizer (f : H → EReal) (z : H)
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hlsc : LowerSemicontinuous f)
    (hfinite : ∃ x0, f x0 < ⊤)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x) :
    ∃ p : H, IsMinOn (moreauObjective f z) Set.univ p := by
  rcases hfinite with ⟨x0, hx0_lt_top⟩
  have hx0_top : f x0 ≠ ⊤ := ne_of_lt hx0_lt_top
  let C : Set H := {x : H | moreauObjective f z x ≤ moreauObjective f z x0}
  have hCne : C.Nonempty := ⟨x0, by simp [C]⟩
  have hCbdd : Bornology.IsBounded C :=
    moreauObjective_sublevel_bounded f z x0 hf_bddBelow hx0_top
  have hCclosed : IsClosed C := by
    have hl := (moreauObjective_lsc f z hlsc).isClosed_preimage (moreauObjective f z x0)
    simpa [C, Set.preimage, Set.Iic] using hl
  have hlevel_closed : ∀ r : EReal, IsClosed {x : H | moreauObjective f z x ≤ r} := by
    intro r
    have hl := (moreauObjective_lsc f z hlsc).isClosed_preimage r
    simpa [Set.preimage, Set.Iic] using hl
  have hlevel_conv : ∀ r : EReal, Convex ℝ {x : H | moreauObjective f z x ≤ r} :=
    moreauObjective_convex_level f z hconv hf_bddBelow
  have hCconv : Convex ℝ C := hlevel_conv (moreauObjective f z x0)
  rcases exists_isMinOn_of_level_closed_convex_on_bounded_closed_convex
      (moreauObjective f z) hCne hCbdd hCclosed hCconv hlevel_closed hlevel_conv with
    ⟨p, hpC, hpminC⟩
  refine ⟨p, ?_⟩
  rw [isMinOn_iff] at hpminC ⊢
  intro y hy
  by_cases hyC : y ∈ C
  · exact hpminC y hyC
  · have hnot : ¬ moreauObjective f z y ≤ moreauObjective f z x0 := hyC
    have hlt : moreauObjective f z x0 < moreauObjective f z y := lt_of_not_ge hnot
    exact le_trans hpC hlt.le

omit [CompleteSpace H] in
private theorem moreau_quadratic_direction (z p y : H) {t : ℝ} (ht : 0 ≤ t) :
    (1 / 2 : ℝ) * ‖(1 - t) • p + t • y - z‖ ^ 2 =
      (1 / 2 : ℝ) * ‖p - z‖ ^ 2 +
        t * inner ℝ (p - z) (y - p) +
        (1 / 2 : ℝ) * t ^ 2 * ‖y - p‖ ^ 2 := by
  have hvec :
      (1 - t) • p + t • y - z = (p - z) + t • (y - p) := by
    module
  rw [hvec, norm_add_sq_real, inner_smul_right, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg ht]
  ring

omit [CompleteSpace H] in
private theorem moreau_minimizer_direction_ineq (f : H → EReal) (z p y : H)
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hfinite : ∃ x0, f x0 < ⊤)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (hmin : IsMinOn (moreauObjective f z) Set.univ p)
    (hy_top : f y ≠ ⊤) :
    inner ℝ (z - p) (y - p) ≤ (f y).toReal - (f p).toReal := by
  rcases hf_bddBelow with ⟨m, hm⟩
  have hy_bot : f y ≠ ⊥ := by
    intro hbot
    have hle := hm y
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  rcases hfinite with ⟨x0, hx0_lt_top⟩
  have hx0_top : f x0 ≠ ⊤ := ne_of_lt hx0_lt_top
  have hx0_bot : f x0 ≠ ⊥ := by
    intro hbot
    have hle := hm x0
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  have hx0_obj_top : moreauObjective f z x0 ≠ ⊤ := by
    dsimp [moreauObjective]
    exact ereal_add_coe_ne_top (q := f x0) hx0_top
  have hp_le_x0 : moreauObjective f z p ≤ moreauObjective f z x0 := by
    rw [isMinOn_iff] at hmin
    exact hmin x0 trivial
  have hp_obj_top : moreauObjective f z p ≠ ⊤ := by
    intro htop
    have htop_le : (⊤ : EReal) ≤ moreauObjective f z x0 := by
      simpa [htop] using hp_le_x0
    exact hx0_obj_top (top_le_iff.mp htop_le)
  have hp_top : f p ≠ ⊤ := by
    intro htop
    have hobj : moreauObjective f z p = ⊤ := by
      dsimp [moreauObjective]
      rw [htop]
      exact ereal_top_add_of_ne_bot (EReal.coe_ne_bot _)
    exact hp_obj_top hobj
  have hp_bot : f p ≠ ⊥ := by
    intro hbot
    have hle := hm p
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  let t : ℕ → ℝ := fun n => ((n + 1 : ℝ)⁻¹)
  have hineq_t : ∀ n : ℕ,
      inner ℝ (z - p) (y - p) -
          (1 / 2 : ℝ) * t n * ‖y - p‖ ^ 2 ≤ (f y).toReal - (f p).toReal := by
    intro n
    have htpos : 0 < t n := by
      dsimp [t]
      positivity
    have ht : 0 ≤ t n := le_of_lt htpos
    have htone : t n ≤ 1 := by
      dsimp [t]
      have hn : (1 : ℝ) ≤ n + 1 := by exact_mod_cast Nat.succ_le_succ (Nat.zero_le n)
      exact inv_le_one_of_one_le₀ hn
    let xt : H := (1 - t n) • p + (t n) • y
    have hxt_conv :
        f xt ≤ ((1 - t n : ℝ) : EReal) * f p + ((t n : ℝ) : EReal) * f y := by
      have hsum : (1 - t n) + t n = 1 := by ring
      simpa [xt] using hconv p y (1 - t n) (t n) (sub_nonneg.mpr htone) ht hsum
    have hxt_top : f xt ≠ ⊤ := by
      intro htop
      have hright_ne_top :
          ((1 - t n : ℝ) : EReal) * f p + ((t n : ℝ) : EReal) * f y ≠ ⊤ := by
        rw [← EReal.coe_toReal hp_top hp_bot, ← EReal.coe_toReal hy_top hy_bot]
        have h :
            ((1 - t n : ℝ) : EReal) * ((f p).toReal : EReal) +
                ((t n : ℝ) : EReal) * ((f y).toReal : EReal) =
              (((1 - t n) * (f p).toReal + (t n) * (f y).toReal : ℝ) : EReal) := by
          norm_num [EReal.coe_mul, EReal.coe_add]
        rw [h]
        exact EReal.coe_ne_top _
      exact hright_ne_top (top_le_iff.mp (by simpa [htop] using hxt_conv))
    have hxt_bot : f xt ≠ ⊥ := by
      intro hbot
      have hle := hm xt
      rw [hbot] at hle
      exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
    have hp_min_xt : moreauObjective f z p ≤ moreauObjective f z xt := by
      rw [isMinOn_iff] at hmin
      exact hmin xt trivial
    have htotal :
        moreauObjective f z p ≤
          ((1 - t n : ℝ) : EReal) * f p + ((t n : ℝ) : EReal) * f y +
            (((1 / 2 : ℝ) * ‖xt - z‖ ^ 2 : ℝ) : EReal) := by
      have hadd := add_le_add_right hxt_conv
          ((((1 / 2 : ℝ) * ‖xt - z‖ ^ 2 : ℝ) : EReal))
      have hadd' :
          f xt + (((1 / 2 : ℝ) * ‖xt - z‖ ^ 2 : ℝ) : EReal) ≤
            ((1 - t n : ℝ) : EReal) * f p + ((t n : ℝ) : EReal) * f y +
              (((1 / 2 : ℝ) * ‖xt - z‖ ^ 2 : ℝ) : EReal) := by
        simpa [add_comm, add_left_comm, add_assoc] using hadd
      exact le_trans hp_min_xt (by simpa [moreauObjective, xt] using hadd')
    have hp_obj_bot : moreauObjective f z p ≠ ⊥ :=
      moreauObjective_ne_bot f z ⟨m, hm⟩ p
    have hright_top :
        ((1 - t n : ℝ) : EReal) * f p + ((t n : ℝ) : EReal) * f y +
          (((1 / 2 : ℝ) * ‖xt - z‖ ^ 2 : ℝ) : EReal) ≠ ⊤ := by
      rw [← EReal.coe_toReal hp_top hp_bot, ← EReal.coe_toReal hy_top hy_bot]
      have h :
          ((1 - t n : ℝ) : EReal) * ((f p).toReal : EReal) +
              ((t n : ℝ) : EReal) * ((f y).toReal : EReal) +
              (((1 / 2 : ℝ) * ‖xt - z‖ ^ 2 : ℝ) : EReal) =
            ((((1 - t n) * (f p).toReal + (t n) * (f y).toReal) +
              ((1 / 2 : ℝ) * ‖xt - z‖ ^ 2) : ℝ) : EReal) := by
        norm_num [EReal.coe_mul, EReal.coe_add]
      rw [h]
      exact EReal.coe_ne_top _
    have hreal := EReal.toReal_le_toReal htotal hp_obj_bot hright_top
    have hp_toReal := moreauObjective_toReal_of_finite f z p hp_top hp_bot
    have hright_toReal :
        (((1 - t n : ℝ) : EReal) * f p + ((t n : ℝ) : EReal) * f y +
          (((1 / 2 : ℝ) * ‖xt - z‖ ^ 2 : ℝ) : EReal)).toReal =
            (1 - t n) * (f p).toReal + (t n) * (f y).toReal +
              (1 / 2 : ℝ) * ‖xt - z‖ ^ 2 := by
      rw [← EReal.coe_toReal hp_top hp_bot, ← EReal.coe_toReal hy_top hy_bot]
      have h :
          ((1 - t n : ℝ) : EReal) * ((f p).toReal : EReal) +
              ((t n : ℝ) : EReal) * ((f y).toReal : EReal) +
              (((1 / 2 : ℝ) * ‖xt - z‖ ^ 2 : ℝ) : EReal) =
            ((((1 - t n) * (f p).toReal + (t n) * (f y).toReal) +
              ((1 / 2 : ℝ) * ‖xt - z‖ ^ 2) : ℝ) : EReal) := by
        norm_num [EReal.coe_mul, EReal.coe_add]
      rw [h]
      exact EReal.toReal_coe _
    rw [hp_toReal, hright_toReal] at hreal
    have hquad := moreau_quadratic_direction z p y (ht := ht)
    have hxt_eq : xt = (1 - t n) • p + (t n) • y := rfl
    rw [← hxt_eq] at hquad
    have hinner_comm :
        inner ℝ (p - z) (y - p) = - inner ℝ (z - p) (y - p) := by
      rw [show p - z = -(z - p) by abel, inner_neg_left]
    rw [hinner_comm] at hquad
    nlinarith [hreal, hquad, htpos]
  have ht_tendsto : Tendsto t atTop (𝓝 (0 : ℝ)) := by
    have hshift : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
      Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
    have hcomp := (tendsto_inv_atTop_nhds_zero_nat (𝕜 := ℝ)).comp hshift
    have heq :
        ((fun n : ℕ => ((n : ℝ)⁻¹)) ∘ fun n : ℕ => n + 1) =
          fun n : ℕ => ((n + 1 : ℝ)⁻¹) := by
      funext n
      norm_num [Nat.cast_add]
    simpa [t, heq] using hcomp
  have hlim_lhs :
      Tendsto (fun n : ℕ =>
        inner ℝ (z - p) (y - p) - (1 / 2 : ℝ) * t n * ‖y - p‖ ^ 2) atTop
        (𝓝 (inner ℝ (z - p) (y - p))) := by
    have hmul :
        Tendsto (fun n : ℕ => ((1 / 2 : ℝ) * ‖y - p‖ ^ 2) * t n) atTop
          (𝓝 (0 : ℝ)) := by
      simpa using ht_tendsto.const_mul ((1 / 2 : ℝ) * ‖y - p‖ ^ 2)
    have hconst : Tendsto (fun _ : ℕ => inner ℝ (z - p) (y - p)) atTop
        (𝓝 (inner ℝ (z - p) (y - p))) := tendsto_const_nhds
    have heq :
        (fun n : ℕ =>
          inner ℝ (z - p) (y - p) - (1 / 2 : ℝ) * t n * ‖y - p‖ ^ 2) =
        (fun n : ℕ =>
          inner ℝ (z - p) (y - p) - ((1 / 2 : ℝ) * ‖y - p‖ ^ 2) * t n) := by
      funext n
      ring
    rw [heq]
    simpa using hconst.sub hmul
  have hlim_rhs : Tendsto (fun _ : ℕ => (f y).toReal - (f p).toReal) atTop
      (𝓝 ((f y).toReal - (f p).toReal)) := tendsto_const_nhds
  exact le_of_tendsto_of_tendsto hlim_lhs hlim_rhs (Filter.Eventually.of_forall hineq_t)

omit [CompleteSpace H] in
private theorem moreau_minimizer_subgradient
    (B : SetValuedOperator H H) (f : H → EReal) (z p : H)
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hB : ∀ x, B x = {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)})
    (hfinite : ∃ x0, f x0 < ⊤)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (hmin : IsMinOn (moreauObjective f z) Set.univ p) :
    z - p ∈ B p := by
  rw [hB]
  intro y
  rcases hf_bddBelow with ⟨m, hm⟩
  have hp_top : f p ≠ ⊤ := by
    rcases hfinite with ⟨x0, hx0_lt_top⟩
    have hx0_top : f x0 ≠ ⊤ := ne_of_lt hx0_lt_top
    have hx0_obj_top : moreauObjective f z x0 ≠ ⊤ := by
      dsimp [moreauObjective]
      exact ereal_add_coe_ne_top (q := f x0) hx0_top
    have hp_le_x0 : moreauObjective f z p ≤ moreauObjective f z x0 := by
      rw [isMinOn_iff] at hmin
      exact hmin x0 trivial
    have hp_obj_top : moreauObjective f z p ≠ ⊤ := by
      intro htop
      have htop_le : (⊤ : EReal) ≤ moreauObjective f z x0 := by
        simpa [htop] using hp_le_x0
      exact hx0_obj_top (top_le_iff.mp htop_le)
    intro htop
    have hobj : moreauObjective f z p = ⊤ := by
      dsimp [moreauObjective]
      rw [htop]
      exact ereal_top_add_of_ne_bot (EReal.coe_ne_bot _)
    exact hp_obj_top hobj
  have hp_bot : f p ≠ ⊥ := by
    intro hbot
    have hle := hm p
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  by_cases hy_top : f y = ⊤
  · rw [hy_top]
    exact le_top
  have hy_bot : f y ≠ ⊥ := by
    intro hbot
    have hle := hm y
    rw [hbot] at hle
    exact (not_le_of_gt (EReal.bot_lt_coe m)) hle
  have hdir := moreau_minimizer_direction_ineq f z p y hconv hfinite ⟨m, hm⟩ hmin hy_top
  have htarget_real :
      (f p).toReal + inner ℝ (z - p) (y - p) ≤ (f y).toReal := by
    linarith
  have hcoe : ((f p).toReal + inner ℝ (z - p) (y - p) : ℝ) ≤ (f y).toReal :=
    htarget_real
  have hE : (((f p).toReal + inner ℝ (z - p) (y - p) : ℝ) : EReal) ≤ f y := by
    rw [← EReal.coe_toReal hy_top hy_bot]
    exact EReal.coe_le_coe hcoe
  have hadd :
      f p + (inner ℝ (z - p) (y - p) : EReal) =
        (((f p).toReal + inner ℝ (z - p) (y - p) : ℝ) : EReal) := by
    calc
      f p + (inner ℝ (z - p) (y - p) : EReal)
          = ((f p).toReal : EReal) + (inner ℝ (z - p) (y - p) : EReal) := by
            rw [EReal.coe_toReal hp_top hp_bot]
      _ = (((f p).toReal + inner ℝ (z - p) (y - p) : ℝ) : EReal) := by
            rw [← EReal.coe_add]
  simpa [hadd] using hE

private theorem moreau_resolvent_surjective
    (B : SetValuedOperator H H) (f : H → EReal)
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hlsc : LowerSemicontinuous f)
    (hB : ∀ x, B x = {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)})
    (hfinite : ∃ z, f z < ⊤)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x) :
    ∀ z : H, ∃ p q : H, q ∈ B p ∧ z = p + q := by
  intro z
  rcases exists_moreau_minimizer f z hconv hlsc hfinite hf_bddBelow with ⟨p, hpmin⟩
  refine ⟨p, z - p, ?_, ?_⟩
  · exact moreau_minimizer_subgradient B f z p hconv hB hfinite hf_bddBelow hpmin
  · abel

private theorem theorem31_subderivative_maximal_monotone
    (B : SetValuedOperator H H) (f : H → EReal)
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hlsc : LowerSemicontinuous f)
    (hB : ∀ x, B x = {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)})
    (hfinite : ∃ z, f z < ⊤)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x) :
    IsMaximalMonotone B := by
  have hmono : IsMonotone B :=
    theorem31_subderivative_monotone B f hB hfinite hf_bddBelow
  exact maximal_of_monotone_and_resolvent_surjective B hmono
    (moreau_resolvent_surjective B f hconv hlsc hB hfinite hf_bddBelow)

omit [CompleteSpace H] in
private theorem mem_enlargement_zero_of_mem {T : SetValuedOperator H H}
    (hT : IsMonotone T) {x u : H} (hu : u ∈ T x) :
    u ∈ enlargement T 0 x := by
  rw [enlargement, Set.mem_setOf_eq]
  intro y v hv
  have hmono : 0 ≤ inner ℝ (u - v) (x - y) := hT u hu v hv
  have hEq : inner ℝ (u - v) (x - y) = inner ℝ (v - u) (y - x) := by
    rw [show u - v = -(v - u) by abel]
    rw [show x - y = -(y - x) by abel]
    rw [inner_neg_left, inner_neg_right, neg_neg]
  simpa [← hEq] using hmono

omit [CompleteSpace H] in
private theorem enlargement_zero_subset_of_maximal_local {T : SetValuedOperator H H}
    (hT : IsMaximalMonotone T) {x v : H} (hv : v ∈ enlargement T 0 x) :
    v ∈ T x := by
  rcases hT with ⟨hT_mono, hT_max⟩
  let T' : SetValuedOperator H H := fun y => T y ∪ {w | y = x ∧ w = v}
  have hT_subset : T.graph ⊆ T'.graph := by
    intro p hp
    exact Or.inl hp
  have hT'_mono : IsMonotone T' := by
    intro y z uy huy uz huz
    rcases huy with huy | huy
    · rcases huz with huz | huz
      · exact hT_mono uy huy uz huz
      · rcases huz with ⟨rfl, rfl⟩
        rw [enlargement, Set.mem_setOf_eq] at hv
        have h := hv y uy huy
        simpa [inner_neg_right] using h
    · rcases huy with ⟨rfl, rfl⟩
      rcases huz with huz | huz
      · rw [enlargement, Set.mem_setOf_eq] at hv
        have h := hv z uz huz
        have hEq : inner ℝ (uy - uz) (y - z) = inner ℝ (uz - uy) (z - y) := by
          rw [show uy - uz = -(uz - uy) by abel]
          rw [show y - z = -(z - y) by abel]
          rw [inner_neg_left, inner_neg_right, neg_neg]
        rw [hEq]
        simpa using h
      · rcases huz with ⟨rfl, rfl⟩
        simp
  have hgraph : T'.graph ⊆ T.graph := hT_max T' hT'_mono hT_subset
  have hp : (x, v) ∈ T'.graph := by
    change v ∈ T' x
    exact Or.inr ⟨rfl, rfl⟩
  exact hgraph hp

private theorem theorem31_subderivative_graph_closed_along_algorithm
    (B : SetValuedOperator H H) (f : H → EReal) (x : ℕ → H)
    (hconv : ∀ x y : H, ∀ a b : ℝ, 0 ≤ a → 0 ≤ b → a + b = 1 →
      f (a • x + b • y) ≤ (a : EReal) * f x + (b : EReal) * f y)
    (hlsc : LowerSemicontinuous f)
    (hB : ∀ x, B x = {v | ∀ y, f y ≥ f x + (inner ℝ v (y - x) : EReal)})
    (hfinite : ∃ z, f z < ⊤)
    (hf_bddBelow : ∃ m : ℝ, ∀ x, (m : EReal) ≤ f x)
    (xInf vBar : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (b : ℕ → H) (φ : ℕ → ℕ) (hφ : StrictMono φ)
    (hb : ∀ n, b n ∈ B (x (n + 2)))
    (hweak : Tendsto (fun n => toWeakSpace ℝ H (b (φ n))) atTop
      (𝓝 (toWeakSpace ℝ H vBar))) :
    vBar ∈ B xInf := by
  have hBmax : IsMaximalMonotone B :=
    theorem31_subderivative_maximal_monotone B f hconv hlsc hB hfinite hf_bddBelow
  have hφ2 : Tendsto (fun n : ℕ => φ n + 2) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_add_right (φ n) 2) hφ.tendsto_atTop
  have hxφ : Tendsto (fun n : ℕ => x (φ n + 2)) atTop (𝓝 xInf) :=
    hxInf.comp hφ2
  have hmem : ∀ n, b (φ n) ∈ enlargement B 0 (x (φ n + 2)) := by
    intro n
    exact mem_enlargement_zero_of_mem hBmax.1 (hb (φ n))
  have hzero : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 (0 : ℝ)) := tendsto_const_nhds
  have hlim_enl : vBar ∈ enlargement B 0 xInf :=
    demiclosed_strong_x_weakStar_u hBmax.1 hxφ hweak hzero hmem
  exact enlargement_zero_subset_of_maximal_local hBmax hlim_enl

private theorem theorem31_A_graph_closed_along_algorithm
    (A : SetValuedOperator H H) (lam : ℕ → ℝ) (x : ℕ → H)
    (hA : IsMaximalMonotone A)
    (hlam_pos : ∀ n, lam n > 0) (hlam_nondec : ∀ n, lam n ≤ lam (n + 1))
    (xInf vBar : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (a b : ℕ → H) (φ : ℕ → ℕ) (hφ : StrictMono φ)
    (ha : ∀ n, a n ∈ A ((lam n)⁻¹ • (x (n + 2) - x (n + 1))))
    (heq : ∀ n,
      ((lam n) ^ 2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n) + a n + b n = 0)
    (hweak : Tendsto (fun n => toWeakSpace ℝ H (b (φ n))) atTop
      (𝓝 (toWeakSpace ℝ H vBar))) :
    -vBar ∈ A (0 : H) := by
  let z : ℕ → H := fun n => (lam n)⁻¹ • (x (n + 2) - x (n + 1))
  let acc : ℕ → H := fun n =>
    ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)
  let u : ℕ → H := fun n => -acc (φ n) - b (φ n)
  have hz : Tendsto z atTop (𝓝 (0 : H)) :=
    theorem31_scaled_velocity_tendsto_zero lam x xInf hlam_pos hlam_nondec hxInf
  have hzφ : Tendsto (fun n => z (φ n)) atTop (𝓝 (0 : H)) :=
    hz.comp hφ.tendsto_atTop
  have hacc : Tendsto acc atTop (𝓝 (0 : H)) :=
    theorem31_acceleration_tendsto_zero lam x xInf hlam_pos hlam_nondec hxInf
  have haccφ : Tendsto (fun n => acc (φ n)) atTop (𝓝 (0 : H)) :=
    hacc.comp hφ.tendsto_atTop
  have haccφ_weak :
      Tendsto (fun n => toWeakSpace ℝ H (acc (φ n))) atTop
        (𝓝 (toWeakSpace ℝ H (0 : H))) :=
    (toWeakSpaceCLM ℝ H).continuous.tendsto (0 : H) |>.comp haccφ
  have huweak : Tendsto (fun n => toWeakSpace ℝ H (u n)) atTop
      (𝓝 (toWeakSpace ℝ H (-vBar))) := by
    have hnegacc :
        Tendsto (fun n => toWeakSpace ℝ H (-acc (φ n))) atTop
          (𝓝 (toWeakSpace ℝ H (-(0 : H)))) := by
      simpa using haccφ_weak.neg
    have hnegb :
        Tendsto (fun n => toWeakSpace ℝ H (-b (φ n))) atTop
          (𝓝 (toWeakSpace ℝ H (-vBar))) := by
      simpa using hweak.neg
    simpa [u, sub_eq_add_neg] using hnegacc.add hnegb
  have hu_enlargement : ∀ n, u n ∈ enlargement A 0 (z (φ n)) := by
    intro n
    have hu_eq_a : u n = a (φ n) := by
      change -acc (φ n) - b (φ n) = a (φ n)
      have hsum : acc (φ n) + a (φ n) + b (φ n) = 0 := by
        simpa [acc] using heq (φ n)
      calc
        -acc (φ n) - b (φ n) = -acc (φ n) - b (φ n) + 0 := by simp
        _ = -acc (φ n) - b (φ n) + (acc (φ n) + a (φ n) + b (φ n)) := by
          rw [hsum]
        _ = a (φ n) := by abel
    rw [hu_eq_a]
    exact mem_enlargement_zero_of_mem hA.1 (by simpa [z] using ha (φ n))
  have hzero : Tendsto (fun _ : ℕ => (0 : ℝ)) atTop (𝓝 (0 : ℝ)) := tendsto_const_nhds
  have hlim_enl : -vBar ∈ enlargement A 0 (0 : H) :=
    demiclosed_strong_x_weakStar_u hA.1 hzφ huweak hzero hu_enlargement
  exact enlargement_zero_subset_of_maximal_local hA hlim_enl

private theorem theorem31_limit_direction_monotonicity_passage
    [FiniteDimensional ℝ H] (A B : SetValuedOperator H H) (f : H → EReal)
    (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (_hnotFinite : ¬ ∃ N, ∀ n ≥ N, x n = x N)
    {d : H} (hd : d ∈ normalizedIncrementLimitPoints x) :
    ∃ vBar : H,
      vBar ∈ B xInf ∧ -vBar ∈ A (0 : H) ∧ d ∈ normalCone (A (0 : H)) (-vBar) := by
  classical
  rcases hd with ⟨φ, hφ, hφ_nonstat, hφ_dir⟩
  have hφ_ge : ∀ n : ℕ, n ≤ φ n := by
    intro n
    induction n with
    | zero => exact Nat.zero_le _
    | succ n ih =>
        exact Nat.succ_le_of_lt (lt_of_le_of_lt ih (hφ (Nat.lt_succ_self n)))
  let χ : ℕ → ℕ := fun n => φ (n + 1) - 1
  have hχ_add_one : ∀ n : ℕ, χ n + 1 = φ (n + 1) := by
    intro n
    have hpos : 1 ≤ φ (n + 1) := by
      exact le_trans (Nat.succ_le_succ (Nat.zero_le n)) (hφ_ge (n + 1))
    exact Nat.sub_add_cancel hpos
  have hχ : StrictMono χ := by
    intro m n hmn
    have hφlt : φ (m + 1) < φ (n + 1) := hφ (Nat.succ_lt_succ hmn)
    have hmpos : 1 ≤ φ (m + 1) := by
      exact le_trans (Nat.succ_le_succ (Nat.zero_le m)) (hφ_ge (m + 1))
    have hnpos : 1 ≤ φ (n + 1) := by
      exact le_trans (Nat.succ_le_succ (Nat.zero_le n)) (hφ_ge (n + 1))
    dsimp [χ]
    omega
  let stepDir : ℕ → H := fun n =>
    ‖x (n + 2) - x (n + 1)‖⁻¹ • (x (n + 2) - x (n + 1))
  have hshift : Tendsto (fun n : ℕ => n + 1) atTop atTop :=
    Filter.tendsto_atTop_mono (fun n => Nat.le_succ n) tendsto_id
  have hχ_dir : Tendsto (fun n : ℕ => stepDir (χ n)) atTop (𝓝 d) := by
    have hφ_shift :
        Tendsto (fun n : ℕ => normalizedIncrementDirection x (φ (n + 1))) atTop (𝓝 d) :=
      hφ_dir.comp hshift
    convert hφ_shift using 1
    ext n
    have hχn := hχ_add_one n
    have hχn_two : χ n + 2 = φ (n + 1) + 1 := by omega
    simp [stepDir, normalizedIncrementDirection, hχn, hχn_two]
  have hsel := theorem31_algorithm_step_selection A B lam x h.generated_by_algorithm
  choose a b ha hb heq using hsel
  have hbdd : Bornology.IsBounded (Set.range b) :=
    theorem31_subgradient_selection_bounded A B f lam x h xInf hxInf a b ha hb heq
  have hbddχ : Bornology.IsBounded (Set.range fun n => b (χ n)) :=
    hbdd.subset (by
      rintro y ⟨n, rfl⟩
      exact ⟨χ n, rfl⟩)
  haveI : ProperSpace H := FiniteDimensional.proper ℝ H
  rcases (isBounded_iff_forall_norm_le (s := Set.range fun n => b (χ n))).mp hbddχ with
    ⟨C, hC⟩
  let R : ℝ := max C 0
  have hb_mem_ball : ∀ n, b (χ n) ∈ Metric.closedBall (0 : H) R := by
    intro n
    rw [Metric.mem_closedBall, dist_eq_norm, sub_zero]
    exact le_trans (hC (b (χ n)) ⟨n, rfl⟩) (le_max_left C 0)
  rcases (ProperSpace.isCompact_closedBall (0 : H) R).tendsto_subseq hb_mem_ball with
    ⟨vBar, _hvBar_ball, ψ, hψ, hbψ⟩
  let ρ : ℕ → ℕ := χ ∘ ψ
  have hρ : StrictMono ρ := hχ.comp hψ
  have hbρ : Tendsto (fun n : ℕ => b (ρ n)) atTop (𝓝 vBar) := by
    simpa [ρ, Function.comp] using hbψ
  have hweakρ : Tendsto (fun n => toWeakSpace ℝ H (b (ρ n))) atTop
      (𝓝 (toWeakSpace ℝ H vBar)) := by
    simpa using ((toWeakSpaceCLM ℝ H).continuous.tendsto vBar).comp hbρ
  have hfinite : ∃ z, f z < ⊤ :=
    ⟨x 1, by simpa [ERealFunction.dom] using h.initial_point_mem_dom⟩
  have hvBarB : vBar ∈ B xInf :=
    theorem31_subderivative_graph_closed_along_algorithm B f x h.convex_f
      h.lowerSemicontinuous_f h.B_eq_subderivative_f hfinite h.f_bddBelow xInf vBar hxInf b
      ρ hρ hb hweakρ
  have hnegA : -vBar ∈ A (0 : H) :=
    theorem31_A_graph_closed_along_algorithm A lam x h.maxMonotoneA h.lam_pos h.lam_nondec
      xInf vBar hxInf a b ρ hρ ha heq hweakρ
  refine ⟨vBar, hvBarB, hnegA, ?_⟩
  rw [mem_normalCone_iff_forall]
  refine ⟨hnegA, ?_⟩
  intro ξ hξ
  let acc : ℕ → H := fun n =>
    ((lam n)^2)⁻¹ • (x (n + 2) - 2 • x (n + 1) + x n)
  have hacc : Tendsto acc atTop (𝓝 (0 : H)) :=
    theorem31_acceleration_tendsto_zero lam x xInf h.lam_pos h.lam_nondec hxInf
  have haccρ : Tendsto (fun n : ℕ => acc (ρ n)) atTop (𝓝 (0 : H)) :=
    hacc.comp hρ.tendsto_atTop
  have haρ_eq : (fun n : ℕ => a (ρ n)) = fun n : ℕ => -acc (ρ n) - b (ρ n) := by
    funext n
    have hsum : acc (ρ n) + a (ρ n) + b (ρ n) = 0 := by
      simpa [acc] using heq (ρ n)
    have htmp : -acc (ρ n) - b (ρ n) = a (ρ n) := by
      calc
        -acc (ρ n) - b (ρ n) = -acc (ρ n) - b (ρ n) + 0 := by simp
        _ = -acc (ρ n) - b (ρ n) + (acc (ρ n) + a (ρ n) + b (ρ n)) := by
          rw [hsum]
        _ = a (ρ n) := by abel
    exact htmp.symm
  have haρ : Tendsto (fun n : ℕ => a (ρ n)) atTop (𝓝 (-vBar)) := by
    have hlim : Tendsto (fun n : ℕ => -acc (ρ n) - b (ρ n)) atTop (𝓝 (-vBar)) := by
      have hnegacc : Tendsto (fun n : ℕ => -acc (ρ n)) atTop (𝓝 (0 : H)) := by
        simpa using haccρ.neg
      simpa using hnegacc.sub hbρ
    rwa [haρ_eq]
  have hdirρ : Tendsto (fun n : ℕ => stepDir (ρ n)) atTop (𝓝 d) := by
    simpa [ρ, Function.comp] using hχ_dir.comp hψ.tendsto_atTop
  have hineq : ∀ n : ℕ, 0 ≤ inner ℝ (a (ρ n) - ξ) (stepDir (ρ n)) := by
    intro n
    let k := ρ n
    let inc : H := x (k + 2) - x (k + 1)
    have hmono : 0 ≤ inner ℝ (a k - ξ) (((lam k)⁻¹ • inc) - (0 : H)) := by
      simpa [k, inc] using h.maxMonotoneA.1 (a k) (ha k) ξ hξ
    have hraw : 0 ≤ inner ℝ (a k - ξ) ((lam k)⁻¹ • inc) := by
      simpa using hmono
    have hinc_nonneg : 0 ≤ inner ℝ (a k - ξ) inc := by
      rw [inner_smul_right] at hraw
      rw [mul_comm] at hraw
      exact nonneg_of_mul_nonneg_left hraw (inv_pos.mpr (h.lam_pos k))
    have hnonstat : k + 1 ∉ stationaryIndices x := by
      have hχψ : χ (ψ n) + 1 = φ (ψ n + 1) := hχ_add_one (ψ n)
      simpa [k, ρ, Function.comp, hχψ] using hφ_nonstat (ψ n + 1)
    have hinc_ne : inc ≠ 0 := by
      intro hzero
      have hstat : k + 1 ∈ stationaryIndices x := by
        simpa [stationaryIndices, inc] using sub_eq_zero.mp hzero
      exact hnonstat hstat
    have hnorm_pos : 0 < ‖inc‖ := norm_pos_iff.mpr hinc_ne
    have hdir_nonneg : 0 ≤ inner ℝ (a k - ξ) (‖inc‖⁻¹ • inc) := by
      rw [inner_smul_right]
      exact mul_nonneg (le_of_lt (inv_pos.mpr hnorm_pos)) hinc_nonneg
    simpa [stepDir, k, inc] using hdir_nonneg
  have hlim_inner :
      Tendsto (fun n : ℕ => inner ℝ (a (ρ n) - ξ) (stepDir (ρ n))) atTop
        (𝓝 (inner ℝ (-vBar - ξ) d)) := by
    exact (haρ.sub tendsto_const_nhds).inner hdirρ
  have hlim_nonneg : 0 ≤ inner ℝ (-vBar - ξ) d :=
    le_of_tendsto_of_tendsto tendsto_const_nhds hlim_inner
      (Filter.Eventually.of_forall hineq)
  have hinner_eq : inner ℝ (-vBar - ξ) d = - inner ℝ d (ξ - -vBar) := by
    calc
      inner ℝ (-vBar - ξ) d = inner ℝ (-(ξ - -vBar)) d := by
        rw [show -vBar - ξ = -(ξ - -vBar) by abel]
      _ = - inner ℝ (ξ - -vBar) d := by rw [inner_neg_left]
      _ = - inner ℝ d (ξ - -vBar) := by rw [real_inner_comm]
  rw [real_inner_comm]
  nlinarith

theorem theorem31_closed_graph_limit_selection_core (A B : SetValuedOperator H H)
    (f : H → EReal) (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    ∃ vBar : H, vBar ∈ B xInf ∧ -vBar ∈ A (0 : H) := by
  classical
  have hsel := theorem31_algorithm_step_selection A B lam x h.generated_by_algorithm
  choose a b ha hb heq using hsel
  have hbdd : Bornology.IsBounded (Set.range b) :=
    theorem31_subgradient_selection_bounded A B f lam x h xInf hxInf a b ha hb heq
  rcases theorem31_weak_cluster_of_bounded_selection b hbdd with
    ⟨vBar, φ, hφ, hweak⟩
  have hfinite : ∃ z, f z < ⊤ := ⟨x 1, by simpa [ERealFunction.dom] using h.initial_point_mem_dom⟩
  have hvBarB : vBar ∈ B xInf :=
    theorem31_subderivative_graph_closed_along_algorithm B f x h.convex_f
      h.lowerSemicontinuous_f h.B_eq_subderivative_f hfinite h.f_bddBelow xInf vBar hxInf b
      φ hφ hb hweak
  have hnegA : -vBar ∈ A (0 : H) :=
    theorem31_A_graph_closed_along_algorithm A lam x h.maxMonotoneA h.lam_pos h.lam_nondec
      xInf vBar hxInf a b φ hφ ha heq hweak
  exact ⟨vBar, hvBarB, hnegA⟩

theorem theorem31_limit_directions_normal_cone_core [FiniteDimensional ℝ H]
    (A B : SetValuedOperator H H) (f : H → EReal)
    (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (hnotFinite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    normalizedIncrementLimitPoints x ⊆ normalConeSet (A (0 : H)) (-(B xInf)) := by
  intro d hd
  rcases theorem31_limit_direction_monotonicity_passage A B f lam x h xInf hxInf hnotFinite hd
    with ⟨vBar, hvBarB, hnegA, hdCone⟩
  rw [normalConeSet]
  refine Set.mem_iUnion.2 ⟨-vBar, ?_⟩
  refine Set.mem_iUnion.2 ⟨?_, hdCone⟩
  simp [hvBarB]

omit [CompleteSpace H] in
private theorem normalCone_mem_interior_eq_zero (C : Set H) {ξ u : H}
    (hξ : ξ ∈ interior C) (hu : u ∈ normalCone C ξ) : u = 0 := by
  by_contra hne
  have hξC : ξ ∈ C := interior_subset hξ
  rw [mem_normalCone_iff_forall] at hu
  have hnhds : C ∈ nhds ξ := mem_interior_iff_mem_nhds.mp hξ
  rcases (Metric.mem_nhds_iff.mp hnhds) with ⟨ε, hε, hεsub⟩
  let c : ℝ := ε / (2 * ‖u‖)
  let y : H := ξ + c • u
  have hyC : y ∈ C := by
    apply hεsub
    rw [Metric.mem_ball, dist_eq_norm]
    dsimp [y, c]
    rw [add_sub_cancel_left]
    rw [norm_smul]
    rw [Real.norm_eq_abs]
    have hc_nonneg : 0 ≤ ε / (2 * ‖u‖) := by positivity
    rw [abs_of_nonneg hc_nonneg]
    have hu_norm_pos : 0 < ‖u‖ := norm_pos_iff.mpr hne
    field_simp [ne_of_gt hu_norm_pos]
    linarith
  have hle : inner ℝ u (y - ξ) ≤ 0 := by
    simpa [real_inner_comm] using hu.2 y hyC
  have hpos : 0 < inner ℝ u (y - ξ) := by
    dsimp [y, c]
    rw [add_sub_cancel_left]
    rw [inner_smul_right]
    rw [real_inner_self_eq_norm_sq]
    have hu_norm_pos : 0 < ‖u‖ := norm_pos_iff.mpr hne
    positivity
  linarith

omit [CompleteSpace H] in
private theorem normalConeSet_subset_zero_of_subset_interior (C S : Set H)
    (hS : S ⊆ interior C) : normalConeSet C S ⊆ ({0} : Set H) := by
  intro u hu
  rw [normalConeSet] at hu
  simp only [mem_iUnion] at hu
  rcases hu with ⟨ξ, hξ⟩
  rcases hξ with ⟨hξS, huCone⟩
  have hu0 : u = 0 := normalCone_mem_interior_eq_zero C (hS hξS) huCone
  simp [hu0]

omit [CompleteSpace H] in
private theorem normalizedIncrementLimitPoints_nonempty_unit [FiniteDimensional ℝ H]
    (x : ℕ → H) (hnotFinite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    ∃ d ∈ normalizedIncrementLimitPoints x, ‖d‖ = 1 := by
  have hmany : ∀ N : ℕ, ∃ n > N, n ∉ stationaryIndices x := by
    intro N
    by_contra hno
    have hall : ∀ n > N, n ∈ stationaryIndices x := by
      intro n hn
      by_contra hnstat
      exact hno ⟨n, hn, hnstat⟩
    apply hnotFinite
    refine ⟨N + 1, ?_⟩
    intro n hn
    induction n, hn using Nat.le_induction with
    | base => rfl
    | succ n hn ih =>
        have hstat : n ∈ stationaryIndices x := by
          exact hall n (lt_of_lt_of_le (Nat.lt_succ_self N) hn)
        have hxstep : x (n + 1) = x n := by
          simpa [stationaryIndices] using hstat
        calc
          x (n + 1) = x n := hxstep
          _ = x (N + 1) := ih
  rcases Nat.exists_strictMono_subsequence hmany with ⟨φ, hφmono, hφstat⟩
  let y : ℕ → H := fun n => normalizedIncrementDirection x (φ n)
  have hy_norm : ∀ n, ‖y n‖ = 1 := by
    intro n
    have hne : x (φ n + 1) - x (φ n) ≠ 0 := by
      intro hz
      have hstat : φ n ∈ stationaryIndices x := by
        rw [stationaryIndices]
        exact sub_eq_zero.mp hz
      exact hφstat n hstat
    dsimp [y, normalizedIncrementDirection]
    rw [norm_smul]
    rw [Real.norm_eq_abs]
    have hnpos : 0 < ‖x (φ n + 1) - x (φ n)‖ := norm_pos_iff.mpr hne
    rw [abs_of_pos (inv_pos.mpr hnpos)]
    field_simp [ne_of_gt hnpos]
  have hy_mem : ∀ n, y n ∈ Metric.closedBall (0 : H) 1 := by
    intro n
    simp [Metric.mem_closedBall, dist_eq_norm, hy_norm n]
  rcases (ProperSpace.isCompact_closedBall (0 : H) 1).tendsto_subseq hy_mem with
    ⟨d, hd_ball, ψ, hψmono, hψtend⟩
  have hcompmono : StrictMono (φ ∘ ψ) := hφmono.comp hψmono
  have hlim :
      Tendsto (fun n => normalizedIncrementDirection x ((φ ∘ ψ) n)) atTop (𝓝 d) := by
    simpa [Function.comp, y] using hψtend
  have hd_mem : d ∈ normalizedIncrementLimitPoints x := by
    exact ⟨φ ∘ ψ, hcompmono, fun n => hφstat (ψ n), hlim⟩
  have hnorm_tend : Tendsto (fun n => ‖y (ψ n)‖) atTop (𝓝 ‖d‖) := by
    simpa [Function.comp] using (tendsto_norm.comp hψtend)
  have hnorm_eq : ‖d‖ = 1 := by
    apply tendsto_nhds_unique hnorm_tend
    simp [hy_norm]
  exact ⟨d, hd_mem, hnorm_eq⟩

omit [CompleteSpace H] in
theorem theorem31_interior_condition_forces_finite_core [FiniteDimensional ℝ H]
    (A B : SetValuedOperator H H) (f : H → EReal)
    (lam : ℕ → ℝ) (x : ℕ → H)
    (_h : Theorem31Assumptions A B f lam x)
    (xInf : H) (_hxInf : Tendsto x atTop (𝓝 xInf))
    (hInterior : (-(B xInf)) ⊆ interior (A (0 : H)))
    (hDirections : normalizedIncrementLimitPoints x ⊆ normalConeSet (A (0 : H)) (-(B xInf)))
    (hnotFinite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    False := by
  rcases normalizedIncrementLimitPoints_nonempty_unit x hnotFinite with ⟨d, hd, hdnorm⟩
  have hzero_mem :
      d ∈ ({0} : Set H) :=
    normalConeSet_subset_zero_of_subset_interior (A (0 : H)) (-(B xInf)) hInterior
      (hDirections hd)
  rw [Set.mem_singleton_iff] at hzero_mem
  rw [hzero_mem] at hdnorm
  norm_num at hdnorm

/-- From the lower linear bound on `Φ_A` and the weighted summability supplied by
Proposition 2.2, the increments are summable; completeness then gives strong convergence
of the iterates. -/
theorem theorem31_variation_converges_from_phi_bound (A : SetValuedOperator H H)
    (lam : ℕ → ℝ) (x : ℕ → H) (α : ℝ) (hα : 0 < α)
    (hPhi : ∀ z, PhiA A z ≥ ((α * ‖z‖ : ℝ) : EReal))
    (hlam_pos : ∀ n, lam n > 0) (hlam_nondec : ∀ n, lam n ≤ lam (n + 1))
    (hWeighted : ∃ S : ℝ,
      Tendsto (fun N : ℕ => (Finset.range (N + 1)).sum (fun n =>
        (lam n : EReal) * PhiA A ((lam n)⁻¹ • (x (n + 2) - x (n + 1)))))
        atTop (𝓝 S)) :
    (∃ S : ℝ,
      Tendsto (fun N : ℕ =>
        (Finset.range (N + 1)).sum (fun n => ‖x (n + 1) - x n‖)) atTop (𝓝 S)) ∧
    ∃ xInf : H, Tendsto x atTop (𝓝 xInf) :=
  theorem31_variation_converges_from_phi_bound_core A lam x α hα hPhi hlam_pos
    hlam_nondec hWeighted

/-- Closedness of the subdifferential graph and of the maximal-monotone graph, applied
to the sequence selected from the algorithmic inclusion in the proof of Theorem 3.1(ii). -/
theorem theorem31_closed_graph_limit_selection (A B : SetValuedOperator H H)
    (f : H → EReal) (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    ∃ vBar : H, vBar ∈ B xInf ∧ -vBar ∈ A (0 : H) :=
  theorem31_closed_graph_limit_selection_core A B f lam x h xInf hxInf

/-- In finite dimension, if the iterates are not eventually stationary, every limit
direction obtained from non-stationary increments lies in the union of normal cones
described in Theorem 3.1(iii). -/
theorem theorem31_limit_directions_normal_cone [FiniteDimensional ℝ H]
    (A B : SetValuedOperator H H) (f : H → EReal)
    (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (hnotFinite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    normalizedIncrementLimitPoints x ⊆ normalConeSet (A (0 : H)) (-(B xInf)) :=
  theorem31_limit_directions_normal_cone_core A B f lam x h xInf hxInf hnotFinite

omit [CompleteSpace H] in
/-- If `-∂f(x∞)` is contained in the interior of `A(0)`, the normal-cone limit-direction
alternative is incompatible with an infinite non-stationary tail. -/
theorem theorem31_interior_condition_forces_finite [FiniteDimensional ℝ H]
    (A B : SetValuedOperator H H) (f : H → EReal)
    (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf))
    (hInterior : (-(B xInf)) ⊆ interior (A (0 : H)))
    (hDirections : normalizedIncrementLimitPoints x ⊆ normalConeSet (A (0 : H)) (-(B xInf)))
    (hnotFinite : ¬ ∃ N, ∀ n ≥ N, x n = x N) :
    False :=
  theorem31_interior_condition_forces_finite_core A B f lam x h xInf hxInf hInterior
    hDirections hnotFinite

/-- Theorem 3.1(i): the increments are summable and the strong limit exists. -/
theorem thm_3_1_i (A B : SetValuedOperator H H) (f : H → EReal)
    (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x) :
    (∃ S : ℝ,
      Tendsto (fun N : ℕ =>
        (Finset.range (N + 1)).sum (fun n => ‖x (n + 1) - x n‖)) atTop (𝓝 S)) ∧
    ∃ xInf : H, Tendsto x atTop (𝓝 xInf) := by
  have hAzero : (0 : H) ∈ A (0 : H) := interior_subset h.zero_mem_interior_A_zero
  rcases (lem_2_1 A h.maxMonotoneA.1 h.domA hAzero).2 h.zero_mem_interior_A_zero with
    ⟨α, hα, hPhi⟩
  have hx1_dom : x 1 ∈ ERealFunction.dom f := h.initial_point_mem_dom
  have hprop := prop_2_2 A B h.maxMonotoneA h.domA hAzero f h.convex_f
    h.lowerSemicontinuous_f h.B_eq_subderivative_f h.dom_subderivative_nonempty
    h.f_bddBelow lam h.lam_pos h.lam_nondec x h.generated_by_algorithm hx1_dom
  exact theorem31_variation_converges_from_phi_bound A lam x α hα hPhi h.lam_pos
    h.lam_nondec hprop.2

/-- Theorem 3.1(ii): the strong limit solves the stationary inclusion. -/
theorem thm_3_1_ii (A B : SetValuedOperator H H) (f : H → EReal)
    (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    (0 : H) ∈ A (0 : H) + B xInf := by
  rcases theorem31_closed_graph_limit_selection A B f lam x h xInf hxInf with
    ⟨vBar, hvBarB, hnegA⟩
  rw [Set.mem_add]
  exact ⟨-vBar, hnegA, vBar, hvBarB, by simp⟩

/-- Theorem 3.1(iii): in finite dimension, either finite convergence holds or the
normalized-increment limit points lie in the stated normal cone; the interior condition
forces finite convergence. -/
theorem thm_3_1_iii [FiniteDimensional ℝ H] (A B : SetValuedOperator H H) (f : H → EReal)
    (lam : ℕ → ℝ) (x : ℕ → H)
    (h : Theorem31Assumptions A B f lam x)
    (xInf : H) (hxInf : Tendsto x atTop (𝓝 xInf)) :
    ((∃ N, ∀ n ≥ N, x n = x N) ∨
      normalizedIncrementLimitPoints x ⊆ normalConeSet (A (0 : H)) (-(B xInf))) ∧
    ((-(B xInf)) ⊆ interior (A (0 : H)) → ∃ N, ∀ n ≥ N, x n = x N) := by
  constructor
  · by_cases hFinite : ∃ N, ∀ n ≥ N, x n = x N
    · exact Or.inl hFinite
    · exact Or.inr (theorem31_limit_directions_normal_cone A B f lam x h xInf hxInf hFinite)
  · intro hInterior
    by_contra hnotFinite
    have hDirections :
        normalizedIncrementLimitPoints x ⊆ normalConeSet (A (0 : H)) (-(B xInf)) :=
      theorem31_limit_directions_normal_cone A B f lam x h xInf hxInf hnotFinite
    exact theorem31_interior_condition_forces_finite A B f lam x h xInf hxInf hInterior
      hDirections hnotFinite
