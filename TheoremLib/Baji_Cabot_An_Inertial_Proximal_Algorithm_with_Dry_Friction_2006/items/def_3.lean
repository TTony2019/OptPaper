import Mathlib
import Foundation.SetValued.Basic

/-!
# Algorithm (A)
Let $H$ be a Hilbert space and $A, B: H \Rightarrow H$ two maximal monotone operators.
Given initial data $x_0, x_1 \in H$ and a sequence $(\lambda_n)$ of positive steps,
the sequence $(x_n)$ is defined by:
$$(x_{n+2} - 2x_{n+1} + x_n) / \lambda_n^2 + A((x_{n+2} - x_{n+1}) / \lambda_n) + B(x_{n+2}) \ni 0.$$
-/
open SetValuedOperator
open scoped Pointwise
variable {H : Type _} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
/-- Algorithm (A): the sequence `x` is generated by the inertial proximal algorithm
with operators `A` and `B` and step sizes `lam`. -/
structure AlgorithmA (A B : SetValuedOperator H H) (x : ℕ → H) (lam : ℕ → ℝ) : Prop where
  lam_pos : ∀ n, lam n > 0
  step : ∀ n, (0 : H) ∈
    ({((lam n)^2)⁻¹ • (x (n+2) - 2 • x (n+1) + x n)} : Set H) +
    A ((lam n)⁻¹ • (x (n+2) - x (n+1))) +
    B (x (n+2))
