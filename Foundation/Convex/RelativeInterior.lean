import Mathlib
import Foundation.Convex.NormalCone

/-!
# Core, relative interior, and strong relative interior

Definition 6.9 of the Bauschke–Combettes book: the core, the strong relative
interior, the relative interior, and the quasirelative interior of a set, together
with the closures of the relative interior and of the quasirelative interior.
Promoted from Bauschke-lean-project (Chap06).
-/

open scoped Pointwise

universe u

namespace Set

section

variable {E : Type u} [AddCommGroup E] [Module ℝ E]

/-! Source item: Bauschke-lean-project/BauschkeLean/Chap06/Definition_6_9 -/

/-- Definition 6.9 (1): the core `core C` is the set of points `x ∈ C` such that the cone
generated by the translate `C - x` is the whole ambient real vector space. -/
def core (C : Set E) : Set E :=
  {x ∈ C | cone (C - ({x} : Set E)) = (univ : Set E)}

/-- Membership in the core means belonging to `C` and generating the whole space by the cone of
the translate `C - x`. -/
theorem mem_core_iff {C : Set E} {x : E} :
    x ∈ core C ↔ x ∈ C ∧ cone (C - ({x} : Set E)) = (univ : Set E) := by
  -- Unfold the defining subset and simplify membership in the bounded comprehension.
  simp [Set.core]

section

variable [TopologicalSpace E] [ContinuousAdd E] [ContinuousConstSMul ℝ E]

/-- Definition 6.9 (2): the strong relative interior `sri C` is the set of points `x ∈ C` such
that the cone generated by `C - x` equals the closed linear span of `C - x`. -/
def strongRelativeInterior (C : Set E) : Set E :=
  {x ∈ C |
    cone (C - ({x} : Set E)) =
      ((Submodule.span ℝ (C - ({x} : Set E))).topologicalClosure : Set E)}

scoped notation "sri" => Set.strongRelativeInterior

/-- Membership in the strong relative interior means belonging to `C` and having the cone of
`C - x` equal to the closed span of `C - x`. -/
theorem mem_strongRelativeInterior_iff {C : Set E} {x : E} :
    x ∈ strongRelativeInterior C ↔
      x ∈ C ∧
        cone (C - ({x} : Set E)) =
          ((Submodule.span ℝ (C - ({x} : Set E))).topologicalClosure : Set E) := by
  -- Unfold the defining subset and simplify membership in the bounded comprehension.
  simp [Set.strongRelativeInterior]

end

/-- Definition 6.9 (3): the relative interior `ri C` is the set of points `x ∈ C` such that the
cone generated by `C - x` equals the linear span of `C - x`. -/
def relativeInterior (C : Set E) : Set E :=
  {x ∈ C | cone (C - ({x} : Set E)) = (Submodule.span ℝ (C - ({x} : Set E)) : Set E)}

scoped notation "ri" => Set.relativeInterior

/-- Membership in the relative interior means belonging to `C` and having the cone of `C - x`
equal to the linear span of `C - x`. -/
theorem mem_relativeInterior_iff {C : Set E} {x : E} :
    x ∈ relativeInterior C ↔
      x ∈ C ∧ cone (C - ({x} : Set E)) = (Submodule.span ℝ (C - ({x} : Set E)) : Set E) := by
  -- Unfold the defining subset and simplify membership in the bounded comprehension.
  simp [Set.relativeInterior]

section StrongToRelative

variable [TopologicalSpace E] [ContinuousAdd E] [ContinuousConstSMul ℝ E]

/-- Strong relative interior implies relative interior. -/
theorem mem_relativeInterior_of_mem_strongRelativeInterior
    {C : Set E} {x : E} (hx : x ∈ sri C) : x ∈ ri C := by
  rcases mem_strongRelativeInterior_iff.mp hx with ⟨hxC, hcone⟩
  refine mem_relativeInterior_iff.mpr ⟨hxC, ?_⟩
  apply Set.Subset.antisymm
  · exact ConvexCone.hull_min
      (C := (Submodule.span ℝ (C - ({x} : Set E))).toConvexCone)
      (fun z hz ↦ Submodule.subset_span hz)
  · intro z hz
    have hz' : z ∈
        ((Submodule.span ℝ (C - ({x} : Set E))).topologicalClosure : Set E) :=
      (Submodule.span ℝ (C - ({x} : Set E))).le_topologicalClosure hz
    rw [← hcone] at hz'
    exact hz'

end StrongToRelative

section QuasiRelativeInterior

variable [TopologicalSpace E] [ContinuousAdd E] [ContinuousConstSMul ℝ E]

/-- Definition 6.9 (4): the quasirelative interior `qri C` is the set of points `x ∈ C` such that
the closure of the cone generated by `C - x` equals the closed linear span of `C - x`. -/
def quasiRelativeInterior (C : Set E) : Set E :=
  {x ∈ C |
    closure (cone (C - ({x} : Set E))) =
      ((Submodule.span ℝ (C - ({x} : Set E))).topologicalClosure : Set E)}

/-- Membership in the quasirelative interior means belonging to `C` and having the closed cone of
`C - x` equal to the closed span of `C - x`. -/
theorem mem_quasiRelativeInterior_iff {C : Set E} {x : E} :
    x ∈ quasiRelativeInterior C ↔
      x ∈ C ∧
        closure (cone (C - ({x} : Set E))) =
          ((Submodule.span ℝ (C - ({x} : Set E))).topologicalClosure : Set E) := by
  -- Unfold the defining subset and simplify membership in the bounded comprehension.
  simp [Set.quasiRelativeInterior]

/-- Definition 6.9 (6): the notation `overline (qri C)` is represented in Lean by
`closedQuasiRelativeInterior C`, defined as the closure of `qri C`. -/
def closedQuasiRelativeInterior (C : Set E) : Set E :=
  closure (quasiRelativeInterior C)

/-- The closed quasirelative interior is the closure of the quasirelative interior. -/
theorem closedQuasiRelativeInterior_def (C : Set E) :
    closedQuasiRelativeInterior C = closure (quasiRelativeInterior C) := by
  -- Unfold the notation wrapper for the closure of the quasirelative interior.
  rfl

end QuasiRelativeInterior

section ClosedRelativeInterior

variable [TopologicalSpace E]

/-- Definition 6.9 (5): the notation `overline (ri C)` is represented in Lean by
`closedRelativeInterior C`, defined as the closure of `ri C`. -/
def closedRelativeInterior (C : Set E) : Set E :=
  closure (relativeInterior C)

/-- The closed relative interior is the closure of the relative interior. -/
theorem closedRelativeInterior_def (C : Set E) :
    closedRelativeInterior C = closure (relativeInterior C) := by
  -- Unfold the notation wrapper for the closure of the relative interior.
  rfl

end ClosedRelativeInterior

end

/-! ## Prerequisite helper lemmas

Promoted together with Definition 6.9 because they are the elementary set and
conic-hull facts used to unfold the interiors above.
Source items: Bauschke-lean-project/BauschkeLean/Chap06/Proposition_6_21
(`sub_singleton_zero_eq_self`, `cone_subset_topologicalClosure_span`) and
Bauschke-lean-project/BauschkeLean/Chap15/Remark_15_6.
-/

section SubSingletonZero

variable {E : Type u} [AddGroup E]

/-- Subtracting the singleton `{0}` leaves a set unchanged. -/
theorem sub_singleton_zero_eq_self (C : Set E) :
    C - ({(0 : E)} : Set E) = C := by
  ext x
  constructor
  · intro hx
    rcases Set.mem_sub.mp hx with ⟨u, hu, v, hv, huv⟩
    have hv0 : v = 0 := by
      simpa using hv
    have hux : u = x := by
      simpa [hv0] using huv
    simpa [hux] using hu
  · intro hx
    exact Set.mem_sub.mpr ⟨x, hx, 0, by simp, by simp⟩

end SubSingletonZero

section ConeSubsetTopologicalClosureSpan

variable {E : Type u} [AddCommGroup E] [Module ℝ E] [TopologicalSpace E] [ContinuousAdd E]
  [ContinuousConstSMul ℝ E]

/-- Every conic hull lies in the closed linear span of the generating set. -/
theorem cone_subset_topologicalClosure_span (C : Set E) :
    cone C ⊆ ((Submodule.span ℝ C).topologicalClosure : Set E) := by
  have hsubset : C ⊆ ((Submodule.span ℝ C).topologicalClosure : Set E) := by
    intro x hx
    exact Submodule.closure_subset_topologicalClosure_span (s := C) (subset_closure hx)
  -- The closed linear span is itself a convex cone, so minimality of `cone C` gives the inclusion.
  simpa [Set.cone_def] using
    (ConvexCone.hull_min (C := ((Submodule.span ℝ C).topologicalClosure).toConvexCone) hsubset)

/-- For a convex set, the generated cone is the canonical cone attached to the set. -/
theorem convexCone_hull_eq_toCone {C : Set E} (hC_convex : Convex ℝ C) :
    (ConvexCone.hull ℝ C : Set E) =
      ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) := by
  simpa [ConvexCone.hull] using
    congrArg (fun S : ConvexCone ℝ E => (S : Set E)) hC_convex.toCone_eq_sInf.symm

/-- For a nonempty convex set, the origin is in its strong relative interior exactly
when its cone is the closed linear span of the set. -/
theorem zero_mem_strongRelativeInterior_iff_cone_eq_closure_span_of_nonempty_convex
    {C : Set E} (hC_nonempty : C.Nonempty) (hC_convex : Convex ℝ C) :
    (0 : E) ∈ strongRelativeInterior C ↔
      cone C = ((Submodule.span ℝ C).topologicalClosure : Set E) := by
  constructor
  · intro h0
    rcases mem_strongRelativeInterior_iff.mp h0 with ⟨h0C, hcone⟩
    simpa [sub_singleton_zero_eq_self] using hcone
  · intro hcone
    obtain ⟨x, hx⟩ := hC_nonempty
    have htoCone :
        ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) =
          ((Submodule.span ℝ C).topologicalClosure : Set E) := by
      calc
        ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) = cone C := by
          simpa [Set.cone_def] using (convexCone_hull_eq_toCone hC_convex).symm
        _ = ((Submodule.span ℝ C).topologicalClosure : Set E) := hcone
    have hx_closedSpan : x ∈ ((Submodule.span ℝ C).topologicalClosure : Set E) := by
      exact Submodule.closure_subset_topologicalClosure_span (s := C) (subset_closure hx)
    have hnegx_toCone : -x ∈ ((hC_convex.toCone C : ConvexCone ℝ E) : Set E) := by
      rw [htoCone]
      exact Submodule.neg_mem _ hx_closedSpan
    rcases hC_convex.mem_toCone.mp hnegx_toCone with ⟨c, hc, y, hy, hcy⟩
    obtain ⟨z, hz, hz_eq⟩ := hC_convex.exists_mem_add_smul_eq hx hy zero_le_one hc.le
    have hz_zero : z = 0 := by
      have hz_eq_zero : (1 + c) • z = 0 := by
        simpa [hcy] using hz_eq
      exact (smul_eq_zero.mp hz_eq_zero).resolve_left (by positivity)
    have h0C : (0 : E) ∈ C := by simpa [hz_zero] using hz
    refine mem_strongRelativeInterior_iff.mpr ?_
    refine ⟨h0C, ?_⟩
    simpa [sub_singleton_zero_eq_self] using hcone

end ConeSubsetTopologicalClosureSpan

end Set
