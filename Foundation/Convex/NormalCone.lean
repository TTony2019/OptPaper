import Mathlib
import Foundation.Separation.Hyperplanes

/-!
# Tangent and normal cones

Definition 6.38 of the Bauschke–Combettes book: the tangent cone `T[C] x` (closure of the cone
generated by `C - x`, empty away from `C`) and the normal cone `N[C] x` (vectors whose
inner-product supremum on `C - x` is nonpositive, empty away from `C`). Promoted from
Bauschke-lean-project (Chap06).
-/

open scoped Classical InnerProductSpace Pointwise

universe u

namespace Set

/-! Source item: Bauschke-lean-project/BauschkeLean/Chap06/Definition_6_9 -/

section Cone

variable {E : Type u} [AddCommMonoid E] [Module ℝ E]

/-- Source-facing bridge: the textbook cone of a set is the underlying set of its convex cone hull
in the canonical mathlib API. -/
abbrev cone (C : Set E) : Set E :=
  (ConvexCone.hull ℝ C : Set E)

/-- The textbook cone notation is the underlying set of the convex cone hull. -/
theorem cone_def (C : Set E) : cone C = (ConvexCone.hull ℝ C : Set E) :=
  rfl

end Cone

section TangentCone

variable {E : Type u} [NormedAddCommGroup E] [Module ℝ E]

/-- Definition 6.38 (1): the tangent cone to `C` at `x` is the closure of the cone generated by
`C - x` when `x ∈ C`, and it is empty otherwise. -/
noncomputable def tangentCone (C : Set E) (x : E) : Set E :=
  {v : E | x ∈ C ∧ v ∈ closure (cone (C - ({x} : Set E)))}

/- Lean surface notation for the textbook tangent cone `T[C]`. -/
scoped notation "T[" C "]" => Set.tangentCone C

/-- The tangent cone at a point of `C` is the closure of the cone generated by the translate
`C - x`. -/
theorem tangentCone_of_mem {C : Set E} {x : E} (hx : x ∈ C) :
    T[C] x = closure (cone (C - ({x} : Set E))) := by
  ext v
  simp [tangentCone, hx]

/-- The tangent cone is empty away from the set. -/
theorem tangentCone_of_not_mem {C : Set E} {x : E} (hx : x ∉ C) :
    T[C] x = ∅ := by
  ext v
  simp [tangentCone, hx]

end TangentCone

section NormalCone

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Definition 6.38 (2): the normal cone to `C` at `x` is the set of vectors `u` whose
inner-product supremum on `C - x` is nonpositive when `x ∈ C`, and it is empty otherwise. -/
noncomputable def normalCone (C : Set H) (x : H) : Set H :=
  {u : H | x ∈ C ∧ innerSupremumOn (C - ({x} : Set H)) u ≤ 0}

/- Lean surface notation for the textbook normal cone `N[C]`. -/
scoped notation "N[" C "]" => Set.normalCone C

/-- At a point of `C`, the normal cone is the negative polar of `C - x`, expressed by the
inequality `innerSupremumOn (C - x) u ≤ 0`. -/
theorem normalCone_of_mem {C : Set H} {x : H} (hx : x ∈ C) :
    N[C] x = {u : H | innerSupremumOn (C - ({x} : Set H)) u ≤ 0} := by
  ext u
  simp [normalCone, hx]

/-- The normal cone is empty away from the set. -/
theorem normalCone_of_not_mem {C : Set H} {x : H} (hx : x ∉ C) :
    N[C] x = ∅ := by
  ext u
  simp [normalCone, hx]

end NormalCone

end Set


/-! Source item: Bauschke-lean-project/BauschkeLean/Chap06/Proposition_6_47 -/

section SupportInequalityOnTranslate

variable {𝓗 : Type u} [NormedAddCommGroup 𝓗] [InnerProductSpace ℝ 𝓗]
variable {C : Set 𝓗}

/-- The support inequality on the translate `C - {p}` is equivalent to the pointwise variational
inequalities against all `y ∈ C`. -/
lemma innerSupremumOn_sub_singleton_le_zero_iff {u p : 𝓗} :
    innerSupremumOn (C - ({p} : Set 𝓗)) u ≤ 0 ↔ ∀ y ∈ C, ⟪y - p, u⟫_ℝ ≤ 0 := by
  constructor
  · intro hsup y hy
    have hsep :
        innerSupremumOn (C - ({p} : Set 𝓗)) u ≤ innerInfimumOn ({0} : Set 𝓗) u := by
      simpa using hsup
    have hinner :=
      (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
        (C - ({p} : Set 𝓗)) ({0} : Set 𝓗) u).1 hsep
    have hy_sub : y - p ∈ C - ({p} : Set 𝓗) := by
      exact ⟨y, hy, p, by simp, rfl⟩
    simpa using hinner (y - p) hy_sub 0 (by simp)
  · intro hinner
    have hsep :
        innerSupremumOn (C - ({p} : Set 𝓗)) u ≤ innerInfimumOn ({0} : Set 𝓗) u :=
      (innerSupremumOn_le_innerInfimumOn_iff_forall_inner_le
        (C - ({p} : Set 𝓗)) ({0} : Set 𝓗) u).2
        (fun v hv z hz ↦ by
          have hz' : z = 0 := by simpa using hz
          subst hz'
          rcases hv with ⟨y, hy, w, hw, hv⟩
          have hw' : w = p := by simpa using hw
          have hv' : v = y - p := by
            simpa [hw'] using hv.symm
          simpa [hv'] using hinner y hy)
    simpa using hsep

end SupportInequalityOnTranslate

namespace Set

section NormalConeBridge

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- Membership in the normal cone, expressed by the pointwise variational inequalities:
`u ∈ N[C] x` iff `x ∈ C` and `⟪y - x, u⟫ ≤ 0` for all `y ∈ C`. This is the classical
presentation of the normal cone used across the papers. -/
theorem mem_normalCone_iff_forall {C : Set H} {x u : H} :
    u ∈ N[C] x ↔ x ∈ C ∧ ∀ y ∈ C, ⟪y - x, u⟫_ℝ ≤ 0 := by
  classical
  by_cases hx : x ∈ C
  · rw [normalCone_of_mem hx]
    simp [hx]
  · rw [normalCone_of_not_mem hx]
    simp [hx]

/-- The normal cone as the classical operator form: the if-then-else presentation with the
pointwise variational inequalities inside, empty away from `C`. -/
theorem normalCone_eq (C : Set H) :
    N[C] = fun x ↦ if x ∈ C then {u : H | ∀ y ∈ C, ⟪y - x, u⟫_ℝ ≤ 0} else ∅ := by
  classical
  funext x
  by_cases hx : x ∈ C
  · rw [if_pos hx, normalCone_of_mem hx]
    ext u
    simp
  · rw [if_neg hx, normalCone_of_not_mem hx]

end NormalConeBridge

end Set
